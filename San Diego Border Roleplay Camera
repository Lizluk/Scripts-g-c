-- HỆ THỐNG LƯU / TẢI DỮ LIỆU TỰ ĐỘNG (An toàn tuyệt đối)
----------------------------------------------------
local function saveData()
	pcall(function()
		if not writefile then return end
		
		local serializableKeybinds = {}
		for seatName, keyCode in pairs(seatKeybinds) do
			serializableKeybinds[seatName] = keyCode.Name
		end
		
		local serializableCams = {}
		for _, cam in ipairs(savedCameraPoints) do
			local p = cam.cframe.Position
			local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cam.cframe:GetComponents()
			table.insert(serializableCams, {
				name = cam.name,
				components = {p.X, p.Y, p.Z, r00, r01, r02, r10, r11, r12, r20, r21, r22}
			})
		end
		
		local data = {
			keybinds = serializableKeybinds,
			cameras = serializableCams,
			autoDelay = autoDelayTime
		}
		
		writefile(configFileName, HttpService:JSONEncode(data))
	end)
end

local function loadData()
	pcall(function()
		if not readfile or not isfile or not isfile(configFileName) then return end
		local content = readfile(configFileName)
		local data = HttpService:JSONDecode(content)
		
		if data then
			if data.keybinds then
				for seatName, keyName in pairs(data.keybinds) do
					local success, keyCode = pcall(function()
						return Enum.KeyCode[keyName]
					end)
					if success and keyCode then
						seatKeybinds[seatName] = keyCode
					end
				end
			end
			
			if data.cameras then
				savedCameraPoints = {}
				for _, cam in ipairs(data.cameras) do
					if cam.components and #cam.components >= 12 then
						local c = cam.components
						local cf = CFrame.new(c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12])
						table.insert(savedCameraPoints, { name = cam.name, cframe = cf })
					end
				end
			end
			
			if data.autoDelay then
				autoDelayTime = data.autoDelay
			end
		end
	end)
end

-- Tải dữ liệu an toàn
loadData()

