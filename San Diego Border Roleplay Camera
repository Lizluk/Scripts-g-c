local function updateCameraList()
	for _, child in ipairs(scrollingCams:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end

	for i, camData in ipairs(savedCameraPoints) do
		local rowFrame = Instance.new("Frame")
		rowFrame.Size = UDim2.new(1, 0, 0, 30)
		rowFrame.BackgroundTransparency = 1
		rowFrame.Parent = scrollingCams

		local viewBtn = Instance.new("TextButton")
		viewBtn.Size = UDim2.new(0.75, 0, 1, 0)
		viewBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		viewBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		viewBtn.Text = camData.name
		viewBtn.TextSize = 12
		viewBtn.Font = Enum.Font.SourceSans
		viewBtn.Parent = rowFrame

		viewBtn.MouseButton1Click:Connect(function()
			isViewingCamera = true
			currentCamFocusCFrame = camData.cframe
			camAngles = Vector2.new(0, 0)
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = camData.cframe
		end)

		local delBtn = Instance.new("TextButton")
		delBtn.Size = UDim2.new(0.22, 0, 1, 0)
		delBtn.Position = UDim2.new(0.78, 0, 0, 0)
		delBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
		delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		delBtn.Text = "Xóa"
		delBtn.TextSize = 11
		delBtn.Font = Enum.Font.SourceSansBold
		delBtn.Parent = rowFrame

		delBtn.MouseButton1Click:Connect(function()
			table.remove(savedCameraPoints, i)
			updateCameraList()
			saveData()
		end)
	end
	scrollingCams.CanvasSize = UDim2.new(0, 0, 0, camListLayout.AbsoluteContentSize.Y)
end

updateCameraList()

saveCamBtn.MouseButton1Click:Connect(function()
	local camName = "Cam Điểm #" .. (#savedCameraPoints + 1)
	table.insert(savedCameraPoints, { name = camName, cframe = camera.CFrame })
	updateCameraList()
	saveData()
end)

