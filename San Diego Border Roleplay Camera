-- CÁC HÀM XỬ LÝ GHẾ & XE (ĐÃ KHÔI PHỤC TỰ ĐỘNG QUÉT)
----------------------------------------------------
local function teleportToSeat(descendant)
	if descendant and descendant:IsA("BasePart") then
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			humanoid.Sit = false
			rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 4, 0)
			task.wait(0.05)
			rootPart.CFrame = descendant.CFrame
			task.wait(0.05)
			local prompt = descendant:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				fireproximityprompt(prompt)
			else
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
				task.wait(0.05)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
				humanoid:Sit(descendant)
			end
		end
	end
end

function clearSeatsList()
	for _, child in ipairs(scrollingSeats:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
end

local function updateSeatsList()
	clearSeatsList()
	local seatPart = humanoid.SeatPart
	if not seatPart then return end

	local vehicle = seatPart.Parent
	currentVehicle = vehicle
	local vehicleSeats, normalSeats = {}, {}

	if vehicle and vehicle:IsA("Model") then
		for _, descendant in ipairs(vehicle:GetDescendants()) do
			if descendant:IsA("VehicleSeat") then table.insert(vehicleSeats, descendant)
			elseif descendant:IsA("Seat") then table.insert(normalSeats, descendant) end
		end

		local driverSeatFound = vehicleSeats[1] or normalSeats[1]
		local allFoundSeats = {}
		for _, s in ipairs(vehicleSeats) do table.insert(allFoundSeats, s) end
		for _, s in ipairs(normalSeats) do table.insert(allFoundSeats, s) end

		for _, descendant in ipairs(allFoundSeats) do
			local rowFrame = Instance.new("Frame")
			rowFrame.Size = UDim2.new(1, 0, 0, 30)
			rowFrame.BackgroundTransparency = 1
			rowFrame.Parent = scrollingSeats

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(0.65, 0, 1, 0)
			btn.BackgroundColor3 = (descendant == seatPart) and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(60, 60, 60)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Text = descendant.Name
			btn.TextSize = 12
			btn.Font = Enum.Font.SourceSans
			btn.Parent = rowFrame

			btn.MouseButton1Click:Connect(function() teleportToSeat(descendant) end)

			local keyBtn = Instance.new("TextButton")
			keyBtn.Size = UDim2.new(0.32, 0, 1, 0)
			keyBtn.Position = UDim2.new(0.68, 0, 0, 0)
			keyBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
			keyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			
			local currentKey = seatKeybinds[descendant.Name]
			keyBtn.Text = currentKey and currentKey.Name or "Set Phím"
			keyBtn.TextSize = 11
			keyBtn.Font = Enum.Font.SourceSans
			keyBtn.Parent = rowFrame

			keyBtn.MouseButton1Click:Connect(function()
				waitingForKeySeat = descendant.Name
				keyBtn.Text = "Bấm phím..."
			end)
		end
		scrollingSeats.CanvasSize = UDim2.new(0, 0, 0, seatListLayout.AbsoluteContentSize.Y)

		if autoEnabled and driverSeatFound and seatPart ~= driverSeatFound then
			task.wait(autoDelayTime)
			teleportToSeat(driverSeatFound)
		end
	end
end

-- Lắng nghe sự kiện đổi nhân vật & đổi xe tự động quét
local function setupCharacter(newChar)
	character = newChar
	humanoid = newChar:WaitForChild("Humanoid")
	
	humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
		local seatPart = humanoid.SeatPart
		if seatPart then
			local vehicle = seatPart.Parent
			if vehicle and vehicle ~= currentVehicle then
				currentVehicle = vehicle
				updateSeatsList() -- TỰ ĐỘNG QUÉT KHI ĐỔI XE MỚI
			end
		else
			currentVehicle = nil
			clearSeatsList()
		end
	end)
end

