local function toggleSelectAll()
    local allPlayers = Players:GetPlayers()
    local otherPlayersCount = 0
    local selectedCount = 0

    for _, p in pairs(allPlayers) do
        if p ~= LocalPlayer then
            otherPlayersCount = otherPlayersCount + 1
            if targets[p.Name] then
                selectedCount = selectedCount + 1
            end
        end
    end

    if selectedCount == otherPlayersCount and otherPlayersCount > 0 then
        targets = {}
        SelectAllBtn.Text = "☑️ SELECT ALL PLAYERS [T]"
        SelectAllBtn.BackgroundColor3 = Color3.fromRGB(50, 90, 150)
    else
        for _, p in pairs(allPlayers) do
            if p ~= LocalPlayer then
                targets[p.Name] = true
            end
        end
        SelectAllBtn.Text = "☒ DESELECT ALL PLAYERS [T]"
        SelectAllBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    end
end

SelectAllBtn.MouseButton1Click:Connect(toggleSelectAll)

