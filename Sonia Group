local syncBindable = Instance.new("BindableEvent")

local function sendSyncCommand(actionType, extraData)
    if not isGroupLeader then return end
    local cmdString = actionType .. ";" .. tostring(extraData or "") .. ";" .. tostring(tick())
    LocalPlayer:SetAttribute("LizlukCommand", cmdString)
end

-- Lắng nghe xem ai trong Server đang dùng Script
local function refreshGroupList()
    for _, child in pairs(GroupScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p:GetAttribute("LizlukScriptActive") then
            local pName = p.Name
            local itemFrame = Instance.new("Frame")
            itemFrame.Size = UDim2.new(1, 0, 0, 30)
            itemFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            itemFrame.Parent = GroupScroll

            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 4)
            itemCorner.Parent = itemFrame

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -35, 1, 0)
            nameLbl.Position = UDim2.new(0, 5, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = pName .. (pName == groupLeaderName and " [LEADER]" or "")
            nameLbl.TextColor3 = (pName == groupLeaderName) and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(200, 200, 200)
            nameLbl.Font = Enum.Font.SourceSansBold
            nameLbl.TextSize = 13
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = itemFrame

            local starBtn = Instance.new("TextButton")
            starBtn.Size = UDim2.new(0, 25, 0, 25)
            starBtn.Position = UDim2.new(1, -28, 0.5, -12)
            starBtn.BackgroundColor3 = (pName == groupLeaderName) and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(60, 60, 65)
            starBtn.Text = "⭐"
            starBtn.TextSize = 12
            starBtn.Parent = itemFrame

            local starCorner = Instance.new("UICorner")
            starCorner.CornerRadius = UDim.new(0, 4)
            starCorner.Parent = starBtn

            starBtn.MouseButton1Click:Connect(function()
                if pName == LocalPlayer.Name then
                    groupLeaderName = LocalPlayer.Name
                    isGroupLeader = true
                    LocalPlayer:SetAttribute("LizlukLeader", LocalPlayer.Name)
                    refreshGroupList()
                end
            end)
        end
    end
end

-- Vòng lặp quét những ai dùng Script và kiểm tra lệnh từ Leader
task.spawn(function()
    while true do
        refreshGroupList()
        
        -- Nếu mình không phải Leader, tìm xem ai đang là Leader để nhận lệnh
        if not isGroupLeader then
            for _, p in pairs(Players:GetPlayers()) do
                if p:GetAttribute("LizlukLeader") == p.Name then
                    groupLeaderName = p.Name
                    local lastCmd = p:GetAttribute("LizlukCommand")
                    if lastCmd and lastCmd ~= "" then
                        local parts = string.split(lastCmd, ";")
                        local cmd = parts[1]
                        local arg = parts[2]
                        local cmdTime = tonumber(parts[3]) or 0
                        
                        -- Chỉ thực thi lệnh nếu mới phát ra
                        if tick() - cmdTime < 1.5 then
                            if cmd == "TOGGLE_KA" then killAuraActive = (arg == "true")
                            elseif cmd == "TOGGLE_DRINK" then autoDrinkActive = (arg == "true")
                            elseif cmd == "TOGGLE_EAT" then autoEatActive = (arg == "true")
                            elseif cmd == "TOGGLE_PASSIVE" then passiveSkillActive = (arg == "true")
                            elseif cmd == "TOGGLE_GRAB" then autoGrabActive = (arg == "true")
                            elseif cmd == "TOGGLE_FORAGE" then autoForageActive = (arg == "true")
                            elseif cmd == "ATTACK" then syncBindable:Fire("ATTACK") end
                            updateUtilityVisuals()
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

