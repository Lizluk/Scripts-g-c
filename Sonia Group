UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if UserInputService:GetFocusedTextBox() or gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.F1 then GroupFrame.Visible = not GroupFrame.Visible end
    if input.KeyCode == Enum.KeyCode.P then MainFrame.Visible = not MainFrame.Visible end
    if input.KeyCode == Enum.KeyCode.O and portalRemote then pcall(function() portalRemote:FireServer() end) end
    
    if input.KeyCode == Enum.KeyCode.Q then
        killAuraActive = not killAuraActive
        StatusLabel.Text = killAuraActive and "KILL AURA: READY [Q]" or "KILL AURA: PAUSED [Q]"
        StatusLabel.TextColor3 = killAuraActive and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 200, 50)
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        for pName, _ in pairs(groupList) do executeGroupAttack(pName) end
    end

    for pName, data in pairs(groupList) do
        if data.Key == input.KeyCode then executeGroupAttack(pName) end
    end
end)

