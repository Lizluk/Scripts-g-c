-- Hàm thực thi đòn đánh Kill Aura
local function performKillAuraAttack()
    if not killAuraActive then return end
    if tick() - lastAttackTime < attackCooldown then return end
    
    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    if myRoot then
        for pName, isTargeted in pairs(targets) do
            if isTargeted then
                local targetCharacter = charactersFolder:FindFirstChild(pName)
                local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                
                if targetRoot then
                    local currentDist = (myRoot.Position - targetRoot.Position).Magnitude
                    if currentDist <= maxDetectDistance then
                        pcall(function()
                            damageRemote:FireServer({[1] = targetCharacter})
                        end)
                        lastAttackTime = tick()
                    end
                end
            end
        end
    end
end

syncBindable.Event:Connect(function(cmd)
    if cmd == "ATTACK" then
        performKillAuraAttack()
    end
end)

