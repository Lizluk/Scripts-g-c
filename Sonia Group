local function onChatMessageReceived(senderName, message)
	if senderName == LocalPlayer.Name then return end

	if message == PREFIX_PING then
		groupMembers[senderName] = os.time()
		refreshGroupGUI()
		return
	end

	if string.sub(message, 1, #PREFIX_CMD) == PREFIX_CMD then
		local commandData = string.sub(message, #PREFIX_CMD + 1)
		local split = string.split(commandData, ":")
		local cmd = split[1]
		local val = split[2]

		if cmd == "ATTACK" then performKillAuraAttack()
		elseif cmd == "KILLAURA" then
			killAuraActive = (val == "true")
			StatusLabel.Text = killAuraActive and "KILL AURA: READY [Q]" or "KILL AURA: PAUSED [Q]"
			StatusLabel.TextColor3 = killAuraActive and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 200, 50)
		elseif cmd == "DRINK" then autoDrinkActive = (val == "true") updateUtilityVisuals()
		elseif cmd == "EAT" then autoEatActive = (val == "true") updateUtilityVisuals()
		elseif cmd == "PASSIVE" then passiveSkillActive = (val == "true") updateUtilityVisuals()
		elseif cmd == "GRAB" then autoGrabActive = (val == "true") updateUtilityVisuals()
		elseif cmd == "FORAGE" then autoForageActive = (val == "true") updateUtilityVisuals()
		elseif cmd == "PORTAL" then triggerPortal()
		elseif cmd == "TOGGLE_SELECT_ALL" then toggleSelectAll()
		end
	end
end

