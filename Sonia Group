-- Xử lý khi nhận Message từ người chơi khác
local function onChatMessageReceived(senderName, message)
	if senderName == LocalPlayer.Name then return end

	-- Nhận heartbeat
	if message == PREFIX_PING then
		groupMembers[senderName] = os.time()
		refreshGroupGUI()
		return
	end

	-- Nhận lệnh điều khiển từ Trưởng Nhóm
	if string.sub(message, 1, #PREFIX_CMD) == PREFIX_CMD then
		local commandData = string.sub(message, #PREFIX_CMD + 1)
		local split = string.split(commandData, ":")
		local cmd = split[1]
		local val = split[2]

		if cmd == "ATTACK" then
			performKillAuraAttack()
		elseif cmd == "KILLAURA" then
			killAuraActive = (val == "true")
			if killAuraActive then
				StatusLabel.Text = "KILL AURA: READY [Q]"
				StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
			else
				StatusLabel.Text = "KILL AURA: PAUSED [Q]"
				StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
			end
		elseif cmd == "DRINK" then
			autoDrinkActive = (val == "true")
			updateUtilityVisuals()
		elseif cmd == "EAT" then
			autoEatActive = (val == "true")
			updateUtilityVisuals()
		elseif cmd == "PASSIVE" then
			passiveSkillActive = (val == "true")
			updateUtilityVisuals()
		elseif cmd == "GRAB" then
			autoGrabActive = (val == "true")
			updateUtilityVisuals()
		elseif cmd == "FORAGE" then
			autoForageActive = (val == "true")
			updateUtilityVisuals()
		elseif cmd == "PORTAL" then
			triggerPortal()
		elseif cmd == "TOGGLE_SELECT_ALL" then
			toggleSelectAll()
		end
	end
end

