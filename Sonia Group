----------------------------------------------------------------
-- 3. ĐÁNH AURA (TỐC ĐỘ 1.4s)
----------------------------------------------------------------
local function executeGroupAttack(pName)
    local data = groupList[pName]
    if not data or not data.Enabled then return end
    if tick() - data.LastAttack < attackCooldown then return end

    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    if myRoot then
        local targetCharacter = charactersFolder:FindFirstChild(pName)
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

        if targetRoot then
            if (myRoot.Position - targetRoot.Position).Magnitude <= maxDetectDistance then
                if damageRemote then pcall(function() damageRemote:FireServer({[1] = targetCharacter}) end) end
                data.LastAttack = tick()
            end
        end
    end
end

