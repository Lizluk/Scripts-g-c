		end
	else
		for _, player in pairs(Players:GetPlayers()) do
			player.Chatted:Connect(function(msg) onChatMessageReceived(player.Name, msg) end)
		end
		Players.PlayerAdded:Connect(function(player)
			player.Chatted:Connect(function(msg) onChatMessageReceived(player.Name, msg) end)
		end)
	end
end)

----------------------------------------------------------------
-- 2. LIGHTWEIGHT ESP
----------------------------------------------------------------

local function applyESP(player, character)
	if not character or player == LocalPlayer then return end
	local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 3)
	if not head then return end

	if head:FindFirstChild("PlayerESP") then head.PlayerESP:Destroy() end

	local bb = Instance.new("BillboardGui")
	bb.Name = "PlayerESP"
	bb.Size = UDim2.new(0, 150, 0, 30)
	bb.AlwaysOnTop = true
	bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
	bb.Adornee = head
	bb.MaxDistance = maxDetectDistance
	bb.Parent = head

	local txt = Instance.new("TextLabel")
	txt.Name = "ESPText"
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.BackgroundTransparency = 1
	txt.Font = Enum.Font.SourceSansBold
	txt.TextSize = 13
	txt.Parent = bb
end

for _, p in pairs(Players:GetPlayers()) do 
	if p ~= LocalPlayer then
		p.CharacterAdded:Connect(function(char) applyESP(p, char) end)
		if p.Character then applyESP(p, p.Character) end
	end
end

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function(char) applyESP(p, char) end)
end)

task.spawn(function()
	while true do
		local myCharacter = LocalPlayer.Character
		local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

		if myRoot then
			for _, player in pairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local head = player.Character:FindFirstChild("Head")
					if head then
						local espGui = head:FindFirstChild("PlayerESP")
						if not espGui then
							applyESP(player, player.Character)
						else
							espGui.MaxDistance = maxDetectDistance
							local txt = espGui:FindFirstChild("ESPText")
							if txt then
								local distance = math.floor((myRoot.Position - head.Position).Magnitude)
								if distance <= maxDetectDistance then
									if targets[player.Name] then
										txt.Text = string.format("[%s] %s\n[%d m]", killAuraActive and "TARGET" or "PAUSED", player.Name, distance)
										txt.TextColor3 = killAuraActive and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 200, 50)
									else
										txt.Text = string.format("%s\n[%d m]", player.Name, distance)
										txt.TextColor3 = Color3.fromRGB(255, 255, 255)
									end
								end
							end
						end
					end
				end
			end
		end
		task.wait(0.3)
	end
end)

----------------------------------------------------------------
-- 3. MAIN UI & TARGET UTILITY LOOP
----------------------------------------------------------------

local buttons = {}

local function buildButtons()
	for _, child in pairs(ScrollingFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	buttons = {}

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local pName = player.Name
			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(1, 0, 0, 30)
			Btn.Font = Enum.Font.SourceSansBold
			Btn.TextSize = 14
			Btn.BorderSizePixel = 0
			Btn.Parent = ScrollingFrame
			Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

			Btn.MouseButton1Click:Connect(function()
				targets[pName] = not targets[pName] and true or nil
			end)

			buttons[pName] = {Button = Btn}
		end
	end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player)
	targets[player.Name] = nil
	groupMembers[player.Name] = nil
	buildButtons()
	refreshGroupGUI()
end)
buildButtons()

task.spawn(function()
	while true do
		local myCharacter = LocalPlayer.Character
		local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
		
		if myRoot then
			for pName, btnData in pairs(buttons) do
				local p = Players:FindFirstChild(pName)
				if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
					btnData.Button.LayoutOrder = targets[pName] and (math.floor(dist) - 100000) or math.floor(dist)
				else
					btnData.Button.LayoutOrder = 999999
				end
			end
		end

		for pName, btnData in pairs(buttons) do
			local Btn = btnData.Button
			Btn.Visible = (searchFilterText == "" or string.find(string.lower(pName), searchFilterText, 1, true)) and true or false

			if targets[pName] then
				Btn.BackgroundColor3 = killAuraActive and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(160, 120, 30)
				Btn.Text = pName .. (killAuraActive and " [TARGET]" or " [PAUSED]")
				Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
				Btn.Text = pName
				Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
			end
		end

		if autoDrinkActive and drinkRemote then
			pcall(function()
				local lake = interactionsFolder:FindFirstChild("Lakes") and interactionsFolder.Lakes:FindFirstChild("Lake")
				if lake then drinkRemote:FireServer(lake) end
			end)
		end

		if autoEatActive and foodRemote then
			pcall(function()
				local ribs = interactionsFolder:FindFirstChild("Food") and interactionsFolder.Food:FindFirstChild("Ribs")
				if ribs then foodRemote:FireServer(ribs) end
			end)
		end

		task.wait(0.3)
	end
end)

