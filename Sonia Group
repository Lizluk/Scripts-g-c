-- Safely get remotes with timeout to prevent infinite script hanging
local function getRemote(parent, name)
	local obj = parent:FindFirstChild(name)
	if not obj then
		task.spawn(function()
			obj = parent:WaitForChild(name, 5)
		end)
	end
	return obj
end

