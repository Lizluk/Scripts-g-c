task.spawn(function()
    while true do
        local elapsed = os.time() - startTime
        local hours = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local secs = elapsed % 60
        PlaytimeLabel.Text = string.format("⏱️ TIME: %02d:%02d:%02d", hours, mins, secs)
        task.wait(1)
    end
end)

local function updateMainListVisibility()
    for pName, btnData in pairs(buttons) do
        if groupList[pName] then
            btnData.Button.Visible = false
        else
            if searchFilterText == "" or string.find(string.lower(pName), searchFilterText, 1, true) then
                btnData.Button.Visible = true
            else
                btnData.Button.Visible = false
            end
        end
    end
end

local function removeFromGroup(pName)
    if groupList[pName] then
        if groupList[pName].Frame then
            groupList[pName].Frame:Destroy()
        end
        groupList[pName] = nil
        updateMainListVisibility()
    end
end

