	for name, lastTime in pairs(groupMembers) do
		if os.time() - lastTime < 10 then -- Lọc người dùng active trong vòng 10s
			local ItemFrame = Instance.new("Frame")
			ItemFrame.Size = UDim2.new(1, 0, 0, 25)
