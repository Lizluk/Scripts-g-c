UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if UserInputService:GetFocusedTextBox() then return end
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		performKillAuraAttack()
		broadcastCommand("ATTACK", "")
	end

	if input.KeyCode == Enum.KeyCode.F1 then GroupFrame.Visible = not GroupFrame.Visible end
	if input.KeyCode == Enum.KeyCode.P then MainFrame.Visible = not MainFrame.Visible end
	if input.KeyCode == Enum.KeyCode.T then 
		toggleSelectAll() 
		broadcastCommand("TOGGLE_SELECT_ALL", "")
	end
	if input.KeyCode == Enum.KeyCode.L then 
		autoDrinkActive = not autoDrinkActive 
		updateUtilityVisuals() 
		broadcastCommand("DRINK", autoDrinkActive)
	end
	if input.KeyCode == Enum.KeyCode.K then 
		autoEatActive = not autoEatActive 
		updateUtilityVisuals() 
		broadcastCommand("EAT", autoEatActive)
	end
	if input.KeyCode == Enum.KeyCode.U then 
		passiveSkillActive = not passiveSkillActive 
		updateUtilityVisuals() 
		broadcastCommand("PASSIVE", passiveSkillActive)
	end
	if input.KeyCode == Enum.KeyCode.J then 
		autoGrabActive = not autoGrabActive 
		updateUtilityVisuals() 
		broadcastCommand("GRAB", autoGrabActive)
	end
	if input.KeyCode == Enum.KeyCode.Y then 
		autoForageActive = not autoForageActive 
		updateUtilityVisuals() 
		broadcastCommand("FORAGE", autoForageActive)
	end
	if input.KeyCode == Enum.KeyCode.O then 
		triggerPortal() 
		broadcastCommand("PORTAL", "")
	end
	if input.KeyCode == Enum.KeyCode.Q then
		killAuraActive = not killAuraActive
		if killAuraActive then
			StatusLabel.Text = "KILL AURA: READY [Q]"
			StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
		else
			StatusLabel.Text = "KILL AURA: PAUSED [Q]"
			StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
		end
		broadcastCommand("KILLAURA", killAuraActive)
	end
end)

