local function sendChatMessage(msg)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if generalChannel then
				generalChannel:SendAsync(msg)
			end
		else
			ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents"):WaitForChild("SayMessageRequest"):FireServer(msg, "All")
		end
	end)
end

local function broadcastCommand(cmdType, value)
	if isLeader then
		local dataStr = cmdType .. ":" .. tostring(value or "")
		sendChatMessage(PREFIX_CMD .. dataStr)
	end
end

