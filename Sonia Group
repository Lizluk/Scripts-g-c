UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if UserInputService:GetFocusedTextBox() then return end
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.F1 then GroupFrame.Visible = not GroupFrame.Visible end
    if input.KeyCode == Enum.KeyCode.P then MainFrame.Visible = not MainFrame.Visible end
    if input.KeyCode == Enum.KeyCode.Q then
        killAuraActive = not killAuraActive
        if killAuraActive then
            StatusLabel.Text = "KILL AURA: READY [Q]"
            StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            StatusLabel.Text = "KILL AURA: PAUSED [Q]"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        end
    end

    -- Click chuột trái cũng chém các mục tiêu trong Group nếu đang bật
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        for pName, data in pairs(groupList) do
            executeGroupAttack(pName)
        end
    end

    -- Đánh theo phím cài riêng
    for pName, data in pairs(groupList) do
        if data.Key == input.KeyCode then
            executeGroupAttack(pName)
        end
    end
end)

-- Vòng lặp Auto Kill Aura tự động theo mốc 1.4s
task.spawn(function()
    while true do
        if killAuraActive then
            for pName, data in pairs(groupList) do
                if data.Enabled then
                    executeGroupAttack(pName)
                end
            end
        end
        task.wait(0.2)
    end
end)

