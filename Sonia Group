local function sendChatMessage(msg)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if generalChannel then generalChannel:SendAsync(msg) end
		else
			local sayReq = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
			if sayReq then sayReq:FireServer(msg, "All") end
		end
	end)
end

local function broadcastCommand(cmdType, value)
	if isLeader then
		sendChatMessage(PREFIX_CMD .. cmdType .. ":" .. tostring(value or ""))
	end
end

