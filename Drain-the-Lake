----------------------------------------------------------------
-- HÀM TÌM KIẾM OBJECT VÀ LOGIC KÍCH HOẠT
----------------------------------------------------------------
local function getPrompt()
    return workspace:FindFirstChild("Scripted") 
        and workspace.Scripted:FindFirstChild("CheckpointParts") 
        and workspace.Scripted.CheckpointParts:FindFirstChild("1")
        and workspace.Scripted.CheckpointParts["1"]:FindFirstChild("Drain")
        and workspace.Scripted.CheckpointParts["1"].Drain:FindFirstChild("Scripted")
        and workspace.Scripted.CheckpointParts["1"].Drain.Scripted:FindFirstChild("ProximityPosition")
        and workspace.Scripted.CheckpointParts["1"].Drain.Scripted.ProximityPosition:FindFirstChild("ProximityPrompt")
end

local function fireUsed()
    local count = tonumber(InputBox1.Text) or 0
    if count > 0 then
        local remote = ReplicatedStorage:WaitForChild("VerdantRemotes"):WaitForChild("VDT_Bucket.Used")
        for i = 1, count do remote:FireServer() end
    end
end

local function firePoured()
    local count = tonumber(InputBox2.Text) or 0
    if count > 0 then
        local p = getPrompt()
        if p then
            local remote = ReplicatedStorage:WaitForChild("VerdantRemotes"):WaitForChild("VDT_Bucket.Poured")
            for i = 1, count do remote:FireServer(p) end
        end
    end
end

local function fireTokens()
    local count = tonumber(InputBox3.Text) or 0
    if count > 0 then
        local p = getPrompt()
        if p then
            local remote = ReplicatedStorage:WaitForChild("VerdantRemotes"):WaitForChild("VDT_Tokens.Take")
            for i = 1, count do remote:FireServer(p) end
        end
    end
end

local function fireAll()
    task.spawn(fireUsed)
    task.spawn(firePoured)
    task.spawn(fireTokens)
end

-- Gán sự kiện nút bấm trên giao diện
SendButton1.MouseButton1Click:Connect(fireUsed)
SendButton2.MouseButton1Click:Connect(firePoured)
SendButton3.MouseButton1Click:Connect(fireTokens)

----------------------------------------------------------------
-- VÒNG LẶP AUTO SIÊU TỐC (Vừa chạy nhanh vừa nhận số từ ô)
----------------------------------------------------------------
task.spawn(function()
    while true do
        if autoEnabled then
            -- Chạy đồng thời cả 3 hàm theo đúng số lượng trong ô nhập
            fireAll() 
            -- Độ trễ tối thiểu để engine nhận lệnh, thay đổi nếu muốn chậm lại
            task.wait(0.01) 
        else
            task.wait(0.1)
        end
    end
end)

----------------------------------------------------------------
-- LẮNG NGHE PHÍM TẮT (KEYBINDS)
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end 
    
    if input.KeyCode == Enum.KeyCode.G then
        MainFrame.Visible = not MainFrame.Visible
    elseif input.KeyCode == Enum.KeyCode.H then
        fireAll()
    elseif input.KeyCode == Enum.KeyCode.J then
        autoEnabled = not autoEnabled
        StatusLabel.Text = autoEnabled and "AUTO STATUS: ON" or "AUTO STATUS: OFF"
        StatusLabel.TextColor3 = autoEnabled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    end
end)
