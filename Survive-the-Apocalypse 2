-- =============================================
local function toggle()
    inversionEnabled = not inversionEnabled
    if inversionEnabled then
        label.Text="(G) Magnet: ON 🟢"; label.TextColor3=Color3.new(0,1,0)
        if not targetPlayer and not currentTargetPos then targetPlayer=client end
        startHeartbeat()
        startScanLoop()
        -- Capture ngay những gì trong DroppedItems
        local f=workspace:FindFirstChild("DroppedItems")
        if f then
            for _,v in ipairs(f:GetDescendants()) do
                if v:IsA("BasePart") and not v.Anchored then
                    capturePart(v)
                end
            end
        end
        game.StarterGui:SetCore("SendNotification",{Title="🧲 Magnet ON",Duration=2,Text="Heartbeat lock | Auto-proximity ON"})
    else
        label.Text="(G) Magnet: OFF 🔴"; label.TextColor3=Color3.new(1,0,0)
        stopHeartbeat()
        stopScanLoop()
        releaseAll()
        statusLabel.Text="Items: 0 | Mode: OFF"
        game.StarterGui:SetCore("SendNotification",{Title="❌ Magnet OFF",Duration=2,Text="Items released"})
    end
end

