-- =============================================
-- MAGNET CORE - HEARTBEAT (không bị rơi khi bị đánh)
-- =============================================
local function getTargetPos()
    if targetPlayer and targetPlayer.Character then
        local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position + Vector3.new(0, STACK_OFFSET_Y, 0) end
    end
    if currentTargetPos then return currentTargetPos end
    local rp = client.Character and client.Character:FindFirstChild("HumanoidRootPart")
    if rp then return (rp.CFrame * CFrame.new(0, STACK_OFFSET_Y, -3)).Position end
    return nil
end

-- Heartbeat: update BodyPosition mỗi frame → không bao giờ rơi
local heartbeatConn = nil

local function startHeartbeat()
    if heartbeatConn then heartbeatConn:Disconnect() end
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not inversionEnabled then return end
        local targetPos = getTargetPos()
        if not targetPos then return end

        for part, data in pairs(capturedParts) do
            if not part or not part.Parent then
                capturedParts[part] = nil
                continue
            end
            local bp = data.bp
            if bp and bp.Parent then
                bp.Position = targetPos
                -- Chống bounce khi gần đích
                local dist = (targetPos - part.Position).Magnitude
                if dist < 3 then
                    part.Velocity = part.Velocity * 0.3
                    part.RotVelocity = part.RotVelocity * 0.3
                end
            end
        end
    end)
end

local function stopHeartbeat()
    if heartbeatConn then
        heartbeatConn:Disconnect()
        heartbeatConn = nil
    end
end

-- =============================================
-- CAPTURE PART
-- =============================================
local function capturePart(part)
    if not part:IsA("BasePart") then return end
    if part.Anchored then return end
    if capturedParts[part] then return end  -- đã capture rồi

    claimOwnership(part)

    local targetPos = getTargetPos() or Vector3.new(0,100,0)

    local bp = Instance.new("BodyPosition", part)
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.D        = BP_DAMPING
    bp.P        = BP_POWER
    bp.Position = targetPos

    -- BodyGyro để giữ orientation (không bị xoay lung tung)
    local bg = Instance.new("BodyGyro", part)
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.D = 200
    bg.P = 1000
    bg.CFrame = CFrame.new(part.Position)

    part.CanCollide = false

    capturedParts[part] = {bp=bp, bg=bg}
end

-- =============================================
-- RELEASE ALL
-- =============================================
local function releaseAll()
    for part, data in pairs(capturedParts) do
        pcall(function()
            if data.bp and data.bp.Parent then data.bp:Destroy() end
            if data.bg and data.bg.Parent then data.bg:Destroy() end
            if part and part.Parent then
                part.CanCollide = true
            end
        end)
    end
    capturedParts = {}
end

-- =============================================
-- SCAN: quét tất cả đồ vật trong workspace
-- Đồ trong bán kính AUTO_PICKUP_RADIUS → tự capture
-- Đồ xa hơn → bỏ qua (chờ bạn lại gần)
-- =============================================
local function isDroppedItem(obj)
    -- Kiểm tra obj là dropped item (BasePart, không phải terrain, không phải character)
    if not obj:IsA("BasePart") then return false end
    if obj.Anchored then return false end
    if obj.Name == "HumanoidRootPart" or obj.Name == "Torso"
    or obj.Name == "UpperTorso" or obj.Name == "LowerTorso"
    or obj.Name == "Head" then return false end
    -- Không thuộc character nào
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and obj:IsDescendantOf(plr.Character) then return false end
    end
    -- Phải thuộc DroppedItems hoặc là loose part trong workspace
    local inDropFolder = false
    local ancestor = obj.Parent
    while ancestor do
        if ancestor.Name == "DroppedItems" then inDropFolder = true; break end
        ancestor = ancestor.Parent
    end
    return inDropFolder
end

local function scanAndCapture()
    local rp = client.Character and client.Character:FindFirstChild("HumanoidRootPart")
    if not rp then return end
    local myPos = rp.Position

    -- Quét DroppedItems folder
    local folder = workspace:FindFirstChild("DroppedItems")
    if folder then
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("BasePart") and not obj.Anchored then
                if not capturedParts[obj] then
                    local dist = (obj.Position - myPos).Magnitude
                    if dist <= AUTO_PICKUP_RADIUS then
                        capturePart(obj)
                    end
                end
            end
        end
    end

    -- Quét thêm toàn workspace (loose parts)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored and not capturedParts[obj] then
            -- Chỉ lấy part trong folder DroppedItems
            local ancestor = obj.Parent
            local valid = false
            while ancestor and ancestor ~= game do
                if ancestor.Name == "DroppedItems" then valid=true; break end
                ancestor = ancestor.Parent
            end
            if valid then
                local dist = (obj.Position - myPos).Magnitude
                if dist <= AUTO_PICKUP_RADIUS then
                    capturePart(obj)
                end
            end
        end
    end
end

-- =============================================
-- AUTO SCAN LOOP
-- =============================================
local scanConn = nil
local function startScanLoop()
    if scanConn then scanConn:Disconnect() end
    local t = 0
    scanConn = RunService.Heartbeat:Connect(function(dt)
        if not inversionEnabled then return end
        t = t + dt
        if t >= SCAN_INTERVAL then
            t = 0
            scanAndCapture()
        end
    end)
end
local function stopScanLoop()
    if scanConn then scanConn:Disconnect(); scanConn=nil end
end

-- =============================================
-- STATUS UPDATE
-- =============================================
task.spawn(function()
    while true do
        if inversionEnabled then
            local count = 0
            for _ in pairs(capturedParts) do count += 1 end
            local mode = "FOLLOW ME"
            if targetPlayer and targetPlayer ~= client then
                mode = "→ " .. targetPlayer.Name
            elseif currentTargetPos then
                mode = "STATION"
            end
            statusLabel.Text = string.format("Items: %d | %s | R: %ds", count, mode, AUTO_PICKUP_RADIUS)
        end
        task.wait(0.5)
    end
end)

-- =============================================
-- MONITOR NEW ITEMS (DroppedItems.DescendantAdded)
-- =============================================
local folder = workspace:FindFirstChild("DroppedItems")
if folder then
    folder.DescendantAdded:Connect(function(v)
        if not inversionEnabled then return end
        if not v:IsA("BasePart") or v.Anchored then return end
        task.wait(0.15)
        local rp = client.Character and client.Character:FindFirstChild("HumanoidRootPart")
        if rp then
            local dist = (v.Position - rp.Position).Magnitude
            if dist <= AUTO_PICKUP_RADIUS then
                capturePart(v)
            end
        end
    end)
end

