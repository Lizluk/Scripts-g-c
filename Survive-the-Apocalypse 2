-- =============================================
-- CLAIM OWNERSHIP
-- =============================================
local function claimOwnership(part)
    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(client, "SimulationRadius", math.huge)
            sethiddenproperty(client, "MaxSimulationRadius", math.huge)
        end
        -- Claim network ownership của part
        if part:IsA("BasePart") then
            pcall(function() part:SetNetworkOwner(client) end)
        end
    end)
end

-- =============================================
-- FILE MANAGEMENT
-- =============================================
local function saveToFile()
    if writefile then
        pcall(function() writefile(FILE_NAME, HttpService:JSONEncode(savedStations)) end)
    end
end
local function loadFromFile()
    if isfile and isfile(FILE_NAME) then
        pcall(function() savedStations = HttpService:JSONDecode(readfile(FILE_NAME)) end)
    end
end
