-- =============================================================================
-- LOGIC KHỞI TẠO DỮ LIỆU & LƯU TRỮ VĨNH VIỄN
-- =============================================================================
local ohNumber1 = 757712
local ohString2 = "ToolReplicator"
local ohString3 = "~sFishing Rod"
local ohString4 = "~sFishPoof"
local currentPositionString = "~f166.3319,151.6902,-552.1445:-0.8641,-0,-0.5035Z-0"

local FILE_NAME = "fishing_saved_positions.json" 
local HttpService = game:GetService("HttpService")
local SavedPositions = {}

-- Hàm ghi file vào máy tính
local function SaveToFile()
    if writefile then
        pcall(function()
            writefile(FILE_NAME, HttpService:JSONEncode(SavedPositions))
        end)
    end
end

-- Hàm đọc file khi mở game
local function LoadFromFile()
    if readfile and isfile and isfile(FILE_NAME) then
        local success, content = pcall(function() return readfile(FILE_NAME) end)
        if success and content ~= "" then
            local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(content) end)
            if decodeSuccess and type(data) == "table" then
                SavedPositions = data
                return
            end
        end
    end
    -- Danh sách mặc định ban đầu nếu chưa từng lưu file
    SavedPositions = {
        {Name = "Vị trí mặc định", Value = "~f166.3319,151.6902,-552.1445:-0.8641,-0,-0.5035Z-0"}
    }
end

LoadFromFile()
if SavedPositions[1] then currentPositionString = SavedPositions[1].Value end
StatusLabel.Text = "Đang chọn: " .. (SavedPositions[1] and SavedPositions[1].Name or "Mặc định")

-- Hàm dịch tọa độ nhân vật sang chuỗi của game
local function GetCurrentPositionString()
    local character = Player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local pos = character.HumanoidRootPart.Position
    local look = character.HumanoidRootPart.CFrame.LookVector
    return string.format("~f%.4f,%.4f,%.4f:%.4f,%.4f,%.4fZ-0", pos.X, pos.Y, pos.Z, look.X, look.Y, look.Z)
end

-- =============================================================================
-- ĐỒ HỌA & ĐIỀU KHIỂN DANH SÁCH
-- =============================================================================
local function UpdateListUI()
    for _, child in pairs(ListScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    ListScroll.CanvasSize = UDim2.new(0, 0, 0, #SavedPositions * 40)
    for index, data in ipairs(SavedPositions) do
        local ItemFrame = Instance.new("Frame")
        local SelectBtn = Instance.new("TextButton")
        local DeleteBtn = Instance.new("TextButton")

        ItemFrame.Parent = ListScroll
        ItemFrame.Size = UDim2.new(1, 0, 0, 35)
        ItemFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

        SelectBtn.Parent = ItemFrame
        SelectBtn.Size = UDim2.new(0, 270, 1, 0)
        SelectBtn.Text = " 📍 " .. data.Name
        SelectBtn.TextXAlignment = Enum.TextXAlignment.Left
        SelectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        SelectBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        SelectBtn.BorderSizePixel = 0
        SelectBtn.TextSize = 14

        SelectBtn.MouseButton1Click:Connect(function()
            currentPositionString = data.Value
            StatusLabel.Text = "Đang chọn: " .. data.Name
        end)

        DeleteBtn.Parent = ItemFrame
        DeleteBtn.Size = UDim2.new(0, 40, 1, 0)
        DeleteBtn.Position = UDim2.new(1, -40, 0, 0)
        DeleteBtn.Text = "X"
        DeleteBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        DeleteBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
        DeleteBtn.Font = Enum.Font.SourceSansBold
        DeleteBtn.BorderSizePixel = 0

        DeleteBtn.MouseButton1Click:Connect(function()
            table.remove(SavedPositions, index)
            SaveToFile() -- Cập nhật file ngay sau khi xóa
            UpdateListUI()
        end)
    end
end

-- Xử lý lấy vị trí hiện tại
GetPosBtn.MouseButton1Click:Connect(function()
    local generatedString = GetCurrentPositionString()
    if generatedString then
        local name = NameInput.Text
        if name == "" then name = "Vị trí " .. os.date("%X") end
        table.insert(SavedPositions, {Name = name, Value = generatedString})
        NameInput.Text = "" 
        SaveToFile() -- Ghi nhớ ngay vào bộ nhớ máy tính
        UpdateListUI()
        currentPositionString = generatedString
        StatusLabel.Text = "Đang chọn: " .. name
    else
        StatusLabel.Text = "❌ Lỗi: Không tìm thấy nhân vật!"
    end
end)

-- Xử lý nút kích hoạt câu cá
StartBtn.MouseButton1Click:Connect(function()
    -- Đọc cấu hình động từ 2 ô nhập mới
    local runCount = tonumber(CountInput.Text) or 10
    local waitDelay = tonumber(DelayInput.Text) or 1.5

    StartBtn.Text = "ĐANG THỰC THI..."
    StartBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    
    -- Phòng chống lỗi LocalizationService không có RemoteFunction (Bọc pcall an toàn)
    local success, remoteService = pcall(function()
        return game:GetService("LocalizationService"):FindFirstChild("RemoteFunction") or game:GetService("LocalizationService").RemoteFunction
    end)
    
    if success and remoteService then
        for i = 1, runCount do
            task.spawn(function()
                pcall(function()
                    remoteService:InvokeServer(ohNumber1, ohString2, ohString3, ohString4, currentPositionString)
                end)
            end)
        end
    else
        StatusLabel.Text = "❌ Lỗi: Game chặn hoặc đổi vị trí Remote!"
    end
    
    task.wait(waitDelay)
    StartBtn.Text = "BẮT ĐẦU CÂU TẠI VỊ TRÍ CHỌN"
    StartBtn.BackgroundColor3 = Color3.fromRGB(163, 61, 61)
end)

UpdateListUI()
