-- =============================================================================
-- KHỞI TẠO BIẾN DỮ LIỆU
-- =============================================================================
local ohNumber1 = 479918
local ohString2 = "ToolReplicator"
local ohString3 = "~sFishing Rod"
local ohString4 = "~sFishPoof"
local currentPositionString = "" 
local targetServiceName = "Chat" -- Mặc định ban đầu theo code mới của bạn

local FILE_NAME = "fishing_saved_positions.json" 
local HttpService = game:GetService("HttpService")
local SavedPositions = {}

local function SaveToFile()
    if writefile then pcall(function() writefile(FILE_NAME, HttpService:JSONEncode(SavedPositions)) end) end
end

local function GetCurrentPositionString()
    local character = Player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local pos = character.HumanoidRootPart.Position
    local look = character.HumanoidRootPart.CFrame.LookVector
    return string.format("~f%.4f,%.4f,%.4f:%.4f,%.4f,%.4fZ0", pos.X, pos.Y, pos.Z, look.X, look.Y, look.Z)
end

-- QUẢN LÝ GIAO DIỆN DANH SÁCH VỊ TRÍ
local function UpdateListUI()
    for _, child in pairs(ListScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    ListScroll.CanvasSize = UDim2.new(0, 0, 0, #SavedPositions * 40)
    
    for index, data in ipairs(SavedPositions) do
        local ItemFrame = Instance.new("Frame")
        local SelectBtn = Instance.new("TextButton")
        local DeleteBtn = Instance.new("TextButton")

        ItemFrame.Parent = ListScroll
        ItemFrame.Size = UDim2.new(1, 0, 0, 35)
        ItemFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

        SelectBtn.Parent = ItemFrame
        SelectBtn.Size = UDim2.new(0, 270, 1, 0)
        SelectBtn.Text = " 📍 " .. data.Name
        SelectBtn.TextXAlignment = Enum.TextXAlignment.Left
        SelectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        SelectBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        SelectBtn.BorderSizePixel = 0
        SelectBtn.TextSize = 13

        SelectBtn.MouseButton1Click:Connect(function()
            currentPositionString = data.Value
            StatusLabel.Text = "📍 Đang chọn vị trí: " .. data.Name
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 255)
        end)

        DeleteBtn.Parent = ItemFrame
        DeleteBtn.Size = UDim2.new(0, 40, 1, 0)
        DeleteBtn.Position = UDim2.new(1, -40, 0, 0)
        DeleteBtn.Text = "X"
        DeleteBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        DeleteBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
        DeleteBtn.Font = Enum.Font.SourceSansBold
        DeleteBtn.BorderSizePixel = 0

        DeleteBtn.MouseButton1Click:Connect(function()
            table.remove(SavedPositions, index)
            SaveToFile()
            UpdateListUI()
        end)
    end
end

local function LoadFromFile()
    if readfile and isfile and isfile(FILE_NAME) then
        local success, content = pcall(function() return readfile(FILE_NAME) end)
        if success and content ~= "" then
            local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(content) end)
            if decodeSuccess and type(data) == "table" then
                SavedPositions = data
                return
            end
        end
    end
    SavedPositions = {{Name = "Vị trí gốc mặc định", Value = "~f251.0864,151.4342,-277.7505:-0.3796,-0,0.9251Z0"}}
end

LoadFromFile()
if SavedPositions[1] then currentPositionString = SavedPositions[1].Value end
UpdateListUI()

-- =============================================================================
-- BƯỚC 1: PHÂN TÍCH CODE (TỰ ĐỘNG BÓC TÁCH MỌI SERVICE)
-- =============================================================================
ParseBtn.MouseButton1Click:Connect(function()
    local text = SpyCodeInput.Text
    if text == "" then
        StatusLabel.Text = "❌ Ô nhập đang trống!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    -- Phân tách tham số cơ bản
    local num1 = text:match("ohNumber1%s*=%s*(%d+)")
    local str2 = text:match('ohString2%s*=%s*"([^"]+)"')
    local str3 = text:match('ohString3%s*=%s*"([^"]+)"')
    local str4 = text:match('ohString4%s*=%s*"([^"]+)"')
    local str5 = text:match('ohString5%s*=%s*"([^"]+)"')
    
    -- THUẬT TOÁN MỚI: Tự động quét tìm GetService("...") bất kỳ
    local detectedService = text:match('game:GetService%("([^"]+)"%)') or text:match("game:GetService%('([^']+)'%)")

    if detectedService then
        targetServiceName = detectedService
    else
        -- Dự phòng nếu không tìm thấy chuỗi GetService chuẩn
        targetServiceName = "Chat"
    end

    if num1 and str2 and str3 and str4 then
        ohNumber1 = tonumber(num1)
        ohString2 = str2
        ohString3 = str3
        ohString4 = str4
        
        if str5 and str5 ~= "" then
            currentPositionString = str5
            local name = "Spy Pos " .. os.date("%X")
            table.insert(SavedPositions, 1, {Name = name, Value = str5})
            SaveToFile()
            UpdateListUI()
        end
        
        StatusLabel.Text = "✅ Bước 1: Nạp xong! Service nhận dạng: " .. targetServiceName
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        SpyCodeInput.Text = "" 
    else
        StatusLabel.Text = "❌ Code không đúng cấu trúc Hydroxide!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

-- =============================================================================
-- BƯỚC 2: LẤY VỊ TRÍ THỰC TẾ SAU
-- =============================================================================
GetPosBtn.MouseButton1Click:Connect(function()
    local generatedString = GetCurrentPositionString()
    if generatedString then
        local name = NameInput.Text
        if name == "" then name = "Vị trí " .. os.date("%X") end
        
        currentPositionString = generatedString
        table.insert(SavedPositions, 1, {Name = name, Value = generatedString})
        NameInput.Text = "" 
        
        SaveToFile()
        UpdateListUI()
        
        StatusLabel.Text = "✅ Bước 2: Đã khóa vị trí thực tế!"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 255)
    else
        StatusLabel.Text = "❌ Lỗi: Không tìm thấy nhân vật!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

-- =============================================================================
-- NÚT BẮT ĐẦU CÂU (CHẠY THEO SERVICE ĐÃ ĐƯỢC PHÂN TÍCH TỰ ĐỘNG)
-- =============================================================================
StartBtn.MouseButton1Click:Connect(function()
    local soLuongKeo = tonumber(CountInput.Text) or 10
    local thoiGianCho = tonumber(DelayInput.Text) or 1.5

    StartBtn.Text = "ĐANG AUTOMATION..."
    StartBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    
    -- Lấy đúng Service đã bốc tách được khi phân tích (Ví dụ: game:GetService("Chat"))
    local successService, TargetService = pcall(function()
        return game:GetService(targetServiceName)
    end)
    
    local remote = nil
    if successService and TargetService then
        remote = TargetService:FindFirstChild("RemoteFunction")
    end

    task.spawn(function()
        if remote then
            StatusLabel.Text = "🎣 Đang câu tại Service: " .. targetServiceName
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
            
            for i = 1, soLuongKeo do
                pcall(function()
                    remote:InvokeServer(ohNumber1, ohString2, ohString3, ohString4, currentPositionString)
                end)
                task.wait(thoiGianCho)
            end
            StatusLabel.Text = "✅ Hoàn thành câu!"
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            StatusLabel.Text = "❌ Không tìm thấy RemoteFunction trong " .. targetServiceName .. "!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        
        StartBtn.Text = "BẮT ĐẦU CÂU TẠI VỊ TRÍ CHỌN"
        StartBtn.BackgroundColor3 = Color3.fromRGB(163, 61, 61)
    end)
end)
