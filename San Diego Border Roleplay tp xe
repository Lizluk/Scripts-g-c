            splitVehicleTpEnabled = not splitVehicleTpEnabled
            SplitTpBtn.Text = splitVehicleTpEnabled and "Xe Đi Trước Người Ở: ON (F5)" or "Xe Đi Trước Người Ở: OFF (F5)"
            SplitTpBtn.BackgroundColor3 = splitVehicleTpEnabled and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(70, 0, 0)
        else
            if not gameProcessed then
                for _, data in ipairs(savedLocations) do
                    if data.key and input.KeyCode.Name == data.key then
                        tpToPos(data.pos)
                    end
                end
            end
        end
    end
end)

local function setupDeathTracker(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    local hrp = character:WaitForChild("HumanoidRootPart", 10)
    if humanoid and hrp then
        local hasDied = false
        local function checkHealth()
            if humanoid.Health <= 0 and not hasDied then
                hasDied = true
                local cf = hrp.CFrame + Vector3.new(0, 5, 0)
                lastDeathPosition = {components = {cf:GetComponents()}}
                table.insert(deathLocations, 1, {
                    name = "Điểm Chết #" .. tostring(#deathLocations + 1),
                    time = os.date("%H:%M:%S"),
                    pos = lastDeathPosition
                })
                if DeathFrame.Visible then refreshDeathList() end
            end
        end
        humanoid:GetPropertyChangedSignal("Health"):Connect(checkHealth)
        humanoid.Died:Connect(checkHealth)
    end
end

if LocalPlayer.Character then setupDeathTracker(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char)
    setupDeathTracker(char)
    if autoRespawnEnabled and lastDeathPosition then
        task.wait(0.5)
        tpToPos(lastDeathPosition)
        lastDeathPosition = nil
    end
end)
