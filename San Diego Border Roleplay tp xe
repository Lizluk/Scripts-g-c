-- SMART TELEPORT HELPER (HỖ TRỢ TÁCH XE VÀ NGƯỜI KHI BẬT F5)
--------------------------------------------------
local function getMyVehicle()
    local character = LocalPlayer.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or not humanoid.SeatPart then return nil end

    local seat = humanoid.SeatPart
    local vehiclesFolder = Workspace:FindFirstChild("Vehicles")

    if vehiclesFolder and seat:IsDescendantOf(vehiclesFolder) then
        local model = seat
        while model and model.Parent ~= vehiclesFolder and model.Parent ~= Workspace do
            model = model.Parent
        end
        return model, seat
    else
        return seat:FindFirstAncestorOfClass("Model"), seat
    end
end

local function tpToPos(cframeData)
    local targetCFrame
    if type(cframeData) == "table" then
        if cframeData.components then
            targetCFrame = CFrame.new(unpack(cframeData.components))
        else
            targetCFrame = CFrame.new(cframeData.x, cframeData.y + 5, cframeData.z)
        end
    else
        return
    end

    local veh, currentSeat = getMyVehicle()

    -- Nếu bật chế độ F5 (Xe đi trước, người ở lại)
    if splitVehicleTpEnabled and veh then
        -- 1. Cho nhân vật rời ghế trước (để người ở lại vị trí cũ)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if humanoid and hrp then
            humanoid.Sit = false
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 3, 0)
        end
        task.wait(0.05)

        -- 2. Tiến hành TP toàn bộ xe đi đến tọa độ mục tiêu
        if veh.PrimaryPart then
            veh:PivotTo(targetCFrame)
        else
            currentSeat.CFrame = targetCFrame
        end
        return
    end

    -- Chế độ bình thường (Cả người lẫn xe cùng TP)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if veh and humanoid and hrp then
        local availableSeats = {}
        for _, descendant in pairs(veh:GetDescendants()) do
            if (descendant:IsA("Seat") or descendant:IsA("VehicleSeat")) then
                if not descendant.Occupant then
                    table.insert(availableSeats, descendant)
                end
            end
        end

        if #availableSeats > 0 then
            local targetSeat = availableSeats[1]

            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            humanoid.Sit = false
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 4, 0)
            task.wait(0.05)
            
            hrp.CFrame = targetSeat.CFrame
            task.wait(0.05)

            local prompt = targetSeat:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                fireproximityprompt(prompt)
            else
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                humanoid:Sit(targetSeat)
            end

            local startTime = tick()
            while tick() - startTime < 1.0 do
                if humanoid.SeatPart == targetSeat then
                    break
                else
                    hrp.CFrame = targetSeat.CFrame
                end
                task.wait(0.05)
            end
            
            task.wait(0.2)
        end
    end

    if veh then
        if veh.PrimaryPart then
            veh:PivotTo(targetCFrame)
        else
            currentSeat.CFrame = targetCFrame
        end
    elseif hrp then
        hrp.CFrame = targetCFrame
    end
end

local function getCurrentCFrameData()
    local veh, seat = getMyVehicle()
    local cf
    if veh then
        local part = veh.PrimaryPart or seat
        cf = part:GetPivot()
    elseif LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        cf = LocalPlayer.Character.HumanoidRootPart.CFrame
    else
        return nil
    end

    local raisedCf = cf + Vector3.new(0, 5, 0)
    return {components = {raisedCf:GetComponents()}}
end

