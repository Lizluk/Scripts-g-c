-- 7. Các hàm xử lý CFrame & Remote
local function getTargetCFrame(instance)
    if not instance then return nil end
    if instance:IsA("BasePart") then return instance.CFrame end
    if instance:IsA("Model") then
        local primary = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
        if primary then return primary.CFrame end
        return instance:GetPivot()
    end
    local foundPart = instance:FindFirstChildWhichIsA("BasePart", true)
    if foundPart then return foundPart.CFrame end
    if instance.Parent and instance.Parent ~= workspace then
        return getTargetCFrame(instance.Parent)
    end
    return nil
end

local function transferItem(itemId)
    local remote = ReplicatedStorage:FindFirstChild("CLIENT_REMOTES") and ReplicatedStorage.CLIENT_REMOTES:FindFirstChild("TransferItem")
    if remote then
        remote:FireServer(itemId, "Main", "Storage")
        print("Đã gửi Remote TransferItem cho ID:", itemId)
    else
        warn("Không tìm thấy RemoteEvent: ReplicatedStorage.CLIENT_REMOTES.TransferItem")
    end
end

local function teleportAndInteract(targetInstance)
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local targetCFrame = getTargetCFrame(targetInstance)
    if targetCFrame then
        hrp.CFrame = targetCFrame * CFrame.new(0, 2, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        task.wait(0.15)
        VirtualInputManager:SendKeyPressEvent(Enum.KeyCode.F, true, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyPressEvent(Enum.KeyCode.F, false, game)
        print("Đã Teleport tới:", targetInstance:GetFullName())
    else
        warn("Không tìm thấy CFrame của:", targetInstance:GetFullName())
    end
end

-- 8. Quét danh sách vật phẩm
local function scanLootables()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local lootablesFolder = workspace:FindFirstChild("Lootables")
    if not lootablesFolder then
        warn("Không tìm thấy thư mục workspace.Lootables")
        return
    end

    local filterText = string.lower(searchBox.Text)

    for _, item in ipairs(lootablesFolder:GetDescendants()) do
        local itemId = item:GetAttribute("ID")
        if itemId then
            local itemName = tostring(item:GetAttribute("ItemName") or item.Name)
            local itemType = tostring(item:GetAttribute("Type") or "Unknown")

            if filterText == "" or string.find(string.lower(itemName), filterText, 1, true) then
                local itemBtn = Instance.new("TextButton")
                itemBtn.Name = "ItemBtn_" .. itemName
                itemBtn.Size = UDim2.new(1, -10, 0, 42)
                itemBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
                itemBtn.Text = string.format("  [%s] %s\n  ID: %s", itemType, itemName, tostring(itemId))
                itemBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
                itemBtn.TextSize = 13
                itemBtn.Font = Enum.Font.SourceSans
                itemBtn.TextXAlignment = Enum.TextXAlignment.Left
                itemBtn.Parent = scrollFrame

                -- Lưu thông tin ID trực tiếp vào nút để dùng cho Transfer All
                itemBtn:SetAttribute("TargetID", itemId)

                local btnCorner = Instance.new("UICorner")
                btnCorner.CornerRadius = UDim.new(0, 4)
                btnCorner.Parent = itemBtn

                -- Bấm thủ công từng món
                itemBtn.MouseButton1Click:Connect(function()
                    if currentMode == "Transfer" then
                        transferItem(itemId)
                    elseif currentMode == "Teleport" then
                        teleportAndInteract(item)
                    end
                end)
            end
        end
    end
end

