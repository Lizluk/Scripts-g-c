            if child:IsA("TextButton") then
                local targetId = child:GetAttribute("TargetID")
                if targetId then
                    transferItem(targetId)
                    task.wait(0.1) -- Khoảng hoãn nhỏ để tránh gửi Remote quá nhanh bị Kick
                end
            end
        end

        transferAllBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 90)
        transferAllBtn.Text = "📥 Transfer All (Lấy tất cả trong danh sách)"
        isTransferringAll = false

        -- Quét lại danh sách sau khi lấy xong
        task.wait(0.5)
        scanLootables()
    end)
end)

