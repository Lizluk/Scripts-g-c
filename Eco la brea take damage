local function viewRemoteLogs(remoteId)
    SelectedRemoteId = remoteId
    local remoteData = RemoteLogs[remoteId]
    if not remoteData then return end
    
    local prefix = (remoteData.ClassName:find("Function") and "🔮 " or "⚡ ")
    DetailTitle.Text = prefix .. remoteData.Name
    
    for _, child in pairs(LogsFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    if BlockedPaths[remoteData.Path] then
        BlockButton.BackgroundColor3 = Color3.fromRGB(150, 45, 45)
        BlockButton.Text = "🟥 Đang Chặn"
    else
        BlockButton.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        BlockButton.Text = "⬜ Chặn"
    end
    
    -- Render dữ liệu tĩnh từ RAM ra UI
    for _, logData in ipairs(remoteData.Logs) do
        local LogBox = Instance.new("Frame")
        LogBox.Size = UDim2.new(1, -6, 0, #logData.DisplayArgs * 20 + 12)
        LogBox.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
        LogBox.BorderColor3 = Color3.fromRGB(40, 40, 45)
        LogBox.Parent = LogsFrame
        
        local BoxLayout = Instance.new("UIListLayout")
        BoxLayout.Padding = UDim.new(0, 2)
        BoxLayout.Parent = LogBox
        
        local padding = Instance.new("UIPadding")
        padding.PaddingTop = UDim.new(0, 4)
        padding.PaddingLeft = UDim.new(0, 8)
        padding.Parent = LogBox
        
        for _, argText in ipairs(logData.DisplayArgs) do
            local argLabel = Instance.new("TextLabel")
            argLabel.Size = UDim2.new(1, 0, 0, 18)
            argLabel.BackgroundTransparency = 1
            argLabel.Text = argText
            argLabel.TextColor3 = Color3.fromRGB(210, 150, 90)
            argLabel.TextSize = 12
            argLabel.Font = Enum.Font.Code
            argLabel.TextXAlignment = Enum.TextXAlignment.Left
            argLabel.Parent = LogBox
        end
        
        LogBox.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                ContextMenu.Position = UDim2.new(0, input.Position.X, 0, input.Position.Y)
                ContextMenu.Visible = true
                
                GenScriptBtn.MouseButton1Click:Connect(function()
                    ContextMenu.Visible = false
                    local method = "FireServer"
                    if remoteData.ClassName == "RemoteFunction" then method = "InvokeServer"
                    elseif remoteData.ClassName == "BindableEvent" then method = "Fire"
                    elseif remoteData.ClassName == "BindableFunction" then method = "Invoke" end
                    
                    local codeString = string.format("-- Generated by HydroSpy V11 Pro\nlocal Target = game.%s\nTarget:%s(%s)", logData.Path, method, table.concat(logData.CodeArgs, ", "))
                    if setclipboard then
                        setclipboard(codeString)
                        print("📋 Đã copy đoạn mã vào Clipboard thành công!")
                    end
                end)
            end
        end)
    end
    RightPanel.Visible = true
end

