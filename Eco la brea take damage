-- LOGIC CẬP NHẬT GIAO DIỆN PHẢI KHI BẤM XEM
local function updateRightPanel(remoteName)
    SelectedRemoteName = remoteName
    DetailTitle.Text = "🔥 " .. remoteName
    
    for _, child in pairs(ArgsFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    
    if BlockedRemotes[remoteName] then
        BlockButton.BackgroundColor3 = Color3.fromRGB(160, 45, 45)
        BlockButton.Text = "🟥 Đang Chặn"
        BlockButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        BlockButton.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        BlockButton.Text = "⬜ Chặn"
        BlockButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    
    local data = SpiedRemotes[remoteName]
    if data and data.Args then
        for _, argStr in ipairs(data.Args) do
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -6, 0, 26)
            label.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
            label.BorderSizePixel = 0
            label.Text = "  " .. argStr
            label.TextColor3 = Color3.fromRGB(215, 155, 95)
            label.TextSize = 12
            label.Font = Enum.Font.Code
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = ArgsFrame
            Instance.new("UICorner", label).CornerRadius = UDim.new(0, 3)
        end
    end
    RightPanel.Visible = true
end

