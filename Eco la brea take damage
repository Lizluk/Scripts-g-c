local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Cấu hình mục tiêu chặn gói tin
local TARGET_EVENT_NAME = "TakeDamage"

-- Trạng thái kích hoạt chặn (Mặc định là tắt, bật/tắt qua GUI)
local IsBlockActive = false

-- Dọn dẹp GUI cũ nếu chạy lại script nhiều lần
local oldGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("TakeDamageBlockerGUI")
if oldGui then oldGui:Destroy() end

-- =========================================================================
-- KIẾN TRÚC CAN THIỆP: METATABLE HOOKING (CHẶN GÓI TIN FIRESERVER)
-- =========================================================================
local success, err = pcall(function()
    local rawMetatable = getrawmetatable(game)
    local setReadOnly = setreadonly or make_writeable
    
    -- Mở khóa Metatable để can thiệp
    setReadOnly(rawMetatable, false)
    
    local oldNamecall = rawMetatable.__namecall

    rawMetatable.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        -- Kiểm tra nếu script của game gọi hàm FireServer
        if not checkcaller() and method == "FireServer" and self:IsA("RemoteEvent") then
            local eventName = self.Name
            
            -- Thực hiện logic chặn gói tin dựa theo từ khóa giống cấu trúc bạn yêu cầu
            if IsBlockActive and string.find(eventName, TARGET_EVENT_NAME) then
                -- Trả về nil để hủy bỏ hoàn toàn gói tin, ngăn không cho gửi dữ liệu sát thương về Server
                return nil
            end
        end
        
        return oldNamecall(self, ...)
    end)

    -- Khóa lại Metatable sau khi cấu hình xong
    setReadOnly(rawMetatable, true)
end)

if not success then 
    warn("⚠️ Thiết bị/Executor của bạn không hỗ trợ can thiệp Metatable sâu: ", err) 
end

