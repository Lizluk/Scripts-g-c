ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 16
UIButtonCorner.Parent = ToggleButton

-- LOGIC CHẶN SỰ KIỆN TAKE DAMAGE (HOOKING)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
-- Thay đổi đường dẫn mục tiêu sang Events.TakeDamage
local TargetEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("TakeDamage")

local isBlocking = false
local rawMeta = getrawmetatable(game)
local oldInstanceMethod = rawMeta.__index.namecall -- Lưu phương thức gốc

-- Mở khóa metatable để can thiệp mạng
setreadonly(rawMeta, false)

rawMeta.__index.namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    -- Nếu đang BẬT chặn và đối tượng gọi là TakeDamage thông qua FireServer/InvokeServer
    if isBlocking and self == TargetEvent and (method == "FireServer" or method == "InvokeServer") then
        warn("[Anti-Damage] Đã chặn gói tin gửi sát thương về server thành công!")
        return nil -- Ngắt kết nối gói tin tại đây, không cho truyền về server
    end
    
    return oldInstanceMethod(self, unpack(args))
end)

setreadonly(rawMeta, true)

-- Sự kiện click nút Bật/Tắt
ToggleButton.MouseButton1Click:Connect(function()
    isBlocking = not isBlocking
    if isBlocking then
        ToggleButton.Text = "Block Damage: ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Xanh lá: Đang chặn
    else
        ToggleButton.Text = "Block Damage: OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Đỏ: Dừng chặn
    end
end)
