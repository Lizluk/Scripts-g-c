local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Danh sách quản lý trạng thái chặn của từng Remote
local BlockedRemotes = {
    ["TakeDamage"] = false
}

-- Dọn dẹp giao diện cũ nếu có
local oldGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("AdvancedRemoteBlocker")
if oldGui then oldGui:Destroy() end

-- =========================================================================
-- KIẾN TRÚC CAN THIỆP PHÂN TÍCH THAM SỐ (ARGUMENT FILTER HOOK)
-- =========================================================================
local success, err = pcall(function()
    local rawMetatable = getrawmetatable(game)
    local setReadOnly = setreadonly or make_writeable
    
    setReadOnly(rawMetatable, false)
    local oldNamecall = rawMetatable.__namecall

    rawMetatable.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        if not checkcaller() and method == "FireServer" and self:IsA("RemoteEvent") then
            local name = self.Name
            
            -- Nếu Remote này nằm trong danh sách đang bị bật chế độ "Chặn"
            if BlockedRemotes[name] == true then
                -- Bẻ gãy đường truyền ngay lập tức, chặn đứng toàn bộ tham số (0.1, "fall"...)
                return nil
            end
        end
        
        return oldNamecall(self, ...)
    end)

    setReadOnly(rawMetatable, true)
end)

if not success then warn("⚠️ Executor không hỗ trợ can thiệp sâu Metatable:", err) end

