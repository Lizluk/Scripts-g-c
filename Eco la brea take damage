-- GHI NHẬN LOG REMOTE VÀO DANH SÁCH BÊN TRÁI
local function registerRemoteLog(remoteName, argsTable)
    SpiedRemotes[remoteName] = {
        Args = argsTable,
        Count = (SpiedRemotes[remoteName] and SpiedRemotes[remoteName].Count or 0) + 1
    }
    
    local existingBtn = LeftPanel:FindFirstChild("Btn_" .. remoteName)
    if existingBtn then
        existingBtn.Text = string.format("  ⚡ (%d) %s", SpiedRemotes[remoteName].Count, remoteName)
        if SelectedRemoteName == remoteName then
            updateRightPanel(remoteName)
        end
    else
        local RemoteItem = Instance.new("TextButton")
        RemoteItem.Name = "Btn_" .. remoteName
        RemoteItem.Size = UDim2.new(1, -6, 0, 30)
        RemoteItem.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
        RemoteItem.BorderSizePixel = 0
        RemoteItem.Text = string.format("  ⚡ (1) %s", remoteName)
        RemoteItem.TextColor3 = Color3.fromRGB(220, 220, 230)
        RemoteItem.TextSize = 13
        RemoteItem.Font = Enum.Font.SourceSans
        RemoteItem.TextXAlignment = Enum.TextXAlignment.Left
        RemoteItem.Parent = LeftPanel
        Instance.new("UICorner", RemoteItem).CornerRadius = UDim.new(0, 4)
        
        RemoteItem.MouseButton1Click:Connect(function()
            for _, child in pairs(LeftPanel:GetChildren()) do
                if child:IsA("TextButton") then child.BackgroundColor3 = Color3.fromRGB(28, 28, 34) end
            end
            RemoteItem.BackgroundColor3 = Color3.fromRGB(44, 44, 52)
            updateRightPanel(remoteName)
        end)
    end
end

-- =========================================================================
-- HỆ THỐNG ĐÁNH CHẶN METAMETHOD LIVE-TRAFFIC (HOOK FIRESERVER)
-- =========================================================================
local success, err = pcall(function()
    local rawMetatable = getrawmetatable(game)
    local setReadOnly = setreadonly or make_writeable
    
    setReadOnly(rawMetatable, false)
    local oldNamecall = rawMetatable.__namecall

    rawMetatable.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        if not checkcaller() and method == "FireServer" and self:IsA("RemoteEvent") then
            local remoteName = self.Name
            local args = {...}
            local formattedArgs = parseArgs(unpack(args))
            
            -- Đẩy tác vụ ghi log ra luồng chạy nền (Tránh gây đứng game)
            task.spawn(function()
                registerRemoteLog(remoteName, formattedArgs)
            end)
            
            -- Cơ chế kích hoạt ngắt kết nối gói tin cụ thể
            if BlockedRemotes[remoteName] == true then
                return nil
            end
        end
        
        return oldNamecall(self, ...)
    end)

    setReadOnly(rawMetatable, true)
end)

if not success then warn("⚠️ Trình thực thi (Executor) của bạn chặn quyền getrawmetatable!", err) end
