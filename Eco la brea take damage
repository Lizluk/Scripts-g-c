-- =========================================================================
-- BỘ CHUYỂN ĐỔI THAM SỐ
-- =========================================================================
local function getArgDetails(v)
    local t = typeof(v)
    if t == "string" then return "String", string.format('"%s"', v), string.format('"%s"', v)
    elseif t == "number" then return "Number", tostring(v), tostring(v)
    elseif t == "boolean" then return "Boolean", tostring(v):upper(), tostring(v)
    elseif t == "Instance" then return "Instance", (v and v:GetFullName() or "nil"), string.format('game.%s', (v and v:GetFullName() or "nil"))
    elseif t == "Vector3" then 
        return "Vector3", string.format("(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z), string.format("Vector3.new(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
    elseif t == "table" then
        local success, json = pcall(function() return HttpService:JSONEncode(v) end)
        return "Table", success and json or "{...}", success and json or "{}"
    else
        return t, tostring(v), tostring(v)
    end
end

