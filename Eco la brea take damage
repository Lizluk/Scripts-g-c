local function refreshLeftPanel()
    for _, btn in pairs(LeftPanel:GetChildren()) do
        if btn:IsA("TextButton") then
            local targetId = tonumber(btn.Name)
            local data = RemoteLogs[targetId]
            if data then
                btn.Visible = (Filters[data.ClassName] == true)
                if not btn.Visible and SelectedRemoteId == targetId then
                    RightPanel.Visible = false
                end
            end
        end
    end
end

