-- =========================================================================
-- HÀM BỔ TRỢ: ĐỊNH DẠNG THAM SỐ THÀNH DẠNG CHUỖI VÀ DẠNG CODE LUA
-- =========================================================================
local function getArgDetails(v)
    local t = typeof(v)
    if t == "string" then return "String", string.format('"%s"', v), string.format('"%s"', v)
    elseif t == "number" then return "Number", tostring(v), tostring(v)
    elseif t == "boolean" then return "Boolean", tostring(v):upper(), tostring(v)
    elseif t == "Instance" then return "Instance", v:GetFullName(), string.format('game.%s', v:GetFullName())
    elseif t == "Vector3" then 
        local str = string.format("(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
        local code = string.format("Vector3.new(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
        return "Vector3", str, code
    elseif t == "table" then
        local success, json = pcall(function() return HttpService:JSONEncode(v) end)
        local display = success and json or "{...}"
        return "Table", display, display
    else
        return t, tostring(v), tostring(v)
    end
end

