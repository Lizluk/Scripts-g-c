-- =========================================================================
-- GHI NHẬN LOG VÀO RAM (TUYỆT ĐỐI KHÔNG TỰ ĐỘNG RENDER RA MÀN HÌNH NÊN KHÔNG LAG)
-- =========================================================================
local function addNewLog(remoteInstance, rawArgs)
    if not remoteInstance or not remoteInstance.Parent then return end
    local rPath = remoteInstance:GetFullName()
    
    if BlockedPaths[rPath] == true then return end
    
    local name = remoteInstance.Name
    local className = remoteInstance.ClassName
    local targetId = nil
    
    for id, data in pairs(RemoteLogs) do
        if data.Path == rPath then targetId = id break end
    end
    
    if not targetId then
        targetId = #RemoteLogs + 1
        RemoteLogs[targetId] = { Name = name, ClassName = className, Path = rPath, Logs = {}, TotalCount = 0 }
    end
    
    local remoteData = RemoteLogs[targetId]
    remoteData.TotalCount = remoteData.TotalCount + 1
    
    local displayList = {}
    local codeList = {}
    for i, v in ipairs(rawArgs) do
        local argType, displayVal, codeVal = getArgDetails(v)
        table.insert(displayList, string.format("[%d] 📦 Type: %s | Value: %s", i, argType, displayVal))
        table.insert(codeList, codeVal)
    end
    if #rawArgs == 0 then table.insert(displayList, "   (No Arguments)") end
    
    table.insert(remoteData.Logs, { DisplayArgs = displayList, CodeArgs = codeList, Path = rPath })
    
    if #remoteData.Logs > MAX_LOGS_PER_REMOTE then
        table.remove(remoteData.Logs, 1)
    end
    
    -- Chỉ cập nhật text của nút bên cột trái, cực nhẹ, không gây tụt FPS
    local existingBtn = LeftPanel:FindFirstChild(tostring(targetId))
    local prefix = className:find("Function") and "🔮" or "⚡"
    
    if existingBtn then
        existingBtn.Text = string.format("  %s (%d) %s", prefix, remoteData.TotalCount, name)
    else
        local RemoteItem = Instance.new("TextButton")
        RemoteItem.Name = tostring(targetId)
        RemoteItem.Size = UDim2.new(1, -6, 0, 30)
        RemoteItem.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
        RemoteItem.BorderSizePixel = 0
        RemoteItem.Text = string.format("  %s (1) %s", prefix, name)
        RemoteItem.TextColor3 = Color3.fromRGB(220, 220, 230)
        RemoteItem.TextSize = 13
        RemoteItem.Font = Enum.Font.SourceSans
        RemoteItem.TextXAlignment = Enum.TextXAlignment.Left
        RemoteItem.Parent = LeftPanel
        
        RemoteItem.MouseButton1Click:Connect(function()
            for _, child in pairs(LeftPanel:GetChildren()) do
                if child:IsA("TextButton") then child.BackgroundColor3 = Color3.fromRGB(26, 26, 30) end
            end
            RemoteItem.BackgroundColor3 = Color3.fromRGB(40, 40, 46)
            viewRemoteLogs(targetId)
        end)
        RemoteItem.Visible = (Filters[className] == true)
    end
end

-- =========================================================================
-- HOOK HỆ THỐNG
-- =========================================================================
local success, err = pcall(function()
    local rawMetatable = getrawmetatable(game)
    local setReadOnly = setreadonly or make_writeable
    
    setReadOnly(rawMetatable, false)
    local oldNamecall = rawMetatable.__namecall

    rawMetatable.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if not checkcaller() and self and self.Parent then
            local successPath, rPath = pcall(function() return self:GetFullName() end)
            
            if successPath then
                if method == "FireServer" and self:IsA("RemoteEvent") then
                    if BlockedPaths[rPath] == true then return end 
                    task.spawn(addNewLog, self, args)
                elseif method == "InvokeServer" and self:IsA("RemoteFunction") then
                    if BlockedPaths[rPath] == true then return nil end 
                    task.spawn(addNewLog, self, args)
                elseif method == "Fire" and self:IsA("BindableEvent") then
                    task.spawn(addNewLog, self, args)
                elseif method == "Invoke" and self:IsA("BindableFunction") then
                    task.spawn(addNewLog, self, args)
                end
            end
        end
        
        return oldNamecall(self, ...)
    end)

    setReadOnly(rawMetatable, true)
end)

if not success then warn("Executor không hỗ trợ can thiệp sâu Metatable:", err) end
