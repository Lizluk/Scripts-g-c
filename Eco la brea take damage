-- LOGIC RENDER VÀ TƯƠNG TÁC
-- =========================================================================
local function viewRemoteLogs(remoteName)
    SelectedRemoteName = remoteName
    DetailTitle.Text = "🔥 " .. remoteName
    
    -- Xóa các danh sách hiển thị cũ
    for _, child in pairs(LogsFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    -- Cập nhật trạng thái nút chặn
    if BlockedRemotes[remoteName] then
        BlockButton.BackgroundColor3 = Color3.fromRGB(150, 45, 45)
        BlockButton.Text = "🟥 Đang Chặn"
    else
        BlockButton.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        BlockButton.Text = "⬜ Chặn"
    end
    
    -- Lấy danh sách toàn bộ các lượt gọi (Log) của Remote này
    local logs = RemoteLogs[remoteName] or {}
    for logIndex, logData in ipairs(logs) do
        -- Tạo một khung bao bọc riêng cho mỗi Lượt Gọi giống ô vuông HydroSpy
        local LogBox = Instance.new("Frame")
        LogBox.Size = UDim2.new(1, -6, 0, #logData.DisplayArgs * 20 + 10)
        LogBox.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
        LogBox.BorderColor3 = Color3.fromRGB(40, 40, 45)
        LogBox.Parent = LogsFrame
        
        local BoxLayout = Instance.new("UIListLayout")
        BoxLayout.Padding = UDim.new(0, 2)
        BoxLayout.Position = UDim2.new(0, 6, 0, 5)
        BoxLayout.Parent = LogBox
        
        -- Thêm các tham số vào bên trong ô vuông đó
        for _, argText in ipairs(logData.DisplayArgs) do
            local argLabel = Instance.new("TextLabel")
            argLabel.Size = UDim2.new(1, -12, 0, 18)
            argLabel.BackgroundTransparency = 1
            argLabel.Text = "    " .. argText
            argLabel.TextColor3 = Color3.fromRGB(210, 150, 90)
            argLabel.TextSize = 12
            argLabel.Font = Enum.Font.Code
            argLabel.TextXAlignment = Enum.TextXAlignment.Left
            argLabel.Parent = LogBox
        end
        
        -- SỰ KIỆN CLICK CHUỘT PHẢI VÀO Ô VUÔNG ĐỂ MỞ MENU COPY CODE
        LogBox.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then -- Click chuột phải
                ContextMenu.Position = UDim2.new(0, input.Position.X, 0, input.Position.Y)
                ContextMenu.Visible = true
                
                -- Kết nối chức năng Generate Script riêng cho lượt gọi này
                GenScriptBtn.MouseButton1Click:Connect(function()
                    ContextMenu.Visible = false
                    
                    -- Xây dựng chuỗi Code Lua hoàn chỉnh
                    local codeString = string.format("-- Generated by HydroSpy V3 Pro\nlocal Remote = %s\nRemote:FireServer(%s)", logData.Path, table.concat(logData.CodeArgs, ", "))
                    
                    -- Sao chép trực tiếp vào bộ nhớ đệm hệ thống (Clipboard) của Executor của bạn
                    if setclipboard then
                        setclipboard(codeString)
                        print("📋 Đã copy code thực thi vào Clipboard!")
                    else
                        print("Mã của bạn:\n" .. codeString)
                    end
                end)
            end
        end)
    end
    RightPanel.Visible = true
end

BlockButton.MouseButton1Click:Connect(function()
    if not SelectedRemoteName then return end
    BlockedRemotes[SelectedRemoteName] = not BlockedRemotes[SelectedRemoteName]
    viewRemoteLogs(SelectedRemoteName)
    
    local itemBtn = LeftPanel:FindFirstChild("Btn_" .. SelectedRemoteName)
    if itemBtn then
        itemBtn.TextColor3 = BlockedRemotes[SelectedRemoteName] and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(220, 220, 230)
    end
end)

-- Ghi nhận dữ liệu Log mới
local function addNewLog(remoteInstance, rawArgs)
    local name = remoteInstance.Name
    if not RemoteLogs[name] then RemoteLogs[name] = {} end
    
    local displayList = {}
    local codeList = {}
    
    for i, v in ipairs(rawArgs) do
        local argType, displayVal, codeVal = getArgDetails(v)
        table.insert(displayList, string.format("[%d] 📦 Type: %s | Value: %s", i, argType, displayVal))
        table.insert(codeList, codeVal)
    end
    if #rawArgs == 0 then table.insert(displayList, "   (No Arguments)") end
    
    -- Lưu trữ thông tin
    table.insert(RemoteLogs[name], {
        DisplayArgs = displayList,
        CodeArgs = codeList,
        Path = remoteInstance:GetFullName()
    })
    
    -- Cập nhật số lượng hiển thị ở cột trái
    local existingBtn = LeftPanel:FindFirstChild("Btn_" .. name)
    local count = #RemoteLogs[name]
    if existingBtn then
        existingBtn.Text = string.format("  ⚡ (%d) %s", count, name)
        if SelectedRemoteName == name then viewRemoteLogs(name) end
    else
        local RemoteItem = Instance.new("TextButton")
        RemoteItem.Name = "Btn_" .. name
        RemoteItem.Size = UDim2.new(1, -6, 0, 30)
        RemoteItem.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
        RemoteItem.BorderSizePixel = 0
        RemoteItem.Text = string.format("  ⚡ (1) %s", name)
        RemoteItem.TextColor3 = Color3.fromRGB(220, 220, 230)
        RemoteItem.TextSize = 13
        RemoteItem.Font = Enum.Font.SourceSans
        RemoteItem.TextXAlignment = Enum.TextXAlignment.Left
        RemoteItem.Parent = LeftPanel
        
        RemoteItem.MouseButton1Click:Connect(function()
            for _, child in pairs(LeftPanel:GetChildren()) do
                if child:IsA("TextButton") then child.BackgroundColor3 = Color3.fromRGB(26, 26, 30) end
            end
            RemoteItem.BackgroundColor3 = Color3.fromRGB(40, 40, 46)
            viewRemoteLogs(name)
        end)
    end
end

-- =========================================================================
-- HỆ THỐNG MÓC NỐI METATABLE HOOKING
-- =========================================================================
local success, err = pcall(function()
    local rawMetatable = getrawmetatable(game)
    local setReadOnly = setreadonly or make_writeable
    
    setReadOnly(rawMetatable, false)
    local oldNamecall = rawMetatable.__namecall

    rawMetatable.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        if not checkcaller() and method == "FireServer" and self:IsA("RemoteEvent") then
            local remoteName = self.Name
            local args = {...}
            
            task.spawn(function()
                addNewLog(self, args)
            end)
            
            if BlockedRemotes[remoteName] == true then
                return nil
            end
        end
        
        return oldNamecall(self, ...)
    end)

    setReadOnly(rawMetatable, true)
end)

if not success then warn("Executor không hỗ trợ can thiệp sâu Metatable:", err) end
