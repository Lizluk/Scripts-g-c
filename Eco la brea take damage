-- =========================================================================
-- BỘ PHÂN TÍCH DỮ LIỆU CHUYÊN SÂU (ADVANCED ARGUMENT PARSER)
-- =========================================================================
local function parseArgs(...)
    local args = {...}
    local formatted = {}
    
    for i, v in ipairs(args) do
        local typeStr = type(v)
        local typeofStr = typeof(v)
        
        if typeStr == "string" then
            table.insert(formatted, string.format("[%d] 📦 Type: String | Value: \"%s\"", i, v))
        elseif typeStr == "number" then
            table.insert(formatted, string.format("[%d] 📦 Type: Number | Value: %s", i, tostring(v)))
        elseif typeStr == "boolean" then
            table.insert(formatted, string.format("[%d] 📦 Type: Boolean | Value: %s", i, tostring(v):upper()))
        elseif typeofStr == "Instance" then
            table.insert(formatted, string.format("[%d] 📦 Type: Instance | Path: %s", i, v:GetFullName()))
        elseif typeofStr == "Vector3" then
            table.insert(formatted, string.format("[%d] 📦 Type: Vector3 | Value: Vector3.new(%.2f, %.2f, %.2f)", i, v.X, v.Y, v.Z))
        elseif typeofStr == "CFrame" then
            table.insert(formatted, string.format("[%d] 📦 Type: CFrame | Value: CFrame.new(%.2f, %.2f, %.2f)", i, v.X, v.Y, v.Z))
        elseif typeofStr == "Color3" then
            table.insert(formatted, string.format("[%d] 📦 Type: Color3 | RGB: %.0f, %.0f, %.0f", i, v.R*255, v.G*255, v.B*255))
        elseif typeStr == "table" then
            local success, json = pcall(function() return HttpService:JSONEncode(v) end)
            table.insert(formatted, string.format("[%d] 📦 Type: Table | Data: %s", i, success and json or "{...}"))
        else
            table.insert(formatted, string.format("[%d] 📦 Type: %s | Value: %s", i, typeofStr, tostring(v)))
        end
    end
    
    if #args == 0 then table.insert(formatted, "   (Không có tham số truyền vào / No Arguments)") end
    return formatted
end

