local Lighting = game:GetService("Lighting")

local function applyFullLighting()
    Lighting.GlobalShadows = false
    Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    Lighting.Brightness = 3
    Lighting.ExposureCompensation = 0.5
    
    Lighting.FogEnd = 9e9
    Lighting.FogStart = 0

    local function setupEffect(className, properties)
        local effect = Lighting:FindFirstChildOfClass(className)
        if not effect then
            effect = Instance.new(className)
            effect.Parent = Lighting
        end
        for prop, val in pairs(properties) do
            effect[prop] = val
        end
        effect.Changed:Connect(function()
            effect[prop] = val
        end)
    end

    setupEffect("Atmosphere", {Density = 0, Offset = 0, Glare = 0, Haze = 0})
    setupEffect("ColorCorrection", {Brightness = 0.2, Contrast = 0.1, Saturation = 0.2})
end

applyFullLighting()

Lighting.Changed:Connect(function(property)
    if property == "Brightness" or property == "OutdoorAmbient" or property == "GlobalShadows" or property == "FogEnd" then
        applyFullLighting()
    end
end)

for _, obj in pairs(Lighting:GetChildren()) do
    obj.Changed:Connect(function()
        applyFullLighting()
    end)
end

print("Lizluk Permanent Full Bright & No Fog Loaded Successfully!")
