local playerButtons = {}
local peccaryButtons = {}

local function scanNpcAndPlayers()
    -- Quét ESP cho heo và các sinh vật khác
    local mainNpcs = workspace:FindFirstChild("NPCs")
    if mainNpcs then
        local pf = mainNpcs:FindFirstChild("FlatHeadedPeccary61")
        if pf then
            for _, v in pairs(pf:GetChildren()) do
                if v:IsA("Model") then applyNPCEsp(v, "Peccary") end
            end
        end
        local bf = mainNpcs:FindFirstChild("Bird")
        if bf then
            for _, v in pairs(bf:GetChildren()) do if v:IsA("Model") then applyNPCEsp(v, "Bird") end end
        end
        local sf = mainNpcs:FindFirstChild("Small")
        if sf then
            for _, v in pairs(sf:GetChildren()) do if v:IsA("Model") then applyNPCEsp(v, "Small") end end
        end
    end

    -- Xây dựng lại danh sách nút bấm trên UI cho sạch sẽ
    for _, btn in pairs(ScrollingFrame:GetChildren()) do
        if btn:IsA("TextButton") then btn:Destroy() end
    end
    playerButtons = {}
    peccaryButtons = {}

    -- Thêm người chơi
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name ~= "Lubakixa" then
            local pName = player.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 28)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 12
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame
            Instance.new("UICorner").Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                targets[pName] = not targets[pName]
            end)
            playerButtons[pName] = Btn
        end
    end

    -- Ép render heo lên UI bằng phương thức trực diện
    if mainNpcs then
        local pf = mainNpcs:FindFirstChild("FlatHeadedPeccary61")
        if pf then
            for _, pig in pairs(pf:GetChildren()) do
                if pig:IsA("Model") then
                    local pigName = pig.Name
                    local Btn = Instance.new("TextButton")
                    Btn.Size = UDim2.new(1, 0, 0, 28)
                    Btn.Font = Enum.Font.SourceSansBold
                    Btn.TextSize = 12
                    Btn.BorderSizePixel = 0
                    Btn.Parent = ScrollingFrame
                    Instance.new("UICorner").Parent = Btn

                    Btn.MouseButton1Click:Connect(function()
                        peccaryTargets[pigName] = not peccaryTargets[pigName]
                    end)
                    peccaryButtons[pigName] = Btn
                end
            end
        end
    end
end

