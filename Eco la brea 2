local function applyESP(character, playerName)
    if not character then return end
    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 5)
    if not head then return end
    if head:FindFirstChild("PlayerESP") then head.PlayerESP:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerESP"
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = head
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 14
    txt.Parent = bb

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if blacklist[playerName] then
            txt.Text = string.format("[🛡️ ĐỒNG ĐỘI] %s", playerName)
            txt.TextColor3 = Color3.fromRGB(0, 180, 255)
            return
        end
        if not charactersFolder or not character:IsDescendantOf(charactersFolder) or not head:IsDescendantOf(character) then
            connection:Disconnect()
            bb:Destroy()
            return
        end
        if not LocalPlayer.Character then return end
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        local distance = math.floor((myRoot.Position - head.Position).Magnitude)
        if targets[playerName] then
            if killAuraActive then
                txt.Text = string.format("[🎯] %s\n[%d m]", playerName, distance)
                txt.TextColor3 = Color3.fromRGB(255, 50, 50)
            else
                txt.Text = string.format("[⏸️] %s\n[%d m]", playerName, distance)
                txt.TextColor3 = Color3.fromRGB(255, 200, 50)
            end
        else
            if playerName == closestPlayerName then
                txt.Text = string.format("[⭐ CẬN] %s\n[%d m]", playerName, distance)
                txt.TextColor3 = Color3.fromRGB(0, 255, 150)
            else
                txt.Text = string.format("%s\n[%d m]", playerName, distance)
                txt.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end
    end)
end

task.spawn(function()
    while not charactersFolder do task.wait(0.5) end
    for _, child in pairs(charactersFolder:GetChildren()) do
        if child:IsA("Model") and child.Name ~= LocalPlayer.Name and child.Name ~= "Lubakixa" then
            if Players:GetPlayerFromCharacter(child) then applyESP(child, child.Name) end
        end
    end
    charactersFolder.ChildAdded:Connect(function(child)
        if child:IsA("Model") and child.Name ~= LocalPlayer.Name and child.Name ~= "Lubakixa" then
            task.wait(0.5)
            if Players:GetPlayerFromCharacter(child) then applyESP(child, child.Name) end
        end
    end)
end)

local function applyNPCEsp(npcModel, typeName)
    if not npcModel or npcModel:FindFirstChild("NpcESP_Holder") then return end
    local targetPart = npcModel:FindFirstChild("Body_m") or npcModel:FindFirstChild("Head") or npcModel:FindFirstChildOfClass("MeshPart") or npcModel:FindFirstChildOfClass("Part")
    if not targetPart then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "NpcESP_Holder"
    bb.Size = UDim2.new(0, 180, 0, 40)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2, 0)
    bb.Adornee = targetPart
    bb.Enabled = npcEspActive 
    bb.Parent = targetPart
    table.insert(activeNpcEsps, bb)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 12
    txt.TextColor3 = Color3.fromRGB(0, 220, 255) 
    txt.Parent = bb

    local connection
    connection = RunService.RenderStepped:Connect(function()
        local myCharacter = LocalPlayer.Character
        if charactersFolder then
            myCharacter = charactersFolder:FindFirstChild(LocalPlayer.Name) or charactersFolder:FindFirstChild("Lubakixa")
        end
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        if not npcModel:IsDescendantOf(workspace) or not targetPart:IsDescendantOf(npcModel) or not myRoot then
            connection:Disconnect()
            local idx = table.find(activeNpcEsps, bb)
            if idx then table.remove(activeNpcEsps, idx) end
            bb:Destroy()
            return
        end
        
        local distance = math.floor((myRoot.Position - targetPart.Position).Magnitude)
        if typeName == "Peccary" and peccaryTargets[npcModel.Name] then
            txt.Text = string.format("🐷 [🎯 MỤC TIÊU]\n%s (%dm)", npcModel.Name, distance)
            txt.TextColor3 = Color3.fromRGB(255, 50, 50)
        else
            txt.Text = string.format("👾 [%s]\n%s (%dm)", typeName, npcModel.Name, distance)
            txt.TextColor3 = (typeName == "Peccary") and Color3.fromRGB(255, 180, 220) or Color3.fromRGB(0, 220, 255)
        end
    end)
end

local function scanNpcFolders()
    local mainNpcs = workspace:FindFirstChild("NPCs")
    if mainNpcs then
        local birdFolder = mainNpcs:FindFirstChild("Bird")
        if birdFolder then for _, c in pairs(birdFolder:GetChildren()) do applyNPCEsp(c, "Bird") end end
        local smallFolder = mainNpcs:FindFirstChild("Small")
        if smallFolder then for _, c in pairs(smallFolder:GetChildren()) do applyNPCEsp(c, "Small") end end
        local peccaryFolder = mainNpcs:FindFirstChild("FlatHeadedPeccary61")
        if peccaryFolder then 
            for _, c in pairs(peccaryFolder:GetChildren()) do 
                if c:IsA("Model") then applyNPCEsp(c, "Peccary") end 
            end 
        end
    end
end

task.spawn(function()
    while true do scanNpcFolders() task.wait(3) end
end)

