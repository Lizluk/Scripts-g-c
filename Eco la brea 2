local playerButtons = {}
local peccaryButtons = {}
local blacklistButtons = {}

local function updateUIList()
    -- Clear cũ
    for _, child in pairs(ScrollingFrame:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    for _, child in pairs(BlacklistFrame:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    playerButtons = {}
    peccaryButtons = {}
    blacklistButtons = {}

    -- Render bảng Kill và bảng Blacklist
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name ~= "Lubakixa" then
            local pName = player.Name
            
            if blacklist[pName] then
                -- Nếu bị cho vào Blacklist thì hiện bên bảng Blacklist làm đồng đội
                local BtnBL = Instance.new("TextButton")
                BtnBL.Size = UDim2.new(1, 0, 0, 24)
                BtnBL.Font = Enum.Font.SourceSansBold
                BtnBL.TextSize = 11
                BtnBL.BackgroundColor3 = Color3.fromRGB(20, 45, 65)
                BtnBL.Text = "🛡️ " .. pName
                BtnBL.TextColor3 = Color3.fromRGB(100, 200, 255)
                BtnBL.Parent = BlacklistFrame
                Instance.new("UICorner", BtnBL).CornerRadius = UDim.new(0, 4)
                
                BtnBL.MouseButton1Click:Connect(function()
                    blacklist[pName] = nil -- Gỡ khỏi Blacklist
                    targets[pName] = nil
                    updateUIList()
                end)
                blacklistButtons[pName] = BtnBL
            else
                -- Nếu không bị Blacklist thì hiện bên bảng Kill
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, 0, 0, 24)
                Btn.Font = Enum.Font.SourceSansBold
                Btn.TextSize = 11
                Btn.BorderSizePixel = 0
                Btn.Parent = ScrollingFrame
                Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

                Btn.MouseButton1Click:Connect(function() 
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
                        -- Giữ Ctrl + Click để ném thẳng vào Blacklist
                        blacklist[pName] = true
                        targets[pName] = nil
                    else
                        -- Click bình thường để Lock Target diệt
                        targets[pName] = not targets[pName] 
                    end
                    updateUIList()
                end)
                playerButtons[pName] = Btn
            end
        end
    end

    -- Render Heo Peccary (Không thể bị cho vào blacklist)
    local mainNpcs = workspace:FindFirstChild("NPCs")
    local peccaryFolder = mainNpcs and mainNpcs:FindFirstChild("FlatHeadedPeccary61")
    if peccaryFolder then
        for _, pci in pairs(peccaryFolder:GetChildren()) do
            if pci:IsA("Model") then
                local npcName = pci.Name
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, 0, 0, 24)
                Btn.Font = Enum.Font.SourceSansBold
                Btn.TextSize = 11
                Btn.BorderSizePixel = 0
                Btn.Parent = ScrollingFrame
                Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

                Btn.MouseButton1Click:Connect(function() 
                    peccaryTargets[npcName] = not peccaryTargets[npcName] 
                end)
                peccaryButtons[npcName] = Btn
            end
        end
    end
end

Players.PlayerAdded:Connect(updateUIList)
Players.PlayerRemoving:Connect(function(player) 
    targets[player.Name] = nil 
    blacklist[player.Name] = nil
    updateUIList() 
end)

task.spawn(function() 
    while true do updateUIList() task.wait(6) end 
end)

--======================================================================
-- 3. VÒNG LẶP HỆ THỐNG GIAO DIỆN & TỰ ĐỘNG XOÁ TÊN KHI MỤC TIÊU CHẾT
--======================================================================
task.spawn(function()
    while true do
        local myCharacter = LocalPlayer.Character
        if charactersFolder then
            myCharacter = charactersFolder:FindFirstChild(LocalPlayer.Name) or charactersFolder:FindFirstChild("Lubakixa")
        end
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        -- Khóa chỉ số
        if isLocking and myCharacter then
            local realAttributesFolder = myCharacter:FindFirstChild("Attributes")
            if realAttributesFolder then
                pcall(function()
                    realAttributesFolder:SetAttribute("Hunger", targetHunger)
                    realAttributesFolder:SetAttribute("Thirst", targetThirst)
                    realAttributesFolder:SetAttribute("Stamina", targetStamina)
                end)
            end
        end

        -- [FIX CHẾT]: Quét dọn các mục tiêu đã chết
        if charactersFolder then
            for pName, isTargeted in pairs(targets) do
                if isTargeted then
                    local pChar = charactersFolder:FindFirstChild(pName)
                    local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
                    -- Nếu không tìm thấy character, không có humanoid, hoặc máu <= 0 -> XÓA KHỎI LOCK TARGET
                    if not pChar or not pHum or pHum.Health <= 0 then
                        targets[pName] = nil
                    end
                end
            end
        end

        local mainNpcs = workspace:FindFirstChild("NPCs")
        local peccaryFolder = mainNpcs and mainNpcs:FindFirstChild("FlatHeadedPeccary61")
        for npcName, isTargeted in pairs(peccaryTargets) do
            if isTargeted then
                local npcModel = peccaryFolder and peccaryFolder:FindFirstChild(npcName)
                local npcHum = npcModel and npcModel:FindFirstChildOfClass("Humanoid")
                -- Nếu heo chết hoặc biến mất -> XÓA KHỎI LOCK TARGET
                if not npcModel or (npcHum and npcHum.Health <= 0) or not npcModel:FindFirstChild("Body_m") then
                    peccaryTargets[npcName] = nil
                end
            end
        end

        -- Tính toán khoảng cách và cập nhật giao diện nút bấm
        local minDistance = math.huge
        local tempClosest = ""
        
        if myRoot and charactersFolder then
            for pName, Btn in pairs(playerButtons) do
                local pChar = charactersFolder:FindFirstChild(pName)
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                if pRoot then
                    local dist = (myRoot.Position - pRoot.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    Btn.LayoutOrder = targets[pName] and (math.floor(dist) - 100000) or math.floor(dist)
                else
                    Btn.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        -- Cập nhật màu sắc nút Player
        for pName, Btn in pairs(playerButtons) do
            if targets[pName] then
                Btn.BackgroundColor3 = killAuraActive and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(160, 120, 30)
                Btn.Text = pName .. (killAuraActive and " [KILL]" or " [PAUSE]")
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                if pName == closestPlayerName then
                    Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                    Btn.Text = "⭐ " .. pName
                    Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
                else
                    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                    Btn.Text = pName
                    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
                end
            end
        end

        -- Cập nhật màu sắc nút Heo Peccary
        for npcName, Btn in pairs(peccaryButtons) do
            local npcModel = peccaryFolder and peccaryFolder:FindFirstChild(npcName)
            local body = npcModel and (npcModel:FindFirstChild("Body_m") or npcModel:FindFirstChildOfClass("Part"))
            if body and myRoot then
                local dist = (myRoot.Position - body.Position).Magnitude
                if peccaryTargets[npcName] then
                    Btn.LayoutOrder = math.floor(dist) - 50000
                    Btn.BackgroundColor3 = Color3.fromRGB(230, 50, 120)
                    Btn.Text = "🐷 " .. npcName .. " [TARGET]"
                    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    Btn.LayoutOrder = math.floor(dist) + 50000
                    Btn.BackgroundColor3 = Color3.fromRGB(25, 35, 45)
                    Btn.Text = "🐷 " .. npcName .. string.format(" (%dm)", math.floor(dist))
                    Btn.TextColor3 = Color3.fromRGB(200, 220, 245)
                end
            else
                Btn.LayoutOrder = 999999
                Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                Btn.Text = "❌ " .. npcName
                Btn.TextColor3 = Color3.fromRGB(100, 100, 100)
            end
        end

        -- Tự động uống nước
        if autoDrinkActive and drinkRemote then
            pcall(function()
                local lake = interactionsFolder and interactionsFolder:FindFirstChild("Lakes") and interactionsFolder.Lakes:FindFirstChild("Lake")
                if lake then drinkRemote:FireServer(lake) end
            end)
        end
        task.wait(0.1)
    end
end)

