-- 3. VÒNG LẶP ĐỒNG BỘ MÀU NÚT & KHOẢNG CÁCH THỰC TẾ
--======================================================================
task.spawn(function()
    while true do
        local myCharacter = LocalPlayer.Character or (charactersFolder and (charactersFolder:FindFirstChild(LocalPlayer.Name) or charactersFolder:FindFirstChild("Lubakixa")))
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

        if isLocking and myCharacter then
            local attr = myCharacter:FindFirstChild("Attributes")
            if attr then
                pcall(function()
                    attr:SetAttribute("Hunger", targetHunger)
                    attr:SetAttribute("Thirst", targetThirst)
                    attr:SetAttribute("Stamina", targetStamina)
                end)
            end
        end

        local minDistance = math.huge
        local tempClosest = ""

        -- Đồng bộ nút Player
        for pName, Btn do
            if Btn and Btn.Parent then
                local pChar = charactersFolder and charactersFolder:FindFirstChild(pName)
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                if pRoot and myRoot then
                    local dist = (myRoot.Position - pRoot.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    Btn.LayoutOrder = targets[pName] and (math.floor(dist) - 100000) or math.floor(dist)
                    
                    if targets[pName] then
