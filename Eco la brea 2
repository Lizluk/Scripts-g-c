-- 4. VÒNG LẶP TẤN CÔNG THƯỜNG PLAYER (LOẠI BỎ BLACKLIST)
--======================================================================
task.spawn(function()
    while true do
        if killAuraActive and attackRemote and charactersFolder then
            local myCharacter = charactersFolder:FindFirstChild(LocalPlayer.Name) or charactersFolder:FindFirstChild("Lubakixa")
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

            if myRoot then
                for pName, isTargeted in pairs(targets) do
                    -- Kiểm tra bảo vệ: Nếu nằm trong BLACKLIST thì TUYỆT ĐỐI không đánh!
                    if isTargeted and not blacklist[pName] then 
                        local targetCharacter = charactersFolder:FindFirstChild(pName)
                        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                        local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
                        local targetHitbox = targetCharacter and targetCharacter:FindFirstChild("BodyHitbox")
                        
                        if targetRoot and targetHumanoid and targetHitbox and targetHumanoid.Health > 0 then
                            local distance = (myRoot.Position - targetRoot.Position).Magnitude
                            if distance <= maxDetectDistance then
                                pcall(function() attackRemote:FireServer(targetHumanoid, targetHitbox, 1) end)
                            end
                        end
                    end
                end
            end
        end
        task.wait(attackCooldown)
    end
end)

