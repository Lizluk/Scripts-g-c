-- Kéo thả sắp xếp thứ tự emote trong danh sách C (tự lưu sau khi kéo)
local draggingEmoteIndex = nil
local dragEmoteConn = nil
local dragEmoteEndConn = nil
local rebuildEmoteListUI

local function moveEmoteItem(fromIdx, toIdx)
	if fromIdx == toIdx then return end
	if fromIdx < 1 or fromIdx > #emoteList then return end
	toIdx = math.clamp(toIdx, 1, #emoteList)

	local activeEntry = (activeEmoteIndex > 0) and emoteList[activeEmoteIndex] or nil
	local movedItem = table.remove(emoteList, fromIdx)
	table.insert(emoteList, toIdx, movedItem)

	if activeEntry then
		activeEmoteIndex = 0
		for i, entry in ipairs(emoteList) do
			if entry == activeEntry then
				activeEmoteIndex = i
				break
			end
		end
	end
	persistEmotes()
end

local function stopEmoteDrag()
	draggingEmoteIndex = nil
	if dragEmoteConn then
		dragEmoteConn:Disconnect()
		dragEmoteConn = nil
	end
	if dragEmoteEndConn then
		dragEmoteEndConn:Disconnect()
		dragEmoteEndConn = nil
	end
	emoteScroll.ScrollingEnabled = true
end

local function startEmoteDrag(sourceIndex)
	stopEmoteDrag()
	if sourceIndex < 1 or sourceIndex > #emoteList then return end

	draggingEmoteIndex = sourceIndex
	emoteScroll.ScrollingEnabled = false

	dragEmoteConn = UserInputService.InputChanged:Connect(function(input)
		if draggingEmoteIndex and input.UserInputType == Enum.UserInputType.MouseMovement then
			local relY = (input.Position.Y - emoteScroll.AbsolutePosition.Y) + emoteScroll.CanvasPosition.Y
			local stepHeight = 32
			local targetIdx = math.clamp(math.floor(relY / stepHeight) + 1, 1, #emoteList)
			if targetIdx ~= draggingEmoteIndex then
				moveEmoteItem(draggingEmoteIndex, targetIdx)
				draggingEmoteIndex = targetIdx
				rebuildEmoteListUI()
				updateStatusText()
			end
		end
	end)

	dragEmoteEndConn = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopEmoteDrag()
			persistEmotes()
			rebuildEmoteListUI()
		end
	end)
end

