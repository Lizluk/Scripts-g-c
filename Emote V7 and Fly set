local function cloneKeybinds(src)
	local out = {}
	for k, defaultVal in pairs(DEFAULT_KEYBINDS) do
		local val = src and src[k]
		if type(val) == "string" and Enum.KeyCode[val] then
			out[k] = val
		else
			out[k] = defaultVal
		end
	end
	return out
end

local function isBindPressed(actionName)
	local codeName = keybinds[actionName]
	local kc = codeName and Enum.KeyCode[codeName]
	if not kc then return false end
	return UserInputService:IsKeyDown(kc)
end

