local function recordScannedAnimId(rawId, rawTitle)
	if not scannerEnabled then return end
	local numericId = extractNumericId(rawId)
	if not numericId or numericId == "" then return end
	if seenScannedIds[numericId] then return end

	seenScannedIds[numericId] = true
	scanCounter += 1

	local titleText = tostring(rawTitle or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if titleText == "" or titleText == "Animation" then
		titleText = "Animation" .. tostring(scanCounter)
	end

	table.insert(scannedIds, 1, {
		title = titleText,
		id = numericId,
	})

	if #scannedIds > 80 then
		local removed = table.remove(scannedIds)
		if removed and removed.id then
			seenScannedIds[removed.id] = nil
		end
	end

	rebuildScannedIdsUI()
end

local function scanActiveAnimationsOnce()
	if not scannerEnabled then return end

	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then return end

	local ok, tracks = pcall(function()
		return animator:GetPlayingAnimationTracks()
	end)
	if ok and type(tracks) == "table" then
		for _, track in ipairs(tracks) do
			local anim = track.Animation
			local animId = anim and anim.AnimationId or ""
			local trackName = (anim and anim.Name ~= "Animation" and anim.Name)
				or (track.Name ~= "" and track.Name)
				or "Playing Anim"
			recordScannedAnimId(animId, trackName)
		end
	end
end

local function setScannerEnabled(state)
	scannerEnabled = (state == true)
	updateScannerSwitchUI()

	if scannerConn then
		scannerConn:Disconnect()
		scannerConn = nil
	end

	if scannerEnabled then
		scanActiveAnimationsOnce()
		scannerConn = RunService.Heartbeat:Connect(function()
			if not scannerEnabled then return end
			local now = os.clock()
			if now - lastScanTick >= 0.35 then
				lastScanTick = now
				scanActiveAnimationsOnce()
			end
		end)
	end
end

