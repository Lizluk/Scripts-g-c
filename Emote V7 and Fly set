		delBtn.Position = UDim2.new(1, -27, 0.5, -10)
		delBtn.BackgroundColor3 = Color3.fromRGB(165, 45, 55)
		delBtn.Text = "X"
		delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		delBtn.Font = Enum.Font.GothamBold
		delBtn.TextSize = 10
		delBtn.Parent = item
		Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 5)

		loadBtn.MouseButton1Click:Connect(function()
			stopAllListEmotes()
			flightStyles = deepCopyStyles(preset.styles)
			standStyles = deepCopyStandStyles(preset.stands)
			if type(preset.emotes) == "table" and #preset.emotes > 0 then
				emoteList = deepCopyEmotes(preset.emotes)
				persistEmotes()
			end
			if preset.keybinds then
