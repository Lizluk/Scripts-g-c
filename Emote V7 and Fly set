local function assignIdIntoSmartSlot(rawId, rawTitle)
	local normId = normalizeAnimId(rawId)
	if normId == "" then return false end

	syncAnimInputsToPack()
	local lowerTitle = string.lower(tostring(rawTitle or ""))

	local function appendExtraIdleIfMissing(idStr)
		currentAnimPack.extraIdles = currentAnimPack.extraIdles or {}
		for _, ex in ipairs(currentAnimPack.extraIdles) do
			if ex == idStr then return end
		end
		table.insert(currentAnimPack.extraIdles, idStr)
	end

	if string.find(lowerTitle, "walk") then
		currentAnimPack.walk = normId
	elseif string.find(lowerTitle, "run") or string.find(lowerTitle, "sprint") then
		currentAnimPack.run = normId
	elseif string.find(lowerTitle, "jump") then
		currentAnimPack.jump = normId
	elseif string.find(lowerTitle, "fall") then
		currentAnimPack.fall = normId
	elseif string.find(lowerTitle, "idle") then
		if currentAnimPack.idle1 == "" then
			currentAnimPack.idle1 = normId
		elseif currentAnimPack.idle2 == "" then
			currentAnimPack.idle2 = normId
		else
			appendExtraIdleIfMissing(normId)
		end
	else
		if currentAnimPack.idle1 == "" then
			currentAnimPack.idle1 = normId
		elseif currentAnimPack.idle2 == "" then
			currentAnimPack.idle2 = normId
		elseif currentAnimPack.walk == "" then
			currentAnimPack.walk = normId
		elseif currentAnimPack.run == "" then
			currentAnimPack.run = normId
		elseif currentAnimPack.jump == "" then
			currentAnimPack.jump = normId
		elseif currentAnimPack.fall == "" then
			currentAnimPack.fall = normId
		else
			appendExtraIdleIfMissing(normId)
		end
	end

	persistActiveAnimPack()
	syncPackToAnimInputs()
	if animChangerActive then
		applyPackToAnimateScript(player.Character, player.Character and player.Character:FindFirstChildOfClass("Humanoid"), true)
	end
	return true
end

local function fillAllScannedIdsToSlots()
	if #scannedIds == 0 then return 0 end
	syncAnimInputsToPack()

	local appliedCount = 0
	for i = #scannedIds, 1, -1 do
		local item = scannedIds[i]
		local normId = normalizeAnimId(item and item.id)
		if normId ~= "" then
			assignIdIntoSmartSlot(normId, item and item.title)
			appliedCount += 1
		end
	end
	return appliedCount
end

