local function normalizeAnimId(rawText)
	local cleaned = tostring(rawText or ""):gsub("%s+", "")
	if cleaned == "" then return "" end
	if string.find(cleaned, "^rbxassetid://") then
		return cleaned
	end
	local digits = cleaned:match("%d+")
	if digits then
		return "rbxassetid://" .. digits
	end
	return cleaned
end

local function extractNumericId(rawText)
	return tostring(rawText or ""):match("%d+")
end

local function copyToClipboardSafe(text)
	local str = tostring(text or "")
	if str == "" then return false end
	local fn = (typeof(setclipboard) == "function" and setclipboard)
		or (typeof(toclipboard) == "function" and toclipboard)
		or (typeof(set_clipboard) == "function" and set_clipboard)
	if fn then
		local ok = pcall(fn, str)
		if ok then return true end
	end
	return false
end

local function deepCopyStyles(src)
	if type(src) ~= "table" then
		return {
			{ name = "Kiểu 1", animId = "", speed = 65 },
			{ name = "Kiểu 2", animId = "", speed = 95 },
			{ name = "Kiểu 3", animId = "", speed = 130 },
		}
	end
	local copy = {}
	for i = 1, 3 do
		local item = src[i] or {}
		copy[i] = {
			name = item.name or ("Kiểu " .. i),
			animId = item.animId or "",
			speed = tonumber(item.speed) or 65,
		}
	end
	return copy
end

local function deepCopyStandStyles(src)
	if type(src) ~= "table" then
		return {
			{ name = "Đứng 1", animId = "", speed = 75 },
			{ name = "Đứng 2", animId = "", speed = 75 },
		}
	end
	local copy = {}
	for i = 1, 2 do
		local item = src[i] or {}
		copy[i] = {
			name = item.name or ("Đứng " .. i),
			animId = item.animId or "",
			speed = tonumber(item.speed) or 75,
		}
	end
	return copy
end

local function deepCopyEmotes(src)
	if type(src) ~= "table" then return {} end
	local copy = {}
	for i, item in ipairs(src) do
		if type(item) == "table" then
			local id = normalizeAnimId(item.animId)
			if id ~= "" then
				table.insert(copy, {
					name = tostring(item.name or ("Emote " .. i)),
					animId = id,
				})
			end
		elseif type(item) == "string" then
			local id = normalizeAnimId(item)
			if id ~= "" then
				table.insert(copy, {
					name = "Emote " .. i,
					animId = id,
				})
			end
		end
	end
	return copy
end

local function normalizeAnimPack(src)
	src = (type(src) == "table") and src or {}
	local extras = {}
	if type(src.extraIdles) == "table" then
		for _, rawId in ipairs(src.extraIdles) do
			local norm = normalizeAnimId(rawId)
			if norm ~= "" then
				table.insert(extras, norm)
			end
		end
	end
	return {
		idle1 = normalizeAnimId(src.idle1),
		idle2 = normalizeAnimId(src.idle2),
		extraIdles = extras,
		walk = normalizeAnimId(src.walk),
		run = normalizeAnimId(src.run),
		jump = normalizeAnimId(src.jump),
		fall = normalizeAnimId(src.fall),
	}
end

-- ================= HÀM ĐỌC / GHI FILE TỰ ĐỘNG =================
local function safeWriteJson(filename, dataTable)
	if typeof(writefile) == "function" then
		pcall(function()
			writefile(filename, HttpService:JSONEncode(dataTable))
		end)
	end
end

local function safeReadJson(filename)
	if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(filename) then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(readfile(filename))
		end)
		if ok and type(decoded) == "table" then
			return decoded
		end
	end
	return nil
end

