local function getDesiredAnimId()
	if isStandMode then
		local s = standStyles[activeStandIndex] or standStyles[1]
		return normalizeAnimId(s and s.animId)
	else
		local f = flightStyles[activeStyleIndex] or flightStyles[1]
		return normalizeAnimId(f and f.animId)
	end
end

local function getActiveSpeed()
	if isStandMode then
		local s = standStyles[activeStandIndex] or standStyles[1]
		return (s and s.speed) or 75
	else
		local f = flightStyles[activeStyleIndex] or flightStyles[1]
		return (f and f.speed) or 65
	end
end

local function stopCurrentCustomAnim()
	if currentAnimTrack then
		pcall(function()
			currentAnimTrack:Stop(0.1)
			currentAnimTrack:Destroy()
		end)
		currentAnimTrack = nil
	end
	currentAnimId = ""
end

local function applyStyleAnimation(forceRestart)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local animId = getDesiredAnimId()

	if animId == "" then
		stopCurrentCustomAnim()
		return
	end

	if not forceRestart and currentAnimId == animId and currentAnimTrack and currentAnimTrack.IsPlaying then
		return
	end

	stopCurrentCustomAnim()

	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local animInstance = Instance.new("Animation")
	animInstance.AnimationId = animId

	local ok, track = pcall(function()
		return animator:LoadAnimation(animInstance)
	end)

	if ok and track then
		track.Priority = Enum.AnimationPriority.Action3
		track.Looped = true
		track:Play(0.12)
		currentAnimTrack = track
		currentAnimId = animId
	end
end

