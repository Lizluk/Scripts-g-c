local function syncInputsToStyles()
	for i = 1, 3 do
		local r = styleRows[i]
		flightStyles[i].animId = normalizeAnimId(r.idBox.Text)
		local numSpeed = tonumber(r.speedBox.Text)
		if numSpeed and numSpeed > 0 then
			flightStyles[i].speed = math.clamp(numSpeed, 10, 500)
		end
		r.speedBox.Text = tostring(flightStyles[i].speed)
	end

	for i = 1, 2 do
		local sr = standRows[i]
		standStyles[i].animId = normalizeAnimId(sr.idBox.Text)
		local numSpeed = tonumber(sr.speedBox.Text)
		if numSpeed and numSpeed > 0 then
			standStyles[i].speed = math.clamp(numSpeed, 10, 500)
		end
