-- ================= LOGIC ANIM CHANGER & CHUYỂN / TẮT BỘ ANIMATION =================
local function captureOriginalAnimateIds(character)
	if not character then return end
	local animateScript = character:FindFirstChild("Animate")
	if not animateScript then return end

	for _, desc in ipairs(animateScript:GetDescendants()) do
		if desc:IsA("Animation") and originalAnimateIds[desc] == nil then
			originalAnimateIds[desc] = desc.AnimationId
		end
	end
end

local function restoreOriginalAnimateIds(character)
	if not character then return end
	local animateScript = character:FindFirstChild("Animate")
	if not animateScript then return end

	for _, desc in ipairs(animateScript:GetDescendants()) do
		if desc:IsA("Animation") and originalAnimateIds[desc] then
			desc.AnimationId = originalAnimateIds[desc]
		end
	end
end

local function getAllIdleIds()
	local list = {}
	if currentAnimPack.idle1 ~= "" then
		table.insert(list, currentAnimPack.idle1)
	end
	if currentAnimPack.idle2 ~= "" then
		table.insert(list, currentAnimPack.idle2)
	end
	for _, id in ipairs(currentAnimPack.extraIdles or {}) do
		if id ~= "" then
			table.insert(list, id)
		end
	end
	return list
end

local function forceReloadCharacterAnimate(character, humanoid)
	if not character or not humanoid then return end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		local ok, tracks = pcall(function()
			return animator:GetPlayingAnimationTracks()
		end)
		if ok and type(tracks) == "table" then
			for _, track in ipairs(tracks) do
				if track ~= currentAnimTrack and track ~= currentEmoteTrack then
					local prio = track.Priority
					if prio == Enum.AnimationPriority.Idle
						or prio == Enum.AnimationPriority.Movement
						or prio == Enum.AnimationPriority.Core then
						pcall(function()
							track:Stop(0)
							track:Destroy()
						end)
					end
				end
			end
		end
	end

	local animateScript = character:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("Script") then
		pcall(function()
			animateScript.Disabled = true
		end)
		task.defer(function()
			if animateScript and animateScript.Parent then
				pcall(function()
					animateScript.Disabled = false
				end)
			end
		end)
	end
end

local function applyPackToAnimateScript(character, humanoid, forceRefreshTracks)
	if not character or not humanoid then return end
	captureOriginalAnimateIds(character)

	local animateScript = character:FindFirstChild("Animate")
	if not animateScript then return end

	local idles = getAllIdleIds()
	local walkId = currentAnimPack.walk
	local runId = (currentAnimPack.run ~= "" and currentAnimPack.run) or walkId
	local jumpId = currentAnimPack.jump
	local fallId = currentAnimPack.fall

	local anyChanged = false

	local function setFolderIds(folderName, ids)
		if #ids == 0 then return end
		local folder = animateScript:FindFirstChild(folderName)
		if not folder then return end
		local idx = 0
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Animation") then
				idx += 1
				local chosen = ids[((idx - 1) % #ids) + 1]
				if chosen and chosen ~= "" and child.AnimationId ~= chosen then
					child.AnimationId = chosen
					anyChanged = true
				end
			end
		end
	end

	setFolderIds("idle", idles)
	if walkId ~= "" then
		setFolderIds("walk", { walkId })
	end
	if runId ~= "" then
		setFolderIds("run", { runId })
	end
	if jumpId ~= "" then
		setFolderIds("jump", { jumpId })
	end
	if fallId ~= "" then
		setFolderIds("fall", { fallId })
	end

	if currentAnimPack.walk ~= "" and currentAnimPack.run ~= "" and not isFlying then
		local moveSpeed = humanoid.WalkSpeed
		local runFolder = animateScript:FindFirstChild("run")
		local walkFolder = animateScript:FindFirstChild("walk")
		if moveSpeed >= RUN_SPEED_THRESHOLD and runFolder then
			for _, child in ipairs(runFolder:GetChildren()) do
				if child:IsA("Animation") and child.AnimationId ~= currentAnimPack.run then
					child.AnimationId = currentAnimPack.run
					anyChanged = true
				end
			end
		elseif walkFolder then
			for _, child in ipairs(walkFolder:GetChildren()) do
				if child:IsA("Animation") and child.AnimationId ~= currentAnimPack.walk then
					child.AnimationId = currentAnimPack.walk
					anyChanged = true
				end
			end
		end
	end

	if forceRefreshTracks or anyChanged then
		forceReloadCharacterAnimate(character, humanoid)
	end
end

local function startAnimChangerLoop(forceRefreshTracks)
	if animHeartbeatConn then
		animHeartbeatConn:Disconnect()
		animHeartbeatConn = nil
	end
	if not animChangerActive then return end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	applyPackToAnimateScript(char, hum, forceRefreshTracks)

	animHeartbeatConn = RunService.Heartbeat:Connect(function()
		if not animChangerActive then return end
		local c = player.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		applyPackToAnimateScript(c, h, false)
	end)
end

