startFlying = function()
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then return end

	syncInputsToStyles()
	isFlying = true
	isHovering = false
	refreshStyleHighlight()

	applyStyleAnimation(true)

	if bodyGyro then bodyGyro:Destroy() end
	if bodyVelocity then bodyVelocity:Destroy() end

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.P = 30000
	bodyGyro.D = 1000
	bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bodyGyro.CFrame = rootPart.CFrame
	bodyGyro.Parent = rootPart

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = rootPart

	animKeepConnection = RunService.Heartbeat:Connect(function()
		if not isFlying or not humanoid then return end
		updateAirFloor(character, rootPart)

		local expectedId = getDesiredAnimId()
		if expectedId ~= "" then
			if not currentAnimTrack or currentAnimId ~= expectedId then
				applyStyleAnimation(true)
			elseif not currentAnimTrack.IsPlaying then
				currentAnimTrack:Play(0.1)
			end
		end

		if activeEmoteIndex > 0 and emoteList[activeEmoteIndex] then
			local eId = normalizeAnimId(emoteList[activeEmoteIndex].animId)
			if eId ~= "" then
				if not currentEmoteTrack or currentEmoteId ~= eId then
					playEmoteAtIndex(activeEmoteIndex, true)
				elseif not currentEmoteTrack.IsPlaying then
					currentEmoteTrack:Play(0.1)
				end
			end
		end
	end)

	local currentVelocity = Vector3.zero

	flightConnection = RunService.RenderStepped:Connect(function()
		if not isFlying or not rootPart or not rootPart.Parent then
			stopFlying()
			return
		end

		if isHovering then
			currentVelocity = Vector3.zero
			bodyVelocity.Velocity = Vector3.zero
			local lookFlat = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
			if lookFlat.Magnitude > 0 then
				local targetCFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + lookFlat)
				bodyGyro.CFrame = bodyGyro.CFrame:Lerp(targetCFrame, SMOOTHNESS)
			end
			return
		end

		local activeSpeed = getActiveSpeed()
		local moveDirection = Vector3.zero
		local rollAngle = 0

		if isBindPressed("forward") then
			moveDirection += camera.CFrame.LookVector
		end
		if isBindPressed("backward") then
			moveDirection -= camera.CFrame.LookVector
		end
		if isBindPressed("left") then
			moveDirection -= camera.CFrame.RightVector
			rollAngle = math.rad(TILT_ANGLE)
		end
		if isBindPressed("right") then
			moveDirection += camera.CFrame.RightVector
			rollAngle = math.rad(-TILT_ANGLE)
		end
		if isBindPressed("upOrStyle") then
			moveDirection += Vector3.new(0, 1, 0)
		end
		if isBindPressed("down") then
			moveDirection -= Vector3.new(0, 1, 0)
		end

		local targetVelocity = Vector3.zero
		if moveDirection.Magnitude > 0 then
			targetVelocity = moveDirection.Unit * activeSpeed
		end

		currentVelocity = currentVelocity:Lerp(targetVelocity, SMOOTHNESS)
		bodyVelocity.Velocity = currentVelocity

		local targetRotation
		if isStandMode then
			local lookFlat = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
			if lookFlat.Magnitude > 0.001 then
				targetRotation = CFrame.lookAt(Vector3.zero, lookFlat.Unit) * CFrame.Angles(0, 0, rollAngle * 0.5)
			else
				targetRotation = CFrame.Angles(0, 0, rollAngle * 0.5)
			end
		else
			targetRotation = camera.CFrame.Rotation * CFrame.Angles(0, 0, rollAngle)
		end

		bodyGyro.CFrame = bodyGyro.CFrame:Lerp(targetRotation, SMOOTHNESS)
	end)

	updateStatusText()
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

	-- Ưu tiên xử lý khi đang chờ bấm phím mới trong tab Phím
	if listeningAction then
		if input.KeyCode == Enum.KeyCode.Escape then
			listeningAction = nil
			refreshKeybindButtons()
			return
		end
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			keybinds[listeningAction] = input.KeyCode.Name
			listeningAction = nil
			persistActiveConfig()
			refreshKeybindButtons()
			updateStatusText()
		end
		return
	end

	-- Chỉ bỏ qua khi đang gõ vào ô nhập liệu TextBox
	if UserInputService:GetFocusedTextBox() then return end

	local codeName = input.KeyCode.Name

	if codeName == keybinds.toggleGui then
		screenGui.Enabled = not screenGui.Enabled
		return
	end

	if codeName == keybinds.toggleFly then
		if isFlying then
			stopFlying()
		else
			useAirFloor = true
			isStandMode = false
			startFlying()
		end
	elseif codeName == keybinds.toggleHover then
		if isFlying then
			isHovering = not isHovering
			updateStatusText()
		end
	elseif codeName == keybinds.cycleStand then
		cycleStandStyle()
	elseif codeName == keybinds.standPoseFromFlight then
		enterStandPoseFromFlight()
	elseif codeName == keybinds.cycleEmote then
		cycleNextEmote()
		rebuildEmoteListUI()
		updateStatusText()
	elseif codeName == keybinds.stopEmotes then
		stopAllListEmotes()
		rebuildEmoteListUI()
		updateStatusText()
	elseif codeName == keybinds.cycleAnimPack then
		cycleNextAnimPack()
	elseif codeName == keybinds.stopAnimPack then
		stopAnimChangerPack()
	elseif codeName == keybinds.upOrStyle then
		styleTapCount += 1
		if styleTapTimer then
			task.cancel(styleTapTimer)
		end
		styleTapTimer = task.delay(MULTI_TAP_WINDOW, function()
			local taps = math.clamp(styleTapCount, 1, 3)
			styleTapCount = 0
			styleTapTimer = nil
			selectFlightStyle(taps)
		end)
	end
end)

