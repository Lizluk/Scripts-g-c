local function selectFlightStyle(index)
	index = math.clamp(tonumber(index) or 1, 1, 3)
	syncInputsToStyles()
	useAirFloor = true
	isStandMode = false
	activeStyleIndex = index
	if not isFlying then
		startFlying()
	else
		refreshStyleHighlight()
		updateStatusText()
		applyStyleAnimation(true)
	end
end

local function selectStandStyle(index)
	index = math.clamp(tonumber(index) or 1, 1, 2)
	syncInputsToStyles()
	isStandMode = true
	activeStandIndex = index
	refreshStyleHighlight()
	updateStatusText()
	if isFlying then
		applyStyleAnimation(true)
	end
end

local function cycleStandStyle()
	if not isStandMode then
		selectStandStyle(activeStandIndex)
	else
		local nextStand = (activeStandIndex % 2) + 1
		selectStandStyle(nextStand)
	end
end

