local function getCycleablePacks()
	local list = {}
	if type(savedAnimPacks) == "table" then
		for idx, item in ipairs(savedAnimPacks) do
			if type(item) == "table" and type(item.pack) == "table" then
				table.insert(list, {
					index = idx,
					name = tostring(item.name or ("Pack #" .. idx)),
					pack = normalizeAnimPack(item.pack),
				})
			end
		end
	end
	return list
end

local function cycleNextAnimPack()
	local list = getCycleablePacks()
	if #list == 0 then
		activateAnimPack(currentAnimPack, currentPackName, true)
		return
	end

	if activePackCycleIndex < 1 or activePackCycleIndex > #list then
		activePackCycleIndex = 0
	end

	local nextIdx = (activePackCycleIndex % #list) + 1
	activePackCycleIndex = nextIdx
	local chosen = list[nextIdx]
	activateAnimPack(chosen.pack, chosen.name, true)
end

-- Quản lý sàn vô hình (bị tắt khi bấm Z để bay tự do theo chuột với dáng đứng X)
local function removeInvisibleFloor()
	if invisibleFloor then
		invisibleFloor:Destroy()
		invisibleFloor = nil
	end
end

local function ensureInvisibleFloor()
	if not invisibleFloor or not invisibleFloor.Parent then
		local part = Instance.new("Part")
		part.Name = "SurfAirFloor"
		part.Size = Vector3.new(18, 1, 18)
		part.Anchored = true
		part.CanCollide = true
		part.Transparency = 1
		part.Material = Enum.Material.SmoothPlastic
		part.Parent = workspace
		invisibleFloor = part
	end
end

local function updateAirFloor(character, rootPart)
	if not isFlying or not useAirFloor or not rootPart then
		removeInvisibleFloor()
		return
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList = { character }
	if invisibleFloor then
		table.insert(ignoreList, invisibleFloor)
	end
	rayParams.FilterDescendantsInstances = ignoreList

	local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -(MAX_SCAN_DIST + 10), 0), rayParams)

	if rayResult then
		local distanceToGround = (rootPart.Position.Y - rayResult.Position.Y)
		if distanceToGround >= MIN_SCAN_DIST and distanceToGround <= MAX_SCAN_DIST then
			ensureInvisibleFloor()
			invisibleFloor.CFrame = CFrame.new(
				rootPart.Position.X,
				rootPart.Position.Y - FLOOR_OFFSET_Y,
				rootPart.Position.Z
			)
		else
			removeInvisibleFloor()
		end
	else
		ensureInvisibleFloor()
		invisibleFloor.CFrame = CFrame.new(
			rootPart.Position.X,
			rootPart.Position.Y - FLOOR_OFFSET_Y,
			rootPart.Position.Z
		)
	end
end

-- Quản lý Emote riêng biệt (phím C chuyển, phím F1 dừng hết không ảnh hưởng X)
local function stopCurrentEmoteTrack()
	if currentEmoteTrack then
		pcall(function()
			currentEmoteTrack:Stop(0.1)
			currentEmoteTrack:Destroy()
		end)
		currentEmoteTrack = nil
	end
	currentEmoteId = ""
end

local function playEmoteAtIndex(index, forceRestart)
	if #emoteList == 0 then return end
	index = ((index - 1) % #emoteList) + 1
	activeEmoteIndex = index

	local entry = emoteList[activeEmoteIndex]
	local animId = normalizeAnimId(entry and entry.animId)
	if animId == "" then return end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	if not forceRestart and currentEmoteId == animId and currentEmoteTrack and currentEmoteTrack.IsPlaying then
		return
	end

	stopCurrentEmoteTrack()

	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local animInstance = Instance.new("Animation")
	animInstance.AnimationId = animId

	local ok, track = pcall(function()
		return animator:LoadAnimation(animInstance)
	end)

	if ok and track then
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = true
		track:Play(0.12)
		currentEmoteTrack = track
		currentEmoteId = animId
	end
end

local function cycleNextEmote()
	if #emoteList == 0 then return end
	local nextIdx = (activeEmoteIndex % #emoteList) + 1
	playEmoteAtIndex(nextIdx, true)
end

local function stopAllListEmotes()
	activeEmoteIndex = 0
	stopCurrentEmoteTrack()
end

