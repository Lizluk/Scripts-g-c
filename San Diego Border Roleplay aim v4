local function getCharacter(player)
    if not player then return nil end
    local pName = player.Name
    local akFolder = workspace:FindFirstChild("Akkinobetuaka")
    if akFolder then
        local foundChar = akFolder:FindFirstChild(pName)
        if foundChar then return foundChar end
    end
    return player.Character or workspace:FindFirstChild(pName)
end

local militaryTeamNames = {"police", "fbi", "bortac", "border patrol", "swat", "us army", "coast guard"}

local function getPlayerTeamName(player)
    if player.Team then
        return string.lower(player.Team.Name)
    end
    local attrTeam = player:GetAttribute("Team")
    if attrTeam then
        return string.lower(tostring(attrTeam))
    end
    return ""
end

local function isPlayerInMilitaryTeam(player)
    if not player then return false end
    local tName = getPlayerTeamName(player)
    for _, mName in ipairs(militaryTeamNames) do
        if tName == mName or string.find(tName, mName, 1, true) then
            return true
        end
    end
    return false
end

local function isPlayerInCivilianTeam(player)
    if not player then return false end
    local tName = getPlayerTeamName(player)
    if string.find(tName, "civilian", 1, true) then
        for _, mName in ipairs(militaryTeamNames) do
            if string.find(tName, mName, 1, true) then
                return false
            end
        end
        return true
    end
    return false
end

local function evaluatePlayerTeam(player)
    if not player or player == LocalPlayer then return end
    local pName = player.Name

    if autoMilitaryTeamActive then
        if isPlayerInMilitaryTeam(player) then
            teammates[pName] = true
            targets[pName] = nil
        else
            teammates[pName] = nil
        end
    elseif autoCivilianTeamActive then
        if isPlayerInCivilianTeam(player) then
            teammates[pName] = true
            targets[pName] = nil
        else
            teammates[pName] = nil
        end
    end
end

local function hookPlayerTeamChanges(player)
    player:GetPropertyChangedSignal("Team"):Connect(function()
        evaluatePlayerTeam(player)
    end)
    player:GetAttributeChangedSignal("Team"):Connect(function()
        evaluatePlayerTeam(player)
    end)
end

for _, p in pairs(Players:GetPlayers()) do
    hookPlayerTeamChanges(p)
end
Players.PlayerAdded:Connect(hookPlayerTeamChanges)

RunService.Stepped:Connect(function()
    if autoMilitaryTeamActive then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if isPlayerInMilitaryTeam(p) then
                    teammates[p.Name] = true
                    targets[p.Name] = nil
                end
            end
        end
    end

    if autoCivilianTeamActive then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if isPlayerInCivilianTeam(p) then
                    teammates[p.Name] = true
                    targets[p.Name] = nil
                end
            end
        end
    end
end)

local espDrawings = {}

local function removeEsp(pName)
    if espDrawings[pName] then
        for _, obj in pairs(espDrawings[pName]) do
            pcall(function() obj:Remove() end)
        end
        espDrawings[pName] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not masterEspToggle or not espEnabled then 
        for pName, _ in pairs(espDrawings) do removeEsp(pName) end
        return 
    end

    local myChar = getCharacter(LocalPlayer)
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Head"))

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name
            local char = getCharacter(player)
            local rootPart = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Head"))
            
            local isTarget = targets[pName] == true
            local isTeam = teammates[pName] == true

            if (isTarget or isTeam) and char and rootPart then
                if not espDrawings[pName] then
                    local box = Drawing.new("Square")
                    box.Visible = false
                    box.Thickness = 2
                    box.Filled = false

                    local nameTag = Drawing.new("Text")
                    nameTag.Visible = false
                    nameTag.Size = 20
                    nameTag.Center = true
                    nameTag.Outline = true
                    nameTag.Font = 2

                    espDrawings[pName] = {Box = box, NameTag = nameTag}
                end

                local box = espDrawings[pName].Box
                local nameTag = espDrawings[pName].NameTag
                local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

                if onScreen then
                    local head = char:FindFirstChild("Head")
                    local topVector = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                    local legVector = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                    
                    local height = math.abs(topVector.Y - legVector.Y)
                    local width = height / 2

                    box.Size = Vector2.new(width, height)
                    box.Position = Vector2.new(vector.X - width / 2, topVector.Y)
                    box.Visible = true

                    local distanceStr = ""
                    if myRoot then
                        local distVal = math.floor((myRoot.Position - rootPart.Position).Magnitude)
                        distanceStr = " [" .. distVal .. "m]"
                    end

                    if isTarget then
                        box.Color = Color3.fromRGB(255, 0, 0)
                        nameTag.Color = Color3.fromRGB(255, 255, 255)
                        nameTag.Text = "🎯 " .. pName .. distanceStr .. " [TARGET]"
                    elseif isTeam then
                        box.Color = Color3.fromRGB(0, 150, 255)
                        nameTag.Color = Color3.fromRGB(255, 255, 255)
                        nameTag.Text = pName .. distanceStr .. " [TEAMMATE]"
                    end

                    nameTag.Position = Vector2.new(vector.X, topVector.Y - 24)
                    nameTag.Visible = true
                else
                    box.Visible = false
                    nameTag.Visible = false
                end
            else
                removeEsp(pName)
            end
        end
    end
end)

local function toggleSelectAll()
    if currentViewMode ~= "KILL" then return end
    local allP = Players:GetPlayers()
    local count, selected = 0, 0
    for _, p in pairs(allP) do
        if p ~= LocalPlayer and not teammates[p.Name] then
            count = count + 1
            if targets[p.Name] then selected = selected + 1 end
        end
    end
    if selected == count and count > 0 then
        targets = {}
        SelectAllBtn.Text = "☑️ SELECT ALL TARGETS [T]"
        SelectAllBtn.BackgroundColor3 = Color3.fromRGB(50, 90, 150)
    else
        for _, p in pairs(allP) do
            if p ~= LocalPlayer and not teammates[p.Name] then targets[p.Name] = true end
        end
        SelectAllBtn.Text = "☒ DESELECT ALL TARGETS [T]"
        SelectAllBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    end
end

