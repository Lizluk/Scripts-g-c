RunService.RenderStepped:Connect(function()
    if UserInputService:GetFocusedTextBox() then return end
    
    -- Crosshair Aim bắn súng bằng chuột trái
    if crosshairAimActive and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        if tick() - lastAttackTime >= attackCooldown then
            performShootingAttack()
            lastAttackTime = tick()
        end
    end

    -- Crosshair Aim 2 bắn súng bằng chuột phải (nhấp hoặc đè giữ)
    if crosshairAim2Active and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        if tick() - lastAttackTime2 >= attackCooldown then
            performCrosshairAim2Shoot()
            lastAttackTime2 = tick()
        end
    end

    if aimLockActive and isAimToggled then
        local myCharacter = getCharacter(LocalPlayer)
        local myRoot = myCharacter and (myCharacter:FindFirstChild("HumanoidRootPart") or myCharacter:FindFirstChild("UpperTorso") or myCharacter:FindFirstChild("Head"))
        if not myRoot then return end

        local closestHead = nil
        local shortestDist = math.huge
        for pName, isTargeted in pairs(targets) do
            if isTargeted and not teammates[pName] then
                local targetPlayer = Players:FindFirstChild(pName)
                local targetDino = getCharacter(targetPlayer)
                local targetHead = targetDino and targetDino:FindFirstChild("Head") 
                if targetHead and targetDino then
                    local dist = (myRoot.Position - targetHead.Position).Magnitude
                    if dist <= actionMaxDistance and dist < shortestDist then
                        shortestDist = dist
                        closestHead = targetHead
                    end
                end
            end
        end

        if closestHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestHead.Position)
        end
    end
end)

