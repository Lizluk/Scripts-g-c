local function findRemote(parent, name, isFunction)
    if not parent then return nil end
    local found = parent:FindFirstChild(name, true)
    if found then return found end
    
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj.Name == name and ((isFunction and obj:IsA("RemoteFunction")) or (not isFunction and obj:IsA("RemoteEvent"))) then
            return obj
        end
    end
    return nil
end

