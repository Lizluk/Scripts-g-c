local function getRealItemName(obj)
    local rawName = obj.Name
    if obj:IsA("BasePart") and not string.match(rawName, "^%d+$") then
        rawName = obj.Name
    else
        local meshPart = obj:FindFirstChildWhichIsA("MeshPart") or obj:FindFirstChildWhichIsA("BasePart")
        if meshPart then rawName = meshPart.Name end
    end
    return rawName
end

local function cleanNameOfNumbers(name)
    return string.gsub(name, "%d+$", "") 
end

local function itemMatchesFilter(obj)
    if selectedItemName == "ALL" then return true end
    local realName = getRealItemName(obj)
    return string.find(realName, selectedItemName) ~= nil
end

local function releaseMismatchedItems()
    if selectedItemName == "ALL" then return end
    for part, _ in pairs(capturedParts) do
        if part and part.Parent then
            local realName = getRealItemName(part.Parent and part.Parent or part)
            local match = string.find(realName, selectedItemName) ~= nil
            if not match then
                pcall(function()
                    if type(capturedParts[part]) == "table" then
                        if capturedParts[part].bp then capturedParts[part].bp:Destroy() end
                        if capturedParts[part].bg then capturedParts[part].bg:Destroy() end
                    end
                    part.CanCollide = true
                end)
                capturedParts[part] = nil
            end
        end
    end
end

local updateItemList 
function updateItemList()
    for _, v in ipairs(itemScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local count = 0
    
    local allBtn = Instance.new("TextButton", itemScroll)
    allBtn.Size=UDim2.new(1,-4,0,26); allBtn.LayoutOrder = 0; allBtn.Text = "⭐ HÚT HẾT (ALL)"
    allBtn.BackgroundColor3 = (selectedItemName == "ALL") and Color3.fromRGB(20,60,20) or Color3.fromRGB(35,35,35)
    allBtn.TextColor3 = Color3.new(1,1,1); allBtn.Font = Enum.Font.GothamBold; allBtn.TextSize = 10
    Instance.new("UICorner",allBtn).CornerRadius = UDim.new(0,4)
    allBtn.MouseButton1Click:Connect(function() selectedItemName = "ALL"; updateItemList() end)
    count += 1

    local foundNames = {}
    local df = Workspace:FindFirstChild("DebrisField")
    if df then
        for _, obj in ipairs(df:GetChildren()) do
            if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") then
                local realName = getRealItemName(obj)
                if realName and not string.match(realName, "^%d+$") then 
                    local cleanName = cleanNameOfNumbers(realName) 
                    foundNames[cleanName] = true 
                end
            end
        end
    end

    for name, _ in pairs(foundNames) do
        local btn = Instance.new("TextButton", itemScroll)
        btn.Size=UDim2.new(1,-4,0,26); btn.LayoutOrder = count; btn.Text = "📦 " .. name
        btn.BackgroundColor3 = (selectedItemName == name) and Color3.fromRGB(60,60,20) or Color3.fromRGB(30,30,30)
        btn.TextColor3 = Color3.new(1,1,1); btn.Font = Enum.Font.GothamBold; btn.TextSize = 10
        btn.TextXAlignment = Enum.TextXAlignment.Left
        local pad = Instance.new("UIPadding",btn); pad.PaddingLeft = UDim.new(0,4)
        Instance.new("UICorner",btn).CornerRadius = UDim.new(0,4)
        btn.MouseButton1Click:Connect(function()
            selectedItemName = name
            releaseMismatchedItems()
            updateItemList()
        end)
        count += 1
    end
    itemScroll.CanvasSize = UDim2.new(0,0,0,count*29)
end

