-- =============================================
-- CLAIM OWNERSHIP & FORCE STREAMING LOAD
-- =============================================
local function claimOwnership(part)
    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(client, "SimulationRadius", math.huge)
            sethiddenproperty(client, "MaxSimulationRadius", math.huge)
        end
        if part:IsA("BasePart") then
            if part.Anchored then part.Anchored = false end
            part.CanCollide = false
            part:SetNetworkOwner(client)
        end
    end)
end

local function forceLoadObject(obj)
    if obj and obj:IsA("Model") then
        pcall(function() obj.LevelOfDetail = Enum.ModelLevelOfDetail.StreamingMesh end)
    end
end

