local function saveToFile()
    if writefile then pcall(function() writefile(FILE_NAME, HttpService:JSONEncode(savedStations)) end) end
end
local function loadFromFile()
    if isfile and isfile(FILE_NAME) then pcall(function() savedStations = HttpService:JSONDecode(readfile(FILE_NAME)) end) end
end
