    if chat then return end
    
    if input.KeyCode == toggleKey then
        autoBiteActive = not autoBiteActive
        MainFrame.Visible = autoBiteActive
        
        if autoBiteActive then
            updatePlayerList()
        end
        
        local statusText = autoBiteActive and "ĐÃ BẬT (ON) 🦖⚔️" or "ĐÃ TẮT (OFF) 💤"
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "AUTO BITE STATUS",
            Text = "Trạng thái cắn Chuột Trái: " .. statusText,
            Duration = 3
        })
    end
end)

