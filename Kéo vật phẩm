--// MAGNET: DYNAMIC 6-AXIS (PULL MODE - DroppedItems)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local client = Players.LocalPlayer

local TARGET_FOLDER_NAME = "DroppedItems" -- Thư mục vật phẩm[cite: 2]
local inversionEnabled = false
local targetPlayer = nil
local currentTargetPos = nil
local movingTargetObj = nil 
local relativeOffset = CFrame.new(0, 5, 0) 
local savedStations = {} 
local selectedStationIdx = nil

-- =============================================
-- KHỞI TẠO GUI (PHONG CÁCH BẠN THÍCH)
-- =============================================
local function GetSafeParent()
    local success, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if success and coreGui then return coreGui end
    return client:WaitForChild("PlayerGui")
end

local safeParent = GetSafeParent()
if safeParent:FindFirstChild("MagnetPull_DroppedItems") then 
    safeParent["MagnetPull_DroppedItems"]:Destroy() 
end

local screenGui = Instance.new("ScreenGui", safeParent)
screenGui.Name = "MagnetPull_DroppedItems"
screenGui.ResetOnSpawn = false

local mainFrame = Instance.new("Frame", screenGui)
mainFrame.Size = UDim2.new(0, 320, 0, 550) 
mainFrame.Position = UDim2.new(0, 20, 0.5, -275)
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
mainFrame.Active = true
mainFrame.Draggable = true
Instance.new("UICorner", mainFrame)

local label = Instance.new("TextLabel", mainFrame)
label.Size = UDim2.new(1, 0, 0, 40)
label.Text = "(G) Magnet: OFF 🔴"
label.TextColor3 = Color3.new(1, 0, 0)
label.BackgroundTransparency = 1
label.Font = Enum.Font.GothamBold
label.TextSize = 18

local stationScroll = Instance.new("ScrollingFrame", mainFrame)
stationScroll.Size = UDim2.new(0.45, 0, 0, 200)
stationScroll.Position = UDim2.new(0, 10, 0, 50)
stationScroll.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Instance.new("UIListLayout", stationScroll)

local playerScroll = Instance.new("ScrollingFrame", mainFrame)
playerScroll.Size = UDim2.new(0.45, 0, 0, 200)
playerScroll.Position = UDim2.new(0.55, -10, 0, 50)
playerScroll.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Instance.new("UIListLayout", playerScroll)

-- =============================================
-- ĐIỀU KHIỂN 6 HƯỚNG (OFFSET CONTROL)
-- =============================================
local controlFrame = Instance.new("Frame", mainFrame)
controlFrame.Size = UDim2.new(1, -20, 0, 150)
controlFrame.Position = UDim2.new(0, 10, 0, 260)
controlFrame.BackgroundTransparency = 1

local function createAdjustBtn(text, pos, offsetVec)
    local btn = Instance.new("TextButton", controlFrame)
    btn.Size = UDim2.new(0, 60, 0, 35)
    btn.Position = pos
    btn.Text = text
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 90)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    Instance.new("UICorner", btn)
    
    btn.MouseButton1Click:Connect(function()
        relativeOffset = relativeOffset * CFrame.new(offsetVec)
        if selectedStationIdx and savedStations[selectedStationIdx].Type == "Dynamic" then
            savedStations[selectedStationIdx].Offset = relativeOffset
        end
    end)
end

createAdjustBtn("LÊN", UDim2.new(0, 80, 0, 0), Vector3.new(0, 2, 0))
createAdjustBtn("XUỐNG", UDim2.new(0, 160, 0, 0), Vector3.new(0, -2, 0))
createAdjustBtn("TIẾN", UDim2.new(0, 80, 0, 45), Vector3.new(0, 0, -2))
createAdjustBtn("LÙI", UDim2.new(0, 160, 0, 45), Vector3.new(0, 0, 2))
createAdjustBtn("TRÁI", UDim2.new(0, 10, 0, 45), Vector3.new(-2, 0, 0))
createAdjustBtn("PHẢI", UDim2.new(0, 230, 0, 45), Vector3.new(2, 0, 0))

local saveBtn = Instance.new("TextButton", mainFrame)
saveBtn.Size = UDim2.new(1, -20, 0, 40)
saveBtn.Position = UDim2.new(0, 10, 1, -60)
saveBtn.Text = "💾 SAVE POSITION"
saveBtn.BackgroundColor3 = Color3.fromRGB(40, 80, 40)
saveBtn.TextColor3 = Color3.new(1, 1, 1)
saveBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", saveBtn)

-- =============================================
-- LOGIC CẬP NHẬT DANH SÁCH
-- =============================================
local function updateLists()
    for _, v in pairs(playerScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, v in pairs(stationScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end

    for _, p in pairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton", playerScroll)
        btn.Size = UDim2.new(1, -5, 0, 30)
        btn.Text = (p == client) and "⭐ ME" or p.Name
        btn.BackgroundColor3 = (targetPlayer == p) and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(45, 45, 45)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.MouseButton1Click:Connect(function()
            movingTargetObj, currentTargetPos, selectedStationIdx = nil, nil, nil
            targetPlayer = p
            updateLists()
        end)
    end

    for i, data in pairs(savedStations) do
        local frame = Instance.new("Frame", stationScroll)
        frame.Size = UDim2.new(1, -5, 0, 30)
        frame.BackgroundTransparency = 1
        
        local btn = Instance.new("TextButton", frame)
        btn.Size = UDim2.new(0.7, 0, 1, 0)
        btn.Text = (data.Type == "Dynamic") and "🚚 ST-"..i or "📍 ST-"..i
        btn.BackgroundColor3 = (selectedStationIdx == i) and Color3.fromRGB(100, 100, 50) or Color3.fromRGB(40, 40, 40)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.MouseButton1Click:Connect(function()
            targetPlayer = nil
            selectedStationIdx = i
            if data.Type == "Dynamic" then
                movingTargetObj = data.Object
                relativeOffset = data.Offset
                currentTargetPos = nil
            else
                currentTargetPos = data.Position
                movingTargetObj = nil
            end
            updateLists()
        end)

        local del = Instance.new("TextButton", frame)
        del.Size = UDim2.new(0.3, 0, 1, 0)
        del.Position = UDim2.new(0.7, 0, 0, 0)
        del.Text = "X"
        del.BackgroundColor3 = Color3.fromRGB(100, 50, 50)
        del.MouseButton1Click:Connect(function()
            table.remove(savedStations, i)
            if selectedStationIdx == i then selectedStationIdx = nil end
            updateLists()
        end)
    end
end

saveBtn.MouseButton1Click:Connect(function()
    local char = client.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local ray = Ray.new(hrp.Position, Vector3.new(0, -10, 0))
    local hit, _ = workspace:FindPartOnRayWithIgnoreList(ray, {char})
    if hit and not hit.Anchored and hit.Parent ~= workspace then
        table.insert(savedStations, {Type = "Dynamic", Object = hit, Offset = hit.CFrame:ToObjectSpace(hrp.CFrame)})
    else
        table.insert(savedStations, {Type = "Static", Position = hrp.Position})
    end
    updateLists()
end)

-- =============================================
-- LOGIC KÉO VẬT PHẨM (PULL MODE)[cite: 2]
-- =============================================
RunService.Heartbeat:Connect(function()
    if inversionEnabled then
        local destination = nil
        
        if targetPlayer and targetPlayer.Character and targetPlayer.Character.PrimaryPart then
            destination = (targetPlayer.Character.PrimaryPart.CFrame * relativeOffset).Position
        elseif movingTargetObj and movingTargetObj.Parent then
            destination = (movingTargetObj.CFrame * relativeOffset).Position
        elseif currentTargetPos then
            destination = (CFrame.new(currentTargetPos) * relativeOffset).Position
        end
        
        if destination then
            local folder = workspace:FindFirstChild(TARGET_FOLDER_NAME)
            if folder then
                for _, item in pairs(folder:GetChildren()) do
                    local p = item:FindFirstChildWhichIsA("BasePart") or item:FindFirstChild("Handle")
                    if p and not p.Anchored then
                        -- Cơ chế kéo: Sử dụng vận tốc hướng về mục tiêu[cite: 2]
                        local direction = (destination - p.Position)
                        p.Velocity = direction * 8 -- Thay đổi số này để chỉnh tốc độ hút mạnh hay nhẹ
                    end
                end
            end
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.G then
        inversionEnabled = not inversionEnabled
        label.Text = inversionEnabled and "(G) Magnet: ON 🟢" or "(G) Magnet: OFF 🔴"
        label.TextColor3 = inversionEnabled and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
    end
end)

updateLists()
