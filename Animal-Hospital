createActionButton("🎯 GOM TẤT CẢ VẬT PHẨM", 0, 0.5, function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local pModel = v.Parent
            if pModel and pModel:IsA("Model") and (pModel.Name == "Chocolate bar" or pModel.Name == "Trash" or pModel.Name == "JumpscareMask") then
                if pModel.PrimaryPart then
                    pModel:SetPrimaryPartCFrame(CFrame.new(root.Position + Vector3.new(0, 1, 0)))
                else
                    for _, pt in pairs(pModel:GetChildren()) do
                        if pt:IsA("BasePart") then pt.CFrame = CFrame.new(root.Position + Vector3.new(0, 1, 0)) end
                    end
                end
            end
        end
    end
end)

