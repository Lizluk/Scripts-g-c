    end
end)

-- Chặn Namecall (AntiSanity và AntiJumpscare)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" then
        if Config.AntiSanity and self.Name == "RE/PlayerLostSanity" then return nil end
        if Config.AntiJumpscare and (self.Name == "RE/JumpscareHollow" or self.Name == "RE/JumpscareShadowWithEyesIMG" or self.Name == "RE/Blackscreen") then return nil end
    end
    return oldNamecall(self, ...)
end)

task.spawn(function()
    while task.wait(0.5) do
        if Config.AutoHeartbeat then
            local NetFolder = ReplicatedStorage:WaitForChild("Util"):WaitForChild("Net")
            local hrEvent = NetFolder:FindFirstChild("RE/HeartbeatMinigameComplete")
            if hrEvent then hrEvent:FireServer() end
        end
        if Config.InfiniteRevive then
            local NetFolder = ReplicatedStorage:WaitForChild("Util"):WaitForChild("Net")
            local reviveRE = NetFolder:FindFirstChild("RE/ReviveOther")
            local enableReviveRE = NetFolder:FindFirstChild("RE/EnabledReviveOther")
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("RevivePP") then
                    if reviveRE then reviveRE:FireServer(p) end
                    if enableReviveRE then enableReviveRE:FireServer(p) end
                end
            end
        end
    end
end)

