local espObjects = {}

local function createESP(object, color, name)
    if not object or espObjects[object] then return end
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Adornee = object
    highlight.Parent = object

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 180, 0, 40)
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = object
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = color
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0
    label.Parent = billboard
    billboard.Parent = object
    
    espObjects[object] = {highlight, billboard}
end

local function removeESP(object)
    if espObjects[object] then
        for _, gui in pairs(espObjects[object]) do pcall(function() gui:Destroy() end) end
        espObjects[object] = nil
    end
end

task.spawn(function()
    while task.wait(1) do
        if Config.MonsterESP then
            for _, child in pairs(Workspace:GetChildren()) do
                if child:IsA("Model") and (child.Name == "SkinwalkerSeparated" or child.Name == "Hider" or child.Name == "Shadow" or child.Name == "TallMonster") then
                    createESP(child, Color3.fromRGB(255, 50, 50), "⚠️ " .. child.Name)
                end
            end
        else
            for _, child in pairs(Workspace:GetChildren()) do
                if child.Name == "SkinwalkerSeparated" or child.Name == "Hider" or child.Name == "Shadow" or child.Name == "TallMonster" then removeESP(child) end
            end
        end

        if Config.PlayerESP then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    createESP(p.Character, Color3.fromRGB(0, 255, 150), p.Name)
                end
            end
        else
            for _, p in pairs(Players:GetPlayers()) do if p.Character then removeESP(p.Character) end end
        end

        if Config.ItemESP then
            for _, child in pairs(Workspace:GetChildren()) do
                if child:IsA("Model") and (child.Name == "Chocolate bar" or child.Name == "Trash" or child.Name == "JumpscareMask") then
                    createESP(child, Color3.fromRGB(255, 255, 50), "📦 " .. child.Name)
                elseif child:IsA("Part") and child.Name == "Fuse Box" then
                    createESP(child, Color3.fromRGB(255, 150, 0), "⚡ Fuse Box")
                end
            end
        else
            for _, child in pairs(Workspace:GetChildren()) do
                if child.Name == "Chocolate bar" or child.Name == "Trash" or child.Name == "Fuse Box" or child.Name == "JumpscareMask" then removeESP(child) end
            end
        end

        local Areas = Workspace:FindFirstChild("Areas")
        if Config.AreaESP and Areas then
            for _, part in pairs(Areas:GetChildren()) do
                if part:IsA("Part") then createESP(part, Color3.fromRGB(0, 180, 255), "🚪 " .. part.Name) end
            end
        else
            if Areas then for _, part in pairs(Areas:GetChildren()) do removeESP(part) end end
        end
    end
end)

