local function refreshPlayers()
    for _, v in pairs(PScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local b = Instance.new("TextButton", PScroll); b.Size = UDim2.new(1,0,0,25); b.Text = p.DisplayName; b.TextColor3 = Color3.new(1,1,1); b.BackgroundColor3 = Color3.fromRGB(45,45,60); Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(function() followSettings.mode = "Follow"; followSettings.target = p; followSettings.enabled = true end)
        end
    end
end

