updateUI = function()
    for _, v in pairs(TabPose:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    for _, v in pairs(TabObj:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    if isfile(fileName) then pcall(function() local data = HttpService:JSONDecode(readfile(fileName)) favorites = data.favorites or {}; savedObjects = data.savedObjects or {} end) end
    
    -- Load danh sách Pose + Nút xóa
    for i, f in ipairs(favorites) do
        local fr = Instance.new("Frame", TabPose); fr.Size = UDim2.new(1,-5,0,28); fr.BackgroundColor3 = Color3.fromRGB(40,40,60); Instance.new("UICorner", fr)
        local b = Instance.new("TextButton", fr); b.Size = UDim2.new(0.75,0,1,0); b.Text = f.name; b.TextColor3 = Color3.new(1,1,1); b.BackgroundTransparency = 1; b.TextSize = 8
        local d = Instance.new("TextButton", fr); d.Size = UDim2.new(0.25,0,1,0); d.Position = UDim2.new(0.75,0,0,0); d.Text = "X"; d.TextColor3 = Color3.new(1,0,0); d.BackgroundTransparency = 1
        b.MouseButton1Click:Connect(function() followSettings.distance, followSettings.height, followSettings.side, followSettings.tilt, followSettings.angle = f.distance, f.height, f.side, f.tilt, f.angle end)
        d.MouseButton1Click:Connect(function() table.remove(favorites, i); saveData(); updateUI() end)
    end
    
    -- Load danh sách Vật thể + Nút xóa
    for i, o in ipairs(savedObjects) do
        local fr = Instance.new("Frame", TabObj); fr.Size = UDim2.new(1,-5,0,28); fr.BackgroundColor3 = Color3.fromRGB(30,45,50); Instance.new("UICorner", fr)
        local b = Instance.new("TextButton", fr); b.Size = UDim2.new(0.75,0,1,0); b.Text = o.name; b.TextColor3 = Color3.new(1,1,1); b.BackgroundTransparency = 1; b.TextSize = 7
        local d = Instance.new("TextButton", fr); d.Size = UDim2.new(0.25,0,1,0); d.Position = UDim2.new(0.75,0,0,0); d.Text = "X"; d.TextColor3 = Color3.new(1,0.2,0.2); d.BackgroundTransparency = 1
        b.MouseButton1Click:Connect(function()
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and v.Name == o.objName and v.Parent.Name == o.parentName then
                    followSettings.mode = "Object"; followSettings.targetObj = v
                    if o.cf then followSettings.objOffset = CFrame.new(unpack(o.cf)) end
                    followSettings.enabled = true; break
                end
            end
        end)
        d.MouseButton1Click:Connect(function() table.remove(savedObjects, i); saveData(); updateUI() end)
    end
end

