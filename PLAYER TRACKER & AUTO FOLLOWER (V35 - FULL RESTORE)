-- LOGIC CORE
-- =============================================
local function lockAtCurrentPos(obj)
    if not obj or not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LP.Character.HumanoidRootPart
    followSettings.mode = "Object"
    followSettings.targetObj = obj
    followSettings.objOffset = obj.CFrame:ToObjectSpace(hrp.CFrame)
    
    -- Reset về 0 để khớp vị trí hiện tại
    followSettings.distance = 0; followSettings.height = 0; followSettings.side = 0; followSettings.angle = 0
    followSettings.enabled = true

    table.insert(savedObjects, {
        name = "Locked: " .. obj.Name,
        objName = obj.Name,
        parentName = obj.Parent.Name,
        cf = {followSettings.objOffset:GetComponents()}
    })
    saveData()
    if updateUI then updateUI() end
end

RunService.RenderStepped:Connect(function()
    if followSettings.selectMode then
        SelectionBox.Adornee = Mouse.Target
    elseif followSettings.enabled and followSettings.targetObj then
        SelectionBox.Adornee = followSettings.targetObj
    else
        SelectionBox.Adornee = nil
    end
end)

Mouse.Button1Down:Connect(function()
    if followSettings.selectMode and Mouse.Target then
        lockAtCurrentPos(Mouse.Target)
        followSettings.selectMode = false
    end
end)

RunService.Heartbeat:Connect(function()
    if not followSettings.enabled then return end
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local goalCF
    if followSettings.mode == "Object" and followSettings.targetObj then
        if followSettings.targetObj.Parent then
            goalCF = followSettings.targetObj.CFrame * followSettings.objOffset
            goalCF = goalCF * CFrame.new(followSettings.side, followSettings.height, followSettings.distance)
            -- Thêm khả năng xoay Angle quanh vật thể
            goalCF = goalCF * CFrame.Angles(0, math.rad(followSettings.angle), 0)
        else followSettings.enabled = false end
    elseif followSettings.mode == "Follow" and followSettings.target then
        local tHRP = followSettings.target.Character and followSettings.target.Character:FindFirstChild("HumanoidRootPart")
        if tHRP then
            local rot = CFrame.Angles(0, math.rad(followSettings.angle), 0)
            local targetPos = tHRP.Position + (tHRP.CFrame * rot).LookVector * followSettings.distance + (tHRP.CFrame * rot).RightVector * followSettings.side
            local rotY = math.atan2((tHRP.Position - targetPos).X, (tHRP.Position - targetPos).Z)
            goalCF = CFrame.new(targetPos + Vector3.new(0, followSettings.height, 0)) * CFrame.Angles(0, rotY + math.pi, 0)
        end
    end
    
    if goalCF then
        hrp.CFrame = goalCF * CFrame.Angles(math.rad(followSettings.tilt), 0, 0)
        hrp.Velocity = Vector3.zero
    end
end)

