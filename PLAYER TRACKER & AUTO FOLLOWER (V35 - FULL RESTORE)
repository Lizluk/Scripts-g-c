local function createSlider(text, min, max, key, pos)
    local label = Instance.new("TextLabel", MF); label.Size = UDim2.new(1,-20,0,15); label.Position = UDim2.new(0,10,0,pos+45); label.TextColor3 = Color3.new(1,1,1); label.Font = "GothamBold"; label.TextSize = 9; label.BackgroundTransparency = 1
    local bg = Instance.new("Frame", MF); bg.Size = UDim2.new(1,-20,0,6); bg.Position = UDim2.new(0,10,0,pos+62); bg.BackgroundColor3 = Color3.fromRGB(45,45,60); Instance.new("UICorner", bg)
    local fill = Instance.new("Frame", bg); fill.BackgroundColor3 = Color3.fromRGB(180, 100, 255); Instance.new("UICorner", fill)
    RunService.RenderStepped:Connect(function()
        fill.Size = UDim2.new(math.clamp((followSettings[key] - min)/(max - min), 0, 1), 0, 1, 0)
        label.Text = text .. ": " .. string.format("%.1f", followSettings[key])
    end)
    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local conn; conn = RunService.RenderStepped:Connect(function()
                if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then conn:Disconnect() return end
                followSettings[key] = min + (math.clamp((UserInputService:GetMouseLocation().X - bg.AbsolutePosition.X)/bg.AbsoluteSize.X, 0, 1) * (max - min))
            end)
        end
    end)
end

