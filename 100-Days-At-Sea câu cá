local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Tên file lưu trữ trên máy của bạn (nằm trong thư mục workspace của Executor)
local SAVE_FILE_NAME = "FishingRod_SavedList.txt"

-- Tự động dọn dẹp GUI cũ nếu chạy lại script
local oldGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("FishingRodAttributeManager")
if oldGui then oldGui:Destroy() end

-- Biến lưu trạng thái vòng lặp và danh sách đã lưu
local activeLoops = {}
local savedNamesList = {}

-- Hàm lấy cần câu trong nhân vật
local function getFishingRod()
    local char = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name) or workspace:FindFirstChild("RikaOrimoto_777")
    if char then
        return char:FindFirstChild("Fishing Rod") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Fishing Rod"))
    end
    return nil
end

-- =========================================================================
-- HÀM LƯU VÀ ĐỌC FILE (SAVE / LOAD)
-- =========================================================================
local function saveListToFile()
    -- Chuyển danh sách table thành chuỗi văn bản, cách nhau bằng dấu phẩy
    local success, err = pcall(function()
        if writefile then
            writefile(SAVE_FILE_NAME, game:GetService("HttpService"):JSONEncode(savedNamesList))
        end
    end)
    if not success then warn("⚠️ Không thể lưu file: ", err) end
end

local function loadListFromFile()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        local success, result = pcall(function()
            local content = readfile(SAVE_FILE_NAME)
            return game:GetService("HttpService"):JSONDecode(content)
        end)
        if success and type(result) == "table" then
            savedNamesList = result
            print("💾 Đã tải thành công danh sách lưu từ máy!")
        end
    end
end

