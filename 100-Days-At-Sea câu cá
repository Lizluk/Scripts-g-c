-- =========================================================================
-- LOGIC VÒNG LẶP KHÓA (LOOP ATTRIBUTE)
-- =========================================================================
local function startLockLoop(fishName)
    if activeLoops[fishName] then return end
    activeLoops[fishName] = true
    
    task.spawn(function()
        while activeLoops[fishName] do
            local rod = getFishingRod()
            if rod then
                rod:SetAttribute("Fish", fishName)
            end
            task.wait(0.1)
        end
    end)
end

-- =========================================================================
-- HÀM TẠO DÒNG ITEM CÓ NÚT XÓA (❌)
-- =========================================================================
local function createLoopButton(fishName)
    if ScrollingFrame:FindFirstChild("Container_" .. fishName) then return end

    -- Khung chứa bao gồm cả nút bấm và nút xóa
    local Container = Instance.new("Frame")
    Container.Name = "Container_" .. fishName
    Container.Size = UDim2.new(1, 0, 0, 38)
    Container.BackgroundTransparency = 1
    Container.Parent = ScrollingFrame

    -- Nút bật/tắt Loop chính (Nằm bên trái)
    local ItemButton = Instance.new("TextButton")
    ItemButton.Size = UDim2.new(1, -45, 1, 0) -- Chừa khoảng trống bên phải cho nút xóa
    ItemButton.Position = UDim2.new(0, 0, 0, 0)
    ItemButton.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
    ItemButton.Text = "  ⚪ Loop: " .. fishName
    ItemButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    ItemButton.TextSize = 14
    ItemButton.Font = Enum.Font.SourceSansBold
    ItemButton.TextXAlignment = Enum.TextXAlignment.Left
    ItemButton.Parent = Container
    Instance.new("UICorner", ItemButton).CornerRadius = UDim.new(0, 5)

    -- Nút Xóa (Nằm bên phải)
    local DeleteButton = Instance.new("TextButton")
    DeleteButton.Size = UDim2.new(0, 38, 1, 0)
    DeleteButton.Position = UDim2.new(1, -38, 0, 0)
    DeleteButton.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
    DeleteButton.Text = "❌"
    DeleteButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    DeleteButton.TextSize = 12
    DeleteButton.Font = Enum.Font.SourceSansBold
    DeleteButton.Parent = Container
    Instance.new("UICorner", DeleteButton).CornerRadius = UDim.new(0, 5)

    local isLooping = false

    -- Logic khi nhấn vào nút chọn tên cá (Bật/Tắt Loop)
    ItemButton.MouseButton1Click:Connect(function()
        isLooping = not isLooping
        if isLooping then
            -- Tắt các dòng khác đang bật loop để tránh xung đột
            for otherName, _ in pairs(activeLoops) do
                activeLoops[otherName] = false
                local otherContainer = ScrollingFrame:FindFirstChild("Container_" .. otherName)
                local otherBtn = otherContainer and otherContainer:FindFirstChildOfClass("TextButton")
                if otherBtn and otherBtn ~= ItemButton then
                    otherBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
                    otherBtn.Text = "  ⚪ Loop: " .. otherName
                end
            end
            startLockLoop(fishName)
            ItemButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Đỏ rực báo hiệu đang khóa
            ItemButton.Text = "  🔴 LOCKING: " .. fishName
        else
            activeLoops[fishName] = false
            ItemButton.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
            ItemButton.Text = "  ⚪ Loop: " .. fishName
        end
    end)

    -- Logic khi bấm nút xóa (❌)
    DeleteButton.MouseButton1Click:Connect(function()
        -- 1. Ngắt vòng lặp loop nếu dòng này đang chạy
        activeLoops[fishName] = false
        
        -- 2. Xóa khỏi table bộ nhớ lưu trữ
        local index = table.find(savedNamesList, fishName)
        if index then
            table.remove(savedNamesList, index)
        end
        
        -- 3. Cập nhật lại file lưu trên máy
        saveListToFile()
        
        -- 4. Xóa khối UI này khỏi màn hình ngay lập tức
        Container:Destroy()
        print("🗑️ Đã xóa hoàn toàn: " .. fishName)
    end)
end

-- =========================================================================
-- KHỞI CHẠY HỆ THỐNG
-- =========================================================================

-- Tự động tải file lưu cũ từ máy lên giao diện
loadListFromFile()
for _, name in ipairs(savedNamesList) do
    createLoopButton(name)
end

-- Sự kiện nạp thêm từ mới từ ô nhập văn bản
AddButton.MouseButton1Click:Connect(function()
    local text = InputBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if text ~= "" and not table.find(savedNamesList, text) then
        table.insert(savedNamesList, text)
        saveListToFile() -- Lưu lại vào máy tính
        createLoopButton(text) -- Tạo dòng nút bấm + nút xóa trên bảng
        InputBox.Text = ""
    end
end)
