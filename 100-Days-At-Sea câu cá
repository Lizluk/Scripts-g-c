-- Bước 2: Sự kiện khi người dùng gõ và thêm tên mới
AddButton.MouseButton1Click:Connect(function()
    local text = InputBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if text ~= "" and not table.find(savedNamesList, text) then
        table.insert(savedNamesList, text) -- Thêm vào table bộ nhớ
        saveListToFile() -- Ghi đè cập nhật vào file lưu trữ của máy
        createLoopButton(text) -- Tạo nút bấm trên màn hình
        InputBox.Text = ""
    end
end)
