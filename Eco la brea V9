--======================================================================
-- HỆ THỐNG ESP PLAYER
--======================================================================
local function applyESP(character, playerName)
    if not character then return end
    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 5)
    if not head then return end
    if head:FindFirstChild("PlayerESP") then head.PlayerESP:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerESP"
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = head
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 14
    txt.Parent = bb

    task.spawn(function()
        while character and character:IsDescendantOf(charactersFolder) and head and head:IsDescendantOf(character) and bb and bb.Parent do
            local myCharacter = LocalPlayer.Character or (charactersFolder and charactersFolder:FindFirstChild(LocalPlayer.Name))
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
            
            if myRoot and head then
                local distance = math.floor((myRoot.Position - head.Position).Magnitude)
                
                if targets[playerName] then
                    txt.Text = killAuraActive and string.format("[🎯 TARGET] %s\n[%d m]", playerName, distance) or string.format("[⏸️ TARGET] %s\n[%d m]", playerName, distance)
                    txt.TextColor3 = Color3.fromRGB(255, 30, 30)
                else
                    if playerName == closestPlayerName then
                        txt.Text = string.format("[⭐ CẬN] %s\n[%d m]", playerName, distance)
                        txt.TextColor3 = Color3.fromRGB(50, 255, 130)
                    else
                        txt.Text = string.format("%s\n[%d m]", playerName, distance)
                        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    end
                end
            end
            task.wait(0.1)
        end
        if bb then bb:Destroy() end
    end)
end

task.spawn(function()
    if charactersFolder then
        charactersFolder.ChildAdded:Connect(function(child)
            local p = Players:GetPlayerFromCharacter(child) or Players:FindFirstChild(child.Name)
            if p and p ~= LocalPlayer and p.Name ~= "Lubakixa" then
                task.wait(0.5)
                applyESP(child, p.Name)
            end
        end)
        for _, child in pairs(charactersFolder:GetChildren()) do
