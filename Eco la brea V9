--======================================================================
local function applyNPCEsp(npcModel, typeName)
    if not npcModel then return end
    if activeNpcEsps[npcModel] then return end
    
    local targetPart = getNPCTargetPart(npcModel)
    if not targetPart then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "NpcESP_Holder"
    bb.Size = UDim2.new(0, 180, 0, 40)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2, 0)
    bb.Adornee = targetPart
    bb.Enabled = npcEspActive 
    bb.Parent = targetPart

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 12
    
    if typeName == "Peccary" then
        txt.TextColor3 = Color3.fromRGB(255, 150, 200)
    elseif typeName == "Bird" then
        txt.TextColor3 = Color3.fromRGB(255, 255, 100)
    else
        txt.TextColor3 = Color3.fromRGB(100, 230, 255)
    end
    txt.Parent = bb

    activeNpcEsps[npcModel] = {
        billboard = bb,
        textLabel = txt,
        typeName = typeName,
        targetPart = targetPart
    }

    npcModel.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if activeNpcEsps[npcModel] then
                if bb then bb:Destroy() end
                activeNpcEsps[npcModel] = nil
            end
        end
    end)
end

