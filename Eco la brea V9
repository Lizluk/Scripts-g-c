-- CƠ CHẾ QUÉT NPC VÀ PLAYERS
--======================================================================
local playerButtons = {}
local peccaryButtons = {}
local scannedNPCModels = {}

local function scanNpcAndPlayers()
    for _, btn in pairs(ScrollingFrame:GetChildren()) do
        if btn:IsA("TextButton") then btn:Destroy() end
    end
    playerButtons = {}
    peccaryButtons = {}
    scannedNPCModels = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name ~= "Lubakixa" then
            local pName = player.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 28)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 12
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame
            Instance.new("UICorner").Parent = Btn

            Btn.MouseButton1Click:Connect(function() targets[pName] = not targets[pName] end)
            playerButtons[pName] = Btn
            
            if charactersFolder and charactersFolder:FindFirstChild(pName) then
                applyESP(charactersFolder[pName], pName)
            end
        end
    end

    if npcsFolder then
        local allObjects = npcsFolder:GetDescendants()
        for _, obj in pairs(allObjects) do
            if obj:IsA("Model") and obj.Parent and obj.Parent ~= npcsFolder then
                table.insert(scannedNPCModels, obj)
                
                local parentName = obj.Parent.Name
                local isPeccary = string.match(obj.Name, "Peccary") or string.match(parentName, "Peccary") or string.match(parentName, "Flat")
                local isBird = string.match(parentName, "Bird") or string.match(obj.Name, "Bird")
                local isSmall = string.match(parentName, "Small") or string.match(obj.Name, "Small")

                if isPeccary then
                    applyNPCEsp(obj, "Peccary")
                    local pigName = obj.Name
                    if not peccaryButtons[pigName] then
                        local Btn = Instance.new("TextButton")
                        Btn.Size = UDim2.new(1, 0, 0, 28)
                        Btn.Font = Enum.Font.SourceSansBold
                        Btn.TextSize = 12
                        Btn.BorderSizePixel = 0
                        Btn.Parent = ScrollingFrame
                        Instance.new("UICorner").Parent = Btn

                        Btn.MouseButton1Click:Connect(function() peccaryTargets[pigName] = not peccaryTargets[pigName] end)
                        peccaryButtons[pigName] = Btn
                    end
                elseif isBird then
                    applyNPCEsp(obj, "Bird")
                elseif isSmall then
                    applyNPCEsp(obj, "Small")
                else
                    applyNPCEsp(obj, parentName)
                end
            end
        end
    end
end

