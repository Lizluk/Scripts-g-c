-- HOTKEY LISTENER & CUSTOM MINIMIZE LOGIC
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        -- 1. Xử lý Ẩn/Hiện GUI theo phím tùy chỉnh
        if input.KeyCode.Name == ToggleGUIKeybindStr then
            if Window then
                if Window.Minimize then
                    Window:Minimize()
                elseif Window.Root then
                    Window.Root.Visible = not Window.Root.Visible
                end
            end
            return
        end

        -- 2. Dừng tất cả Emote
        if input.KeyCode.Name == StopEmoteKeybindStr then
            StopAllEmotes()
            Fluent:Notify({Title = "Đã Dừng Emote", Content = "Bấm phím tắt dừng emote thành công!", Duration = 1.5})
            return
        end

        -- 3. Phát Emote từ phím tắt
        for _, data in pairs(EmoteList) do
            if data.Keybind and data.Keybind ~= "None" and data.Keybind == input.KeyCode.Name then
                PlayEmote(data.ID)
                return
            end
        end

        -- 4. Đổi Anim Pack từ phím tắt
        for name, data in pairs(PresetList) do
            if data.Keybind and data.Keybind ~= "None" and data.Keybind == input.KeyCode.Name then
                AppliedPack = CloneTable(data)
                CurrentPack = CloneTable(data)
                ApplyAnimations(data)
                SaveToFile()
                Fluent:Notify({Title = "Đã Áp Dụng Pack", Content = "Đã bật Pack: " .. name .. " qua phím " .. input.KeyCode.Name, Duration = 2})
                return
            end
        end
    end
end)

