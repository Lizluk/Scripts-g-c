-- ==========================================
-- HÀM QUẢN LÝ FILE & CLONE TABLE
-- ==========================================
local function CloneTable(t)
    local copy = {}
    for k, v in pairs(t) do
        if type(v) == "table" then
            copy[k] = CloneTable(v)
        else
            copy[k] = v
        end
    end
    return copy
end

local function CleanID(id)
    if not id then return "" end
    return tostring(id):match("%d+") or ""
end

local function SaveToFile()
    if writefile then
        pcall(function()
            local dataToSave = {
                Presets = PresetList,
                Emotes = EmoteList,
                AppliedPack = AppliedPack,
                Keybind = ToggleGUIKeybindStr,
                StopKeybind = StopEmoteKeybindStr
            }
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(dataToSave))
        end)
    end
end

local function LoadFromFile()
    if isfile and isfile(SAVE_FILE_NAME) and readfile then
        pcall(function()
            local decoded = HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
            if decoded then
                PresetList = decoded.Presets or {}
                EmoteList = decoded.Emotes or {}
                AppliedPack = decoded.AppliedPack or nil
                if decoded.Keybind then
                    ToggleGUIKeybindStr = decoded.Keybind
                    if Enum.KeyCode[ToggleGUIKeybindStr] then
                        Window.MinimizeKey = Enum.KeyCode[ToggleGUIKeybindStr]
                    end
                end
                if decoded.StopKeybind then
                    StopEmoteKeybindStr = decoded.StopKeybind
                end
            end
        end)
    end
end

-- ==========================================
-- HÀM PHÁT & DỪNG EMOTE / ANIMATION (HEARTBEAT LOOP)
-- ==========================================
local function StopAllEmotes()
    isEmoteLocked = false
    if emoteLoopConn then
        emoteLoopConn:Disconnect()
        emoteLoopConn = nil
    end
    for _, track in ipairs(ActiveEmoteTracks) do
        pcall(function() track:Stop(0.2) end)
    end
    ActiveEmoteTracks = {}
end

local function StartEmoteLoop()
    if emoteLoopConn then emoteLoopConn:Disconnect() end
    emoteLoopConn = RunService.Heartbeat:Connect(function()
        if not isEmoteLocked or #ActiveEmoteTracks == 0 then return end
        for _, track in ipairs(ActiveEmoteTracks) do
            if track then
                if not track.IsPlaying then
                    pcall(function()
                        track:Play(0, 1, 1)
                        track.Priority = Enum.AnimationPriority.Action4
                    end)
                else
                    pcall(function()
                        track.Priority = Enum.AnimationPriority.Action4
                    end)
                end
            end
        end
    end)
end

local function PlayEmote(idData)
    StopAllEmotes()
    
    local idsToPlay = {}
    if type(idData) == "table" then
        for _, id in ipairs(idData) do
            local cId = CleanID(id)
            if cId ~= "" then table.insert(idsToPlay, cId) end
        end
    else
        local cId = CleanID(idData)
        if cId ~= "" then table.insert(idsToPlay, cId) end
    end

    if #idsToPlay == 0 then return end

    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid then return end

    local Animator = Humanoid:FindFirstChildOfClass("Animator") or Humanoid:WaitForChild("Animator")

    for _, rawId in ipairs(idsToPlay) do
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. rawId
        local track = Animator:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = true
        track:Play(0, 1, 1)
        table.insert(ActiveEmoteTracks, track)
    end

    isEmoteLocked = true
    StartEmoteLoop()
end

local function ApplyAnimations(packData)
    if not packData then return end
    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local AnimateScript = Character:WaitForChild("Animate", 5)
    if not AnimateScript then return end

    local idleFolder = AnimateScript:FindFirstChild("idle")
    if idleFolder then
        local idles = {}
        for _, child in ipairs(idleFolder:GetChildren()) do
            if child:IsA("Animation") then table.insert(idles, child) end
        end
        
        local validIdleIDs = {}
        if packData.IdleList then
            for _, id in ipairs(packData.IdleList) do
                local cId = CleanID(id)
                if cId ~= "" then table.insert(validIdleIDs, cId) end
            end
        elseif packData.Idle1 or packData.Idle2 then
            if CleanID(packData.Idle1) ~= "" then table.insert(validIdleIDs, CleanID(packData.Idle1)) end
            if CleanID(packData.Idle2) ~= "" then table.insert(validIdleIDs, CleanID(packData.Idle2)) end
        end

        if #validIdleIDs > 0 then
            for i, animObj in ipairs(idles) do
                local targetID = validIdleIDs[((i - 1) % #validIdleIDs) + 1]
                animObj.AnimationId = "rbxassetid://" .. targetID
            end
        end
    end

    local function ChangeSingleAnim(animName, id)
        local rawId = CleanID(id)
        if rawId == "" then return end
        local animFolder = AnimateScript:FindFirstChild(animName)
        if animFolder then
            for _, animObj in ipairs(animFolder:GetChildren()) do
                if animObj:IsA("Animation") then animObj.AnimationId = "rbxassetid://" .. rawId end
            end
        end
    end

    ChangeSingleAnim("walk", packData.Walk)
    ChangeSingleAnim("run", packData.Run)
    ChangeSingleAnim("jump", packData.Jump)
    ChangeSingleAnim("fall", packData.Fall)

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if Humanoid then
        local Animator = Humanoid:FindFirstChildOfClass("Animator")
        if Animator then
            for _, track in ipairs(Animator:GetPlayingAnimationTracks()) do track:Stop() end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
