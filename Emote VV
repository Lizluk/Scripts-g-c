                if not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
                    conn:Disconnect()
                    data.Keybind = input.KeyCode.Name
                    SaveToFile()
                    RenderSavedEmotes()
                    Fluent:Notify({Title = "Đã gán!", Content = name .. " -> Phím " .. input.KeyCode.Name, Duration = 2})
                end
            end)
        end)

        ResetKeyBtn.MouseButton1Click:Connect(function()
            data.Keybind = "None"
            SaveToFile()
            RenderSavedEmotes()
            Fluent:Notify({Title = "Đã Xóa Phím", Content = "Đã hủy phím tắt cho emote: " .. name, Duration = 2})
        end)
    end
end

