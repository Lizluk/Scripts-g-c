-- 4. VÒNG LẶP CHO LỆNH TẤN CÔNG THƯỜNG (KILL AURA CODE 1)
----------------------------------------------------------------
task.spawn(function()
    while true do
        if killAuraActive and attackRemote and charactersFolder then
            for pName, isTargeted in pairs(targets) do
                if isTargeted then
                    local targetCharacter = charactersFolder:FindFirstChild(pName)
                    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
                    local targetHitbox = targetCharacter and targetCharacter:FindFirstChild("BodyHitbox")
                    
                    if targetHumanoid and targetHitbox then
                        pcall(function()
                            -- Cập nhật đồng bộ theo gói Spy mới (Attack với 3 tham số)
                            attackRemote:FireServer(targetHumanoid, targetHitbox, 1)
                        end)
                    end
                end
            end
        end
        task.wait(attackCooldown)
    end
end)

----------------------------------------------------------------
-- 5. VÒNG LẶP CHO LỆNH SKILL CẮN/VỒ CỦA CÁC THÚ ĂN THỊT (CODE 2)
----------------------------------------------------------------
task.spawn(function()
    while true do
        if autoPounceActive and attackRemote and charactersFolder then
            for pName, isTargeted in pairs(targets) do
                if isTargeted then
                    local targetCharacter = charactersFolder:FindFirstChild(pName)
                    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
                    local targetHitbox = targetCharacter and targetCharacter:FindFirstChild("BodyHitbox")
                    
                    if targetHumanoid and targetHitbox then
                        -- Tự động quét tìm điểm bám (Hỗ trợ cả 2 dòng thú ăn thịt khác nhau)
                        local rootPart = targetCharacter:FindFirstChild("RootPart")
                        local torso = rootPart and rootPart:FindFirstChild("Torso")
                        
                        local latchPoint = nil
                        if torso then
                            -- Kiểm tra dòng thú cũ (LatchPoint2.R) hoặc dòng thú mới (GrapplePoint2 nằm sâu bên trong Waist -> Hips)
                            latchPoint = torso:FindFirstChild("LatchPoint2.R") 
                                or (torso:FindFirstChild("Waist") and torso.Waist:FindFirstChild("Hips") and torso.Waist.Hips:FindFirstChild("GrapplePoint2"))
                                or torso:GetChildren()[1] -- Điểm dự phòng nếu không tìm thấy cụ thể
                        end
                        
                        if latchPoint then
                            pcall(function()
                                attackRemote:FireServer(targetHumanoid, targetHitbox, 2, latchPoint)
                            end)
                        end
                    end
                end
            end
        end
        task.wait(pounceCooldown)
    end
end)

----------------------------------------------------------------
-- 6. VÒNG LẶP CHO LỆNH TẤN CÔNG NPC
----------------------------------------------------------------
task.spawn(function()
    while true do
        if killAuraActive and attackNPCRemote and npcsFolder then
            local myCharacter = charactersFolder and charactersFolder:FindFirstChild("Lubakixa") or LocalPlayer.Character
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

            if myRoot then
                for _, folder in pairs(npcsFolder:GetChildren()) do
                    if folder:IsA("Folder") or folder:IsA("Model") then
                        local targetsList = folder:IsA("Model") and {folder} or folder:GetChildren()
                        
                        for _, npcModel in pairs(targetsList) do
                            if npcModel:IsA("Model") then
                                local bodyPart = npcModel:FindFirstChild("Body_m") or npcModel:FindFirstChildOfClass("MeshPart") or npcModel:FindFirstChildOfClass("Part")
                                
                                if bodyPart then
                                    local distance = (myRoot.Position - bodyPart.Position).Magnitude
                                    if distance <= maxDetectDistance then
                                        pcall(function()
                                            attackNPCRemote:FireServer(bodyPart, 1)
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(npcAttackCooldown)
    end
end)
