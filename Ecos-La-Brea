-- 5. VÒNG LẶP TẤN CÔNG THƯỜNG (KILL AURA)
--======================================================================
task.spawn(function()
    while true do
        if killAuraActive and attackRemote and charactersFolder then
            for pName, isTargeted in pairs(targets) do
                if isTargeted then
                    local targetCharacter = charactersFolder:FindFirstChild(pName)
                    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
                    local targetHitbox = targetCharacter and targetCharacter:FindFirstChild("BodyHitbox")
                    
                    if targetHumanoid and targetHitbox then
                        pcall(function()
                            attackRemote:FireServer(targetHumanoid, targetHitbox, 1)
                        end)
                    end
                end
            end
        end
        task.wait(attackCooldown)
    end
end)

--======================================================================
-- 6. VÒNG LẶP SKILL VỒ (POUNCE)
--======================================================================
task.spawn(function()
    while true do
        if autoPounceActive and attackRemote and charactersFolder then
            for pName, isTargeted in pairs(targets) do
                if isTargeted then
                    local targetCharacter = charactersFolder:FindFirstChild(pName)
                    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
                    local targetHitbox = targetCharacter and targetCharacter:FindFirstChild("BodyHitbox")
                    
                    if targetHumanoid and targetHitbox then
                        local rootPart = targetCharacter:FindFirstChild("RootPart")
                        local torso = rootPart and rootPart:FindFirstChild("Torso")
                        
                        local latchPoint = nil
                        if torso then
                            latchPoint = torso:FindFirstChild("LatchPoint2.R") 
                                or (torso:FindFirstChild("Waist") and torso.Waist:FindFirstChild("Hips") and torso.Waist.Hips:FindFirstChild("GrapplePoint2"))
                                or torso:GetChildren()[1]
                        end
                        
                        if latchPoint then
                            pcall(function()
                                attackRemote:FireServer(targetHumanoid, targetHitbox, 2, latchPoint)
                            end)
                        end
                    end
                end
            end
        end
        task.wait(pounceCooldown)
    end
end)

