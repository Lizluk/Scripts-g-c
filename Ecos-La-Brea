-- CẬP NHẬT: HỆ THỐNG AN TOÀN QUÉT NPC ESP (PHÂN LOẠI HIỂN THỊ PECCARY MỤC TIÊU)
------------------------------------------------------------------------
local function applyNPCEsp(npcModel, typeName)
    if not npcModel then return end
    if npcModel:FindFirstChild("NpcESP_Holder") then return end
    
    local targetPart = npcModel:FindFirstChild("Body_m")
        or npcModel:FindFirstChild("Head") 
        or npcModel:FindFirstChildOfClass("MeshPart") 
        or npcModel:FindFirstChildOfClass("Part")
        
    if not targetPart then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "NpcESP_Holder"
    bb.Size = UDim2.new(0, 180, 0, 40)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2, 0)
    bb.Adornee = targetPart
    bb.Enabled = npcEspActive 
    bb.Parent = targetPart
    
    table.insert(activeNpcEsps, bb)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 12
    txt.TextColor3 = Color3.fromRGB(0, 220, 255) 
    txt.Parent = bb

    local connection
    connection = RunService.RenderStepped:Connect(function()
        local myCharacter = charactersFolder and (charactersFolder:FindFirstChild(LocalPlayer.Name) or charactersFolder:FindFirstChild("Lubakixa")) or LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        if not npcModel:IsDescendantOf(workspace) or not targetPart:IsDescendantOf(npcModel) or not myRoot then
            connection:Disconnect()
            local idx = table.find(activeNpcEsps, bb)
            if idx then table.remove(activeNpcEsps, idx) end
            bb:Destroy()
            return
        end

        local distance = math.floor((myRoot.Position - targetPart.Position).Magnitude)
        
        -- Cập nhật trực quan ESP: Nếu con heo này đang được nhắm bắn, đổi màu ESP đỏ rực
        if typeName == "Peccary" and peccaryTargets[npcModel.Name] then
            txt.Text = string.format("🐷 [🎯 TÂN CÔNG]\n%s (%dm)", npcModel.Name, distance)
            txt.TextColor3 = Color3.fromRGB(255, 50, 50)
        else
            txt.Text = string.format("👾 [%s]\n%s (%dm)", typeName, npcModel.Name, distance)
            txt.TextColor3 = (typeName == "Peccary") and Color3.fromRGB(255, 180, 220) or Color3.fromRGB(0, 220, 255)
        end
    end)
end

local function scanNpcFolders()
    local mainNpcs = workspace:FindFirstChild("NPCs")
    if mainNpcs then
        local birdFolder = mainNpcs:FindFirstChild("Bird")
        if birdFolder then
            for _, c in pairs(birdFolder:GetChildren()) do applyNPCEsp(c, "Bird") end
        end
        local smallFolder = mainNpcs:FindFirstChild("Small")
        if smallFolder then
            for _, c in pairs(smallFolder:GetChildren()) do applyNPCEsp(c, "Small") end
        end
        local peccaryFolder = mainNpcs:FindFirstChild("FlatHeadedPeccary61")
        if peccaryFolder then
            for _, c in pairs(peccaryFolder:GetChildren()) do
                if c:IsA("Model") then applyNPCEsp(c, "Peccary") end
            end
        end
    end
    
    local barrierFolder = workspace:FindFirstChild("NpcBarriers")
    if barrierFolder then
        for _, c in pairs(barrierFolder:GetChildren()) do applyNPCEsp(c, "Barrier") end
    end
end

task.spawn(function()
    task.wait(1)
    scanNpcFolders()
    
    pcall(function()
        local mainNpcs = workspace:WaitForChild("NPCs", 10)
        if mainNpcs then
            local bird = mainNpcs:WaitForChild("Bird", 5)
            if bird then bird.ChildAdded:Connect(function(c) task.wait(0.1) applyNPCEsp(c, "Bird") end) end
            
            local small = mainNpcs:WaitForChild("Small", 5)
            if small then small.ChildAdded:Connect(function(c) task.wait(0.1) applyNPCEsp(c, "Small") end) end

            local peccary = mainNpcs:WaitForChild("FlatHeadedPeccary61", 5)
            if peccary then peccary.ChildAdded:Connect(function(c) task.wait(0.1) applyNPCEsp(c, "Peccary") end) end
        end
    end)
    
    while true do
        scanNpcFolders()
        task.wait(4)
    end
end)

