local function applyESP(character, playerName)
    if not character then return end
    local head = character:WaitForChild("Head", 5)
    if not head then return end

    if head:FindFirstChild("PlayerESP") then head.PlayerESP:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerESP"
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = head
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 14
    txt.Parent = bb

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not charactersFolder or not character:IsDescendantOf(charactersFolder) or not head:IsDescendantOf(character) or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            connection:Disconnect()
            bb:Destroy()
            return
        end
        
        local myRoot = LocalPlayer.Character.HumanoidRootPart
        local distance = math.floor((myRoot.Position - head.Position).Magnitude)
        
        if targets[playerName] then
            if killAuraActive then
                txt.Text = string.format("[🎯] %s\n[%d m]", playerName, distance)
                txt.TextColor3 = Color3.fromRGB(255, 50, 50)
            else
                txt.Text = string.format("[⏸️] %s\n[%d m]", playerName, distance)
                txt.TextColor3 = Color3.fromRGB(255, 200, 50)
            end
        elseif playerName == closestPlayerName then
            txt.Text = string.format("[⭐ CHIẾT CẬN] %s\n[%d m]", playerName, distance)
            txt.TextColor3 = Color3.fromRGB(0, 255, 150)
        else
            txt.Text = string.format("%s\n[%d m]", playerName, distance)
            txt.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    end)
end

local function trackCharacters()
    if charactersFolder then
        for _, child in pairs(charactersFolder:GetChildren()) do
            if child:IsA("Model") and child.Name ~= LocalPlayer.Name and child.Name ~= "Lubakixa" and Players:GetPlayerFromCharacter(child) then
                applyESP(child, child.Name)
            end
        end
        
        charactersFolder.ChildAdded:Connect(function(child)
            if child:IsA("Model") and child.Name ~= LocalPlayer.Name and child.Name ~= "Lubakixa" then
                task.wait(0.5)
                if Players:GetPlayerFromCharacter(child) then
                    applyESP(child, child.Name)
                end
            end
        end)
    end
end
task.spawn(trackCharacters)

----------------------------------------------------------------
-- 3. VÒNG LẶP CHÍNH QUẢN LÝ GIAO DIỆN, KHHOẢNG CÁCH & KHÓA STATS
----------------------------------------------------------------

local buttons = {}

local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name ~= "Lubakixa" then
            local pName = player.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 30)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 14
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                targets[pName] = not targets[pName]
            end)

            buttons[pName] = {Button = Btn}
        end
    end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player)
    targets[player.Name] = nil
    buildButtons()
end)
buildButtons()

task.spawn(function()
    while true do
        local myCharacter = charactersFolder and charactersFolder:FindFirstChild("Lubakixa") or LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        pcall(function()
            if LocalPlayer:GetAttribute("Stamina") then LocalPlayer:SetAttribute("Stamina", 80) end
            if LocalPlayer:GetAttribute("Thirst") then LocalPlayer:SetAttribute("Thirst", 80) end
            if LocalPlayer:GetAttribute("Hunger") then LocalPlayer:SetAttribute("Hunger", 80) end
        end)

        local minDistance = math.huge
        local tempClosest = ""

        if myRoot and charactersFolder then
            for pName, btnData in pairs(buttons) do
                local pChar = charactersFolder:FindFirstChild(pName)
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                if pRoot then
                    local dist = (myRoot.Position - pRoot.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    if targets[pName] then
                        btnData.Button.LayoutOrder = math.floor(dist) - 100000
                    else
                        btnData.Button.LayoutOrder = math.floor(dist)
                    end
                else
                    btnData.Button.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        for pName, btnData in pairs(buttons) do
            local Btn = btnData.Button
            if targets[pName] then
                if killAuraActive then
                    Btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                    Btn.Text = pName .. " [KILLING]"
                else
                    Btn.BackgroundColor3 = Color3.fromRGB(160, 120, 30)
                    Btn.Text = pName .. " [PAUSED]"
                end
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            elseif pName == closestPlayerName then
                Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                Btn.Text = "⭐ " .. pName .. " (GẦN NHẤT)"
                Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
            else
                Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                Btn.Text = pName
                Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end

        if autoDrinkActive and drinkRemote then
            pcall(function()
                local lake = interactionsFolder and interactionsFolder:FindFirstChild("Lakes") and interactionsFolder.Lakes:FindFirstChild("Lake")
                if lake then drinkRemote:FireServer(lake) end
            end)
        end

        if autoEatActive and foodRemote then
            pcall(function()
                local ribs = interactionsFolder and interactionsFolder:FindFirstChild("Food") and interactionsFolder.Food:FindFirstChild("Ribs")
                if ribs then foodRemote:FireServer(ribs) end
            end)
        end

        task.wait(0.1)
    end
end)

