--======================================================================
-- 4. VÒNG LẶP CHÍNH: QUẢN LÝ KHOẢNG CÁCH, CHỈ SỐ & TRỰC QUAN HÓA NÚT BẤM
--======================================================================
task.spawn(function()
    while true do
        local myCharacter = charactersFolder and (charactersFolder:FindFirstChild(LocalPlayer.Name) or charactersFolder:FindFirstChild("Lubakixa")) or LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        -- Khóa chỉ số
        if isLocking and myCharacter then
            local realAttributesFolder = myCharacter:FindFirstChild("Attributes")
            if realAttributesFolder then
                pcall(function()
                    realAttributesFolder:SetAttribute("Hunger", targetHunger)
                    realAttributesFolder:SetAttribute("Thirst", targetThirst)
                    realAttributesFolder:SetAttribute("Stamina", targetStamina)
                end)
            end
        end

        -- Tìm kiếm Player gần nhất
        local minDistance = math.huge
        local tempClosest = ""
        if myRoot and charactersFolder then
            for pName, Btn in pairs(playerButtons) do
                local pChar = charactersFolder:FindFirstChild(pName)
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                if pRoot then
                    local dist = (myRoot.Position - pRoot.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    Btn.LayoutOrder = targets[pName] and (math.floor(dist) - 100000) or math.floor(dist)
                else
                    Btn.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        -- Cập nhật màu sắc nút bấm cho PLAYER
        for pName, Btn in pairs(playerButtons) do
            if targets[pName] then
                Btn.BackgroundColor3 = killAuraActive and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(160, 120, 30)
                Btn.Text = pName .. (killAuraActive and " [KILLING]" or " [PAUSED]")
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            elseif pName == closestPlayerName then
                Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                Btn.Text = "⭐ " .. pName .. " (GẦN NHẤT)"
                Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
            else
                Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                Btn.Text = pName
                Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end

        -- CẬP NHẬT: Quản lý màu sắc nút bấm riêng cho mục tiêu HEOCƠ (PECCARY)
        local peccaryFolder = workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild("FlatHeadedPeccary61")
        for npcName, Btn in pairs(peccaryButtons) do
            local npcModel = peccaryFolder and peccaryFolder:FindFirstChild(npcName)
            local body = npcModel and (npcModel:FindFirstChild("Body_m") or npcModel:FindFirstChildOfClass("Part"))
            
            if body and myRoot then
                local dist = (myRoot.Position - body.Position).Magnitude
                Btn.LayoutOrder = peccaryTargets[npcName] and (math.floor(dist) - 50000) or (math.floor(dist) + 50000)
                
                if peccaryTargets[npcName] then
                    Btn.BackgroundColor3 = Color3.fromRGB(230, 50, 120) -- Đỏ hồng nhắm bắn
                    Btn.Text = "🐷 " .. npcName .. " [KILL TARGET]"
                    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    Btn.BackgroundColor3 = Color3.fromRGB(25, 35, 45) -- Màu tối mặc định cho Heo
                    Btn.Text = "🐷 " .. npcName .. string.format(" (%dm)", math.floor(dist))
                    Btn.TextColor3 = Color3.fromRGB(200, 220, 245)
                end
            else
                Btn.LayoutOrder = 999999
                Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                Btn.Text = "❌ " .. npcName .. " (DEAD/FAR)"
                Btn.TextColor3 = Color3.fromRGB(100, 100, 100)
            end
        end

        -- Auto Drink
        if autoDrinkActive and drinkRemote then
            pcall(function()
                local lake = interactionsFolder and interactionsFolder:FindFirstChild("Lakes") and interactionsFolder.Lakes:FindFirstChild("Lake")
                if lake then drinkRemote:FireServer(lake) end
            end)
        end

        task.wait(0.1)
    end
end)

