            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 28)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 13
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                if currentViewMode == "KILL" then
                    -- Bấm từ danh sách Kill -> Chuyển sang Team List
                    teammates[pName] = true
                    targets[pName] = nil
                else
                    -- Bấm từ danh sách Team -> Trả lại Kill List
                    teammates[pName] = nil
                end
            end)

            -- Bấm chuột phải để Toggle Target nhanh khi ở Kill List
            Btn.MouseButton2Click:Connect(function()
                if currentViewMode == "KILL" then
                    targets[pName] = not targets[pName] or nil
                end
            end)

            buttons[pName] = {Button = Btn}
        end
    end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player)
    targets[player.Name] = nil
    teammates[player.Name] = nil
    buildButtons()
end)
buildButtons()

task.spawn(function()
    while true do
        local myCharacter = getCharacter(LocalPlayer)
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        local minDistance = math.huge
        local tempClosest = ""

        if myRoot then
            for pName, btnData in pairs(buttons) do
                local p = Players:FindFirstChild(pName)
                local pChar = getCharacter(p)
                if pChar and pChar:FindFirstChild("HumanoidRootPart") then
                    local dist = (myRoot.Position - pChar.HumanoidRootPart.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance and not teammates[pName] then
                        minDistance = dist
                        tempClosest = pName
                    end
                    btnData.Button.LayoutOrder = targets[pName] and (math.floor(dist) - 100000) or math.floor(dist)
                else
                    btnData.Button.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        for pName, btnData in pairs(buttons) do
            local Btn = btnData.Button
            local isSearchMatch = (searchFilterText == "" or string.find(string.lower(pName), searchFilterText, 1, true))

            if currentViewMode == "KILL" then
                -- Hiển thị những người KHÔNG thuộc danh sách Đồng đội
                if not teammates[pName] and isSearchMatch then
                    Btn.Visible = true
                    if targets[pName] then
                        Btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                        Btn.Text = pName .. " [TARGET]"
                        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    elseif pName == closestPlayerName then
                        Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                        Btn.Text = "⭐ " .. pName .. " (GẦN NHẤT)"
                        Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
                    else
                        Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                        Btn.Text = pName
                        Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
                    end
                else
                    Btn.Visible = false
                end
            elseif currentViewMode == "TEAM" then
                -- Hiển thị những người THUỘC danh sách Đồng đội (F1)
                if teammates[pName] and isSearchMatch then
                    Btn.Visible = true
                    Btn.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
                    Btn.Text = "🤝 " .. pName .. " [TEAMMATE]"
                    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    Btn.Visible = false
                end
            end
        end

        task.wait(0.1)
    end
end)
