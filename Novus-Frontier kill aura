local function applyESP(player, character)
    if not character or player == LocalPlayer then return end
    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 3)
    if not head then return end

    if head:FindFirstChild("PlayerESP") then head.PlayerESP:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerESP"
    bb.Size = UDim2.new(0, 150, 0, 30)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = head
    bb.MaxDistance = maxDetectDistance
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Name = "ESPText"
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.Parent = bb
end

local function setupPlayerESP(player)
    if player == LocalPlayer then return end
    player.CharacterAdded:Connect(function(char) applyESP(player, char) end)
    local char = getCharacter(player)
    if char then applyESP(player, char) end
end

for _, p in pairs(Players:GetPlayers()) do setupPlayerESP(p) end
Players.PlayerAdded:Connect(setupPlayerESP)

task.spawn(function()
    while true do
        local myCharacter = getCharacter(LocalPlayer)
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

        if myRoot then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local pChar = getCharacter(player)
                    if pChar and pChar:FindFirstChild("Head") then
                        local head = pChar.Head
                        local espGui = head:FindFirstChild("PlayerESP")
                        if not espGui then
                            applyESP(player, pChar)
                        else
                            espGui.MaxDistance = maxDetectDistance
                            local txt = espGui:FindFirstChild("ESPText")
                            if txt then
                                local distance = math.floor((myRoot.Position - head.Position).Magnitude)
                                if distance <= maxDetectDistance then
                                    if targets[player.Name] then
                                        txt.Text = string.format("[🎯] %s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(255, 50, 50)
                                    elseif player.Name == closestPlayerName then
                                        txt.Text = string.format("[⭐] %s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(0, 255, 150)
                                    else
                                        txt.Text = string.format("%s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.25)
    end
end)

local buttons = {}

local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 28)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 13
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                targets[pName] = not targets[pName] or nil
            end)

            buttons[pName] = {Button = Btn}
        end
    end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player)
    targets[player.Name] = nil
    buildButtons()
end)
buildButtons()

task.spawn(function()
    while true do
        local myCharacter = getCharacter(LocalPlayer)
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        local minDistance = math.huge
        local tempClosest = ""

        if myRoot then
            for pName, btnData in pairs(buttons) do
                local p = Players:FindFirstChild(pName)
                local pChar = getCharacter(p)
                if pChar and pChar:FindFirstChild("HumanoidRootPart") then
                    local dist = (myRoot.Position - pChar.HumanoidRootPart.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    btnData.Button.LayoutOrder = targets[pName] and (math.floor(dist) - 100000) or math.floor(dist)
                else
                    btnData.Button.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        for pName, btnData in pairs(buttons) do
            local Btn = btnData.Button
            Btn.Visible = (searchFilterText == "" or string.find(string.lower(pName), searchFilterText, 1, true))

            if targets[pName] then
                Btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                Btn.Text = pName .. " [TARGET]"
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            elseif pName == closestPlayerName then
                Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                Btn.Text = "⭐ " .. pName .. " (GẦN NHẤT)"
                Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
            else
                Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                Btn.Text = pName
                Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end

        task.wait(0.1)
    end
end)
