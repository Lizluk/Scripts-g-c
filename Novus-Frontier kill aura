-- 2. TẤN CÔNG BẰNG TAY (MANUAL ATTACK VIA LEFT CLICK)
----------------------------------------------------------------

local function performManualAttack()
    if not (normalAuraActive or specialAuraActive) then return end
    if tick() - lastAttackTime < attackCooldown then return end

    local myCharacter = getCharacter(LocalPlayer)
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    if myRoot then
        for pName, isTargeted in pairs(targets) do
            if isTargeted then
                local targetCharacter = workspace:FindFirstChild(pName) or (Players:FindFirstChild(pName) and Players[pName].Character)
                
                if targetCharacter then
                    -- Normal Attack
                    if normalAuraActive then
                        local myOriginPart = myCharacter:FindFirstChild("Hand.R") or myCharacter:FindFirstChild("Head") or myRoot

                        local primaryParts = {"Claws.002", "Wing.001.L", "LeftFoot", "Shin.R", "RightFoot", "HumanoidRootPart"}
                        for _, partName in ipairs(primaryParts) do
                            local hitPart = targetCharacter:FindFirstChild(partName)
                            if hitPart and hitPart:IsA("BasePart") then
                                if (myRoot.Position - hitPart.Position).Magnitude <= maxDetectDistance then
                                    pcall(function()
                                        meleeRemote:FireServer(hitPart, nil, hitPart.Position, myOriginPart, {["AttackOrigin"] = myOriginPart, ["AttackType"] = "PrimaryAttack"})
                                    end)
                                end
                            end
                        end

                        local clawPart = targetCharacter:FindFirstChild("Claws.002") or targetCharacter:FindFirstChild("Hand.R") or targetCharacter:FindFirstChild("HumanoidRootPart")
                        if clawPart and clawPart:IsA("BasePart") then
                            if (myRoot.Position - clawPart.Position).Magnitude <= maxDetectDistance then
                                pcall(function()
                                    meleeRemote:FireServer(clawPart, nil, clawPart.Position, myOriginPart, {["AttackOrigin"] = myOriginPart, ["AttackType"] = "ClawswipeAttack"})
                                end)
                            end
                        end
                    end

                    -- Special Attack
                    if specialAuraActive then
                        local myFakeHead = myCharacter:FindFirstChild("FakeHead") or myCharacter:FindFirstChild("Head") or myRoot
                        local chargeParts = {"LeftUpperLeg", "RightUpperLeg", "UpperTorso", "HumanoidRootPart"}

                        for _, partName in ipairs(chargeParts) do
                            local hitPart = targetCharacter:FindFirstChild(partName)
                            if hitPart and hitPart:IsA("BasePart") then
                                if (myRoot.Position - hitPart.Position).Magnitude <= maxDetectDistance then
                                    pcall(function()
                                        meleeRemote:FireServer(hitPart, nil, hitPart.Position, myFakeHead, {["AttackOrigin"] = myFakeHead, ["AttackType"] = "ChargeAttack"})
                                    end)
                                end
                            end
                        end
                    end

                    lastAttackTime = tick()
                end
            end
        end
    end
end

