local function applyESP(player, character)
    if not character or player == LocalPlayer then return end
    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 3)
    if not head then return end

    if head:FindFirstChild("PlayerESP") then head.PlayerESP:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerESP"
    bb.Size = UDim2.new(0, 150, 0, 30)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = head
    bb.MaxDistance = maxDetectDistance
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Name = "ESPText"
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.Parent = bb
end

local function setupPlayerESP(player)
    if player == LocalPlayer then return end
    player.CharacterAdded:Connect(function(char) applyESP(player, char) end)
    local char = getCharacter(player)
    if char then applyESP(player, char) end
end

for _, p in pairs(Players:GetPlayers()) do setupPlayerESP(p) end
Players.PlayerAdded:Connect(setupPlayerESP)

task.spawn(function()
    while true do
        local myCharacter = getCharacter(LocalPlayer)
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

        if myRoot then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local pChar = getCharacter(player)
                    if pChar and pChar:FindFirstChild("Head") then
                        local head = pChar.Head
                        local espGui = head:FindFirstChild("PlayerESP")
                        if not espGui then
                            applyESP(player, pChar)
                        else
                            espGui.MaxDistance = maxDetectDistance
                            local txt = espGui:FindFirstChild("ESPText")
                            if txt then
                                local distance = math.floor((myRoot.Position - head.Position).Magnitude)
                                if distance <= maxDetectDistance then
                                    if teammates[player.Name] then
                                        txt.Text = string.format("[🤝] %s (TEAM)\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(0, 200, 255)
                                    elseif targets[player.Name] then
                                        txt.Text = string.format("[🎯] %s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(255, 50, 50)
                                    elseif player.Name == closestPlayerName then
                                        txt.Text = string.format("[⭐] %s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(0, 255, 150)
                                    else
                                        txt.Text = string.format("%s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.25)
    end
end)

