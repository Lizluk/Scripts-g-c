UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if UserInputService:GetFocusedTextBox() then return end
    if gameProcessed then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        performManualAttack()
    end

    if input.KeyCode == Enum.KeyCode.P then MainFrame.Visible = not MainFrame.Visible end
    if input.KeyCode == Enum.KeyCode.T then toggleSelectAll() end

    -- Q: Normal Attack
    if input.KeyCode == Enum.KeyCode.B then
        normalAuraActive = not normalAuraActive
        NormalStatusLabel.Text = normalAuraActive and "NORMAL ATTACK: ON [B]" or "NORMAL ATTACK: OFF [Q]"
        NormalStatusLabel.TextColor3 = normalAuraActive and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 70, 70)
    end

    -- H: Special Attack
    if input.KeyCode == Enum.KeyCode.H then
        specialAuraActive = not specialAuraActive
        SpecialStatusLabel.Text = specialAuraActive and "SPECIAL ATTACK: ON [H]" or "SPECIAL ATTACK: OFF [H]"
        SpecialStatusLabel.TextColor3 = specialAuraActive and Color3.fromRGB(255, 150, 50) or Color3.fromRGB(255, 70, 70)
    end

    -- L: Drink Water
    if input.KeyCode == Enum.KeyCode.L then
        autoWaterActive = not autoWaterActive
        WaterStatusLabel.Text = autoWaterActive and "DRINK WATER: ON [L]" or "DRINK WATER: OFF [L]"
        WaterStatusLabel.TextColor3 = autoWaterActive and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(255, 70, 70)
    end

    -- J: Auto Eat
    if input.KeyCode == Enum.KeyCode.J then
        autoEatActive = not autoEatActive
        EatStatusLabel.Text = autoEatActive and "AUTO EAT: ON [J]" or "AUTO EAT: OFF [J]"
        EatStatusLabel.TextColor3 = autoEatActive and Color3.fromRGB(255, 220, 50) or Color3.fromRGB(255, 70, 70)
    end
end)

