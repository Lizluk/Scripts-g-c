-- 2. XỬ LÝ LATCH ABILITY (TOGGLE BẰNG PHÍM Y)
----------------------------------------------------------------

local function toggleLatch()
    latchActive = not latchActive

    if latchActive then
        local myCharacter = getCharacter(LocalPlayer)
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        local latchTargetPart = nil
        local selectedCFrame = nil

        local cframeAntennae = CFrame.new(-0.53503418, 1.49145508, 0.847290039, 0.512408733, -0.788345397, -0.340512812, 0.471051902, -0.0735112578, 0.879037499, -0.718016505, -0.610825658, 0.333683848)
        local cframeMidriff = CFrame.new(1.92724609, 1.05755615, -0.626220703, 0.0126661658, -0.44036904, 0.897727668, 5.34025304e-08, 0.897799671, 0.440404326, -0.999919891, -0.00557819009, 0.0113717318)

        if myRoot then
            for pName, isTargeted in pairs(targets) do
                if isTargeted and not teammates[pName] then
                    local targetCharacter = workspace:FindFirstChild(pName) or (Players:FindFirstChild(pName) and Players[pName].Character)
                    if targetCharacter then
                        if targetCharacter:FindFirstChild("MidriffFin") then
                            latchTargetPart = targetCharacter.MidriffFin
                            selectedCFrame = cframeMidriff
                        elseif targetCharacter:FindFirstChild("Antennae.007.L") then
                            latchTargetPart = targetCharacter["Antennae.007.L"]
                            selectedCFrame = cframeAntennae
                        else
                            latchTargetPart = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
                            selectedCFrame = cframeAntennae
                        end

                        if latchTargetPart then
                            local dist = (myRoot.Position - latchTargetPart.Position).Magnitude
                            if dist <= maxDetectDistance then
                                break
                            else
                                latchTargetPart = nil
                            end
                        end
                    end
                end
            end
        end

        if latchTargetPart and selectedCFrame then
            pcall(function()
                latchRemote:FireServer("LatchStart", latchTargetPart, selectedCFrame)
            end)
            LatchStatusLabel.Text = "LATCH ABILITY: ON [Y]"
            LatchStatusLabel.TextColor3 = Color3.fromRGB(180, 100, 255)
        else
            latchActive = false
            LatchStatusLabel.Text = "LATCH ABILITY: NO TARGET [Y]"
            LatchStatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
        end
    else
        pcall(function()
            latchRemote:FireServer("LatchEnd")
        end)
        LatchStatusLabel.Text = "LATCH ABILITY: OFF [Y]"
        LatchStatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
    end
end

