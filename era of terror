local function toggleSelectAll()
    local allPlayers = Players:GetPlayers()
    local otherPlayersCount = 0
    local selectedCount = 0

    for _, p in pairs(allPlayers) do
        if p ~= LocalPlayer then
            otherPlayersCount = otherPlayersCount + 1
            if targets[p.Name] then
                selectedCount = selectedCount + 1
            end
        end
    end

    if selectedCount == otherPlayersCount and otherPlayersCount > 0 then
        targets = {}
        SelectAllBtn.Text = "☑️ SELECT ALL PLAYERS [T]"
        SelectAllBtn.BackgroundColor3 = Color3.fromRGB(50, 90, 150)
    else
        for _, p in pairs(allPlayers) do
            if p ~= LocalPlayer then
                targets[p.Name] = true
            end
        end
        SelectAllBtn.Text = "☒ DESELECT ALL PLAYERS [T]"
        SelectAllBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    end
end

SelectAllBtn.MouseButton1Click:Connect(toggleSelectAll)

-- LỰC ĐÁNH / INFLICT DAMAGE LOGIC (Tự động lấy chỉ số Dame từ 2 ô nhập liệu)
local function performKillAuraAttack()
    if not killAuraActive then return end
    if tick() - lastAttackTime < attackCooldown then return end
    
    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    if myRoot then
        for pName, isTargeted in pairs(targets) do
            if isTargeted then
                local charsFolder = workspace:FindFirstChild("Characters")
                local targetCharacter = workspace:FindFirstChild(pName) or (charsFolder and charsFolder:FindFirstChild(pName))
                local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                
                if targetRoot then
                    local currentDist = (myRoot.Position - targetRoot.Position).Magnitude
                    if currentDist <= maxDetectDistance then
                        local targetPart = targetCharacter:FindFirstChild("Torso") 
                            or targetCharacter:FindFirstChild("UpperTorso") 
                            or targetCharacter:FindFirstChild("HumanoidRootPart")

                        if targetPart then
                            pcall(function()
                                local remote = inflictDamageRemote or ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("InflictDamage")
                                if remote then
                                    local ohTable1 = {
                                        [1] = targetPart
                                    }
                                    local ohNumber2 = customDamage1
                                    local ohNumber3 = 5
                                    local ohNumber4 = customDamage2
                                    local ohNumber5 = 0
                                    local ohNumber6 = 0

                                    remote:FireServer(ohTable1, ohNumber2, ohNumber3, ohNumber4, ohNumber5, ohNumber6)
                                end
                            end)
                            lastAttackTime = tick()
                        end
                    end
                end
            end
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if UserInputService:GetFocusedTextBox() or gameProcessed then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        performKillAuraAttack()
    elseif input.KeyCode == Enum.KeyCode.P then 
        MainFrame.Visible = not MainFrame.Visible 
    elseif input.KeyCode == Enum.KeyCode.T then 
        toggleSelectAll() 
    elseif input.KeyCode == Enum.KeyCode.Q then
        killAuraActive = not killAuraActive
        if killAuraActive then
            StatusLabel.Text = "KILL AURA: READY [Q]"
            StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            StatusLabel.Text = "KILL AURA: PAUSED [Q]"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        end
    end
end)

