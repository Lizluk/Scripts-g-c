-- HIỆU ỨNG GLOW ON/OFF
local function updateVisuals()
    local tInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if isEnabled then
        StatusBtn.Text = "STATUS: ACTIVE (ON)"
        TweenService:Create(StatusBtn, tInfo, {BackgroundColor3 = Color3.fromRGB(10, 45, 25), TextColor3 = Color3.fromRGB(0, 255, 140)}):Play()
        TweenService:Create(StatusGlow, tInfo, {Color = Color3.fromRGB(0, 255, 140)}):Play()
        TweenService:Create(UIStroke, tInfo, {Color = Color3.fromRGB(0, 255, 140)}):Play()
    else
        StatusBtn.Text = "STATUS: OFF"
        TweenService:Create(StatusBtn, tInfo, {BackgroundColor3 = Color3.fromRGB(45, 15, 20), TextColor3 = Color3.fromRGB(255, 75, 90)}):Play()
        TweenService:Create(StatusGlow, tInfo, {Color = Color3.fromRGB(255, 60, 80)}):Play()
        TweenService:Create(UIStroke, tInfo, {Color = Color3.fromRGB(255, 50, 70)}):Play()
    end
end

local function toggleState()
    isEnabled = not isEnabled
    updateVisuals()
end

-- HÀM GIẢ LẬP NHẤP CHUỘT TRÁI
local function autoClickLeftMouse()
    pcall(function()
        local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
        VirtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 0)
    end)
end

-- VÒNG LẶP CHẠY LIÊN TỤC NGAY CẢ KHI BACKGROUND
task.spawn(function()
    while true do
        if isEnabled then
            autoClickLeftMouse()
            task.wait(math.max(0.01, clickDelay))
        else
            task.wait(0.1)
        end
    end
end)

-- PHÍM TẮT & SỰ KIỆN GIAO DIỆN
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.F1 then
        toggleState()
    end
end)

StatusBtn.MouseButton1Click:Connect(toggleState)

SpeedBox.FocusLost:Connect(function()
    local num = tonumber(SpeedBox.Text)
    if num and num > 0 then
        clickDelay = num
    else
        SpeedBox.Text = tostring(clickDelay)
    end
end)
