            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("RevivePP") then
                    if reviveRE then reviveRE:FireServer(p) end
                    if enableReviveRE then enableReviveRE:FireServer(p) end
                end
            end
