local espObjects = {}

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if method == "SetAttribute" and args[1] == "Charges" and Config.AutoLockCharges then
        if self:IsA("Tool") and (self.Name == "Taser" or self.Name == "FireExtinguisher") then
            local setCharges = tonumber(ChargesInput.Text) or 100
            local inputVal = tonumber(args[2])
            if inputVal and inputVal < setCharges then
                return oldNamecall(self, "Charges", setCharges) 
            end
        end
    end

    if method == "FireServer" then
        if Config.AntiSanity and (self.Name == "PlayerLostSanity" or self.Name == "RE/PlayerLostSanity") then return nil end
        if Config.AntiJumpscare and (self.Name == "JumpscareHollow" or self.Name == "JumpscareShadowWithEyesIMG" or self.Name == "Blackscreen") then return nil end
        
        if Config.AutoLockCharges then
            if self.Name == "UseTaser" or self.Name == "TaserFire" or self.Name == "RE/TaserUsed" or 
               self.Name == "UseFireExtinguisher" or self.Name == "ExtinguisherFire" or self.Name == "RE/ExtinguisherUsed" then
                return nil
            end
        end
    end
    return oldNamecall(self, ...)
end)

