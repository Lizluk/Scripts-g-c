local function CreateSlider(name, prop, pos, min, max, default)
-- Nếu không có trong file save, áp dụng mặc định ban đầu
if Config[prop] == nil then
Config[prop] = default
end
local currentVal = Config[prop]

local label = Instance.new("TextLabel", Main); label.Size = UDim2.new(0.9, 0, 0, 18); label.Position = pos
label.Text = name .. ": " .. currentVal; label.TextColor3 = Color3.new(1, 1, 1); label.BackgroundTransparency = 1; label.Font = Enum.Font.GothamMedium; label.TextSize = 12

local sliderFrame = Instance.new("Frame", Main)
sliderFrame.Size = UDim2.new(0.8, 0, 0, 4); sliderFrame.Position = pos + UDim2.new(0.05, 0, 0, 18)
sliderFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 55)

local btn = Instance.new("TextButton", sliderFrame); btn.Size = UDim2.new(0, 14, 0, 14); btn.AnchorPoint = Vector2.new(0.5, 0.5)
btn.Position = UDim2.new((currentVal - min) / (max - min), 0, 0.5, 0); btn.Text = ""; btn.BackgroundColor3 = Color3.fromRGB(0, 255, 150); Instance.new("UICorner", btn)

local dragging = false
btn.MouseButton1Down:Connect(function() dragging = true end)

-- Chỉ lưu cấu hình khi người chơi thả tay chuột/ngón tay (Tối ưu hóa tránh ghi đĩa liên tục)
