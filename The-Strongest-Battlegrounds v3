local function RefreshList()
for _, v in pairs(Scroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
for _, p in pairs(Players:GetPlayers()) do
if p ~= lp then
local isBlacklisted = Blacklist[p.UserId] == true

        local item = Instance.new("Frame", Scroll)
        item.Size = UDim2.new(1, -10, 0, 50)
        item.BackgroundTransparency = 1
        
        -- Nút chọn người chơi chính
        local b = Instance.new("TextButton", item)
        b.Size = UDim2.new(0.75, -5, 1, 0)
        b.Text = ""
        b.BackgroundColor3 = (targetPlayer == p) and Color3.fromRGB(0, 150, 120) or Color3.fromRGB(35, 35, 45)
        Instance.new("UICorner", b)
        
        local img = Instance.new("ImageLabel", b)
        img.Size = UDim2.new(0, 40, 0, 40)
        img.Position = UDim2.new(0, 5, 0, 5)
        img.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
        Instance.new("UICorner", img).CornerRadius = UDim.new(1, 0)
        
        local info = Instance.new("TextLabel", b)
        info.Size = UDim2.new(1, -55, 1, 0)
        info.Position = UDim2.new(0, 50, 0, 0)
        info.BackgroundTransparency = 1
        info.TextXAlignment = Enum.TextXAlignment.Left
        info.Font = Enum.Font.GothamMedium
        info.RichText = true
        
        -- Nếu trong danh sách đen thì tên hiển thị màu đỏ rực
        local tagColor = isBlacklisted and "#FF3333" or "#00FFCC"
        info.Text = "<b>" .. p.DisplayName .. "</b>\n<font color='" .. tagColor .. "'>@" .. p.Name .. "</font>"
        info.TextColor3 = isBlacklisted and Color3.fromRGB(255, 100, 100) or Color3.new(1, 1, 1)
        
        b.MouseButton1Click:Connect(function()
            if not Blacklist[p.UserId] then
                StopMyAnims()
                targetPlayer = p
                RefreshList()
            end
        end)

        -- Nút Blacklist nằm bên phải mỗi dòng
        local blBtn = Instance.new("TextButton", item)
        blBtn.Size = UDim2.new(0.25, 0, 1, 0)
        blBtn.Position = UDim2.new(0.75, 5, 0, 0)
        blBtn.Text = isBlacklisted and "UNBAN" or "BLACK"
        blBtn.BackgroundColor3 = isBlacklisted and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(45, 45, 55)
        blBtn.TextColor3 = Color3.new(1, 1, 1)
        blBtn.Font = Enum.Font.GothamBold
        blBtn.TextSize = 10
        Instance.new("UICorner", blBtn)
        
        blBtn.MouseButton1Click:Connect(function()
            Blacklist[p.UserId] = not Blacklist[p.UserId]
            -- Lưu cấu hình Blacklist ngay khi bấm thay đổi
            SaveSettings()
            
            -- Nếu đang bám mà đưa vào danh sách đen thì hủy bám ngay lập tức
            if Blacklist[p.UserId] and targetPlayer == p then
                targetPlayer = nil
                StopMyAnims()
            end
            RefreshList()
        end)
    end
end


end
