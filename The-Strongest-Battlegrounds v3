-- =============================================
-- LOGIC LƯU VÀ TẢI CẤU HÌNH (SAVE / LOAD CONFIG)
-- =============================================
local function SaveSettings()
local success, encoded = pcall(function()
return HttpService:JSONEncode({
Config = Config,
Blacklist = Blacklist
})
end)
if success and writefile then
writefile(FILE_NAME, encoded)
end
end

local function LoadSettings()
if isfile and isfile(FILE_NAME) and readfile then
local content = readfile(FILE_NAME)
local success, decoded = pcall(function()
return HttpService:JSONDecode(content)
end)
if success and decoded then
if decoded.Config then
for k, v in pairs(decoded.Config) do
Config[k] = v
end
end
if decoded.Blacklist then
-- JSON chuyển Key là Number thành String khi lưu, cần chuyển ngược lại về dạng ID (Number)
for k, v in pairs(decoded.Blacklist) do
local userId = tonumber(k) or k
Blacklist[userId] = v
end
end
end
end
end

-- Tải cấu hình đã lưu trước khi tạo giao diện
LoadSettings()

-- Hàm dọn dẹp động tác cũ và khôi phục tự xoay người
local function StopMyAnims()
local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
if hum then
for _, v in pairs(hum:GetPlayingAnimationTracks()) do v:Stop(0) end
hum.AutoRotate = true -- Khôi phục khả năng xoay hướng tự do
end
end

