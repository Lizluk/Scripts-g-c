    local ohString1 = "Sử dụng1"
    local ohVector32 = Vector3.new(3728.668212890625, 127.35263061523438, 2791.09228515625)
    local ohCFrame3 = CFrame.new(3727.16309, 135.066177, 2762.37427, -0.998629451, 0.0135587566, -0.0505492501, -1.38518549e-17, 0.965858281, 0.259070903, 0.0523360856, 0.258715838, -0.9645347)
    
