local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Flag quản lý trạng thái bật/tắt (mặc định tắt)
local isActive = false

-- 1. Tạo GUI hiển thị trạng thái
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ToggleStatusGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(0, 200, 0, 40)
statusLabel.Position = UDim2.new(0.5, -100, 0.1, 0)
statusLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
statusLabel.TextSize = 16
statusLabel.Font = Enum.Font.SourceSansBold
statusLabel.Text = "Trạng thái: TẮT (X)"
statusLabel.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = statusLabel

-- 2. Hàm thực thi (Đã thêm FireServer)
local function executeAction()
    local ohString1 = "Use1"
    local ohVector32 = Vector3.new(3728.668212890625, 127.35263061523438, 2791.09228515625)
    local ohCFrame3 = CFrame.new(3727.16309, 135.066177, 2762.37427, -0.998629451, 0.0135587566, -0.0505492501, -1.38518549e-17, 0.965858281, 0.259070903, 0.0523360856, 0.258715838, -0.9645347)

    -- Tìm RemoteEvent và thực thi
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("CLIENT_REMOTES") 
        and game:GetService("ReplicatedStorage").CLIENT_REMOTES:FindFirstChild("Fight")

    if remote then
        remote:FireServer(ohString1, ohVector32, ohCFrame3)
    else
        warn("Không tìm thấy RemoteEvent CLIENT_REMOTES.Fight!")
    end
end

-- 3. Lắng nghe sự kiện phím & chuột
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- Bật/Tắt bằng phím X
    if input.KeyCode == Enum.KeyCode.X then
        isActive = not isActive
        if isActive then
            statusLabel.Text = "Trạng thái: BẬT (X)"
            statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            statusLabel.Text = "Trạng thái: TẮT (X)"
            statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    end

    -- Bấm chuột trái -> Gọi 10 luồng song song
    if input.UserInputType == Enum.UserInputType.MouseButton1 and isActive then
        for i = 1, 10 do
            task.spawn(executeAction)
        end
    end
end)
