-- 2. ESP HIGHLIGHT CHỐNG LAG
----------------------------------------------------------------

local function applyHighlight(player, character)
    if not character or player == LocalPlayer then return end
    
    local highlight = character:FindFirstChild("ESPHighlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Parent = character
    end

    if targets[player.Name] then
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.Enabled = true
    elseif player.Name == closestPlayerName then
        highlight.FillColor = Color3.fromRGB(0, 255, 128)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.Enabled = true
    else
        highlight.Enabled = false
    end
end

