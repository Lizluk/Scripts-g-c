-- 3. QUẢN LÝ QUÉT NGƯỜI CHƠI VÀ BẢNG GUI
----------------------------------------------------------------

local buttons = {}

local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 30)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 14
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

            Btn.MouseButton1Click:Connect(function()
                targets[pName] = not targets[pName] and true or nil
            end)

            buttons[pName] = {Button = Btn}
        end
    end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player)
    targets[player.Name] = nil
    buildButtons()
end)
buildButtons()

task.spawn(function()
    while true do
        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        local minDistance = math.huge
        local tempClosest = ""

        if myRoot then
            for pName, btnData in pairs(buttons) do
                local p = Players:FindFirstChild(pName)
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    btnData.Button.LayoutOrder = targets[pName] and (math.floor(dist) - 100000) or math.floor(dist)
                else
                    btnData.Button.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local pName = player.Name
                local btnData = buttons[pName]
                if btnData then
                    local Btn = btnData.Button
                    if targets[pName] then
                        Btn.BackgroundColor3 = killAuraActive and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(160, 120, 30)
                        Btn.Text = pName .. (killAuraActive and " [TARGET]" or " [PAUSED]")
                        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    elseif pName == closestPlayerName then
                        Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                        Btn.Text = "⭐ " .. pName .. " (GẦN NHẤT)"
                        Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
                    else
                        Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                        Btn.Text = pName
                        Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
                    end
                end
                
                if player.Character then
                    applyHighlight(player, player.Character)
                end
            end
        end

        if autoDrinkActive and drinkRemote and interactionsFolder then
            pcall(function()
                local lake = interactionsFolder:FindFirstChild("Lakes") and interactionsFolder.Lakes:FindFirstChild("Lake")
                if lake then drinkRemote:FireServer(lake) end
            end)
        end

        if autoEatActive and foodRemote and interactionsFolder then
            pcall(function()
                local ribs = interactionsFolder:FindFirstChild("Food") and interactionsFolder.Food:FindFirstChild("Ribs")
                if ribs then foodRemote:FireServer(ribs) end
            end)
        end

        task.wait(0.5)
    end
end)

