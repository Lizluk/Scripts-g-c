-- Vòng lặp Kill Aura
task.spawn(function()
    local isLeftJab = true

    while true do
        if killAuraActive and combatRemote then
            local myCharacter = LocalPlayer.Character
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

            if myRoot then
                local hasTargetInRange = false

                for pName, isTargeted in pairs(targets) do
                    if isTargeted then
                        local folder = charactersFolder or workspace
                        local targetCharacter = folder:FindFirstChild(pName) or (Players:FindFirstChild(pName) and Players[pName].Character)
                        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                        
                        if targetRoot then
                            local currentDist = (myRoot.Position - targetRoot.Position).Magnitude
                            if currentDist <= maxDetectDistance then
                                hasTargetInRange = true
                                break
                            end
                        end
                    end
                end

                if hasTargetInRange then
                    pcall(function()
                        local attackType = isLeftJab and "Jab_L" or "Jab_R"
                        combatRemote:FireServer(attackType)
                        isLeftJab = not isLeftJab
                    end)
                end
            end
        end
        task.wait(attackCooldown)
    end
end)

