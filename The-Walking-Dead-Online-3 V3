    -- Bật/Tắt Chế độ X (Sử dụng Use1 khi bấm Chuột trái)
    if input.KeyCode == Enum.KeyCode.X then
        modeX = not modeX
        statusX.Text = modeX and "Chế độ X (Use1): BẬT" or "Chế độ X (Use1): TẮT"
        statusX.TextColor3 = modeX and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
    end

    -- Bật/Tắt Chế độ V (Sử dụng Jab L/R khi bấm Chuột trái)
    if input.KeyCode == Enum.KeyCode.V then
        modeV = not modeV
        statusV.Text = modeV and "Chế độ V (Jab L/R): BẬT" or "Chế độ V (Jab L/R): TẮT"
        statusV.TextColor3 = modeV and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
    end

    -- Keybind P: Ẩn/Hiện Toàn Bộ Menu GUI
    if input.KeyCode == Enum.KeyCode.P then 
        MainFrame.Visible = not MainFrame.Visible 
    end

    -- Keybind Q: Tạm dừng / Tiếp tục Kill Aura
    if input.KeyCode == Enum.KeyCode.Q then
        killAuraActive = not killAuraActive
        if killAuraActive then
            StatusLabel.Text = "KILL AURA: RUNNING [Q]"
            StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            StatusLabel.Text = "KILL AURA: PAUSED [Q]"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        end
    end

    -- Khi nhấn chuột trái (MouseButton1) để thực hiện Combo
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if modeX then
            for i = 1, loopAmount do
                task.spawn(executeX)
            end
        end

        if modeV then
            for i = 1, loopAmount do
                task.spawn(executeV)
            end
        end
    end
end)
