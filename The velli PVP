local function getClosestToCrosshairTarget()
    local myCharacter = getCharacter(LocalPlayer)
    local myRoot = myCharacter and (myCharacter:FindFirstChild("HumanoidRootPart") or myCharacter:FindFirstChild("UpperTorso") or myCharacter:FindFirstChild("Head"))
    if not myRoot then return nil, nil end

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closestHead = nil
    local closestChar = nil
    local shortestDist = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not teammates[player.Name] then
            local pChar = getCharacter(player)
            local pHead = pChar and pChar:FindFirstChild("Head") 
                or pChar and (pChar:FindFirstChild("HumanoidRootPart") or pChar:FindFirstChild("UpperTorso"))
            
            if pHead and pChar then
                local worldDist = (myRoot.Position - pHead.Position).Magnitude
                if worldDist <= crosshairMaxDistance then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(pHead.Position)
                    if onScreen then
                        local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if distToCenter < shortestDist and distToCenter < 300 then
                            shortestDist = distToCenter
                            closestHead = pHead
                            closestChar = pChar
                        end
                    end
                end
            end
        end
    end
    return closestHead, closestChar
end

local function performManualAttack()
    local myCharacter = getCharacter(LocalPlayer)
    local myRoot = myCharacter and (myCharacter:FindFirstChild("HumanoidRootPart") or myCharacter:FindFirstChild("UpperTorso") or myCharacter:FindFirstChild("Head"))

    if myRoot then
        if crosshairAimActive == true then
            if tick() - lastAttackTime < attackCooldown then return end
            local targetHead, targetChar = getClosestToCrosshairTarget()
            if targetHead and targetChar and tryShootRemote then
                pcall(function()
                    local muzzlePos = myRoot.Position + Vector3.new(0, 2, 0)
                    local dirUnit = (targetHead.Position - muzzlePos).Unit

                    local ohTable1 = {
                        [1] = {
                            ["MuzzleDirectionUnit"] = dirUnit,
                            ["BulletImpactPosition"] = targetHead.Position,
                            ["TargetInstance"] = targetHead,
                            ["TargetCFrame"] = targetHead.CFrame,
                            ["TargetSize"] = targetHead.Size,
                            ["Normal"] = Vector3.new(0, 1, 0),
                            ["MuzzlePosition"] = muzzlePos,
                            ["TargetCharacter"] = targetChar
                        }
                    }
                    tryShootRemote:FireServer(ohTable1)
                end)
                lastAttackTime = tick()
                return
            end
        end
    end
end

local function performAutoSkillF3Attack()
    local myCharacter = getCharacter(LocalPlayer)
    local myRoot = myCharacter and (myCharacter:FindFirstChild("HumanoidRootPart") or myCharacter:FindFirstChild("UpperTorso") or myCharacter:FindFirstChild("Head"))

    if not myRoot then return end
    
    if autoSkillF3Active and tick() - lastAttackTime >= attackCooldown and tryShootRemote then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not teammates[player.Name] then
                local pChar = getCharacter(player)
                local pHead = pChar and pChar:FindFirstChild("Head") 
                    or pChar and (pChar:FindFirstChild("HumanoidRootPart") or pChar:FindFirstChild("UpperTorso"))
                
                if pHead and pChar then
                    local dist = (myRoot.Position - pHead.Position).Magnitude
                    if dist <= skillF3Distance then
                        pcall(function()
                            local muzzlePos = myRoot.Position + Vector3.new(0, 2, 0)
                            local dirUnit = (pHead.Position - muzzlePos).Unit

                            local ohTable1 = {
                                [1] = {
                                    ["MuzzleDirectionUnit"] = dirUnit,
                                    ["BulletImpactPosition"] = pHead.Position,
                                    ["TargetInstance"] = pHead,
                                    ["TargetCFrame"] = pHead.CFrame,
                                    ["TargetSize"] = pHead.Size,
                                    ["Normal"] = Vector3.new(0, 1, 0),
                                    ["MuzzlePosition"] = muzzlePos,
                                    ["TargetCharacter"] = pChar
                                }
                            }
                            tryShootRemote:FireServer(ohTable1)
                        end)
                        lastAttackTime = tick()
                        break
                    end
                end
            end
        end
    end

    if tAbilityEvent and #customSkills > 0 then
        if tick() - lastCustomSkillTime >= customSkillCooldown then
            for _, skillData in ipairs(customSkills) do
                if skillData.Enabled then
                    local foundClosePlayer = false
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and not teammates[player.Name] then
                            local pChar = getCharacter(player)
                            local pRoot = pChar and (pChar:FindFirstChild("HumanoidRootPart") or pChar:FindFirstChild("Head"))
                            if pRoot and (myRoot.Position - pRoot.Position).Magnitude <= skillF3Distance then
                                foundClosePlayer = true
                                break
                            end
                        end
                    end

                    if foundClosePlayer then
                        pcall(function()
                            tAbilityEvent:FireServer(skillData.InstanceObj, skillData.CFrameVal)
                        end)
                        lastCustomSkillTime = tick()
                        break
                    end
                end
            end
        end
    end
end

