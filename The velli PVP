local SAVE_FILE_NAME = "LizlukCustomSkills.json"

local function saveSkillsToFile()
    if not writefile then return end
    pcall(function()
        local exportData = {}
        for _, skill in ipairs(customSkills) do
            table.insert(exportData, {
                Name = skill.Name,
                CodeText = skill.CodeText or "",
                Enabled = skill.Enabled
            })
        end
        writefile(SAVE_FILE_NAME, HttpService:JSONEncode(exportData))
    end)
end

local function loadSkillsFromFile()
    if not readfile or not isfile then return end
    pcall(function()
        if isfile(SAVE_FILE_NAME) then
            local rawData = readfile(SAVE_FILE_NAME)
            local decoded = HttpService:JSONDecode(rawData)
            if type(decoded) == "table" then
                for _, data in ipairs(decoded) do
                    local parsedInstance = workspace
                    local parsedCFrame = CFrame.new(0, 0, 0)
                    local rawText = data.CodeText or ""

                    if rawText ~= "" then
                        pcall(function()
                            local func = loadstring([[
                                local workspace = game:GetService("Workspace")
                                local ohInstance1, ohCFrame2
                                ]] .. rawText .. [[
                                return ohInstance1, ohCFrame2
                            ]])
                            if func then
                                local inst, cf = func()
                                if inst then parsedInstance = inst end
                                if cf then parsedCFrame = cf end
                            end
                        end)
                    end

                    table.insert(customSkills, {
                        Name = data.Name or ("Custom Skill " .. (#customSkills + 1)),
                        CodeText = rawText,
                        InstanceObj = parsedInstance,
                        CFrameVal = parsedCFrame,
                        Enabled = data.Enabled ~= false
                    })
                end
            end
        end
    end)
end

