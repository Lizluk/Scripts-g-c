    local customName = SkillNameBox.Text
    if customName == "" then
        customName = "Custom Skill " .. (#customSkills + 1)
    end

    local parsedInstance = workspace
    local parsedCFrame = CFrame.new(0, 0, 0)

    pcall(function()
        local func = loadstring([[
            local workspace = game:GetService("Workspace")
            local ohInstance1, ohCFrame2
            ]] .. rawText .. [[
            return ohInstance1, ohCFrame2
        ]])
        if func then
            local inst, cf = func()
            if inst then parsedInstance = inst end
            if cf then parsedCFrame = cf end
        end
    end)

    table.insert(customSkills, {
        Name = customName,
        CodeText = rawText,
        InstanceObj = parsedInstance,
        CFrameVal = parsedCFrame,
        Enabled = true
    })

    AddSkillBox.Text = ""
