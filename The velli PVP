local buttons = {}

local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 28)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 13
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

            Btn.MouseButton1Click:Connect(function()
                if currentViewMode == "KILL" then
                    teammates[pName] = true
                    targets[pName] = nil
                else
                    teammates[pName] = nil
                end
            end)

            Btn.MouseButton2Click:Connect(function()
                if currentViewMode == "KILL" then
                    targets[pName] = not targets[pName] or nil
                end
            end)

            buttons[pName] = {Button = Btn}
        end
    end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player)
    targets[player.Name] = nil
    teammates[player.Name] = nil
    removeEsp(player.Name)
    buildButtons()
end)
