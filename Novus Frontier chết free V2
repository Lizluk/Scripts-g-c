local key = Enum.KeyCode.F1 -- Phím bấm kích hoạt (Có thể đổi tùy ý)
local player = game.Players.LocalPlayer
local runService = game:GetService("RunService")
local userInputService = game:GetService("UserInputService")

local noclipConnection = nil
local savedPosition = nil -- Biến dùng để lưu lại vị trí cũ trước khi chết

-- Hàm thực hiện làm lag rớt map
local function doFreeFall()
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if hrp and humanoid and humanoid.Health > 0 then
        -- 🔥 BƯỚC QUAN TRỌNG: Lưu lại vị trí chính xác (CFrame) hiện tại trước khi thực hiện tự sát
        savedPosition = hrp.CFrame
        
        -- Thông báo
        game.StarterGui:SetCore("SendNotification", {
            Title = "Hệ thống rơi tự do";
            Duration = 1.5;
            Text = "Đang lưu vị trí và thực hiện lag rớt sàn...";
        })
        
        -- Bước 1: Ép trạng thái rơi để đánh lừa Server game
        humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
        
        -- Bước 2: Đẩy nhẹ nhân vật xuống dưới sàn đất hiện tại để tránh kẹt sàn trên
        hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 15, hrp.Position.Z)
        task.wait(0.05)
        
        -- Bước 3: Bật Noclip vĩnh viễn cho mạng này bằng Stepped (Ép tắt va chạm liên tục)
        if noclipConnection then noclipConnection:Disconnect() end
        noclipConnection = runService.Stepped:Connect(function()
            if character and character:Parent() then
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            else
                if noclipConnection then noclipConnection:Disconnect() end
            end
        end)
        
        -- Bước 4: Tăng tốc độ rơi tự do hướng xuống dưới đáy map (-1000)
        hrp.Velocity = Vector3.new(0, -2000, 0)
    end
end

-- Bộ lắng nghe phím bấm vĩnh viễn (Không bao giờ bị hủy khi chết)
userInputService.InputBegan:Connect(function(input, chat)
    if chat then return end
    if input.KeyCode == key then
        doFreeFall()
    end
end)

-- 🔥 TỰ ĐỘNG RESET VÀ ĐƯA BẠN QUAY LẠI VỊ TRÍ CŨ KHI HỒI SINH
player.CharacterAdded:Connect(function(newCharacter)
    -- Dọn dẹp noclip cũ
    if noclipConnection then 
        noclipConnection:Disconnect() 
        noclipConnection = nil
    end
    
    -- Kiểm tra nếu trước đó bạn có lưu vị trí
    if savedPosition then
        -- Chờ HumanoidRootPart của nhân vật mới xuất hiện hoàn toàn
        local newHrp = newCharacter:WaitForChild("HumanoidRootPart", 5)
        if newHrp then
            -- Đợi thêm một chút siêu ngắn để tránh lỗi văng ngược do game chưa load xong map
            task.wait(0.1) 
            
            -- Dịch chuyển bạn về đúng tọa độ cũ
            newHrp.CFrame = savedPosition
            
            -- Thông báo cho bạn biết đã quay lại vị trí cũ thành công
            game.StarterGui:SetCore("SendNotification", {
                Title = "Hệ thống dịch chuyển";
                Duration = 1.5;
                Text = "Đã đưa bạn quay lại vị trí cũ thành công!";
            })
            
            -- Xóa bộ nhớ vị trí cũ để tránh bị dịch chuyển nhầm cho những lần chết tự nhiên khác
            savedPosition = nil 
        end
    end
end)
