-- Dữ liệu Quest gốc từ RemoteSpy của bạn
local questData = {
    ["Name"] = "Buy 5 sheep !",
    ["RequiredLevel"] = 0,
    ["MaxProgress"] = 5,
    ["Description"] = "Buy a sheep",
    ["Reward"] = {
        ["Coins"] = 40
    }
}

-- Biến kiểm soát trạng thái vòng lặp
local isRunning = false 
local stopRequested = false -- Tín hiệu báo dừng khẩn cấp

StartBtn.MouseButton1Click:Connect(function()
    if isRunning then return end -- Chặn bấm liên tục khi đang chạy
    
    local loopCount = tonumber(InputBox.Text)
    
    if loopCount and loopCount > 0 then
        isRunning = true
        stopRequested = false -- Reset trạng thái dừng
        
        -- Cập nhật giao diện nút Bắt đầu
        StartBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
        StartBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
        StartBtn.Text = "⌛ ĐANG CHẠY..."
        
        -- Làm sáng nút Dừng để báo hiệu có thể bấm được
        StopBtn.BackgroundColor3 = Color3.fromRGB(220, 40, 40)
        StopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        task.spawn(function()
            local remote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("E_RewardQuest")
            
            if remote then
                for i = 1, loopCount do
                    -- Kiểm tra xem người dùng có bấm nút DỪNG hay không
                    if stopRequested then 
                        print("🛑 Đã dừng vòng lặp theo yêu cầu tại lượt thứ: " .. i)
                        break 
                    end
                    
                    pcall(function()
                        remote:FireServer(questData)
                    end)
                    
                    -- Nghỉ một chút sau mỗi 500 lần bắn gói tin để tránh crash
                    if i % 500 == 0 then
                        task.wait()
                    end
                end
                if not stopRequested then
                    print("✅ Hoàn thành chạy lệnh đủ " .. loopCount .. " lần!")
                end
            else
                warn("❌ Không tìm thấy Remote Event 'E_RewardQuest'!")
            end
            
            -- Khôi phục lại trạng thái ban đầu cho cả 2 nút bấm
            isRunning = false
            StartBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
            StartBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            StartBtn.Text = "🚀 BẮT ĐẦU CHẠY"
            
            StopBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
            StopBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end)
    else
        InputBox.Text = "Vui lòng nhập số hợp lệ!"
        task.wait(1.5)
        InputBox.Text = "10000"
    end
end)

-- Sự kiện khi bấm nút DỪNG LẠI
StopBtn.MouseButton1Click:Connect(function()
    if isRunning then
        stopRequested = true
        StopBtn.Text = "⌛ ĐANG DỪNG..."
        StopBtn.BackgroundColor3 = Color3.fromRGB(80, 40, 40)
    end
end)

-- Phím tắt ẩn giao diện nhanh
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.J then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

