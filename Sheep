-- Dữ liệu Quest
local questData = {
    ["Name"] = "Buy 5 sheep !",
    ["RequiredLevel"] = 0,
    ["MaxProgress"] = 5,
    ["Description"] = "Buy a sheep",
    ["Reward"] = {
        ["Coins"] = 40
    }
}

local isSpawning = false

StartBtn.MouseButton1Click:Connect(function()
    if isSpawning then return end
    
    local totalCount = tonumber(InputBox.Text)
    
    if totalCount and totalCount > 0 then
        isSpawning = true
        
        local remote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("E_RewardQuest")
        
        if remote then
            task.spawn(function()
                -- Cấu hình tối ưu chống lag:
                local batchSize = 150 -- Số lượng gói tin gửi trong mỗi đợt (Khuyên dùng từ 100 - 200)
                local sentCount = 0
                
                while sentCount < totalCount do
                    -- Tính toán số lượng cần gửi trong đợt này
                    local currentBatch = math.min(batchSize, totalCount - sentCount)
                    
                    -- Gửi trực tiếp trong vòng lặp kín (Bỏ task.spawn bên trong để tiết kiệm CPU)
                    for i = 1, currentBatch do
                        pcall(function()
                            remote:FireServer(questData)
                        end)
                    end
                    
                    sentCount = sentCount + currentBatch
                    
                    -- Cập nhật tiến độ trực tiếp lên nút bấm cho bạn theo dõi
                    StartBtn.Text = "⌛ ĐANG XỬ LÝ: " .. sentCount .. "/" .. totalCount
                    StartBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
                    
                    -- Nghỉ đúng 1 khung hình (khoảng 0.016 giây) để GPU giải phóng bộ nhớ, chống tụt FPS
                    task.wait() 
                end
                
                print("✅ Đã xử lý thành công " .. totalCount .. " gói tin mà không gây lag!")
                
                -- Khôi phục nút bấm sau khi hoàn tất
                isSpawning = false
                StartBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
                StartBtn.Text = "🚀 CHẠY MƯỢT MÀ (ANTI-LAG)"
            end)
        else
            warn("❌ Không tìm thấy Remote Event!")
            isSpawning = false
        end
    else
        InputBox.Text = "Nhập số hợp lệ!"
        task.wait(1)
        InputBox.Text = "5000"
    end
end)

