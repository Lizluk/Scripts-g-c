StatusLabel.Parent = MainFrame

-- Dữ liệu Quest gốc của bạn
local questData = {
    ["Name"] = "Buy 5 sheep !",
    ["RequiredLevel"] = 0,
    ["MaxProgress"] = 5,
    ["Description"] = "Buy a sheep",
    ["Reward"] = {
        ["Coins"] = 40
    }
}

local isSpawning = false

StartBtn.MouseButton1Click:Connect(function()
    if isSpawning then return end
    
    local spawnCount = tonumber(InputBox.Text)
    
    if spawnCount and spawnCount > 0 then
        isSpawning = true
        StartBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
        StartBtn.Text = "⚡ ĐANH KÍCH HOẠT..."
        
        local remote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("E_RewardQuest")
        
        if remote then
            -- Sử dụng cấu trúc giải phóng bộ nhớ để tạo toàn bộ luồng trong 1 tích tắc
            for i = 1, spawnCount do
                task.spawn(function()
                    pcall(function()
                        remote:FireServer(questData)
                    end)
                end)
            end
            print("⚡ Đã kích nổ đồng thời " .. spawnCount .. " gói tin lên Server!")
        else
            warn("❌ Không tìm thấy Remote Event!")
        end
        
        -- Reset lại nút ngay lập tức vì không phải chờ đợi vòng lặp
        task.wait(0.5)
        isSpawning = false
        StartBtn.BackgroundColor3 = Color3.fromRGB(255, 85, 0)
        StartBtn.Text = "⚡ KÍCH HOẠT ĐỒNG THỜI"
    else
        InputBox.Text = "Nhập số hợp lệ!"
        task.wait(1)
        InputBox.Text = "1000"
    end
end)

-- Phím tắt ẩn giao diện nhanh
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.J then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

print("🔥 Script Instant Multi-Spawn đã kích hoạt thành công!")
