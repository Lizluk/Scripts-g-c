                b.BackgroundColor3 = (targetEntity == npc) and Color3.fromRGB(0, 150, 120) or Color3.fromRGB(35, 35, 45); Instance.new("UICorner", b)
                
                -- Tạo text đại diện thay cho Avatar vì NPC không có UserId
