            b.BackgroundColor3 = (targetEntity == p) and Color3.fromRGB(0, 150, 120) or Color3.fromRGB(35, 35, 45); Instance.new("UICorner", b)
            
            local img = Instance.new("ImageLabel", item); img.Size = UDim2.new(0, 40, 0, 40); img.Position = UDim2.new(0, 5, 0, 5)
            img.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48); Instance.new("UICorner", img).CornerRadius = UDim.new(1, 0)
            
            local info = Instance.new("TextLabel", item); info.Size = UDim2.new(1, -60, 1, 0); info.Position = UDim2.new(0, 55, 0, 0)
            info.Text = "<b>" .. p.DisplayName .. "</b>\n<font color='#00FFCC'>@Player</font>"; info.RichText = true; info.TextColor3 = Color3.new(1,1,1); info.BackgroundTransparency = 1; info.TextXAlignment = Enum.TextXAlignment.Left; info.Font = Enum.Font.GothamMedium
            
            b.MouseButton1Click:Connect(function() 
                ResetCharacterState() 
                targetEntity = p 
                RefreshList() 
            end)
        end
    end

    -- 2. THÊM NPC TỪ THƯ MỤC workspace.NPCs VÀO DANH SÁCH
    local npcFolder = workspace:FindFirstChild("NPCs")
    if npcFolder then
        for _, npc in pairs(npcFolder:GetChildren()) do
