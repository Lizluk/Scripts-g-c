-- =============================================
-- LOGIC CORE SYNC V48 (FIX HOÀN TOÀN LỖI XOAY)
-- =============================================
RunService.Stepped:Connect(function()
    if not active or not targetEntity then return end
    
    -- Kiểm tra mục tiêu là Player hay là Model NPC để lấy Character đích danh
    local tChar = nil
    if targetEntity:IsA("Player") then
        tChar = targetEntity.Character
    elseif targetEntity:IsA("Model") then
        tChar = targetEntity
    end
    
    local myChar = lp.Character
    if not myChar or not tChar then return end
    
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local tHrp = tChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    local tHum = tChar:FindFirstChildOfClass("Humanoid")

    if myHrp and tHrp and myHum and tHum then
        local myAnimator = myHum:FindFirstChildOfClass("Animator") or myHum:AddField("Animator", Instance.new("Animator", myHum))
        local tAnimator = tHum:FindFirstChildOfClass("Animator")

        -- 1. PHYSICS MIMIC 
        myHum.AutoRotate = false -- Tạm thời khóa khi đang bắt chước để không lệch góc ép
        if myHum:GetState() ~= tHum:GetState() then 
            myHum:ChangeState(tHum:GetState()) 
        end

        local goalCF = tHrp.CFrame * CFrame.new(Config.R, Config.H, -Config.F)
        if faceEachOther then 
            goalCF = goalCF * CFrame.Angles(0, math.pi, 0) 
        end
        
        myHrp.CFrame = myHrp.CFrame:Lerp(goalCF, Config.S/100)
        myHrp.AssemblyLinearVelocity = Vector3.zero
        myHrp.AssemblyAngularVelocity = Vector3.zero

        -- 2. QUÉT VÀ ÉP CHỐNG ĐƠ ANIMATION
        local tTracks = tAnimator and tAnimator:GetPlayingAnimationTracks() or tHum:GetPlayingAnimationTracks()
        local currentTargetIds = {}

        for _, tt in pairs(tTracks) do
            if tt.Animation and tt.Animation.AnimationId then
                local animId = string.match(tt.Animation.AnimationId, "%d+") or tt.Animation.AnimationId
                currentTargetIds[animId] = tt
                
                local myTrack = activeTracks[animId]
                
                if not myTrack or not myTrack.IsPlaying then
                    local success, newTrack = pcall(function()
                        return myAnimator:LoadAnimation(tt.Animation)
                    end)
                    if success and newTrack then
                        newTrack.Priority = tt.Priority
                        newTrack:Play(0.05)
                        activeTracks[animId] = newTrack
                        lastTimePosition[animId] = tt.TimePosition
                    end
                    myTrack = activeTracks[animId]
                end
                
                if myTrack then
                    myTrack:AdjustWeight(tt.WeightCurrent, 0.05)
                    myTrack:AdjustSpeed(tt.Speed)
                    
                    if lastTimePosition[animId] and myTrack.TimePosition == lastTimePosition[animId] and tt.TimePosition ~= lastTimePosition[animId] then
                        myTrack:Play(0)
                        myTrack.TimePosition = tt.TimePosition
                    end
                    
                    if math.abs(myTrack.TimePosition - tt.TimePosition) > 0.1 then
                        myTrack.TimePosition = tt.TimePosition
                    end
                    
                    lastTimePosition[animId] = myTrack.TimePosition
                end
            end
        end

        for animId, myTrack in pairs(activeTracks) do
            if not currentTargetIds[animId] then
                myTrack:Stop(0.05)
                activeTracks[animId] = nil
                lastTimePosition[animId] = nil
            end
        end

        -- Vô hiệu hóa va chạm
        for _, part in pairs(myChar:GetChildren()) do 
            if part:IsA("BasePart") then 
                part.CanCollide = false 
            end 
        end
    end
end)
