-- Hàm dọn dẹp động tác cũ và KHÔI PHỤC VẬT LÝ GỐC
local function ResetCharacterState()
    local myChar = lp.Character
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if hum then
        -- 1. Trả lại quyền tự xoay theo hướng chuột/camera cho nhân vật của bạn
        hum.AutoRotate = true 
        
        -- 2. Dừng toàn bộ animation đang bắt chước
        local animator = hum:FindFirstChildOfClass("Animator") or hum
        for _, v in pairs(animator:GetPlayingAnimationTracks()) do 
            v:Stop(0.05) 
        end
    end
    
    -- 3. Bật lại va chạm (Collision) cho nhân vật
    if myChar then
        for _, part in pairs(myChar:GetChildren()) do 
            if part:IsA("BasePart") then 
                part.CanCollide = true 
            end 
        end
    end
    
    table.clear(activeTracks)
    table.clear(lastTimePosition)
end

