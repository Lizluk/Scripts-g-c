                txtLabel.Text = "NPC"; txtLabel.BackgroundColor3 = Color3.fromRGB(60, 60, 75); txtLabel.TextColor3 = Color3.new(1, 1, 0)
                txtLabel.Font = Enum.Font.GothamBold; txtLabel.TextSize = 12; Instance.new("UICorner", txtLabel).CornerRadius = UDim.new(1, 0)

                local info = Instance.new("TextLabel", item); info.Size = UDim2.new(1, -60, 1, 0); info.Position = UDim2.new(0, 55, 0, 0)
                info.Text = "<b>" .. npc.Name .. "</b>\n<font color='#FFFF00'>@Workspace.NPCs</font>"; info.RichText = true; info.TextColor3 = Color3.new(1,1,1); info.BackgroundTransparency = 1; info.TextXAlignment = Enum.TextXAlignment.Left; info.Font = Enum.Font.GothamMedium
                
                b.MouseButton1Click:Connect(function() 
                    ResetCharacterState() 
                    targetEntity = npc 
