-- Phím tắt bàn phím (G bật/tắt, [ hạ thấp, ] nâng cao, RightShift ẩn/hiện GUI)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.G then
		config.enabled = not config.enabled
		refreshToggleUI()
		saveConfig()
	elseif input.KeyCode == Enum.KeyCode.LeftBracket then
		changeOffset(-0.1)
	elseif input.KeyCode == Enum.KeyCode.RightBracket then
		changeOffset(0.1)
	elseif input.KeyCode == Enum.KeyCode.RightShift then
		screenGui.Enabled = not screenGui.Enabled
	end
end)

-- Quét mực nước Terrain
local function getWaterSurfaceY(pos: Vector3): number?
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if not terrain then return nil end

	local minX = math.floor((pos.X - 4) / 4) * 4
	local maxX = math.floor((pos.X + 4) / 4) * 4
	local minZ = math.floor((pos.Z - 4) / 4) * 4
	local maxZ = math.floor((pos.Z + 4) / 4) * 4

	local minBound = Vector3.new(minX, math.floor((pos.Y - 20) / 4) * 4, minZ)
	local maxBound = Vector3.new(maxX, math.floor((pos.Y + 6) / 4) * 4, maxZ)

	local region = Region3.new(minBound, maxBound):ExpandToGrid(4)
	local materials, _ = terrain:ReadVoxels(region, 4)
	local size = materials.Size

	local highestWaterTop: number? = nil
	for x = 1, size.X do
		for y = size.Y, 1, -1 do
			for z = 1, size.Z do
				if materials[x][y][z] == Enum.Material.Water then
					local voxelTopY = region.CFrame.Position.Y - (region.Size.Y / 2) + (y * 4)
					if not highestWaterTop or voxelTopY > highestWaterTop then
						highestWaterTop = voxelTopY
					end
					break
				end
			end
		end
	end

	return highestWaterTop
end

-- Vòng lặp cập nhật vị trí sàn đỡ
RunService.Heartbeat:Connect(function()
	if not pad or not pad.Parent then
		pad.Parent = workspace
	end

	if not config.enabled then
		pad.CanCollide = false
		pad.Position = Vector3.new(0, -5000, 0)
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		pad.CanCollide = false
		return
	end

	local waterY = getWaterSurfaceY(root.Position)
	if waterY and root.Position.Y >= waterY - 4 then
		local targetTopY = waterY + config.offsetY
		pad.CanCollide = true
		pad.Position = Vector3.new(root.Position.X, targetTopY - (pad.Size.Y / 2), root.Position.Z)
	else
		pad.CanCollide = false
		pad.Position = Vector3.new(0, -5000, 0)
	end
end)
