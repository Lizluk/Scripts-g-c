    if input.KeyCode == Enum.KeyCode.F then MainFrame.Visible = not MainFrame.Visible end
    if input.KeyCode == Enum.KeyCode.L then autoDrinkActive = not autoDrinkActive updateUtilityVisuals() end
    if input.KeyCode == Enum.KeyCode.K then autoEatActive = not autoEatActive updateUtilityVisuals() end
    if input.KeyCode == Enum.KeyCode.E then
        killAuraActive = not killAuraActive
        if killAuraActive then
            StatusLabel.Text = "KILL AURA: RUNNING [E]"
            StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            StatusLabel.Text = "KILL AURA: PAUSED [E]"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        end
    end
end)

