-- 3. ĐỒNG BỘ REALTIME & CHẠY HAI REMOTE SÁT THƯƠNG CÙNG LÚC
----------------------------------------------------------------

local buttons = {}

local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name
            
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 30)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 14
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                targets[pName] = not targets[pName]
            end)

            buttons[pName] = Btn
        end
    end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player)
    targets[player.Name] = nil
    buildButtons()
end)
buildButtons()

task.spawn(function()
    while true do
        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        local minDistance = math.huge
        local tempClosest = ""

        if myRoot then
            for pName, Btn in pairs(buttons) do
                local p = Players:FindFirstChild(pName)
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    
                    if targets[pName] then
                        Btn.LayoutOrder = math.floor(dist) - 100000
                    else
                        Btn.LayoutOrder = math.floor(dist)
                    end
                else
                    Btn.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        -- Cập nhật màu sắc nút (Đã tối ưu hóa tương phản từ ảnh image_9f2229.jpg)
        for pName, Btn in pairs(buttons) do
            if targets[pName] then
                if killAuraActive then
                    Btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                    Btn.Text = pName .. " [KILLING]"
                else
                    Btn.BackgroundColor3 = Color3.fromRGB(160, 120, 30)
                    Btn.Text = pName .. " [PAUSED]"
                end
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            elseif pName == closestPlayerName then
                -- FIX: Dùng nền cực tối và chữ màu xanh lá sáng, loại bỏ hoàn toàn Stroke gây lóa chữ
                Btn.BackgroundColor3 = Color3.fromRGB(15, 35, 25) 
                Btn.Text = "⭐ " .. pName .. " (GẦN NHẤT)"
                Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
            else
                Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                Btn.Text = pName
                Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end

        -- KÍCH HOẠT ĐỒNG THỜI 2 REMOTE SÁT THƯƠNG
        if killAuraActive then
            for pName, isTargeted in pairs(targets) do
                if isTargeted then
                    local targetCharacter = charactersFolder:FindFirstChild(pName)
                    if targetCharacter then
                        pcall(function()
                            local ohTable1 = {[1] = targetCharacter}
                            damageRemote:FireServer(ohTable1) -- Remote 1
                            breathRemote:FireServer(ohTable1) -- Remote 2 (Mới thêm)
                        end)
                    end
                end
            end
        end

        -- Tự động uống
        if autoDrinkActive then
            pcall(function()
                local lake = interactionsFolder:FindFirstChild("Lakes") and interactionsFolder.Lakes:FindFirstChild("Lake")
                if lake then drinkRemote:FireServer(lake) end
            end)
        end

        -- Tự động ăn
        if autoEatActive then
            pcall(function()
                local ribs = interactionsFolder:FindFirstChild("Food") and interactionsFolder.Food:FindFirstChild("Ribs")
                if ribs then foodRemote:FireServer(ribs) end
            end)
        end

        task.wait(0.1)
    end
end)
