-- Khởi tạo biến trạng thái
local Options = Fluent.Options
local ToggleStates = {
    KillAura = false,
    AutoDrink = false,
    AutoFood = false
}
local AuraDistance = 20 -- Khoảng cách mặc định cho Kill Aura

-- Các hàm xử lý Logic từ Remote của bạn
local LocalPlayer = game:GetService("Players").LocalPlayer

local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = AuraDistance

    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            -- Tìm mô hình nhân vật trong workspace dựa trên tên người chơi
            local characterModel = workspace.Characters:FindFirstChild(player.Name)
            if characterModel and characterModel:FindFirstChild("Humanoid") and characterModel.Humanoid.Health > 0 then
                local distance = (LocalPlayer.Character.HumanoidRootPart.Position - characterModel.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    closestPlayer = characterModel
                    shortestDistance = distance
                end
            end
        end
    end
    return closestPlayer
end

-- Vòng lặp chạy ngầm cho các chức năng (Sử dụng Task để tối ưu hóa)
task.spawn(function()
    while task.wait(0.1) do
        -- 1. Xử lý Kill Aura
        if ToggleStates.KillAura then
            local target = getClosestPlayer()
            if target then
                local ohTable1 = { [1] = target }
                game:GetService("ReplicatedStorage").Remotes.CharactersDamageRemote:FireServer(ohTable1)
            end
        end

        -- 2. Xử lý Tự động uống nước
        if ToggleStates.AutoDrink then
            local lake = workspace.Interactions.Lakes:FindFirstChild("Lake")
            if lake then
                game:GetService("ReplicatedStorage").Remotes.DrinkRemote:FireServer(lake)
            end
        end

        -- 3. Xử lý Tự động ăn thức ăn
        if ToggleStates.AutoFood then
            local fruit = workspace.Interactions.Food:FindFirstChild("Fruit")
            if fruit then
                game:GetService("ReplicatedStorage").Remotes.Food:FireServer(fruit)
            end
        end
    end
end)

