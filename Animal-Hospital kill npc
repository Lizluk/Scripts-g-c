-- 2. HÀM KÍCH HOẠT REMOTE SUNG CHO NPC
local function shootNPC(npcModel)
    if not npcModel then return end
    local ohVector31 = Vector3.new(-104.44049835205078, 4.774374008178711, -6.360236644744873)
    local ohInstance2 = npcModel:FindFirstChild("Head.002") or npcModel:FindFirstChild("Head") or npcModel:FindFirstChild("HumanoidRootPart")
    
    if ohInstance2 then
        local remote = ReplicatedStorage:FindFirstChild("Util") and ReplicatedStorage.Util:FindFirstChild("Net") and ReplicatedStorage.Util.Net:FindFirstChild("RE/PlayShootEffect")
        if remote then
            remote:FireServer(ohVector31, ohInstance2)
            print("🤖 Đã bắn NPC: " .. npcModel.Name)
        end
    end
end

-- HÀM KÍCH HOẠT REMOTE SUNG CHO NGƯỜI CHƠI THẬT (VÀO FACE)
local function shootPlayer(targetPlr)
    if not targetPlr or not targetPlr.Character then return end
    local char = targetPlr.Character
    
    -- Tọa độ chuẩn xác từ log mới của bạn
    local ohVector31 = Vector3.new(-105.00645446777344, 4.289616584777832, 0.588221549987793)
    
    -- Ưu tiên tìm mục tiêu trong CharacterModel hoặc trực tiếp trong Character
    local ohInstance2 = char:FindFirstChild("Face", true) 
        or char:FindFirstChild("CharacterModel") and char.CharacterModel:FindFirstChild("Face")
        or char:FindFirstChild("Head") 
        or char:FindFirstChild("HumanoidRootPart")
        
    if ohInstance2 then
        local remote = ReplicatedStorage:FindFirstChild("Util") and ReplicatedStorage.Util:FindFirstChild("Net") and ReplicatedStorage.Util.Net:FindFirstChild("RE/PlayShootEffect")
        if remote then
            remote:FireServer(ohVector31, ohInstance2)
            print("👤 Đã bắn Player: " .. targetPlr.Name .. " vào mục tiêu: " .. ohInstance2.Name)
        end
    end
end

-- 3. HÀM TẠO ESP CHỮ CHO NPC
local function createESPTag(npcModel)
    if not npcModel or npcModel:FindFirstChild("NPC_ESP_Tag") then return end
    local head = npcModel:FindFirstChild("Head") or npcModel:FindFirstChild("Head.002") or npcModel:FindFirstChildOfClass("BasePart")
    if not head then return end
    
    local BillboardGui = Instance.new("BillboardGui")
    BillboardGui.Name = "NPC_ESP_Tag"
    BillboardGui.Size = UDim2.new(0, 150, 0, 30)
    BillboardGui.AlwaysOnTop = true
    BillboardGui.ExtentsOffset = Vector3.new(0, 2.5, 0)
    BillboardGui.Adornee = head
    BillboardGui.Parent = npcModel

    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.BackgroundTransparency = 1
    TextLabel.Text = "[NPC] " .. npcModel.Name
    TextLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
    TextLabel.TextSize = 12
    TextLabel.Font = Enum.Font.SourceSansBold
    TextLabel.TextStrokeTransparency = 0
    TextLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TextLabel.Parent = BillboardGui
end

-- 4. HÀM TẠO CARD HIỂN THỊ DÒNG TÊN TRÊN MENU
local function createListRow(nameText, onClickCallback, isPlayerRow)
    local RowFrame = Instance.new("Frame")
    RowFrame.Size = UDim2.new(1, -5, 0, 38)
    RowFrame.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
    RowFrame.BorderSizePixel = 0
    RowFrame.Parent = ScrollFrame
    
    local RowCorner = Instance.new("UICorner")
    RowCorner.CornerRadius = UDim.new(0, 6)
    RowCorner.Parent = RowFrame
    
    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(1, -15, 1, 0)
    NameLabel.Position = UDim2.new(0, 15, 0, 0)
    NameLabel.Text = (isPlayerRow and "👤 " or "🤖 ") .. nameText
    NameLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    NameLabel.TextSize = 12
    NameLabel.Font = Enum.Font.SourceSansBold
    NameLabel.TextXAlignment = Enum.TextXAlignment.Left
    NameLabel.BackgroundTransparency = 1
    NameLabel.Parent = RowFrame
    
    local ClickBtn = Instance.new("TextButton")
    ClickBtn.Size = UDim2.new(1, 0, 1, 0)
    ClickBtn.BackgroundTransparency = 1
    ClickBtn.Text = ""
    ClickBtn.Parent = RowFrame
    
    ClickBtn.MouseEnter:Connect(function()
        RowFrame.BackgroundColor3 = Color3.fromRGB(48, 55, 65)
        NameLabel.TextColor3 = isPlayerRow and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(0, 255, 150)
    end)
    
    ClickBtn.MouseLeave:Connect(function()
        RowFrame.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
        NameLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    end)
    
    ClickBtn.MouseButton1Click:Connect(function()
        RowFrame.BackgroundColor3 = isPlayerRow and Color3.fromRGB(150, 100, 0) or Color3.fromRGB(0, 100, 50)
        task.wait(0.1)
        RowFrame.BackgroundColor3 = Color3.fromRGB(48, 55, 65)
        onClickCallback()
    end)
end

-- 5. HÀM UPDATE CHÍNH XÁC DANH SÁCH THEO TAB THỰC TẾ
local function updateMainList()
    -- Xóa sạch các card cũ trên giao diện
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    if currentTab == "NPC" then
        -- XỬ LÝ QUÉT TAB NPC
        local npcsFolder = Workspace:FindFirstChild("NPCs")
        if npcsFolder then
            for _, npc in ipairs(npcsFolder:GetChildren()) do
                if npc:IsA("Model") or npc:IsA("Folder") or npc:IsA("BasePart") then
                    createESPTag(npc) -- Tạo ESP trên đầu
                    createListRow(npc.Name, function()
                        shootNPC(npc)
                    end, false)
                end
            end
        end
    elseif currentTab == "PLAYER" then
        -- XỬ LÝ QUÉT TAB PLAYERS THỰC
        clearOldESP() -- Tắt bớt ESP NPC khi sang tab người chơi cho đỡ rối mắt
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then -- Không hiện tên bản thân lên danh sách bắn
                createListRow(player.Name, function()
                    shootPlayer(player)
                end, true)
            end
        end
    end
end

