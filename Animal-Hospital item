-- 3. HÀM QUÉT ẢNH THÔNG MINH (Quét trực tiếp từ UI game và Workspace)
local function getLiveIcon(itemName)
    -- Bước 1: Quét từ bảng minigame/TV/Report đang hiển thị trong các phòng trước
    local roomsFolder = Workspace:FindFirstChild("Rooms")
    if roomsFolder then
        for _, zone in ipairs(roomsFolder:GetChildren()) do
            for _, room in ipairs(zone:GetChildren()) do
                local inv = room:FindFirstChild("Minigame") and room.Minigame:FindFirstChild("TV") 
                    and room.Minigame.TV:FindFirstChild("Screen") and room.Minigame.TV.Screen:FindFirstChild("UI")
                    and room.Minigame.TV.Screen.UI:FindFirstChild("Report") and room.Minigame.TV.Screen.UI.Report:FindFirstChild("inv")
                
                if inv then
                    local targetUI = inv:FindFirstChild(itemName)
                    if targetUI and targetUI:IsA("ImageLabel") and targetUI.Image ~= "" then
                        return targetUI.Image
                    end
                end
            end
        end
    end

    -- Bước 2: Quét từ Billboard của item thực tế nằm dưới sàn
    -- Riêng Medicine chặn không cho lấy nhầm từ model 'Organ'
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == itemName and (desc:IsA("Model") or desc:IsA("Folder") or desc:IsA("BasePart")) then
            if itemName == "Medicine" and desc.Parent and desc.Parent.Name == "Organ" then
                continue -- bỏ qua nếu bị lồng nhầm vào asset tim
            end
            local billboard = desc:FindFirstChildOfClass("BillboardGui") or desc:FindFirstChild("BillboardGui", true)
            if billboard then
                local img = billboard:FindFirstChildOfClass("ImageLabel")
                if img and img.Image ~= "" then 
                    return img.Image 
                end
            end
        end
    end

    -- Ảnh tạm thời khi chưa quét thấy (Dùng dấu hỏi chấm hệ thống hoặc icon gốc của game)
    return "rbxassetid://6034287525" 
end

