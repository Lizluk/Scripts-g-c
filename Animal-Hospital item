-- 4. Hàm Dịch Chuyển Hút Đồ
local isTeleporting = false
local function teleportAndGrab(itemName)
    if isTeleporting or not itemName then return false end
    
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart or not fireproximityprompt then return false end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("ProximityPrompt") then
            local parentName = object.Parent and object.Parent.Name
            local objectText = object.ObjectText
            local grandParentName = object.Parent and object.Parent.Parent and object.Parent.Parent.Name
            
            if parentName == itemName or objectText == itemName or grandParentName == itemName then
                isTeleporting = true
                local oldCFrame = rootPart.CFrame
                local targetCFrame = object.Parent:IsA("Model") and object.Parent:GetModelCFrame() or object.Parent.CFrame
                
                rootPart.CFrame = targetCFrame
                task.wait(0.15)
                
                fireproximityprompt(object)
                task.wait(0.08)
                
                rootPart.CFrame = oldCFrame
                task.wait(0.1)
                isTeleporting = false
                return true
            end
        end
    end
    isTeleporting = false
    return false
end

-- 5. Hàm quét TV một lần duy nhất
local function runOneShotTVGrab(roomNumber, buttonObject, strokeObject, numLabel)
    task.spawn(function()
        local roomsFolder = Workspace:FindFirstChild("Rooms")
        local targetFolder = nil
        
        if roomNumber >= 1 and roomNumber <= 5 then
            targetFolder = roomsFolder and roomsFolder:FindFirstChild("Medical")
        elseif roomNumber >= 6 and roomNumber <= 8 then
            targetFolder = roomsFolder and roomsFolder:FindFirstChild("Emergency")
        end
        
        local roomObj = targetFolder and targetFolder:FindFirstChild("Room" .. roomNumber)
        local minigame = roomObj and roomObj:FindFirstChild("Minigame")
        local tv = minigame and minigame:FindFirstChild("TV")
        local screen = tv and tv:FindFirstChild("Screen")
        local ui = screen and screen:FindFirstChild("UI")
        local report = ui and ui:FindFirstChild("Report")
        local inv = report and report:FindFirstChild("inv")
        
        if inv then
            for _, itemUI in ipairs(inv:GetChildren()) do
                if (itemUI:IsA("ImageLabel") or itemUI:IsA("Frame")) and itemUI.Visible == true and itemUI.Name ~= "UIGridLayout" then
                    local checkIcon = itemUI:FindFirstChild("check")
                    local isAlreadyDone = checkIcon and checkIcon.Visible == true
                    
                    if not isAlreadyDone then
                        print("🛒 [One-Shot] Đang gom: " .. itemUI.Name .. " - Phòng " .. roomNumber)
                        teleportAndGrab(itemUI.Name)
                        task.wait(0.3)
                    end
                end
            end
        else
            print("❌ Không tìm thấy màn hình TV của Phòng " .. roomNumber)
        end
        
        roomToggleState[roomNumber] = false
        buttonObject.BackgroundColor3 = Color3.fromRGB(32, 38, 34)
        numLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        strokeObject.Color = Color3.fromRGB(0, 180, 100)
        print("✅ Phòng " .. roomNumber .. " xử lý xong!")
    end)
end

