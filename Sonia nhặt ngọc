--======================================================================
-- HÀM TẠO NÚT BẤM NHẶT ĐỒ (CÓ HIỆU ỨNG TƯƠNG TÁC)
--======================================================================
local function createPickupButton(pearlName, displayName, btnColor, order)
    local button = Instance.new("TextButton")
    button.Name = pearlName
    button.Size = UDim2.new(1, 0, 0, 40)
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    button.Font = Enum.Font.GothamBold
    button.Text = "🔮 " .. displayName
    button.TextColor3 = btnColor
    button.TextSize = 13
    button.LayoutOrder = order
    button.Parent = ButtonContainer

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = button

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = btnColor
    btnStroke.Thickness = 1
    btnStroke.Parent = button

    -- Sự kiện bấm nút nhặt đồ
    button.MouseButton1Click:Connect(function()
        local pearlItem = droppedFolder:FindFirstChild(pearlName)
        
        if pearlItem then
            pcall(function()
                pickupRemote:FireServer(pearlItem)
            end)
            
            -- Hiệu ứng phản hồi visual khi nhặt thành công
            TweenService:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = btnColor}):Play()
            button.TextColor3 = Color3.fromRGB(0, 0, 0)
            task.wait(0.15)
            TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 35)}):Play()
            button.TextColor3 = btnColor
        else
            -- Phản hồi màu đỏ nếu vật phẩm không có trên Workspace
            button.Text = "❌ " .. displayName .. " (Không có)"
            task.wait(1)
            button.Text = "🔮 " .. displayName
        end
    end)
end

--======================================================================
-- TẠO 3 NÚT TƯƠNG ỨNG
--======================================================================
createPickupButton("PurplePearl", "PurplePearl", Color3.fromRGB(180, 100, 255), 1)
createPickupButton("OrangePearl", "OrangePearl", Color3.fromRGB(255, 160, 50), 2)
createPickupButton("PinkPearl", "PinkPearl", Color3.fromRGB(255, 120, 180), 3)

-- Phím tắt phím H để Ẩn/Hiện Menu
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.H then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

print("Hệ thống Pearl Pickup GUI đã sẵn sàng! Bấm 'H' để ẩn/hiện.")
