local function refreshClonedUI()
    for _, child in pairs(ClonedScrollingFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for i, clientScript in ipairs(clonedClientsList) do
        if clientScript and clientScript.Parent then
            local itemFrame = Instance.new("Frame")
            itemFrame.Size = UDim2.new(1, 0, 0, 30)
            itemFrame.BackgroundTransparency = 1
            itemFrame.Parent = ClonedScrollingFrame

            local statusBtn = Instance.new("TextButton")
            statusBtn.Size = UDim2.new(1, 0, 1, 0)
            statusBtn.BackgroundColor3 = clientScript.Disabled and Color3.fromRGB(150, 50, 50) or Color3.fromRGB(50, 130, 70)
            statusBtn.Text = string.format("Client [%d] - Disabled: %s", i, tostring(clientScript.Disabled))
            statusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            statusBtn.Font = Enum.Font.SourceSansBold
            statusBtn.TextSize = 12
            statusBtn.Parent = itemFrame

            local statusCorner = Instance.new("UICorner")
            statusCorner.CornerRadius = UDim.new(0, 4)
            statusCorner.Parent = statusBtn

            statusBtn.MouseButton1Click:Connect(function()
                clientScript.Disabled = not clientScript.Disabled
                refreshClonedUI()
            end)
        end
    end
end

local function executeDuplicate()
    local count = tonumber(CloneCountBox.Text)
    if count and count > 0 then
        savedCloneCount = count
    end
    
    if savedCloneCount <= 0 then return end

    local char = LocalPlayer.Character
    if not char then return end
    
    local originalClient = char:FindFirstChild("Client") or LocalPlayer:WaitForChild("PlayerScripts", 2):FindFirstChild("Client")

    if originalClient then
        clonedClientsList = {}
        for i = 1, savedCloneCount do
            local clone = originalClient:Clone()
            clone.Name = "Client_Clone_" .. tostring(i)
            clone.Parent = char
            table.insert(clonedClientsList, clone)
        end
        refreshClonedUI()
    end
end

CloneBtn.MouseButton1Click:Connect(executeDuplicate)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    newChar:WaitForChild("HumanoidRootPart", 5)
    task.wait(0.5)
    if savedCloneCount > 0 then
        executeDuplicate()
    end
end)

