local function updateESPForCharacter(player, character)
    if not character or player == LocalPlayer then return end
    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 5)
    if not head then return end

    if head:FindFirstChild("PlayerESP") then 
        head.PlayerESP:Destroy() 
    end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerESP"
    bb.Size = UDim2.new(0, 160, 0, 45)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 3, 0)
    bb.Adornee = head
    bb.MaxDistance = dangerDetectDistance
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Name = "ESPText"
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.Parent = bb
end

local function setupPlayerESP(player)
    if player == LocalPlayer then return end
    
    if not teamSafeList[player.Name] then
        targets[player.Name] = true
    end

    player.CharacterAdded:Connect(function(char)
        updateESPForCharacter(player, char)
    end)
    if player.Character then
        updateESPForCharacter(player, player.Character)
    end
end

for _, p in pairs(Players:GetPlayers()) do 
    setupPlayerESP(p) 
end
Players.PlayerAdded:Connect(setupPlayerESP)

local buttons = {}
local teamButtons = {}

local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, child in pairs(TeamScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}
    teamButtons = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name

            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 30)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 14
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                if not teamSafeList[pName] then
                    targets[pName] = not targets[pName]
                end
