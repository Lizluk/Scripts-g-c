    if not healArmorActive then return end
    pcall(function()
        if sendCharacterEffectRemote then
            for i = 1, burstCount do
                sendCharacterEffectRemote:FireServer(math.huge, "MedkitHeal")
                sendCharacterEffectRemote:FireServer(math.huge, "ApplyVest")
            end
        end
    end)
end

