local CustomMacros = {}
local function buildMacroUI()
    for _, child in pairs(MacroScrollingFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for i, macro in ipairs(CustomMacros) do
        local itemFrame = Instance.new("Frame")
        itemFrame.Size = UDim2.new(1, 0, 0, 30)
        itemFrame.BackgroundTransparency = 1
        itemFrame.Parent = MacroScrollingFrame

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(1, -65, 1, 0)
        toggleBtn.BackgroundColor3 = macro.Active and Color3.fromRGB(70, 130, 70) or Color3.fromRGB(50, 50, 55)
        toggleBtn.Text = macro.Name .. " (" .. macro.Action .. ")"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        toggleBtn.Font = Enum.Font.SourceSansBold
        toggleBtn.TextSize = 12
        toggleBtn.Parent = itemFrame

        local toggleCorner = Instance.new("UICorner")
        toggleCorner.CornerRadius = UDim.new(0, 4)
        toggleCorner.Parent = toggleBtn

        toggleBtn.MouseButton1Click:Connect(function()
            macro.Active = not macro.Active
            buildMacroUI()
        end)

        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 60, 1, 0)
        delBtn.Position = UDim2.new(1, -60, 0, 0)
        delBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        delBtn.Text = "XÓA"
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.Font = Enum.Font.SourceSansBold
        delBtn.TextSize = 12
        delBtn.Parent = itemFrame

        local delCorner = Instance.new("UICorner")
        delCorner.CornerRadius = UDim.new(0, 4)
        delCorner.Parent = delBtn

        delBtn.MouseButton1Click:Connect(function()
            table.remove(CustomMacros, i)
            buildMacroUI()
        end)
    end
end

AddMacroBtn.MouseButton1Click:Connect(function()
    local rName = RemoteNameBox.Text
