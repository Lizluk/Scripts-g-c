task.spawn(function()
    while true do
        if healArmorActive then
            if tick() - lastHealArmorTime >= healArmorCooldown then
                performHealAndArmor()
                lastHealArmorTime = tick()
            end
        end
        task.wait(0.1)
    end
end)

-- HÀM XỬ LÝ SỰ KIỆN GÂY SÁT THƯƠNG ZOMBIE KHI CLICK / ĐÈ CHUỘT TRÁI
local function performZombieAttack()
    if not killAuraZombieActive then return end
    
    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    pcall(function()
        local gameFolder = workspace:FindFirstChild("GameFolder")
        local possibleFolders = {
            gameFolder and gameFolder:FindFirstChild("Zombies"),
            workspace:FindFirstChild("Zombies"),
            gameFolder and gameFolder:FindFirstChild("AI"),
            workspace:FindFirstChild("Enemies")
        }
        
        local closestZombie = nil
        local shortestDist = maxDetectDistance

        for _, folder in pairs(possibleFolders) do
            if folder then
                for _, zombie in pairs(folder:GetChildren()) do
                    if allowedZombieTypes[zombie.Name] then
                        local zRoot = zombie:FindFirstChild("HumanoidRootPart") or zombie:FindFirstChild("Torso") or zombie:FindFirstChild("Head")
                        if zRoot then
                            local dist = (myRoot.Position - zRoot.Position).Magnitude
                            if dist <= shortestDist then
                                shortestDist = dist
                                closestZombie = zombie
                            end
                        end
                    end
                end
            end
        end

        if closestZombie and sendOuchiesRemote then
            for i = 1, burstCount do
                sendOuchiesRemote:FireServer(closestZombie, zombieDamage)
            end
        end
    end)
end

