task.spawn(function()
    while true do
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and targets[p.Name] == nil and not teamSafeList[p.Name] then
                targets[p.Name] = true
            end
        end

        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        local minDistance = math.huge
        local tempClosest = ""
        local dangerDetected = false

        if myRoot then
            for pName, btnData in pairs(buttons) do
                local p = Players:FindFirstChild(pName)
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local head = p.Character:FindFirstChild("Head")
                    local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    
                    if head then
                        local espGui = head:FindFirstChild("PlayerESP")
                        if not espGui then
                            updateESPForCharacter(p, p.Character)
                        else
                            espGui.MaxDistance = dangerDetectDistance
                            local txt = espGui:FindFirstChild("ESPText")
                            if txt then
                                local intDist = math.floor(dist)
                                if intDist <= dangerDetectDistance then
                                    if teamSafeList[pName] then
                                        txt.Text = string.format("[🛡️ TEAM] %s\n[%d m]", pName, intDist)
                                        txt.TextColor3 = Color3.fromRGB(100, 255, 150)
                                    elseif targets[pName] and intDist <= dangerDetectDistance then
                                        dangerDetected = true
                                        txt.Text = string.format("[⚠ NGUY HIỂM !] %s\n[%d m]", pName, intDist)
                                        txt.TextColor3 = Color3.fromRGB(255, 0, 0)
                                    elseif targets[pName] then
                                        txt.Text = string.format("[🎯 TARGET] %s\n[%d m]", pName, intDist)
                                        txt.TextColor3 = Color3.fromRGB(255, 50, 50)
                                    elseif pName == closestPlayerName then
                                        txt.Text = string.format("[⭐ GẦN] %s\n[%d m]", pName, intDist)
                                        txt.TextColor3 = Color3.fromRGB(50, 255, 130)
                                    else
                                        txt.Text = string.format("%s\n[%d m]", pName, intDist)
                                        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                                    end
                                else
                                    txt.Text = ""
                                end
                            end
                        end
                    end

                    if dist <= dangerDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    if targets[pName] then
                        btnData.Button.LayoutOrder = math.floor(dist) - 100000
                    else
                        btnData.Button.LayoutOrder = math.floor(dist)
                    end
                else
                    btnData.Button.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        if dangerDetected and (tick() - lastDangerSoundTime >= 2) then
            pcall(function()
                local sound = Instance.new("Sound")
                sound.SoundId = "rbxassetid://4590657391"
                sound.Volume = 1
                sound.Parent = SoundService
                sound:Play()
                game.Debris:AddItem(sound, 2)
            end)
            lastDangerSoundTime = tick()
        end

        for pName, btnData in pairs(buttons) do
            local Btn = btnData.Button
            local p = Players:FindFirstChild(pName)
            local distText = ""
            
            if myRoot and p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude)
                distText = " [" .. dist .. "m]"
            end

            if searchFilterText == "" or string.find(string.lower(pName), searchFilterText, 1, true) then
                Btn.Visible = true
            else
                Btn.Visible = false
            end

            if teamSafeList[pName] then
                Btn.BackgroundColor3 = Color3.fromRGB(40, 90, 60)
                Btn.Text = pName .. distText .. " [TEAM SAFE]"
                Btn.TextColor3 = Color3.fromRGB(150, 255, 150)
            elseif targets[pName] then
                local currentDist = myRoot and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude or 999
                if currentDist <= dangerDetectDistance then
                    Btn.BackgroundColor3 = Color3.fromRGB(220, 20, 20)
                    Btn.Text = "⚠️ " .. pName .. distText .. " [ĐANG LẠI GẦN!]"
                elseif killAuraActive then
                    Btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                    Btn.Text = pName .. distText .. " [TARGET]"
                else
                    Btn.BackgroundColor3 = Color3.fromRGB(160, 120, 30)
                    Btn.Text = pName .. distText .. " [PAUSED]"
                end
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            elseif pName == closestPlayerName then
                Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                Btn.Text = "⭐ " .. pName .. " [GẦN]"
                Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
            else
                Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                Btn.Text = pName .. distText
                Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end

        for pName, teamBtnData in pairs(teamButtons) do
            local TeamBtn = teamBtnData.Button
            
            if teamSearchFilterText == "" or string.find(string.lower(pName), teamSearchFilterText, 1, true) then
                TeamBtn.Visible = true
            else
                TeamBtn.Visible = false
            end

            if teamSafeList[pName] then
                TeamBtn.BackgroundColor3 = Color3.fromRGB(50, 160, 80)
                TeamBtn.Text = "🛡️ " .. pName .. " (IN TEAM)"
                TeamBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                TeamBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                TeamBtn.Text = pName
                TeamBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
            end
        end

        task.wait(0.3)
    end
end)
