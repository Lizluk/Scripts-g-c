--------------------------------------------------
-- HITBOX EXPANDER LOGIC
--------------------------------------------------
local function isNPC(char)
    return char and char:IsA("Model") and char:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(char)
end

local function applyHitbox(npc, size)
    local part = npc:FindFirstChild(targetHitboxPart)
    if part and part:IsA("BasePart") then
        if not part:FindFirstChild("OriginalSize") then
            local origSize = Instance.new("Vector3Value")
            origSize.Name = "OriginalSize"
            origSize.Value = part.Size
            origSize.Parent = part
        end

        part.Size = Vector3.new(size, size, size)
        part.Material = Enum.Material.ForceField
        part.Transparency = 0.5
        part.Color = Color3.fromRGB(255, 0, 0)
        part.CanCollide = false
        part.Massless = true
    end
end

local function resetHitbox(npc)
    local part = npc:FindFirstChild(targetHitboxPart)
    if part and part:IsA("BasePart") then
        local origSize = part:FindFirstChild("OriginalSize")
        if origSize then
            part.Size = origSize.Value
            origSize:Destroy()
        end
        part.Material = Enum.Material.Plastic
        part.Transparency = 0
        part.CanCollide = true
        part.Massless = false
    end
end

local function toggleHitbox()
    hitboxEnabled = not hitboxEnabled
    if hitboxEnabled then
        HitboxBtn.Text = "NPC Hitbox: ON (F4)"
        HitboxBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
        local size = tonumber(HitboxSizeBox.Text) or 7
        for _, model in pairs(workspace:GetDescendants()) do
            if isNPC(model) then applyHitbox(model, size) end
        end
        npcConnections["childAdded"] = workspace.DescendantAdded:Connect(function(obj)
            if isNPC(obj) then
                task.wait(0.2)
                applyHitbox(obj, tonumber(HitboxSizeBox.Text) or 7)
            end
        end)
    else
        HitboxBtn.Text = "NPC Hitbox: OFF (F4)"
        HitboxBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 60)
        for _, model in pairs(workspace:GetDescendants()) do
            if isNPC(model) then resetHitbox(model) end
        end
        if npcConnections["childAdded"] then npcConnections["childAdded"]:Disconnect() end
    end
end

HitboxBtn.MouseButton1Click:Connect(toggleHitbox)
HitboxPartBtn.MouseButton1Click:Connect(function()
    targetHitboxPart = (targetHitboxPart == "Head") and "Torso" or "Head"
    HitboxPartBtn.Text = "Hitbox Part: " .. targetHitboxPart
end)

--------------------------------------------------
-- HOSTILE NPC ESP TRACKER LOGIC
--------------------------------------------------
local hostileFolder = workspace:FindFirstChild("PlayerCharacters") and workspace.PlayerCharacters:FindFirstChild("HostileNPCs")

local function getRootPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc:FindFirstChild("Torso") or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart")
end

local function removeESP(npc)
    if activeHighlights[npc] then activeHighlights[npc]:Destroy() activeHighlights[npc] = nil end
    if activeLabels[npc] then activeLabels[npc]:Destroy() activeLabels[npc] = nil end
end

local function createESP(npc)
    if not npc:IsA("Model") or activeHighlights[npc] then return end
    task.spawn(function()
        local rootPart = getRootPart(npc)
        local timer = 0
        while not rootPart and timer < 3 and espEnabled and npc.Parent do
            task.wait(0.2)
            timer = timer + 0.2
            rootPart = getRootPart(npc)
        end
        if not rootPart or not espEnabled or not npc.Parent then return end

        local highlight = Instance.new("Highlight")
        highlight.Adornee = npc
        highlight.FillColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = npc
        activeHighlights[npc] = highlight

        local bbGui = Instance.new("BillboardGui")
        bbGui.Adornee = rootPart
        bbGui.AlwaysOnTop = true
        bbGui.ExtentsOffset = Vector3.new(0, 3, 0)
        bbGui.Size = UDim2.new(0, 200, 0, 40)

        local label = Instance.new("TextLabel", bbGui)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = 15
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0

        bbGui.Parent = npc
        activeLabels[npc] = {gui = bbGui, label = label, root = rootPart}
    end)
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    local myRoot = LocalPlayer.Character and getRootPart(LocalPlayer.Character)
    for npc, data in pairs(activeLabels) do
        if npc and npc.Parent and data.root and data.root.Parent then
            if myRoot then
                local dist = math.floor((myRoot.Position - data.root.Position).Magnitude)
                data.label.Text = string.format("%s\n[%d m]", npc.Name, dist)
            end
        else
            removeESP(npc)
        end
    end
end)

ESPBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        ESPBtn.Text = "Hostile NPC ESP: ON"
        ESPBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
        if hostileFolder then
            for _, npc in pairs(hostileFolder:GetChildren()) do createESP(npc) end
        end
    else
        ESPBtn.Text = "Hostile NPC ESP: OFF"
        ESPBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 0)
        for npc, _ in pairs(activeHighlights) do removeESP(npc) end
    end
end)

if hostileFolder then
    hostileFolder.ChildAdded:Connect(function(child) if espEnabled then createESP(child) end end)
    hostileFolder.ChildRemoved:Connect(removeESP)
end

