local function applyESP(player, character)
    if not character or player == LocalPlayer then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    if head:FindFirstChild("PlayerESP") then head.PlayerESP:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerESP"
    bb.Size = UDim2.new(0, 150, 0, 30)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = head
    bb.MaxDistance = maxDetectDistance
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Name = "ESPText"
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.Parent = bb
end

for _, p in pairs(Players:GetPlayers()) do 
    if p ~= LocalPlayer then
        p.CharacterAdded:Connect(function(char) applyESP(p, char) end)
        if p.Character then applyESP(p, p.Character) end
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char) applyESP(p, char) end)
end)

-- Vòng lặp ESP
task.spawn(function()
    while true do
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local head = player.Character:FindFirstChild("Head")
                    if head then
                        local espGui = head:FindFirstChild("PlayerESP")
                        if espGui then
                            espGui.MaxDistance = maxDetectDistance
                            local txt = espGui:FindFirstChild("ESPText")
                            if txt then
                                local distance = math.floor((myRoot.Position - head.Position).Magnitude)
                                if distance <= maxDetectDistance then
                                    if targets[player.Name] then
                                        txt.Text = killAuraActive and string.format("[🎯] %s\n[%d m]", player.Name, distance) or string.format("[⏸️] %s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = killAuraActive and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 200, 50)
                                    elseif player.Name == closestPlayerName then
                                        txt.Text = string.format("[⭐] %s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(0, 255, 150)
                                    else
                                        txt.Text = string.format("%s\n[%d m]", player.Name, distance)
                                        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.25)
    end
end)

-- Quản lý danh sách người chơi trên GUI
local buttons = {}
local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 30)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 14
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                targets[pName] = not targets[pName] or nil
            end)
            buttons[pName] = {Button = Btn}
        end
    end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player) targets[player.Name] = nil buildButtons() end)
buildButtons()

-- Vòng lặp cập nhật khoảng cách danh sách Player
task.spawn(function()
    while true do
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local minDistance = math.huge
        local tempClosest = ""

        if myRoot then
            for pName, btnData in pairs(buttons) do
                local p = Players:FindFirstChild(pName)
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    btnData.Button.LayoutOrder = targets[pName] and (math.floor(dist) - 100000) or math.floor(dist)
                else
                    btnData.Button.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        for pName, btnData in pairs(buttons) do
            local Btn = btnData.Button
            if targets[pName] then
                Btn.BackgroundColor3 = killAuraActive and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(160, 120, 30)
                Btn.Text = killAuraActive and (pName .. " [TARGET]") or (pName .. " [PAUSED]")
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            elseif pName == closestPlayerName then
                Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                Btn.Text = "⭐ " .. pName .. " (GẦN NHẤT)"
                Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
            else
                Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                Btn.Text = pName
                Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end

        if autoDrinkActive and drinkRemote and interactionsFolder then
            pcall(function()
                local lake = interactionsFolder:FindFirstChild("Lakes") and interactionsFolder.Lakes:FindFirstChild("Lake")
                if lake then drinkRemote:FireServer(lake) end
            end)
        end

        if autoEatActive and foodRemote and interactionsFolder then
            pcall(function()
                local ribs = interactionsFolder:FindFirstChild("Food") and interactionsFolder.Food:FindFirstChild("Ribs")
                if ribs then foodRemote:FireServer(ribs) end
            end)
        end
        task.wait(0.3)
    end
end)

