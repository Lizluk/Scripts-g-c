UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if UserInputService:GetFocusedTextBox() or gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.P then MainFrame.Visible = not MainFrame.Visible end
    if input.KeyCode == Enum.KeyCode.L then autoDrinkActive = not autoDrinkActive updateUtilityVisuals() end
    if input.KeyCode == Enum.KeyCode.K then autoEatActive = not autoEatActive updateUtilityVisuals() end
    if input.KeyCode == Enum.KeyCode.U then passiveSkillActive = not passiveSkillActive updateUtilityVisuals() end
    if input.KeyCode == Enum.KeyCode.J then autoGrabActive = not autoGrabActive updateUtilityVisuals() end
    if input.KeyCode == Enum.KeyCode.Y then autoForageActive = not autoForageActive updateUtilityVisuals() end
    if input.KeyCode == Enum.KeyCode.X then autoCarcassActive = not autoCarcassActive updateUtilityVisuals() end
    if input.KeyCode == Enum.KeyCode.G then triggerPortal() end
    if input.KeyCode == Enum.KeyCode.Q then
        killAuraActive = not killAuraActive
        StatusLabel.Text = killAuraActive and "KILL AURA: RUNNING [Q]" or "KILL AURA: PAUSED [Q]"
        StatusLabel.TextColor3 = killAuraActive and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 200, 50)
    end
end)

