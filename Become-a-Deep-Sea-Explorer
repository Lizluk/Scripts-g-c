-- [TÌM DỊCH VỤ KNIT]
local function getKnitService(serviceName)
    local path = ReplicatedStorage:FindFirstChild("Packages")
    if path then
        local index = path:FindFirstChild("_Index")
        if index then
            local knit = index:FindFirstChild("sleitnick_knit@1.7.0")
            if knit then
                return knit.knit.Services[serviceName].RF
            end
        end
    end
    return nil
end

local autoAdd = false
local autoSell = false
local autoTreas = false

-- [VÒNG LẶP]
task.spawn(function()
    while true do
        if autoAdd then
            local s = getKnitService("FishService")
            if s then s.AddToInventory:InvokeServer(FishInputBox.Text, "Catch") end
        end
        if autoTreas then
            local s = getKnitService("TreasureService")
            if s then s.AddToInventory:InvokeServer(TreasureInputBox.Text, "Default") end
        end
        if autoSell then
            local s = getKnitService("MarketService")
            if s then s.Sell:InvokeServer() end
        end
        task.wait(0.2)
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.G then autoAdd = not autoAdd end
    if input.KeyCode == Enum.KeyCode.H then autoSell = not autoSell end
    if input.KeyCode == Enum.KeyCode.J then autoTreas = not autoTreas end
    if input.KeyCode == Enum.KeyCode.P then MainFrame.Visible = not MainFrame.Visible end
    StatusLabel.Text = string.format("Cá: %s | Bán: %s | Báu: %s", tostring(autoAdd), tostring(autoSell), tostring(autoTreas))
end)
