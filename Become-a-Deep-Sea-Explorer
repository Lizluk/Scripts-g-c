-- Phương pháp nạp GUI an toàn nhất
local function safeParent(gui)
    local success = false
    -- Thử dùng syn.protect_gui (nếu dùng Synapse/các executor cao cấp)
    if syn and syn.protect_gui then syn.protect_gui(gui) end
    
    -- Thử các vị trí khác nhau
    local parents = {
        (gethui and gethui()),
        game:GetService("CoreGui"),
        LocalPlayer:WaitForChild("PlayerGui")
    }
    
    for _, parent in ipairs(parents) do
        if parent then
            pcall(function() gui.Parent = parent end)
            if gui.Parent == parent then 
                print("GUI đã được nạp thành công vào: " .. parent.Name)
                success = true
                break 
            end
        end
    end
    if not success then warn("Không thể nạp GUI vào bất kỳ vị trí nào!") end
end

safeParent(ScreenGui)

