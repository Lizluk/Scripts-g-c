----------------------------------------------------------------
-- HỆ THỐNG VÒNG LẶP CHẠY AUTO (BACKGROUND THREADS)
----------------------------------------------------------------

-- Vòng lặp Auto Add Cá (Phím G)
task.spawn(function()
    while true do
        if autoAddEnabled then
            local fishName = FishInputBox.Text
            if fishName ~= "" then
                pcall(function()
                    -- Gửi yêu cầu Add cá lên Server thông qua InvokeServer
                    FishService:InvokeServer(fishName, "Catch")
                end)
            end
            task.wait(0.05) -- Tốc độ add cá (Giảm xuống nếu muốn nhanh hơn, tăng lên nếu bị lag)
        else
            task.wait(0.2)
        end
    end
end)

-- Vòng lặp Auto Bán Cá (Phím H)
task.spawn(function()
    while true do
        if autoSellEnabled then
            pcall(function()
                -- Gửi yêu cầu bán toàn bộ cá lên Server thông qua InvokeServer
                MarketService:InvokeServer()
            end)
            task.wait(0.5) -- Tốc độ bán (0.5 giây một lần để đảm bảo server nhận kịp lệnh)
        else
            task.wait(0.2)
        end
    end
end)

----------------------------------------------------------------
-- LẮNG NGHE PHÍM TẮT TỪ BÀN PHÍM (KEYBINDS)
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- Nếu đang chat hoặc đang gõ chữ đổi tên cá trong ô nhập thì không kích hoạt phím tắt
    if gameProcessed then return end 
    
    -- Phím G: Bật/Tắt Auto Add Cá
    if input.KeyCode == Enum.KeyCode.G then
        autoAddEnabled = not autoAddEnabled
        if autoAddEnabled then
            AutoAddStatus.Text = "[G] Auto Add Cá: ON (" .. FishInputBox.Text .. ")"
            AutoAddStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            AutoAddStatus.Text = "[G] Auto Add Cá: OFF"
            AutoAddStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        
    -- Phím H: Bật/Tắt Auto Bán Cá
    elseif input.KeyCode == Enum.KeyCode.H then
        autoSellEnabled = not autoSellEnabled
        if autoSellEnabled then
            AutoSellStatus.Text = "[H] Auto Bán Cá: ON"
            AutoSellStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            AutoSellStatus.Text = "[H] Auto Bán Cá: OFF"
            AutoSellStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        
    -- Phím P: Ẩn hoặc Hiện bảng Menu trên màn hình
    elseif input.KeyCode == Enum.KeyCode.P then
        MainFrame.Visible = not MainFrame.Visible
    end
end)
