-- HỆ THỐNG VÒNG LẶP CHẠY AUTO MƯỢT MÀ
----------------------------------------------------------------

-- Vòng lặp Auto Add Cá (Phím G)
task.spawn(function()
    while true do
        if autoAddEnabled then
            local fishName = FishInputBox.Text
            if fishName ~= "" then
                pcall(function()
                    FishService:InvokeServer(fishName, "Catch")
                end)
            end
            task.wait(0.05) -- Tốc độ gửi lệnh add cá
        else
            task.wait(0.2)
        end
    end
end)

-- Vòng lặp Auto Add Kho Báu (Phím J)
task.spawn(function()
    while true do
        if autoTreasureEnabled then
            local treasureName = TreasureInputBox.Text
            if treasureName ~= "" then
                pcall(function()
                    TreasureService:InvokeServer(treasureName, "Default")
                end)
            end
            task.wait(0.05) -- Tốc độ gửi lệnh add báu vật
        else
            task.wait(0.2)
        end
    end
end)

-- Vòng lặp Auto Bán Vật Phẩm (Phím H)
task.spawn(function()
    while true do
        if autoSellEnabled then
            pcall(function()
                MarketService:InvokeServer()
            end)
            task.wait(0.5) -- Bán đồ mỗi 0.5s để server kịp cập nhật tiền
        else
            task.wait(0.2)
        end
    end
end)

----------------------------------------------------------------
-- LẮNG NGHE PHÍM TẮT TỪ BÀN PHÍM (KEYBINDS)
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end -- Không kích hoạt phím khi đang gõ chat/nhập chữ
    
    -- Phím G: Auto Add Cá
    if input.KeyCode == Enum.KeyCode.G then
        autoAddEnabled = not autoAddEnabled
        if autoAddEnabled then
            AutoAddStatus.Text = "[G] Auto Add Cá: ON (" .. FishInputBox.Text .. ")"
            AutoAddStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            AutoAddStatus.Text = "[G] Auto Add Cá: OFF"
            AutoAddStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        
    -- Phím J: Auto Tìm Kho Báu (MỚI)
    elseif input.KeyCode == Enum.KeyCode.J then
        autoTreasureEnabled = not autoTreasureEnabled
        if autoTreasureEnabled then
            AutoTreasureStatus.Text = "[J] Auto Tìm Kho Báu: ON (" .. TreasureInputBox.Text .. ")"
            AutoTreasureStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            AutoTreasureStatus.Text = "[J] Auto Tìm Kho Báu: OFF"
            AutoTreasureStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        end

    -- Phím H: Auto Bán Đồ
    elseif input.KeyCode == Enum.KeyCode.H then
        autoSellEnabled = not autoSellEnabled
        if autoSellEnabled then
            AutoSellStatus.Text = "[H] Auto Bán Đồ (Market): ON"
            AutoSellStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            AutoSellStatus.Text = "[H] Auto Bán Đồ (Market): OFF"
            AutoSellStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        
    -- Phím P: Ẩn/Hiện Menu
    elseif input.KeyCode == Enum.KeyCode.P then
        MainFrame.Visible = not MainFrame.Visible
    end
