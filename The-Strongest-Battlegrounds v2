--// SMART MIRROR STALKER V28 (BIG TEXT & UI OPTIMIZED)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local lp = Players.LocalPlayer

-- Khởi tạo biến
local active = false
local isHoldingMouse = false
local lastHealth = 100
local targetPlayer = nil
local blacklisted = {}

local Config = {
    stalkRange = 25,
    offsetForward = 3.5,
    moveSpeed = 35,
    faceEachOther = true,
    revengeMode = true
}

-- =============================================
-- HÀM LƯU/TẢI CÀI ĐẶT
-- =============================================
local fileName = "Stalker_V28_Config.json"
local function SaveSettings()
    pcall(function() if writefile then writefile(fileName, HttpService:JSONEncode(Config)) end end)
end
local function LoadSettings()
    pcall(function()
        if isfile and isfile(fileName) then
            local decoded = HttpService:JSONDecode(readfile(fileName))
            for k, v in pairs(decoded) do Config[k] = v end
        end
    end)
end
LoadSettings()

-- =============================================
-- GIAO DIỆN GUI (TO & RÕ)
-- =============================================
if lp.PlayerGui:FindFirstChild("MirrorStalker_V28") then
    lp.PlayerGui:FindFirstChild("MirrorStalker_V28"):Destroy()
end

local ScreenGui = Instance.new("ScreenGui", lp.PlayerGui)
ScreenGui.Name = "MirrorStalker_V28"
ScreenGui.ResetOnSpawn = false

local Main = Instance.new("Frame", ScreenGui)
Main.Size = UDim2.new(0, 300, 0, 550) -- Tăng chiều rộng một chút
Main.Position = UDim2.new(0.5, -150, 0.5, -275)
Main.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Main.Active = true
Main.Draggable = true
Instance.new("UICorner", Main)

local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Text = "STALKER V28 - BIG TEXT"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.TextSize = 18 -- Chữ tiêu đề to
Title.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
Title.Font = Enum.Font.GothamBold

local function CreateSlider(name, configKey, pos, min, max, default)
    local val = Config[configKey] or default
    local label = Instance.new("TextLabel", Main)
    label.Size = UDim2.new(0.9, 0, 0, 25)
    label.Position = pos
    label.Text = name .. ": " .. val
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 14
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamSemibold

    local sliderFrame = Instance.new("Frame", Main)
    sliderFrame.Size = UDim2.new(0.8, 0, 0, 6)
    sliderFrame.Position = pos + UDim2.new(0.05, 0, 0.05, 5)
    sliderFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

    local btn = Instance.new("TextButton", sliderFrame)
    btn.Size = UDim2.new(0, 16, 0, 16)
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.Position = UDim2.new((val - min) / (max - min), 0, 0.5, 0)
    btn.Text = ""
    btn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    Instance.new("UICorner", btn)

    local dragging = false
    btn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false SaveSettings() end end)

    RunService.Heartbeat:Connect(function()
        if dragging then
            local mousePos = UserInputService:GetMouseLocation().X
            local relativePos = math.clamp((mousePos - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
            btn.Position = UDim2.new(relativePos, 0, 0.5, 0)
            local currentVal = math.floor(min + (relativePos * (max - min)))
            label.Text = name .. ": " .. currentVal
            Config[configKey] = currentVal
        end
    end)
end

CreateSlider("Tầm quét", "stalkRange", UDim2.new(0.05, 0, 0.08, 0), 5, 100, 25)
CreateSlider("Khoảng cách", "offsetForward", UDim2.new(0.05, 0, 0.16, 0), -20, 20, 3.5)
CreateSlider("Tốc độ bám", "moveSpeed", UDim2.new(0.05, 0, 0.24, 0), 0, 100, 35)

local Scroll = Instance.new("ScrollingFrame", Main)
Scroll.Size = UDim2.new(0.92, 0, 0.42, 0)
Scroll.Position = UDim2.new(0.04, 0, 0.33, 0)
Scroll.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
Scroll.ScrollBarThickness = 6
local listLayout = Instance.new("UIListLayout", Scroll)
listLayout.Padding = UDim.new(0, 4) -- Tạo khoảng cách giữa các tên

local function RefreshList()
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            local b = Instance.new("TextButton", Scroll)
            b.Size = UDim2.new(1, -8, 0, 45) -- Dòng tên cao hơn để dễ bấm
            b.Text = "  " .. p.DisplayName .. " (@" .. p.Name .. ")" -- Hiện cả tên hiển thị
            b.TextColor3 = Color3.new(1, 1, 1)
            b.TextSize = 18 -- CHỮ TO RÕ
            b.Font = Enum.Font.SourceSansBold
            b.TextXAlignment = Enum.TextXAlignment.Left
            Instance.new("UICorner", b)
            
            local function UpdateColor()
                if blacklisted[p.Name] then
                    b.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
                elseif targetPlayer == p then
                    b.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
                else
                    b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                end
            end
            UpdateColor()

            b.MouseButton1Click:Connect(function()
                if blacklisted[p.Name] then return end
                targetPlayer = (targetPlayer == p) and nil or p
                RefreshList()
            end)

            b.MouseButton2Click:Connect(function()
                blacklisted[p.Name] = not blacklisted[p.Name]
                if blacklisted[p.Name] and targetPlayer == p then targetPlayer = nil end
                RefreshList()
            end)
        end
    end
    Scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end
RefreshList()
Players.PlayerAdded:Connect(RefreshList)
Players.PlayerRemoving:Connect(RefreshList)

local FaceBtn = Instance.new("TextButton", Main)
FaceBtn.Size = UDim2.new(0.44, 0, 0, 35)
FaceBtn.Position = UDim2.new(0.04, 0, 0.77, 0)
FaceBtn.Text = Config.faceEachOther and "FACE: ON" or "FACE: OFF"
FaceBtn.TextSize = 16
FaceBtn.BackgroundColor3 = Config.faceEachOther and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(60, 60, 60)
FaceBtn.TextColor3 = Color3.new(1, 1, 1)
Instance.new("UICorner", FaceBtn)

local RevengeBtn = Instance.new("TextButton", Main)
RevengeBtn.Size = UDim2.new(0.44, 0, 0, 35)
RevengeBtn.Position = UDim2.new(0.52, 0, 0.77, 0)
RevengeBtn.Text = Config.revengeMode and "REVENGE: ON" or "REVENGE: OFF"
RevengeBtn.TextSize = 16
RevengeBtn.BackgroundColor3 = Config.revengeMode and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(60, 60, 60)
RevengeBtn.TextColor3 = Color3.new(1, 1, 1)
