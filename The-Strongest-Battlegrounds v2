--// SMART MIRROR STALKER V24 (HOLD LEFT-CLICK TO STALK)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer

-- Biến cấu hình
local active = false
local isHoldingMouse = false -- Kiểm tra giữ CHUỘT TRÁI
local faceEachOther = true -- Mặc định bật để nhìn thẳng đối phương khi đánh
local revengeMode = true
local targetPlayer = nil
local stalkRange = 25
local offsetForward = 3.5 -- Khoảng cách cực gần để đánh trúng
local offsetRight = 0
local moveSpeed = 35 -- Tốc độ cao để áp sát nhanh
local blacklisted = {}
local lastHealth = 100

-- Xóa GUI cũ
if lp.PlayerGui:FindFirstChild("MirrorStalker_V24") then
    lp.PlayerGui:FindFirstChild("MirrorStalker_V24"):Destroy()
end

-- =============================================
-- GIAO DIỆN GUI
-- =============================================
local ScreenGui = Instance.new("ScreenGui", lp.PlayerGui)
ScreenGui.Name = "MirrorStalker_V24"
ScreenGui.ResetOnSpawn = false

local Main = Instance.new("Frame", ScreenGui)
Main.Size = UDim2.new(0, 280, 0, 500)
Main.Position = UDim2.new(0.5, -140, 0.5, -250)
Main.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
Main.Active = true
Main.Draggable = true
Instance.new("UICorner", Main)

local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "STALKER V24 [GIỮ CHUỘT TRÁI]"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.BackgroundColor3 = Color3.fromRGB(0, 80, 0)
Title.Font = Enum.Font.GothamBold

local function CreateSlider(name, pos, min, max, default, callback)
    local label = Instance.new("TextLabel", Main)
    label.Size = UDim2.new(0.9, 0, 0, 20)
    label.Position = pos
    label.Text = name .. ": " .. default
    label.TextColor3 = Color3.new(1, 1, 1)
    label.BackgroundTransparency = 1

    local sliderFrame = Instance.new("Frame", Main)
    sliderFrame.Size = UDim2.new(0.8, 0, 0, 4)
    sliderFrame.Position = pos + UDim2.new(0.05, 0, 0.05, 0)
    sliderFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

    local btn = Instance.new("TextButton", sliderFrame)
    btn.Size = UDim2.new(0, 14, 0, 14)
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
    btn.Text = ""
    btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    Instance.new("UICorner", btn)

    local dragging = false
    btn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

    RunService.Heartbeat:Connect(function()
        if dragging then
            local mousePos = UserInputService:GetMouseLocation().X
            local relativePos = math.clamp((mousePos - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
            btn.Position = UDim2.new(relativePos, 0, 0.5, 0)
            local val = math.floor(min + (relativePos * (max - min)))
            label.Text = name .. ": " .. val
            callback(val)
        end
    end)
end

CreateSlider("Tầm nhận diện", UDim2.new(0.05, 0, 0.1, 0), 5, 100, 25, function(v) stalkRange = v end)
CreateSlider("Khoảng cách", UDim2.new(0.05, 0, 0.18, 0), -20, 20, 3.5, function(v) offsetForward = v end)
CreateSlider("Tốc độ bám", UDim2.new(0.05, 0, 0.26, 0), 0, 100, 35, function(v) moveSpeed = v end)

local RevengeBtn = Instance.new("TextButton", Main)
RevengeBtn.Size = UDim2.new(0.42, 0, 0, 35)
RevengeBtn.Position = UDim2.new(0.05, 0, 0.35, 0)
RevengeBtn.Text = "REVENGE: ON"
RevengeBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
RevengeBtn.TextColor3 = Color3.new(1, 1, 1)
Instance.new("UICorner", RevengeBtn)

local FaceBtn = Instance.new("TextButton", Main)
FaceBtn.Size = UDim2.new(0.42, 0, 0, 35)
FaceBtn.Position = UDim2.new(0.53, 0, 0.35, 0)
FaceBtn.Text = "FACE: ON"
FaceBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
FaceBtn.TextColor3 = Color3.new(1, 1, 1)
Instance.new("UICorner", FaceBtn)

local Scroll = Instance.new("ScrollingFrame", Main)
Scroll.Size = UDim2.new(0.9, 0, 0.35, 0)
Scroll.Position = UDim2.new(0.05, 0, 0.45, 0)
Scroll.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
Instance.new("UIListLayout", Scroll)

local function RefreshList()
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            local b = Instance.new("TextButton", Scroll)
            b.Size = UDim2.new(1, -5, 0, 30)
            b.Text = p.Name
            b.BackgroundColor3 = blacklisted[p.Name] and Color3.fromRGB(150,0,0) or (targetPlayer == p and Color3.fromRGB(0,150,0) or Color3.fromRGB(30,30,30))
            b.TextColor3 = Color3.new(1, 1, 1)
            b.MouseButton1Click:Connect(function() 
                if not blacklisted[p.Name] then targetPlayer = p RefreshList() end 
            end)
            -- Chuột phải trong List vẫn là Blacklist
            b.MouseButton2Click:Connect(function() 
                blacklisted[p.Name] = not blacklisted[p.Name] 
                if blacklisted[p.Name] and targetPlayer == p then targetPlayer = nil end
                RefreshList() 
            end)
        end
    end
end
Players.PlayerAdded:Connect(RefreshList)
Players.PlayerRemoving:Connect(RefreshList)
RefreshList()

local ToggleBtn = Instance.new("TextButton", Main)
ToggleBtn.Size = UDim2.new(0.9, 0, 0, 45)
ToggleBtn.Position = UDim2.new(0.05, 0, 0.88, 0)
ToggleBtn.Text = "SYSTEM: OFF [F]"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
ToggleBtn.Font = Enum.Font.GothamBold

-- =============================================
-- LOGIC ĐIỀU KHIỂN
-- =============================================
local function ResetAnims()
    if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        for _, t in pairs(lp.Character.Humanoid:GetPlayingAnimationTracks()) do t:Stop(0.1) end
    end
end

local function ToggleHack()
    active = not active
    ToggleBtn.Text = active and "READY [F]\n(Giữ Chuột Trái để bám/đánh)" or "SYSTEM: OFF [F]"
    ToggleBtn.BackgroundColor3 = active and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    if not active then targetPlayer = nil isHoldingMouse = false ResetAnims() end
end

ToggleBtn.MouseButton1Click:Connect(ToggleHack)

UserInputService.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.F then ToggleHack() end
    if i.UserInputType == Enum.UserInputType.MouseButton1 then isHoldingMouse = true end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then 
        isHoldingMouse = false 
        ResetAnims() 
    end
end)

RevengeBtn.MouseButton1Click:Connect(function()
    revengeMode = not revengeMode
    RevengeBtn.Text = revengeMode and "REVENGE: ON" or "REVENGE: OFF"
    RevengeBtn.BackgroundColor3 = revengeMode and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(60, 60, 60)
end)

FaceBtn.MouseButton1Click:Connect(function()
    faceEachOther = not faceEachOther
    FaceBtn.Text = faceEachOther and "FACE: ON" or "FACE: OFF"
    FaceBtn.BackgroundColor3 = faceEachOther and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(60, 60, 60)
end)

-- =============================================
-- VÒNG LẶP XỬ LÝ (PRE-RENDER)
-- =============================================
RunService.PreRender:Connect(function()
    if not active then return end
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Tự động đổi mục tiêu nếu bị tấn công
    if revengeMode and char:FindFirstChild("Humanoid") then
        local currentHealth = char.Humanoid.Health
        if currentHealth < lastHealth and currentHealth > 0 then
            local dist = 20
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then targetPlayer = p RefreshList() break end
                end
            end
        end
        lastHealth = currentHealth
    end

    -- CHỈ BÁM KHI ĐANG GIỮ CHUỘT TRÁI (VỪA ĐÁNH VỪA BÁM)
    if isHoldingMouse then
        -- Tìm người gần nhất nếu chưa có target
        if not targetPlayer then
            local closestDist = stalkRange
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= lp and not blacklisted[p.Name] and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if d < closestDist then
                        closestDist = d
                        targetPlayer = p
                        RefreshList()
                    end
                end
            end
        end

        -- Thực hiện di chuyển áp sát
        if targetPlayer and targetPlayer.Character then
            local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tHum = targetPlayer.Character:FindFirstChild("Humanoid")
            
            if tHrp and tHum and tHum.Health > 0 then
                -- Giữ nhân vật thẳng đứng (V20)
                local _, yRotation, _ = tHrp.CFrame:ToEulerAnglesYXZ()
                local baseCF = CFrame.new(tHrp.Position) * CFrame.Angles(0, yRotation, 0)
                
                -- Tính vị trí áp sát
                local targetCF = baseCF * CFrame.new(offsetRight, 0, -offsetForward)
                if faceEachOther then targetCF = targetCF * CFrame.Angles(0, math.pi, 0) end
                
                hrp.CFrame = hrp.CFrame:Lerp(targetCF, moveSpeed/100)
                
                -- Đồng bộ hành động
                local myHum = char:FindFirstChildOfClass("Humanoid")
                if myHum then
                    for _, track in pairs(tHum:GetPlayingAnimationTracks()) do
                        local playing = false
                        for _, mt in pairs(myHum:GetPlayingAnimationTracks()) do
                            if mt.Animation.AnimationId == track.Animation.AnimationId then playing = true break end
                        end
                        if not playing then myHum:LoadAnimation(track.Animation):Play(0) end
                    end
                end
                
                hrp.Velocity = Vector3.zero
                -- Noclip khi bám
                for _, p in pairs(char:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end
            else
                targetPlayer = nil -- Người kia chết thì bỏ target để tìm người mới
                RefreshList()
            end
        end
    else
        -- Khi thả chuột, khôi phục va chạm để không lọt sàn
        if char then
            for _, p in pairs(char:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = true end end
        end
    end
end)
