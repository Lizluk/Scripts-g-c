local ToggleBtn = Instance.new("TextButton", Main)
ToggleBtn.Size = UDim2.new(0.92, 0, 0, 50)
ToggleBtn.Position = UDim2.new(0.04, 0, 0.88, 0)
ToggleBtn.Text = "SYSTEM: OFF [F]"
ToggleBtn.TextSize = 20 -- Nút tổng rất to
ToggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
ToggleBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", ToggleBtn)

-- =============================================
-- LOGIC XỬ LÝ
-- =============================================
local function ToggleHack()
    active = not active
    ToggleBtn.Text = active and "SYSTEM: READY [F]" or "SYSTEM: OFF [F]"
    ToggleBtn.BackgroundColor3 = active and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    if not active then targetPlayer = nil end
end

ToggleBtn.MouseButton1Click:Connect(ToggleHack)
FaceBtn.MouseButton1Click:Connect(function() Config.faceEachOther = not Config.faceEachOther FaceBtn.Text = Config.faceEachOther and "FACE: ON" or "FACE: OFF" FaceBtn.BackgroundColor3 = Config.faceEachOther and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(60, 60, 60) SaveSettings() end)
RevengeBtn.MouseButton1Click:Connect(function() Config.revengeMode = not Config.revengeMode RevengeBtn.Text = Config.revengeMode and "REVENGE: ON" or "REVENGE: OFF" RevengeBtn.BackgroundColor3 = Config.revengeMode and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(60, 60, 60) SaveSettings() end)

UserInputService.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.F then ToggleHack() end
    if i.UserInputType == Enum.UserInputType.MouseButton1 then isHoldingMouse = true end
end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then isHoldingMouse = false end end)

RunService.PreRender:Connect(function()
    if not active then return end
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Revenge Logic
    if Config.revengeMode and char:FindFirstChild("Humanoid") then
        local h = char.Humanoid.Health
        if h < lastHealth and h > 0 then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= lp and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    if (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude < 15 then
                        targetPlayer = p
                        RefreshList()
                        break
                    end
                end
            end
        end
        lastHealth = h
    end

    if isHoldingMouse then
        -- Xóa target nếu chết
        if targetPlayer and (not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("Humanoid") or targetPlayer.Character.Humanoid.Health <= 0) then
            targetPlayer = nil
            RefreshList()
        end

        -- Tự tìm target gần nhất nếu trống
        if not targetPlayer then
            local closestDist = Config.stalkRange
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= lp and not blacklisted[p.Name] and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if d < closestDist then
                        closestDist = d
                        targetPlayer = p
                    end
                end
            end
        end

        -- Di chuyển áp sát (Khóa trục đứng)
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local tHrp = targetPlayer.Character.HumanoidRootPart
            local _, yRot, _ = tHrp.CFrame:ToEulerAnglesYXZ()
            local baseCF = CFrame.new(tHrp.Position) * CFrame.Angles(0, yRot, 0)
            local targetCF = baseCF * CFrame.new(0, 0, -Config.offsetForward)
            if Config.faceEachOther then targetCF = targetCF * CFrame.Angles(0, math.pi, 0) end
            
            hrp.CFrame = hrp.CFrame:Lerp(targetCF, Config.moveSpeed/100)
            hrp.Velocity = Vector3.zero
            for _, p in pairs(char:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end
        end
    else
        if char then for _, p in pairs(char:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = true end end end
    end
end)
