-- =============================================
-- MAGNET LOGIC - ANTI-DROP (Giữ chặt, không rơi)
-- =============================================
local function applyStrongMagnet(part)
    if not part:IsA("BasePart") or part.Anchored or capturedParts[part] then return end
    
    capturedParts[part] = true
    claimOwnershipOnce()
    
    -- KHÔNG dùng Attachment - giảm lag
    -- Dùng BodyPosition để GIỮ CHẶT
    local bp = Instance.new("BodyPosition", part)
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)  -- Lực CỰC MẠNH
    bp.D = 500  -- Damping - chống rung
    bp.P = 3000  -- Power - tốc độ đến mục tiêu
    
    task.spawn(function()
        while inversionEnabled and part and part.Parent do
            local finalPos = nil
            
            -- Tìm target position
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                finalPos = targetPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, 8, 0)
            elseif currentTargetPos then
                finalPos = currentTargetPos
            else
                local rp = client.Character and client.Character:FindFirstChild("HumanoidRootPart")
                if rp then
                    finalPos = (rp.CFrame * CFrame.new(0, 10, -5)).Position
                end
            end
            
            if finalPos then
                bp.Position = finalPos
                part.CanCollide = false
                
                -- Giảm velocity nếu đến gần để không bị bounce
                local dist = (finalPos - part.Position).Magnitude
                if dist < 5 then
                    part.Velocity = part.Velocity * 0.5
                end
            end
            
            task.wait(0.1)  -- Update mỗi 0.1s thay vì Heartbeat → giảm lag
        end
        
        -- Cleanup khi tắt
        if bp then bp:Destroy() end
        part.CanCollide = true
        capturedParts[part] = nil
    end)
end

-- =============================================
-- UPDATE COUNTER (Giảm tần suất update)
-- =============================================
task.spawn(function()
    while true do
        if inversionEnabled then
            local count = 0
            for _ in pairs(capturedParts) do
                count = count + 1
            end
            
            local mode = "OFF"
            if targetPlayer then
                mode = (targetPlayer == client) and "FOLLOW ME" or "FOLLOW " .. targetPlayer.Name
            elseif currentTargetPos then
                mode = "STATION"
            end
            
            statusLabel.Text = string.format("Items: %d | %s", count, mode)
        end
        task.wait(1)  -- Update mỗi 1s thay vì 0.5s → giảm lag
    end
end)

-- =============================================
-- TOGGLE ON/OFF
-- =============================================
local function toggle()
    inversionEnabled = not inversionEnabled
    
    if inversionEnabled then
        label.Text = "(G) Magnet: ON 🟢"
        label.TextColor3 = Color3.new(0, 1, 0)
        
        print("\n" .. string.rep("=", 60))
        print("🧲 MAGNET ENABLED - ANTI-DROP MODE")
        print(string.rep("=", 60))
        
        -- Set default target
        if not targetPlayer and not currentTargetPos then
            targetPlayer = client
        end
        
        local folder = workspace:FindFirstChild("DroppedItems")
        if folder then
            local itemCount = 0
            for _, v in pairs(folder:GetDescendants()) do
                if v:IsA("BasePart") then
                    applyStrongMagnet(v)
                    itemCount = itemCount + 1
                end
            end
            print(string.format("✅ Captured %d items (WILL NOT DROP!)", itemCount))
        else
            warn("⚠️ workspace.DroppedItems not found!")
        end
        
        game.StarterGui:SetCore("SendNotification", {
            Title = "🧲 Magnet ON",
            Duration = 2,
            Text = "Items locked - will not drop!",
        })
    else
        label.Text = "(G) Magnet: OFF 🔴"
        label.TextColor3 = Color3.new(1, 0, 0)
        
        print("\n" .. string.rep("=", 60))
        print("❌ MAGNET DISABLED - Items can drop now")
        print(string.rep("=", 60))
        
        -- Clear all (items will drop)
        for part in pairs(capturedParts) do
            capturedParts[part] = nil
        end
        
        statusLabel.Text = "Items: 0 | Mode: OFF"
        
        game.StarterGui:SetCore("SendNotification", {
            Title = "❌ Magnet OFF",
            Duration = 2,
            Text = "Items released",
        })
    end
end

