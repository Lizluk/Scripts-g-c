local function updatePlayerList()
    for _, v in pairs(playerScroll:GetChildren()) do 
        if v:IsA("TextButton") then v:Destroy() end 
    end
    
    local playerCount = 0
    for _, player in pairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton", playerScroll)
        btn.Size = UDim2.new(1, -5, 0, 28)
        btn.Text = (player == client) and "👤 " .. player.Name .. " (ME)" or "👤 " .. player.Name
        btn.BackgroundColor3 = (targetPlayer == player) and Color3.fromRGB(70, 70, 30) or Color3.fromRGB(35, 35, 35)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        
        local padding = Instance.new("UIPadding", btn)
        padding.PaddingLeft = UDim.new(0, 5)
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        
        btn.MouseButton1Click:Connect(function()
            targetPlayer = player
            currentTargetPos = nil
            updatePlayerList()
            updateStationList()
            
            local mode = (player == client) and "FOLLOW ME" or "FOLLOW " .. player.Name
            statusLabel.Text = string.format("Items: %d | %s", table.getn(capturedParts), mode)
            
            print(string.format("✅ Target set: %s", player.Name))
        end)
        
        playerCount = playerCount + 1
    end
    
    playerScroll.CanvasSize = UDim2.new(0, 0, 0, playerCount * 31)
end

