-- Hàm đưa một vật thể cụ thể về vị trí tương đối trước mặt nhân vật
local function BringObject(object)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not object then return end

    -- Thiết lập vị trí tương đối: Cách nhân vật 3 studs về phía trước để tránh bị đè nặng
    local RelativeOffset = root.CFrame * CFrame.new(0, 0, -3)

    if object:IsA("BasePart") then
        object.CanCollide = false
        object.CFrame = RelativeOffset
    elseif object:IsA("Model") then
        if object.PrimaryPart then
            object:SetPrimaryPartCFrame(RelativeOffset)
        else
            local mainPart = object:FindFirstChildWhichIsA("BasePart")
            if mainPart then mainPart.CFrame = RelativeOffset end
        end
    end
end

-- Hàm quét và cập nhật lại danh sách nút bấm dựa trên các món đang có trong thư mục
local function RefreshMenu()
    -- Xóa các nút cũ đi để cập nhật mới
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    if not TargetFolder then
        local ErrorTxt = Instance.new("TextLabel")
        ErrorTxt.Size = UDim2.new(1, 0, 0, 30)
        ErrorTxt.Text = "Không tìm thấy DroppedItems!"
        ErrorTxt.TextColor3 = Color3.fromRGB(255, 100, 100)
        ErrorTxt.BackgroundTransparency = 1
        ErrorTxt.Parent = ScrollingFrame
        return
    end

    -- Tìm các tên vật phẩm duy nhất (Unique Names) để phân loại
    local UniqueItems = {}
    for _, item in ipairs(TargetFolder:GetChildren()) do
        if not UniqueItems[item.Name] then
            UniqueItems[item.Name] = true
        end
    end

    -- Tạo nút bấm cho từng tên món đồ độc bản
    for itemName, _ in pairs(UniqueItems) do
        local ItemBtn = Instance.new("TextButton")
        ItemBtn.Size = UDim2.new(1, -5, 0, 30)
        ItemBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        ItemBtn.Text = "Bring: " .. itemName
        ItemBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
        ItemBtn.Font = Enum.Font.SourceSans
        ItemBtn.TextSize = 14
        ItemBtn.Parent = ScrollingFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = ItemBtn

        -- Sự kiện khi bấm vào nút của món đồ đó
        ItemBtn.MouseButton1Click:Connect(function()
            for _, item in ipairs(TargetFolder:GetChildren()) do
                if item.Name == itemName then
                    task.spawn(BringObject, item)
                end
            end
        end)
    end

    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

-- Sự kiện cho nút BRING ALL
BringAllBtn.MouseButton1Click:Connect(function()
    if TargetFolder then
        for _, item in ipairs(TargetFolder:GetChildren()) do
            task.spawn(BringObject, item)
        end
    end
end)

-- Tự động cập nhật lại danh sách nút bấm khi thư mục có thêm hoặc bớt đồ
if TargetFolder then
    TargetFolder.ChildAdded:Connect(RefreshMenu)
    TargetFolder.ChildRemoved:Connect(RefreshMenu)
end

-- Khởi chạy quét lần đầu
RefreshMenu()
