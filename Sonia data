--======================================================================
-- LOGIC QUÉT VÀ ÉP GIÁ TRỊ TỪ GUI VÀO WORKSPACE DATA
--======================================================================
ToggleBtn.MouseButton1Click:Connect(function()
    isLocking = not isLocking
    
    if isLocking then
        -- Thu thập toàn bộ dữ liệu mới nhất từ các ô nhập trên giao diện
        for attrName, box in pairs(uiBoxes) do
            local rawText = box.Text
            -- Nếu nhập số thì chuyển thành kiểu dữ liệu Number, nếu là chữ (như inf) thì giữ nguyên chuỗi String
            attributesConfig[attrName] = tonumber(rawText) or rawText
        end
        
        ToggleBtn.Text = "ĐANG KHÓA TOÀN BỘ (ON) 🔒"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            TextColor3 = Color3.fromRGB(0, 0, 0)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(255, 255, 255)
    else
        ToggleBtn.Text = "CHƯA KHÓA (OFF)"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(40, 40, 40),
            TextColor3 = Color3.fromRGB(200, 200, 200)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(100, 100, 100)
    end
end)

RunService.Heartbeat:Connect(function()
    if not isLocking then return end
    
    local charactersFolder = workspace:FindFirstChild("Characters")
    local myCharacter = charactersFolder and charactersFolder:FindFirstChild(client.Name)
    local dataFolder = myCharacter and myCharacter:FindFirstChild("Data")
    
    if dataFolder then
        -- 1. Khóa các thuộc tính được tinh chỉnh từ các ô trên giao diện GUI
        for attributeName, attributeValue in pairs(attributesConfig) do
            if dataFolder:GetAttribute(attributeName) ~= nil then
                dataFolder:SetAttribute(attributeName, attributeValue)
            end
        end
        
        -- 2. Ép các thuộc tính Boolean (True/False) chạy ngầm ổn định
        for boolName, boolValue in pairs(booleanConfig) do
            if dataFolder:GetAttribute(boolName) ~= nil then
                dataFolder:SetAttribute(boolName, boolValue)
            end
        end
    end
end)

-- Phím tắt phím J dùng để Ẩn / Hiện nhanh giao diện Locker này
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.J then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

