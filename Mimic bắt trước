--// FACE-TO-FACE MIRROR V14 (SUPER FAST SYNC + ORIENTATION FIX)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local client = Players.LocalPlayer

-- Biến điều chỉnh
local active = false
local faceEachOther = true -- Chế độ đối diện mặt
local targetPlayer = nil
local offsetForward = 5 -- Mặc định đứng cách ra một chút để nhìn mặt
local offsetRight = 0
local moveSpeed = 20

-- =============================================
-- GIAO DIỆN GUI (THÊM NÚT CHỈNH ĐỐI DIỆN)
-- =============================================
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
local Main = Instance.new("Frame", ScreenGui)
Main.Size = UDim2.new(0, 280, 0, 500)
Main.Position = UDim2.new(0.7, 0, 0.2, 0)
Main.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Main.Active = true
Main.Draggable = true
Instance.new("UICorner", Main)

local function CreateSlider(name, pos, min, max, default, callback)
    local label = Instance.new("TextLabel", Main)
    label.Size = UDim2.new(0.9, 0, 0, 20)
    label.Position = pos
    label.Text = name .. ": " .. default
    label.TextColor3 = Color3.new(1, 1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium

    local sliderFrame = Instance.new("Frame", Main)
    sliderFrame.Size = UDim2.new(0.8, 0, 0, 4)
    sliderFrame.Position = pos + UDim2.new(0.05, 0, 0.05, 0)
    sliderFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

    local btn = Instance.new("TextButton", sliderFrame)
    btn.Size = UDim2.new(0, 14, 0, 14)
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
    btn.Text = ""
    btn.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
    Instance.new("UICorner", btn)

    local dragging = false
    btn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

    RunService.RenderStepped:Connect(function()
        if dragging then
            local mousePos = UserInputService:GetMouseLocation().X
            local relativePos = math.clamp((mousePos - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
            btn.Position = UDim2.new(relativePos, 0, 0.5, 0)
            local val = math.floor(min + (relativePos * (max - min)))
            label.Text = name .. ": " .. val
            callback(val)
        end
    end)
end

CreateSlider("Khoảng cách", UDim2.new(0.05, 0, 0.08, 0), -20, 20, 5, function(v) offsetForward = v end)
CreateSlider("Lệch Trái/Phải", UDim2.new(0.05, 0, 0.18, 0), -15, 15, 0, function(v) offsetRight = v end)
CreateSlider("Tốc độ bám", UDim2.new(0.05, 0, 0.28, 0), 0, 100, 20, function(v) moveSpeed = v end)

local FaceBtn = Instance.new("TextButton", Main)
FaceBtn.Size = UDim2.new(0.9, 0, 0, 35)
FaceBtn.Position = UDim2.new(0.05, 0, 0.38, 0)
FaceBtn.Text = "CHẾ ĐỘ: ĐỐI DIỆN MẶT"
FaceBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 120)
FaceBtn.TextColor3 = Color3.new(1, 1, 1)
FaceBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", FaceBtn)

FaceBtn.MouseButton1Click:Connect(function()
