-- =============================================
-- LOGIC ĐỒNG BỘ SIÊU TỐC
-- =============================================

local function InstantSyncAnims(tChar)
    local tHum = tChar:FindFirstChildOfClass("Humanoid")
    local myHum = client.Character and client.Character:FindFirstChildOfClass("Humanoid")
    if tHum and myHum then
        local tTracks = tHum:GetPlayingAnimationTracks()
        local myTracks = myHum:GetPlayingAnimationTracks()
        for _, myTrack in pairs(myTracks) do
            local exists = false
            for _, tTrack in pairs(tTracks) do
                if tTrack.Animation.AnimationId == myTrack.Animation.AnimationId then exists = true break end
            end
            if not exists then myTrack:Stop(0) end
        end
        for _, tTrack in pairs(tTracks) do
            local isPlaying = false
            for _, myTrack in pairs(myTracks) do
                if myTrack.Animation.AnimationId == tTrack.Animation.AnimationId then
                    isPlaying = true
                    if math.abs(myTrack.TimePosition - tTrack.TimePosition) > 0.05 then myTrack.TimePosition = tTrack.TimePosition end
                    myTrack:AdjustSpeed(tTrack.Speed)
                    break
                end
            end
            if not isPlaying then
                local anim = myHum:LoadAnimation(tTrack.Animation)
                anim:Play(0)
                anim.TimePosition = tTrack.TimePosition
            end
        end
    end
end

RunService.PreRender:Connect(function()
    if not active or not targetPlayer or not targetPlayer.Character then return end
    
    local myChar = client.Character
    local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("TorsoRot"))
    local tChar = targetPlayer.Character
    local tHrp = tChar:FindFirstChild("TorsoRot") or tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Base")

    if myHrp and tHrp then
        -- Vị trí bám dựa trên Offset
        -- Mẹo: Nếu đối diện mặt, mình đứng phía trước (Z âm) và xoay ngược lại
        local goalCF
        if faceEachOther then
            -- Đứng trước mặt mục tiêu và nhìn thẳng vào mục tiêu
            goalCF = tHrp.CFrame * CFrame.new(offsetRight, 0, -offsetForward) * CFrame.Angles(0, math.pi, 0)
        else
            -- Đứng cùng hướng (bám sau lưng hoặc đứng cạnh)
            goalCF = tHrp.CFrame * CFrame.new(offsetRight, 0, -offsetForward)
        end
        
        local speed = math.clamp(moveSpeed / 100, 0.1, 1)
        myHrp.CFrame = myHrp.CFrame:Lerp(goalCF, speed)
        
        InstantSyncAnims(tChar)
        
        myHrp.Velocity = Vector3.new(0,0,0)
        for _, part in pairs(myChar:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)
