local Scroll = Instance.new("ScrollingFrame", Main)
Scroll.Size = UDim2.new(0.9, 0, 0.3, 0)
Scroll.Position = UDim2.new(0.05, 0, 0.48, 0)
Scroll.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
Instance.new("UIListLayout", Scroll)

local function RefreshList()
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= client then
            local b = Instance.new("TextButton", Scroll)
            b.Size = UDim2.new(1, -5, 0, 25)
            b.Text = p.DisplayName or p.Name
            b.BackgroundColor3 = (targetPlayer == p) and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(30, 30, 30)
            b.TextColor3 = (targetPlayer == p) and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
            b.MouseButton1Click:Connect(function() targetPlayer = p RefreshList() end)
        end
    end
end
Players.PlayerAdded:Connect(RefreshList)
Players.PlayerRemoving:Connect(RefreshList)
RefreshList()

