local function GetObjectsFromPath(pathStr)
    if pathStr == "workspace.Players" or pathStr == "Players" then
        return Players
    end
    
    local obj = game
    local parts = string.split(pathStr, ".")
    for _, part in ipairs(parts) do
        if part ~= "" and obj then
            pcall(function()
                if obj == game and game:GetService(part) then
                    obj = game:GetService(part)
                else
                    obj = obj:FindFirstChild(part)
                end
            end)
        end
    end
    return obj
end

local ExecSelectedPlayers = {}
local playerButtonCache = {}

local function UpdateExecPlayerList()
    local pathStr = PathBox.Text
    local parentObj = GetObjectsFromPath(pathStr)
    if not parentObj then return end

    local childrenList = {}
    if parentObj == Players or parentObj:IsA("Players") then
        childrenList = Players:GetPlayers()
    else
        childrenList = parentObj:GetChildren()
    end

    local myRoot = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("RootPart"))
    local unsortedList = {}
    local maxDistLimit = tonumber(DistanceBox.Text) or 50

    for _, child in ipairs(childrenList) do
        if child ~= LocalPlayer then
            local targetChar = child:IsA("Player") and child.Character or (child:IsA("Model") and child)
            local targetHead = targetChar and (targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("RootPart") or targetChar:FindFirstChildWhichIsA("BasePart"))
            local dist = 999999

            if myRoot and targetHead then
                dist = math.floor((targetHead.Position - myRoot.Position).Magnitude)
            end

            table.insert(unsortedList, {
                Object = child,
                Name = child.Name,
                Distance = dist
            })
        end
    end

    table.sort(unsortedList, function(a, b)
        local inRangeA = (a.Distance <= maxDistLimit) and 1 or 0
        local inRangeB = (b.Distance <= maxDistLimit) and 1 or 0
        if inRangeA ~= inRangeB then
            return inRangeA > inRangeB
        end
        return a.Distance < b.Distance
    end)

    local currentNamesKey = ""
    for _, data in ipairs(unsortedList) do
        currentNamesKey = currentNamesKey .. data.Name .. ","
    end

    if ExecPlrScroll:GetAttribute("CachedKeys") ~= currentNamesKey then
        ExecPlrScroll:SetAttribute("CachedKeys", currentNamesKey)
        for _, child in ipairs(ExecPlrScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        playerButtonCache = {}

        for index, data in ipairs(unsortedList) do
            local nameToCheck = data.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, -5, 0, 25)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 11
            Btn.LayoutOrder = index
            Btn.Parent = ExecPlrScroll
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

            local function RefreshBtnStyle()
                if ExecSelectedPlayers[nameToCheck] then
                    Btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
                    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
                    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
                end
            end
            RefreshBtnStyle()

            Btn.MouseButton1Click:Connect(function()
                ExecSelectedPlayers[nameToCheck] = not ExecSelectedPlayers[nameToCheck] and true or nil
                RefreshBtnStyle()
            end)

            playerButtonCache[nameToCheck] = Btn
        end
    end

    for index, data in ipairs(unsortedList) do
        local nameToCheck = data.Name
        local Btn = playerButtonCache[nameToCheck]
        if Btn then
            Btn.LayoutOrder = index
            if data.Distance <= maxDistLimit and data.Distance ~= 999999 then
                Btn.Text = string.format("🌟 [Gần bạn] %s [%dm]", nameToCheck, data.Distance)
            elseif data.Distance ~= 999999 then
                Btn.Text = string.format("%s [%dm]", nameToCheck, data.Distance)
            else
                Btn.Text = string.format("%s [N/A]", nameToCheck)
            end
        end
    end
end

