local function SaveDataToFile()
    if not writefile then return end
    local exportTable = {}
    for _, item in ipairs(RemotesList) do
        table.insert(exportTable, {
            Name = item.Name,
            Code = item.Code,
            Mode = item.Mode,
            Value = item.Value,
            Distance = item.Distance,
            UseMouseClick = item.UseMouseClick,
            KeyName = item.Key and item.Key.Name or nil
        })
    end
    pcall(function()
        writefile(SaveFileName, HttpService:JSONEncode(exportTable))
    end)
end

local function ExecuteSmartRemote(itemData)
    local targetNamesToRun = {}
    local maxDist = tonumber(itemData.Distance) or 50
    local myRoot = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("RootPart"))

    if myRoot then
        local pathStr = PathBox.Text
        local parentObj = GetObjectsFromPath(pathStr)
        if parentObj then
            local childrenList = (parentObj == Players or parentObj:IsA("Players")) and Players:GetPlayers() or parentObj:GetChildren()
            
            for _, child in ipairs(childrenList) do
                if child ~= LocalPlayer and ExecSelectedPlayers[child.Name] then
                    local targetChar = child:IsA("Player") and child.Character or (child:IsA("Model") and child)
                    local targetHead = targetChar and (targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("RootPart") or targetChar:FindFirstChildWhichIsA("BasePart"))
                    
                    if targetHead then
                        local dist = (targetHead.Position - myRoot.Position).Magnitude
                        if dist <= maxDist then
                            table.insert(targetNamesToRun, { Name = child.Name, Distance = dist })
                        end
                    end
                end
            end
        end
    end

    table.sort(targetNamesToRun, function(a, b)
        return a.Distance < b.Distance
    end)

    if #targetNamesToRun == 0 then
        return
    end

    local nearestTarget = targetNamesToRun[1].Name

    local codeToRun = itemData.Code
    codeToRun = string.gsub(codeToRun, '"Name"', '"' .. nearestTarget .. '"')
    codeToRun = string.gsub(codeToRun, "'Name'", "'" .. nearestTarget .. "'")
    codeToRun = string.gsub(codeToRun, "Name", nearestTarget)

    local func, err = loadstring(codeToRun)
    if func then
        task.spawn(function() pcall(func) end)
    end
end

