UserInputService.InputBegan:Connect(function(input, gpe)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if IsBindingToggleGuiKey then
            ToggleGuiKey = input.KeyCode
            ToggleKeyBindBtn.Text = "Phím Ẩn/Hiện: " .. input.KeyCode.Name
            ToggleKeyBindBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 180)
            IsBindingToggleGuiKey = false
            SaveSettingsToFile()
            return
        end

        if IsBindingESPKey then
            ESPToggleKey = input.KeyCode
            ESPKeyBindBtn.Text = "Phím ESP: " .. input.KeyCode.Name
            ESPKeyBindBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 180)
            IsBindingESPKey = false
            SaveSettingsToFile()
            return
        end

        if input.KeyCode == ToggleGuiKey and not gpe then
            MainFrame.Visible = not MainFrame.Visible
            return
        end

        if input.KeyCode == ESPToggleKey and not gpe then
            ESPEnabled = not ESPEnabled
            return
        end

        if input.KeyCode == Enum.KeyCode.T and not gpe and ExecContainer.Visible then
            local typing = UserInputService:GetFocusedTextBox()
            if not typing then
                local pathStr = PathBox.Text
                local parentObj = GetObjectsFromPath(pathStr)
                if parentObj then
                    local childrenList = (parentObj == Players or parentObj:IsA("Players")) and Players:GetPlayers() or parentObj:GetChildren()
                    for _, child in ipairs(childrenList) do
                        if child ~= LocalPlayer then
                            ExecSelectedPlayers[child.Name] = true
                        end
                    end
                    UpdateExecPlayerList()
                end
                return
            end
        end

        -- Gán phím cho tab Remote Exec
        if ActiveBindingItem then
            ActiveBindingItem.Key = input.KeyCode
            ActiveBindingItem.KeyBtn.Text = input.KeyCode.Name
            ActiveBindingItem.KeyBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 180)
            ActiveBindingItem = nil
            SaveDataToFile()
            return
        end

        -- Gán phím cho tab Multi-Kill
        if ActiveTargetBindingItem then
            ActiveTargetBindingItem.Key = input.KeyCode
            ActiveTargetBindingItem.KeyBtn.Text = input.KeyCode.Name
            ActiveTargetBindingItem.KeyBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 180)
            ActiveTargetBindingItem = nil
            SaveTargetDataToFile()
            return
        end

        if IsBindingGlobalKey then
            KillGlobalKey = input.KeyCode
            GlobalKeyBtn.Text = "Phím: " .. input.KeyCode.Name
            GlobalKeyBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 30)
            IsBindingGlobalKey = false
            return
        end

        -- Kích hoạt phím cho tab Remote Exec
        for _, item in ipairs(RemotesList) do
            if item.Key and input.KeyCode == item.Key and not gpe then
                item:ToggleOrExecute()
            end
        end

        -- Kích hoạt phím cho tab Multi-Kill (Bật/Tắt trạng thái vòng lặp lệnh)
        for _, item in ipairs(TargetRemotesList) do
            if item.Key and input.KeyCode == item.Key and not gpe then
                item:ToggleOrExecute()
            end
        end
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        for _, item in ipairs(RemotesList) do
            if item.IsActive and item.UseMouseClick then
                if item.Mode == 1 then
                    pcall(function() ExecuteSmartRemote(item) end)
                elseif item.Mode == 2 then
                    local count = math.clamp(math.floor(item.Value), 1, 500)
                    for i = 1, count do
                        task.spawn(function() pcall(function() ExecuteSmartRemote(item) end) end)
                    end
                end
            end
        end
    end
end)

