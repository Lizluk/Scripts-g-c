local function applyCustomESP(targetModel)
    if not targetModel:IsA("Model") then return end
    if targetModel.Name == LocalPlayer.Name then return end

    local targetPart = targetModel:FindFirstChild("Head") 
        or targetModel:FindFirstChild("RootPart") 
        or targetModel:FindFirstChild("HumanoidRootPart") 
        or targetModel:FindFirstChildWhichIsA("BasePart")

    if not targetPart then return end
    if targetPart:FindFirstChild("CustomPlayerESP") then targetPart.CustomPlayerESP:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "CustomPlayerESP"
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = targetPart
    bb.Parent = targetPart

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 14
    txt.Parent = bb

    if not targetModel:FindFirstChild("CustomESP_Highlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "CustomESP_Highlight"
        highlight.Adornee = targetModel
        highlight.Parent = targetModel
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.6
        highlight.OutlineTransparency = 0
    end

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not targetModel:IsDescendantOf(workspace) or not targetPart:IsDescendantOf(targetModel) or not LocalPlayer.Character or not (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("RootPart")) then
            connection:Disconnect()
            bb:Destroy()
            if targetModel:FindFirstChild("CustomESP_Highlight") then
                targetModel.CustomESP_Highlight:Destroy()
            end
            return
        end

        if not ESPEnabled then
            txt.Visible = false
            if targetModel:FindFirstChild("CustomESP_Highlight") then
                targetModel.CustomESP_Highlight.Enabled = false
            end
            return
        else
            txt.Visible = true
            if targetModel:FindFirstChild("CustomESP_Highlight") then
                targetModel.CustomESP_Highlight.Enabled = true
            end
        end

        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("RootPart")
        local distance = math.floor((myRoot.Position - targetPart.Position).Magnitude)
        local maxDistLimit = tonumber(DistanceBox.Text) or 50
        
        local isTarget = ExecSelectedPlayers[targetModel.Name] or SelectedPlayers[targetModel.Name]
        local prefix = ""
        if distance <= maxDistLimit then
            prefix = "🌟 [Gần bạn]\n"
        end

        if isTarget then
            txt.Text = string.format("%s[🎯 TARGET] %s\n[%d m]", prefix, targetModel.Name, distance)
            txt.TextColor3 = Color3.fromRGB(255, 50, 50)
        else
            txt.Text = string.format("%s%s\n[%d m]", prefix, targetModel.Name, distance)
            if distance <= maxDistLimit then
                txt.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                txt.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end
    end)
end

local function InitESPWatcher()
    local function applyStandardESP(player)
        if player == LocalPlayer then return end
        local function onChar(char)
            applyCustomESP(char)
        end
        player.CharacterAdded:Connect(onChar)
        if player.Character then onChar(player.Character) end
    end

    for _, p in pairs(Players:GetPlayers()) do applyStandardESP(p) end
    Players.PlayerAdded:Connect(applyStandardESP)
end

InitESPWatcher()

