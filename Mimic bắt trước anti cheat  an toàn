-- =============================================
-- LOGIC DI CHUYỂN TỰ NHIÊN (FIXED SPEED BAN)
-- =============================================
RunService.Heartbeat:Connect(function()
    if not active or not targetPlayer or not targetPlayer.Character then return end
    local myChar = lp.Character; local tChar = targetPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

    if myHrp and tHrp and myHum and tHum then
        -- 1. GIỚI HẠN TỐC ĐỘ AN TOÀN (Không để nhảy lên quá cao)
        myHum.WalkSpeed = math.min(Config.S, 40) 
        
        local goalCF = tHrp.CFrame * CFrame.new(Config.R, Config.H, -Config.F)
        if faceEachOther then goalCF = goalCF * CFrame.Angles(0, math.pi, 0) end
        
        -- 2. KIỂM TRA KHOẢNG CÁCH (Nếu quá xa thì không TP, chỉ đi bộ)
        local dist = (myHrp.Position - goalCF.Position).Magnitude
        
        if dist > 0.5 then
            myHum:MoveTo(goalCF.Position) -- Đi bộ tự nhiên
        end
        
        -- 3. CHỈ LERP NHẸ KHI ĐÃ ĐẾN GẦN (Để dính tư thế nằm/nghiêng)
        if dist < 3 then
            myHrp.CFrame = myHrp.CFrame:Lerp(goalCF, 0.15)
        end

        -- Animation Sync
        local tTracks = tHum:GetPlayingAnimationTracks()
        local myTracks = myHum:GetPlayingAnimationTracks()
        for _, mt in pairs(myTracks) do
            local exists = false
            for _, tt in pairs(tTracks) do if tt.Animation.AnimationId == mt.Animation.AnimationId then exists = true break end end
            if not exists then mt:Stop(0) end 
        end
        for _, tt in pairs(tTracks) do
            local isPlay = false
            for _, mt in pairs(myTracks) do if mt.Animation.AnimationId == tt.Animation.AnimationId then isPlay = true; mt.TimePosition = tt.TimePosition; mt:AdjustSpeed(tt.Speed) break end end
            if not isPlay then myHum:LoadAnimation(tt.Animation):Play(0.1) end
        end
    end
end)
