                        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

                        if targetRoot then
                            local currentDist = (myRoot.Position - targetRoot.Position).Magnitude
                            if currentDist <= maxDetectDistance then
                                pcall(function()
                                    local ohString1 = "Grab"
                                    local ohTable2 = {
                                        [1] = targetRoot,
                                        [2] = GRAB_OFFSET_CFRAME
                                    }
                                    activateAbilityRemote:FireServer(ohString1, ohTable2)
                                end)
                            end
                        end
                    end
                end
            end
        end
        task.wait(grabCooldown)
    end
end)

