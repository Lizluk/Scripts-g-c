local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")

-- Hàm quét tìm tất cả các mục có tên "ToolClient" nằm trong bất kỳ vũ khí nào
local function getTargetToolClients()
    local targets = {}
    
    -- 1. Quét trong Backpack (Túi đồ)
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") or tool:IsA("Model") then
            -- Tìm trực tiếp con mang tên ToolClient
            local clientScript = tool:FindFirstChild("ToolClient")
            if clientScript then
                table.insert(targets, clientScript)
            end
        end
    end
    
    -- 2. Quét trong Character (Khi đang cầm trên tay)
    local character = player.Character
    if character then
        for _, tool in pairs(character:GetChildren()) do
            if tool:IsA("Tool") or tool:IsA("Model") then
                local clientScript = tool:FindFirstChild("ToolClient")
                if clientScript then
                    table.insert(targets, clientScript)
                end
            end
        end
    end
    
    return targets
end

-- =============================================
-- KHỞI CHẠY NHÂN BẢN SIÊU TỐC
-- =============================================
local function cloneToolClients(multiplier)
    local toolClients = getTargetToolClients()
    local totalCloned = 0
    
    print("\n" .. string.rep("=", 70))
    print("💎 LIZLUK SUPER CLONE V3 - MULTIPLIER: x" .. multiplier)
    print(string.rep("=", 70))
    
    if #toolClients == 0 then
        print("❌ CẢNH BÁO: Không tìm thấy file 'ToolClient' nào trong các vũ khí hiện tại!")
        return 0
    end
    
    for _, originalScript in pairs(toolClients) do
        local parentWeapon = originalScript.Parent
        print(string.format("→ Đang xử lý ToolClient của vũ khí: [%s]", parentWeapon.Name))
        
        -- Mở khóa quyền sao chép vật thể
        originalScript.Archivable = true
        
        for i = 1, multiplier - 1 do
            -- Thử cách 1: Sao chép trực tiếp bằng hàm Clone hệ thống
            local success, clone = pcall(function() 
                return originalScript:Clone() 
            end)
            
            if success and clone then
                clone.Parent = parentWeapon
                totalCloned = totalCloned + 1
            else
                -- Cách 2 (Dự phòng cho Solara): Tự tạo một Instance mới trùng tên nếu bị chặn Clone
                local backupClone = Instance.new(originalScript.ClassName or "LocalScript")
                backupClone.Name = "ToolClient"
                backupClone.Parent = parentWeapon
                totalCloned = totalCloned + 1
            end
        end
        print(string.format("   ✓ Đã nhân bản xong x%d bản sao cho [%s]", multiplier - 1, parentWeapon.Name))
    end
    
    print(string.rep("=", 70))
    print("🔥 Hoàn thành! Tổng cộng đã nhân bản: " .. totalCloned)
    return totalCloned
end

-- =============================================
-- XÓA TẤT CẢ CLONES (GIỮ LẠI ĐÚNG 1 GỐC)
-- =============================================
local function deleteClonedScripts()
    local totalDeleted = 0
    
    -- Quét dọn trong Backpack
    for _, tool in pairs(backpack:GetChildren()) do
        local list = {}
        for _, child in pairs(tool:GetChildren()) do
            if child.Name == "ToolClient" then
                table.insert(list, child)
            end
        end
        if #list > 1 then
            for i = 2, #list do
                list[i]:Destroy()
                totalDeleted = totalDeleted + 1
            end
        end
    end
    
    -- Quét dọn trong Character
    local character = player.Character
    if character then
        for _, tool in pairs(character:GetChildren()) do
            local list = {}
            for _, child in pairs(tool:GetChildren()) do
                if child.Name == "ToolClient" then
                    table.insert(list, child)
                end
            end
            if #list > 1 then
                for i = 2, #list do
                    list[i]:Destroy()
                    totalDeleted = totalDeleted + 1
                end
            end
        end
    end
    
    return totalDeleted
end

