local isChamberedON = false

-- Hàm cập nhật giao diện nút Chambered
local function toggleChamberedState(state)
	if state ~= nil then
		isChamberedON = state
	else
		isChamberedON = not isChamberedON
	end

	if isChamberedON then
		chamberBtn.Text = "Chambered: ON (F2)"
		chamberBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
	else
		chamberBtn.Text = "Chambered: OFF (F2)"
		chamberBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

-- Bấm chuột vào nút trên GUI
chamberBtn.MouseButton1Click:Connect(function()
	toggleChamberedState()
end)

-- Hàm quét và cập nhật các chỉ số của tất cả súng
local function applyWeaponStats()
	local magValue = tonumber(magBox.Text)
	local fireValue = tonumber(fireBox.Text)

	local searchContainers = {}
	if player:FindFirstChild("Backpack") then table.insert(searchContainers, player.Backpack) end
	if player.Character then table.insert(searchContainers, player.Character) end
	if player:FindFirstChild("Balo") then table.insert(searchContainers, player.Balo) end

	for _, container in ipairs(searchContainers) do
		for _, item in ipairs(container:GetDescendants()) do
			-- Tìm MagAmmo
			if item.Name == "MagAmmo" and (item:IsA("ValueBase") or item:IsA("DoubleConstrainedValue")) then
				if magValue then
					item.Value = magValue
				end
			end
			
			-- Tìm FireMode
			if item.Name == "FireMode" and item:IsA("ValueBase") then
				if fireValue then
					item.Value = fireValue
				end
			end
			
			-- Tìm Chambered (BoolValue)
			if item.Name == "Chambered" and item:IsA("BoolValue") then
				item.Value = isChamberedON
			end
		end
	end
end

-- Tự động chạy quét liên tục
task.spawn(function()
	while true do
		applyWeaponStats()
		task.wait(0.2)
	end
end)

-- Lắng nghe các phím bấm
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	-- Phím F1: Bật/Tắt giao diện
	if input.KeyCode == Enum.KeyCode.F1 then
		mainFrame.Visible = not mainFrame.Visible
	
	-- Phím F2: Bật/Tắt Chambered (Tích xanh / Bỏ tích)
	elseif input.KeyCode == Enum.KeyCode.F2 then
		toggleChamberedState()
	end
end)
