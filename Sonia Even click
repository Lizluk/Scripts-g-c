-- 2. LOGIC XỬ LÝ (INVOKE SERVER KHI BẤM F3)
local function executeAction()
    if isExecuting then return end
    isExecuting = true

    triggerBtn.BackgroundColor3 = Color3.fromRGB(200, 130, 30)
    triggerBtn.Text = "ĐANG GỬI..."
    
    local count = tonumber(countInput.Text) or 1

    task.spawn(function()
        for i = 1, count do
            statusLabel.Text = string.format("Đã gửi %d/%d", i, count)
            pcall(function()
                cardMatchRemote:InvokeServer(true)
            end)
            if count > 1 then
                task.wait(0.05)
            end
        end

        statusLabel.Text = "Hoàn thành! Chờ bấm tiếp..."
        triggerBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 250)
        triggerBtn.Text = "BẤM ĐỂ GỬI (F3)"
        isExecuting = false
    end)
end

-- Kích hoạt khi click nút trên UI
triggerBtn.MouseButton1Click:Connect(executeAction)

-- Kích hoạt trực tiếp khi nhấn F3
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F3 then
        executeAction()
    end
end)
