local function updateLists()
    for _, v in pairs(playerScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, v in pairs(stationScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end

    -- Update players
    local playerCount = 0
    for _, p in pairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton", playerScroll)
        btn.Size = UDim2.new(1, -5, 0, 28)
        btn.Text = (p == client) and "⭐ ME" or "👤 " .. p.Name
        btn.BackgroundColor3 = (targetPlayer == p) and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(40, 40, 40)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        Instance.new("UICorner", btn)
        
        btn.MouseButton1Click:Connect(function()
            movingTargetObj, currentTargetPos, selectedStationIdx = nil, nil, nil
            targetPlayer = p
            updateLists()
            
            local mode = (p == client) and "FOLLOW ME" or "FOLLOW " .. p.Name
            statusLabel.Text = string.format("Items: ∞ | %s", mode)
        end)
        
        playerCount = playerCount + 1
    end
    playerScroll.CanvasSize = UDim2.new(0, 0, 0, playerCount * 31)

    -- Update stations
    local stationCount = 0
    for i, data in pairs(savedStations) do
        local frame = Instance.new("Frame", stationScroll)
        frame.Size = UDim2.new(1, -5, 0, 28)
        frame.BackgroundTransparency = 1
        
        local btn = Instance.new("TextButton", frame)
        btn.Size = UDim2.new(0.7, 0, 1, 0)
        btn.Text = (data.Type == "Dynamic") and "🚚 ST-"..i or "📍 ST-"..i
        btn.BackgroundColor3 = (selectedStationIdx == i) and Color3.fromRGB(100, 100, 50) or Color3.fromRGB(35, 35, 35)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        Instance.new("UICorner", btn)
        
        btn.MouseButton1Click:Connect(function()
            targetPlayer = nil
            selectedStationIdx = i
            if data.Type == "Dynamic" then
                movingTargetObj = data.Object
                relativeOffset = data.Offset
                currentTargetPos = nil
            else
                currentTargetPos = data.Position
                movingTargetObj = nil
            end
            updateLists()
            statusLabel.Text = string.format("Items: ∞ | STATION %d", i)
        end)

        local del = Instance.new("TextButton", frame)
        del.Size = UDim2.new(0.3, 0, 1, 0)
        del.Position = UDim2.new(0.7, 0, 0, 0)
        del.Text = "❌"
        del.BackgroundColor3 = Color3.fromRGB(100, 40, 40)
        del.TextColor3 = Color3.new(1, 1, 1)
        del.Font = Enum.Font.GothamBold
        del.TextSize = 13
        Instance.new("UICorner", del)
        
        del.MouseButton1Click:Connect(function()
            table.remove(savedStations, i)
            saveToFile()  -- Lưu ngay khi xóa
            if selectedStationIdx == i then selectedStationIdx = nil end
            updateLists()
            
            game.StarterGui:SetCore("SendNotification", {
                Title = "🗑️ Deleted",
                Duration = 2,
                Text = string.format("Station #%d removed", i),
            })
        end)
        
        stationCount = stationCount + 1
    end
    stationScroll.CanvasSize = UDim2.new(0, 0, 0, stationCount * 31)
end

saveBtn.MouseButton1Click:Connect(function()
    local char = client.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local ray = Ray.new(hrp.Position, Vector3.new(0, -10, 0))
    local hit, _ = workspace:FindPartOnRayWithIgnoreList(ray, {char})
    
    if hit and not hit.Anchored and hit.Parent ~= workspace then
        -- Dynamic station (đứng trên object)
        table.insert(savedStations, {
            Type = "Dynamic", 
            Object = hit, 
            Offset = hit.CFrame:ToObjectSpace(hrp.CFrame)
        })
        print("✅ Saved Dynamic Station (cannot persist)")
    else
        -- Static station (vị trí cố định)
        table.insert(savedStations, {
            Type = "Static", 
            Position = hrp.Position
        })
        saveToFile()  -- Lưu vào file
        print("✅ Saved Static Station to file")
    end
    
    updateLists()
    
    game.StarterGui:SetCore("SendNotification", {
        Title = "💾 Station Saved",
        Duration = 2,
        Text = string.format("Station #%d saved!", #savedStations),
    })
end)

