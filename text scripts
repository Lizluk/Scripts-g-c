UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.G then
        inversionEnabled = not inversionEnabled
        
        if inversionEnabled then
            label.Text = "(G) Magnet: ON 🟢"
            label.TextColor3 = Color3.new(0, 1, 0)
            
            print("\n" .. string.rep("=", 60))
            print("🧲 MAGNET ENABLED - UNLIMITED MODE")
            print(string.rep("=", 60))
            
            game.StarterGui:SetCore("SendNotification", {
                Title = "🧲 Magnet ON",
                Duration = 2,
                Text = "Unlimited items - no drop!",
            })
        else
            label.Text = "(G) Magnet: OFF 🔴"
            label.TextColor3 = Color3.new(1, 0, 0)
            
            -- Xóa tất cả BodyPosition
            local folder = workspace:FindFirstChild(TARGET_FOLDER_NAME)
            if folder then
                for _, item in pairs(folder:GetChildren()) do
                    local p = item:FindFirstChildWhichIsA("BasePart") or item:FindFirstChild("Handle")
                    if p then
                        local bp = p:FindFirstChild("MagnetBodyPos")
                        if bp then bp:Destroy() end
                        p.CanCollide = true
                    end
                end
            end
            
            statusLabel.Text = "Items: 0 | Mode: OFF | ∞ UNLIMITED"
            
            print("\n" .. string.rep("=", 60))
            print("❌ MAGNET DISABLED - Items released")
            print(string.rep("=", 60))
            
            game.StarterGui:SetCore("SendNotification", {
                Title = "❌ Magnet OFF",
                Duration = 2,
                Text = "Items can drop now",
            })
        end
    end
end)

