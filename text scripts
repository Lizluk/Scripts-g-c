    ownershipClaimed = true
    
    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(client, "SimulationRadius", math.huge)
            sethiddenproperty(client, "MaxSimulationRadius", math.huge)
        end
    end)
    
    print("✅ Ownership claimed (infinite range)")
end

-- =============================================
-- LOGIC HÚT ĐỒ VẬT - UNLIMITED (KHÔNG GIỚI HẠN)
-- =============================================
local itemCount = 0

RunService.Heartbeat:Connect(function()
    if not inversionEnabled then return end
    
    claimOwnership()
    
    local destination = nil
    
    -- Tìm destination
    if targetPlayer and targetPlayer.Character and targetPlayer.Character.PrimaryPart then
        destination = (targetPlayer.Character.PrimaryPart.CFrame * relativeOffset).Position
    elseif movingTargetObj and movingTargetObj.Parent then
        destination = (movingTargetObj.CFrame * relativeOffset).Position
    elseif currentTargetPos then
        destination = (CFrame.new(currentTargetPos) * relativeOffset).Position
    end
    
    if not destination then return end
    
    -- Hút TẤT CẢ items (KHÔNG GIỚI HẠN)
    local folder = workspace:FindFirstChild(TARGET_FOLDER_NAME)
    if not folder then return end
    
    itemCount = 0
    for _, item in pairs(folder:GetChildren()) do
        local p = item:FindFirstChildWhichIsA("BasePart") or item:FindFirstChild("Handle")
        
        if p and not p.Anchored then
            itemCount = itemCount + 1
            
            -- Dùng BodyPosition để GIỮ CHẶT (không rơi)
            local bp = p:FindFirstChild("MagnetBodyPos")
            if not bp then
                bp = Instance.new("BodyPosition")
                bp.Name = "MagnetBodyPos"
                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)  -- Lực vô hạn
                bp.D = 500  -- Damping
                bp.P = 3000  -- Power
                bp.Parent = p
            end
            
            bp.Position = destination
            p.CanCollide = false
            
            -- Giảm velocity nếu đến gần
            local dist = (destination - p.Position).Magnitude
            if dist < 5 then
                p.Velocity = p.Velocity * 0.5
            end
        end
    end
end)

