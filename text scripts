-- =============================================
-- LƯU/TẢI FILE (PERSISTENT STORAGE)
-- =============================================
local function saveToFile()
    if not writefile then 
        warn("⚠️ writefile not supported!")
        return 
    end
    
    local dataToSave = {}
    for i, station in ipairs(savedStations) do
        if station.Type == "Static" and station.Position then
            table.insert(dataToSave, {
                Type = "Static",
                Position = {
                    X = station.Position.X,
                    Y = station.Position.Y,
                    Z = station.Position.Z
                }
            })
        end
        -- Dynamic stations không lưu được (vì object có thể mất)
    end
    
    local success, err = pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(dataToSave))
    end)
    
    if success then
        print(string.format("✅ Saved %d stations to file", #dataToSave))
    else
        warn("❌ Save failed:", err)
    end
end

local function loadFromFile()
    if not isfile or not readfile then 
        print("⚠️ File functions not supported")
        return 
    end
    
    if not isfile(SAVE_FILE) then
        print("ℹ️ No save file found, starting fresh")
        return
    end
    
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(SAVE_FILE))
    end)
    
    if success and result then
        savedStations = {}
        for _, data in ipairs(result) do
            if data.Type == "Static" and data.Position then
                table.insert(savedStations, {
                    Type = "Static",
                    Position = Vector3.new(
                        data.Position.X,
                        data.Position.Y,
                        data.Position.Z
                    )
                })
            end
        end
        print(string.format("✅ Loaded %d stations from file", #savedStations))
    else
        warn("❌ Load failed:", result)
    end
end

