        dBtn.TextColor3=Color3.new(1,1,1); dBtn.Font=Enum.Font.GothamBold; dBtn.TextSize=10; dBtn.BorderSizePixel=0
        Instance.new("UICorner",dBtn).CornerRadius=UDim.new(0,4)
        dBtn.MouseButton1Click:Connect(function() table.remove(savedStations,i); saveToFile(); updateStationList() end)
    end
    stationScroll.CanvasSize=UDim2.new(0,0,0,(#savedStations+1)*29)
end

-- =============================================
-- TOGGLE SYSTEM
-- =============================================
local function toggle()
    inversionEnabled = not inversionEnabled
    if inversionEnabled then
        label.Text="(G) System: ON 🟢"; label.TextColor3=Color3.new(0,1,0)
        if not targetPlayer and not currentTargetPos then targetPlayer=client end
        startHeartbeat()
        startScanLoop()
        
        local df = workspace:FindFirstChild("DebrisField")
        if df then
            for _, v in ipairs(df:GetChildren()) do
                if itemMatchesFilter(v) then
                    if v:IsA("BasePart") and not v.Anchored then
                        capturePart(v)
                    elseif v:IsA("Model") or v:IsA("Folder") then
                        for _, child in ipairs(v:GetChildren()) do
                            if child:IsA("BasePart") and not child.Anchored then capturePart(child) end
                        end
                    end
                end
            end
        end
        game.StarterGui:SetCore("SendNotification",{Title="✅ System Activated",Duration=2,Text="Chế độ: "..currentSystemMode})
    else
        label.Text="(G) System: OFF 🔴"; label.TextColor3=Color3.new(1,0,0)
        stopHeartbeat(); stopScanLoop(); releaseAll()
        statusLabel.Text="Items: 0 | Target: OFF | Filter: ALL"
        game.StarterGui:SetCore("SendNotification",{Title="❌ System Deactivated",Duration=2,Text="Đã dừng quét"})
    end
end

