-- =============================================
-- REAL NAME EXTRACTOR
-- =============================================
local function getRealItemName(obj)
    if obj:IsA("BasePart") and not string.match(obj.Name, "^%d+$") then
        return obj.Name
    end
    local meshPart = obj:FindFirstChildWhichIsA("MeshPart") or obj:FindFirstChildWhichIsA("BasePart")
    if meshPart then return meshPart.Name end
    return obj.Name
end

local function itemMatchesFilter(obj)
    if selectedItemName == "ALL" then return true end
    return getRealItemName(obj) == selectedItemName
end

local function releaseMismatchedItems()
    if selectedItemName == "ALL" then return end
    for part, _ in pairs(capturedParts) do
        if part and part.Parent then
            local match = (part.Name == selectedItemName) or (part.Parent and getRealItemName(part.Parent) == selectedItemName)
            if not match then
                pcall(function()
                    if capturedParts[part].bp then capturedParts[part].bp:Destroy() end
                    if capturedParts[part].bg then capturedParts[part].bg:Destroy() end
                    part.CanCollide = true
                end)
                capturedParts[part] = nil
            end
        end
    end
end

