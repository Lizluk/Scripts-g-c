local function updatePlayerList()
    for _, v in ipairs(playerScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton", playerScroll)
        btn.Size=UDim2.new(1,-4,0,26); btn.LayoutOrder=count
        btn.Text=(plr==client) and "👤 "..plr.Name.." (ME)" or "👤 "..plr.Name
        btn.BackgroundColor3=(targetPlayer==plr) and Color3.fromRGB(60,60,20) or Color3.fromRGB(30,30,30)
        btn.TextColor3=Color3.new(1,1,1); btn.Font=Enum.Font.GothamBold; btn.TextSize=10
        btn.TextXAlignment=Enum.TextXAlignment.Left; btn.BorderSizePixel=0
        local pad=Instance.new("UIPadding",btn); pad.PaddingLeft=UDim.new(0,4)
        Instance.new("UICorner",btn).CornerRadius=UDim.new(0,4)
        btn.MouseButton1Click:Connect(function() targetPlayer=plr; currentTargetPos=nil; updatePlayerList() end)
