                })
                -- Chọn xong tự tắt chế độ Click đi để tránh nhấp nhầm về sau
                toggleClickToFilter()
            end
        end
    end
end)

-- =============================================
-- SYSTEM TARGET COORDINATES
-- =============================================
local function getTargetPos()
    if targetPlayer and targetPlayer.Character then
        local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position + Vector3.new(0, STACK_OFFSET_Y, 0) end
    end
    if currentTargetPos then return currentTargetPos end
    local rp = client.Character and client.Character:FindFirstChild("HumanoidRootPart")
    if rp then return (rp.CFrame * CFrame.new(0, STACK_OFFSET_Y, -3)).Position end
    return nil
end

-- =============================================
-- MAGNET CORE - HEARTBEAT
-- =============================================
local heartbeatConn = nil
local function startHeartbeat()
    if heartbeatConn then heartbeatConn:Disconnect() end
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not inversionEnabled then return end
        if currentSystemMode == "BRING" then return end 

        local targetPos = getTargetPos()
        if not targetPos then return end

        for part, data in pairs(capturedParts) do
            if not part or not part.Parent then
                capturedParts[part] = nil
                continue
            end
            local bp = data.bp
            if bp and bp.Parent then
                bp.Position = targetPos
                local dist = (targetPos - part.Position).Magnitude
                if dist < 3 then
                    part.Velocity = part.Velocity * 0.3
                    part.RotVelocity = part.RotVelocity * 0.3
                end
            end
        end
    end)
end

local function stopHeartbeat()
    if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
end

-- =============================================
-- CAPTURE/TELEPORT PART
-- =============================================
local function capturePart(part)
    if not part:IsA("BasePart") then return end
    if part.Anchored then return end
    
    local targetPos = getTargetPos()
    if not targetPos then return end

    claimOwnership(part)

    -- CHẾ ĐỘ BRING: TỐC BIẾN NGAY LẬP TỨC
    if currentSystemMode == "BRING" then
        pcall(function()
            part.Velocity = Vector3.new(0,0,0)
            part.RotVelocity = Vector3.new(0,0,0)
            part.CFrame = CFrame.new(targetPos) 
        end)
        return
    end

    -- CHẾ ĐỘ MAGNET: HÚT BÁM ĐUÔI
    if capturedParts[part] then return end
    
    local bp = Instance.new("BodyPosition", part)
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.D        = BP_DAMPING
    bp.P        = BP_POWER
    bp.Position = targetPos

    local bg = Instance.new("BodyGyro", part)
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.D = 200
    bg.P = 1000
    bg.CFrame = CFrame.new(part.Position)

    part.CanCollide = false
    capturedParts[part] = {bp=bp, bg=bg}
end

-- =============================================
-- SCAN INTERIOR
-- =============================================
local function scanAndCapture()
    local rp = client.Character and client.Character:FindFirstChild("HumanoidRootPart")
    if not rp then return end
    local myPos = rp.Position

    local debrisField = workspace:FindFirstChild("DebrisField")
    if debrisField then
        for _, obj in ipairs(debrisField:GetChildren()) do
            if itemMatchesFilter(obj) then
                if obj:IsA("BasePart") and not obj.Anchored then
                    local dist = (obj.Position - myPos).Magnitude
                    if dist <= AUTO_PICKUP_RADIUS then pcall(function() capturePart(obj) end) end
                elseif obj:IsA("Model") or obj:IsA("Folder") then
                    for _, child in ipairs(obj:GetChildren()) do
                        if child:IsA("BasePart") and not child.Anchored then
                            local dist = (child.Position - myPos).Magnitude
                            if dist <= AUTO_PICKUP_RADIUS then pcall(function() capturePart(child) end) end
                        end
                    end
                end
            end
        end
    end
end

-- =============================================
-- AUTO SCAN LOOP
-- =============================================
local scanConn = nil
local function startScanLoop()
    if scanConn then scanConn:Disconnect() end
    local t = 0
    scanConn = RunService.Heartbeat:Connect(function(dt)
        if not inversionEnabled then return end
        t = t + dt
        if t >= SCAN_INTERVAL then
            t = 0
            scanAndCapture()
        end
    end)
end
local function stopScanLoop()
    if scanConn then scanConn:Disconnect(); scanConn=nil end
end

