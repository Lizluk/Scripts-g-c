task.spawn(function()
    while true do
        if inversionEnabled then
            local count = 0
            for _ in pairs(capturedParts) do count += 1 end
            local mode = "FOLLOW ME"
            if targetPlayer and targetPlayer ~= client then
                mode = "→ " .. targetPlayer.Name
            elseif currentTargetPos then
                mode = "STATION"
            end
            statusLabel.Text = string.format("Items: %d | Target: %s | Sys: %s", count, mode, currentSystemMode)
        end
        task.wait(0.5)
    end
end)

