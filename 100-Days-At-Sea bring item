    local followBtn=Instance.new("TextButton",stationScroll)
    followBtn.Size=UDim2.new(1,-4,0,26); followBtn.LayoutOrder=0; followBtn.Text="📍 Follow Me"
    followBtn.BackgroundColor3=(targetPlayer==client and not currentTargetPos) and Color3.fromRGB(20,55,20) or Color3.fromRGB(30,30,30)
    followBtn.TextColor3=Color3.new(1,1,1); followBtn.Font=Enum.Font.GothamBold; followBtn.TextSize=10; followBtn.BorderSizePixel=0
    Instance.new("UICorner",followBtn).CornerRadius=UDim.new(0,4)
    followBtn.MouseButton1Click:Connect(function()
        targetPlayer=client; currentTargetPos=nil
        updatePlayerList(); updateStationList()
    end)

    for i, pos in ipairs(savedStations) do
        local entry=Instance.new("Frame",stationScroll)
        entry.Size=UDim2.new(1,-4,0,26); entry.LayoutOrder=i; entry.BackgroundTransparency=1

        local sBtn=Instance.new("TextButton",entry)
        sBtn.Size=UDim2.new(0.65,0,1,0); sBtn.Text="🎯 Stat "..i
        sBtn.BackgroundColor3=Color3.fromRGB(30,30,30); sBtn.TextColor3=Color3.new(1,1,1)
        sBtn.Font=Enum.Font.GothamBold; sBtn.TextSize=10; sBtn.BorderSizePixel=0
        Instance.new("UICorner",sBtn).CornerRadius=UDim.new(0,4)
        sBtn.MouseButton1Click:Connect(function()
            targetPlayer=nil; currentTargetPos=Vector3.new(pos.x,pos.y,pos.z)
            updatePlayerList(); updateStationList()
        end)

