local debrisField = workspace:FindFirstChild("DebrisField")
if debrisField then
    debrisField.ChildAdded:Connect(function(v)
        if not inversionEnabled then return end
        task.wait(0.15)
        local rp = client.Character and client.Character:FindFirstChild("HumanoidRootPart")
        if not rp then return end
        
        if itemMatchesFilter(v) then
            if v:IsA("BasePart") and not v.Anchored then
                local dist = (v.Position - rp.Position).Magnitude
                if dist <= AUTO_PICKUP_RADIUS then capturePart(v) end
            elseif v:IsA("Model") or v:IsA("Folder") then
                for _, child in ipairs(v:GetChildren()) do
                    if child:IsA("BasePart") and not child.Anchored then
                        local dist = (child.Position - rp.Position).Magnitude
                        if dist <= AUTO_PICKUP_RADIUS then capturePart(child) end
                    end
                end
            end
        end
    end)
end

