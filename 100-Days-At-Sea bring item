    -- Tìm xem vật phẩm có nằm trong DebrisField không
    local df = workspace:FindFirstChild("DebrisField")
    if df then
        local current = target
        local isInsideDebris = false
        local topObject = nil

        -- Đi ngược lên trên tổ hợp cha để check xem có thuộc DebrisField không
        while current and current ~= workspace do
