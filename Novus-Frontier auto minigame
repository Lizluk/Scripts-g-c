--[[
    AUTO QUICKTIME MINIGAME - Dino Survival
    GUI: QuickTimeGUI > Main > Bar > CanvasGroup
    
    Cách hoạt động:
    - Tìm đúng frame "Indicator" (kim trượt)
    - Tìm các frame "Target" (vùng vàng + xanh)
    - Bấm khi kim nằm trong bất kỳ vùng Target nào
    
    [P] = Bật/Tắt
]]

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")
local lp         = Players.LocalPlayer
local PlayerGui  = lp:WaitForChild("PlayerGui")

local ENABLED  = true
local COOLDOWN = 0.6   -- giây chờ sau click
local cooling  = false

-- ── Click tại tọa độ thực ──────────────────────────────────────
local function clickAt(x, y)
    if cooling then return end
    cooling = true
    pcall(mousemoveabs, x, y)
    task.wait(0.02)
    pcall(mouse1click)
    print(string.format("[QTE] ✅ Click! X=%.0f Y=%.0f", x, y))
    task.delay(COOLDOWN, function() cooling = false end)
end

-- ── MAIN LOOP ──────────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    if not ENABLED or cooling then return end

    -- Tìm đúng GUI tên "QuickTimeGUI"
    local qteGui = PlayerGui:FindFirstChild("QuickTimeGUI")
    if not qteGui or not qteGui.Enabled then return end

    local main = qteGui:FindFirstChild("Main")
    if not main or not main.Visible then return end

    local bar = main:FindFirstChild("Bar")
    if not bar or not bar.Visible then return end

    local canvas = bar:FindFirstChild("CanvasGroup")
    if not canvas then return end

    -- Lấy Indicator (kim trượt) — chứa 2 mũi tên
    local indicator = bar:FindFirstChild("Indicator")
    if not indicator or not indicator.Visible then return end

    -- Vị trí X hiện tại của kim (dùng arrow trên làm chuẩn)
    local arrow = indicator:FindFirstChild("arrow_drop_down")
        or indicator:FindFirstChildOfClass("ImageLabel")
        or indicator:FindFirstChildOfClass("Frame")
    
    local ptrX
    if arrow then
        ptrX = arrow.AbsolutePosition.X + arrow.AbsoluteSize.X / 2
    else
        ptrX = indicator.AbsolutePosition.X + indicator.AbsoluteSize.X / 2
    end

    local ptrY = bar.AbsolutePosition.Y + bar.AbsoluteSize.Y / 2

    -- Lấy tất cả frame "Target" trong CanvasGroup
    for _, target in pairs(canvas:GetChildren()) do
        if target.Name ~= "Target" then continue end
        if not target.Visible then continue end

        local tLeft  = target.AbsolutePosition.X
        local tRight = tLeft + target.AbsoluteSize.X
        local tCenterX = tLeft + target.AbsoluteSize.X / 2

        -- Kim đang nằm trong vùng Target → BẤM!
        if ptrX >= tLeft and ptrX <= tRight then
            clickAt(tCenterX, ptrY)
            return
        end
    end
end)

-- ── PHÍM TẮT ───────────────────────────────────────────────────
UIS.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.P then
        ENABLED = not ENABLED
        local msg = ENABLED and "✅ BẬT" or "❌ TẮT"
        print("[QTE] " .. msg)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification",
                {Title = "Auto QTE", Text = msg, Duration = 2})
        end)
    end
end)

-- ── KHỞI ĐỘNG ──────────────────────────────────────────────────
print("=========================================")
print(" AUTO QUICKTIME - Dino Survival")
print(" Chờ con báo vồ... tự động bấm!")
print(" [P] = Bật / Tắt")
print("=========================================")
pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title    = "Auto QTE ✅ Đang chạy",
        Text     = "Chờ con báo vồ... [P] để tắt/bật",
        Duration = 4,
    })
end)
