-- Hàm gửi lệnh tấn công chung
local Entities = workspace:FindFirstChild("Entities")

local function sendAttack()
    if not Entities then return end
    
    local targetsTable = {}
    local count = 0
    
    for _, entity in ipairs(Entities:GetChildren()) do
        if entity:FindFirstChild("Humanoid") and entity.Name ~= Player.Name then
            count = count + 1
            targetsTable[count] = entity
        end
    end
    
    if count > 0 then
        local loopCount = tonumber(countBox.Text) or 1
        for i = 1, loopCount do
            local ohTable1 = {
                ["attackType"] = "LightAttack",
                ["currentTime"] = tick(),
                ["combo"] = 1,
                ["id"] = tostring(math.random()) .. "/Client/RikaOrimoto_777",
                ["targets"] = targetsTable,
                ["flourishTimes"] = {},
                ["style"] = "Sword",
                ["TerrainDamage"] = true,
                ["startTime"] = tick(),
                ["stateTimers"] = {
                    ["Microstun"] = 0, ["Swing"] = tick(), ["FreeCharge"] = 0,
                    ["SwingCD"] = 0, ["Whifflag"] = 0, ["Charge"] = 0,
                    ["Block"] = 0, ["Knock"] = 0, ["Endlag"] = 0,
                    ["CantAttack"] = 0, ["Stun"] = 0, ["Dead"] = 0
                }
            }

            local attackEvent = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("AttackPlayer")
            if attackEvent then
                attackEvent:FireServer(ohTable1)
            end
        end
    end
end

-- 1. Xử lý Đè Giữ Chuột Trái liên tục
local isHoldClickActive = false
local isMouseDown = false

clickToggleBtn.MouseButton1Click:Connect(function()
    isHoldClickActive = not isHoldClickActive
    if isHoldClickActive then
        clickToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        clickToggleBtn.Text = "Đè Chuột Trái: BẬT"
    else
        clickToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        clickToggleBtn.Text = "Đè Chuột Trái: TẮT"
        isMouseDown = false
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.K then
            -- Bật/tắt phím K nhanh bằng bàn phím
            autoKeyBtn.MouseButton1Click:Fire()
        elseif isHoldClickActive and input.UserInputType == Enum.UserInputType.MouseButton1 then
            isMouseDown = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isMouseDown = false
    end
end)

-- Vòng lặp đè chuột trái (gọi liên tục theo delay khi đang giữ chuột)
task.spawn(function()
    while true do
        if isHoldClickActive and isMouseDown then
            sendAttack()
            local delayTime = tonumber(delayBox.Text) or 0.2
            task.wait(delayTime)
        else
            task.wait(0.05)
        end
    end
end)

