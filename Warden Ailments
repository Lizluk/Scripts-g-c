task.spawn(function()
    local cachedDataFolder = nil

    while true do
        if isLocking then
            -- Tối ưu hóa việc Cache folder Data để tránh quét Workspace liên tục
            if not cachedDataFolder or not cachedDataFolder:IsDescendantOf(workspace) then
                local charactersFolder = workspace:FindFirstChild("Characters")
                local myCharacter = charactersFolder and charactersFolder:FindFirstChild(client.Name)
                cachedDataFolder = myCharacter and myCharacter:FindFirstChild("Ailments")
            end
            
            if cachedDataFolder then
                -- Ép giá trị thuộc tính GUI
                for attributeName, attributeValue in pairs(attributesConfig) do
                    if cachedDataFolder:GetAttribute(attributeName) ~= nil then
                        cachedDataFolder:SetAttribute(attributeName, attributeValue)
                    end
                end
                
                -- Ép giá trị Boolean
                for boolName, boolValue in pairs(booleanConfig) do
                    if cachedDataFolder:GetAttribute(boolName) ~= nil then
                        cachedDataFolder:SetAttribute(boolName, boolValue)
                    end
                end
            end
        else
            cachedDataFolder = nil -- Reset cache khi tắt khóa
        end
        task.wait(0.1) -- Giới hạn 10 FPS cho việc ghi dữ liệu (Không lag máy)
    end
end)

-- Phím tắt J để Toggle Menu
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.J then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

