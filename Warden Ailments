-- Hàm tạo hàng nhập liệu (Tối ưu hóa UI elements)
local function generateUIEntry(name, defaultValue)
    local container = Instance.new("Frame")
    container.Name = name
    container.Size = UDim2.new(1, -6, 0, 32)
    container.BackgroundTransparency = 1
    container.Parent = ScrollingFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 140, 1, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = "📍 " .. name
    label.TextColor3 = Color3.fromRGB(210, 210, 210)
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 110, 0, 28)
    box.Position = UDim2.new(1, -115, 0, 2)
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    box.BorderSizePixel = 0
    box.Text = defaultValue
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 13
    box.Font = Enum.Font.Gotham
    box.Parent = container

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 5)
    boxCorner.Parent = box

    uiBoxes[name] = box
end

-- Sinh toàn bộ danh sách ô nhập liệu
local itemCount = 0
for attrName, defaultVal in pairs(attributesConfig) do
    generateUIEntry(attrName, defaultVal)
