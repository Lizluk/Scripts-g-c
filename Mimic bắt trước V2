local function CreateSlider(name, prop, pos, min, max, default)
    local label = Instance.new("TextLabel", Main); label.Size = UDim2.new(0.9, 0, 0, 20); label.Position = pos
    label.Text = name .. ": " .. default; label.TextColor3 = Color3.new(1, 1, 1); label.BackgroundTransparency = 1
    local sliderFrame = Instance.new("Frame", Main); sliderFrame.Size = UDim2.new(0.8, 0, 0, 4); sliderFrame.Position = pos + UDim2.new(0.05, 0, 0.05, 5)
    sliderFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    local btn = Instance.new("TextButton", sliderFrame); btn.Size = UDim2.new(0, 16, 0, 16); btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0); btn.Text = ""; btn.BackgroundColor3 = Color3.fromRGB(0, 255, 150); Instance.new("UICorner", btn)
    local dragging = false
    btn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    RunService.RenderStepped:Connect(function()
        if dragging then
            local rel = math.clamp((UserInputService:GetMouseLocation().X - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
            btn.Position = UDim2.new(rel, 0, 0.5, 0); local val = math.floor(min + (rel * (max - min)))
            label.Text = name .. ": " .. val; Config[prop] = val
        end
    end)
end

