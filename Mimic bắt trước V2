local function RefreshList()
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            local item = Instance.new("Frame", Scroll); item.Size = UDim2.new(1, -10, 0, 50); item.BackgroundTransparency = 1
            local b = Instance.new("TextButton", item); b.Size = UDim2.new(1, 0, 1, 0); b.Text = ""
            b.BackgroundColor3 = (targetPlayer == p) and Color3.fromRGB(0, 150, 120) or Color3.fromRGB(35, 35, 45); Instance.new("UICorner", b)
            
            local img = Instance.new("ImageLabel", item); img.Size = UDim2.new(0, 40, 0, 40); img.Position = UDim2.new(0, 5, 0, 5)
            img.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48); Instance.new("UICorner", img).CornerRadius = UDim.new(1, 0)
            
            local info = Instance.new("TextLabel", item); info.Size = UDim2.new(1, -60, 1, 0); info.Position = UDim2.new(0, 55, 0, 0)
            info.Text = "<b>" .. p.DisplayName .. "</b>\n<font color='#00FFCC'>@" .. p.Name .. "</font>"; info.RichText = true; info.TextColor3 = Color3.new(1,1,1); info.BackgroundTransparency = 1; info.TextXAlignment = Enum.TextXAlignment.Left; info.Font = Enum.Font.GothamMedium
            
            b.MouseButton1Click:Connect(function() 
                StopMyAnims() 
                targetPlayer = p 
                RefreshList() 
            end)
        end
    end
end
