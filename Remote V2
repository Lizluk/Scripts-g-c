-- ==========================================
-- LOGIC HOOK & QUẢN LÝ TRẠNG THÁI
-- ==========================================

local CapturedLogs = {}   -- Danh sách lưu các lệnh đã bắt được

local function GetFullPath(obj)
    local fullName = obj.Name
    local current = obj.Parent
    while current and current ~= game and current ~= workspace do
        fullName = current.Name .. "." .. fullName
        current = current.Parent
    end
    return 'game:GetService("' .. (obj.Parent and obj.Parent.Name or "ReplicatedStorage") ..")." .. fullName
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if method == "FireServer" or method == "InvokeServer" then
        -- Kiểm tra trong danh sách CapturedLogs xem lệnh này có đang bị đánh dấu chặn (IsIgnored = true) không
        for _, log in ipairs(CapturedLogs) do
            if log.Object == self and log.IsIgnored then
                return nil -- Chặn đứng lệnh ngay lập tức!
            end
        end
        
        -- Nếu chưa có trong danh sách hiển thị thì thêm mới vào
        local remotePath = GetFullPath(self)
        local found = false
        for _, log in ipairs(CapturedLogs) do
            if log.Object == self and log.Method == method then
                log.Count = log.Count + 1
                found = true
                break
            end
        end
        
        if not found then
            table.insert(CapturedLogs, {
                Object = self,
                Path = remotePath,
                Method = method,
                Count = 1,
                IsIgnored = false
            })
            
            if #CapturedLogs > 40 then
                table.remove(CapturedLogs, 1)
            end
        end
    end
    
    return oldNamecall(self, ...)
end)

-- Vẽ lại giao diện danh sách
local function RefreshLogUI()
    for _, child in ipairs(LogListContainer:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    local totalHeight = 0
    for _, logData in ipairs(CapturedLogs) do
        local LogItem = Instance.new("Frame")
        LogItem.Parent = LogListContainer
        LogItem.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        LogItem.BorderSizePixel = 0
        LogItem.Size = UDim2.new(1, 0, 0, 32)
        
        -- Thanh màu: Đỏ nếu đang chặn (Ignore), Xanh nếu hoạt động bình thường
        local StatusIndicator = Instance.new("Frame")
        StatusIndicator.Parent = LogItem
        StatusIndicator.BackgroundColor3 = logData.IsIgnored and Color3.fromRGB(220, 50, 50) or Color3.fromRGB(50, 200, 100)
        StatusIndicator.BorderSizePixel = 0
        StatusIndicator.Size = UDim2.new(0, 4, 1, 0)
        
        -- Số đếm (Count)
        local CountLabel = Instance.new("TextLabel")
        CountLabel.Parent = LogItem
        CountLabel.BackgroundTransparency = 1
        CountLabel.Position = UDim2.new(0, 8, 0, 0)
        CountLabel.Size = UDim2.new(0, 25, 1, 0)
        CountLabel.Font = Enum.Font.GothamBold
        CountLabel.Text = tostring(logData.Count)
        CountLabel.TextColor3 = logData.IsIgnored and Color3.fromRGB(220, 100, 100) or Color3.fromRGB(100, 220, 100)
        CountLabel.TextSize = 11
        
        -- Tên lệnh / Đường dẫn
        local PathLabel = Instance.new("TextLabel")
        PathLabel.Parent = LogItem
        PathLabel.BackgroundTransparency = 1
        PathLabel.Position = UDim2.new(0, 35, 0, 0)
        PathLabel.Size = UDim2.new(0, 280, 1, 0)
        PathLabel.Font = Enum.Font.Code
        PathLabel.Text = logData.Path .. ":" .. logData.Method .. "()"
        PathLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        PathLabel.TextSize = 10
        PathLabel.TextXAlignment = Enum.TextXAlignment.Left
        PathLabel.TextTruncate = Enum.TextTruncate.AtEnd
        
        -- Nút bấm riêng cho từng dòng (Ignore / Bỏ Chặn)
        local ToggleBlockBtn = Instance.new("TextButton")
        ToggleBlockBtn.Parent = LogItem
        ToggleBlockBtn.BackgroundColor3 = logData.IsIgnored and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(180, 50, 50)
        ToggleBlockBtn.Position = UDim2.new(0, 325, 0, 5)
        ToggleBlockBtn.Size = UDim2.new(0, 75, 0, 22)
        ToggleBlockBtn.Font = Enum.Font.GothamBold
        ToggleBlockBtn.Text = logData.IsIgnored and "Bỏ Chặn" or "Ignore"
        ToggleBlockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ToggleBlockBtn.TextSize = 10
        
        ToggleBlockBtn.MouseButton1Click:Connect(function()
            logData.IsIgnored = not logData.IsIgnored
            RefreshLogUI()
        end)
        
        totalHeight = totalHeight + 37
    end
    
    LogListContainer.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

