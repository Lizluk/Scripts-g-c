-- ==========================================
-- LOGIC HOOK & QUẢN LÝ DANH SÁCH LỆNH
-- ==========================================

local IgnoredRemotes = {} -- Danh sách các đường dẫn/tên remote bị chặn (Ignore)
local CapturedLogs = {}   -- Danh sách lưu trữ các log hiển thị trên UI

local function GetFullPath(obj)
    local fullName = obj.Name
    local current = obj.Parent
    while current and current ~= game and current ~= workspace do
        fullName = current.Name .. "." .. fullName
        current = current.Parent
    end
    return 'game:GetService("' .. (obj.Parent and obj.Parent.Name or "ReplicatedStorage") ..")." .. fullName
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if method == "FireServer" or method == "InvokeServer" then
        local remotePath = GetFullPath(self)
        
        -- Kiểm tra xem remote này có nằm trong danh sách Ignore hay không
        if IgnoredRemotes[remotePath] or IgnoredRemotes[self.Name] then
            return nil -- Chặn lệnh không cho gửi đi
        end
        
        -- Ghi lại lịch sử lệnh gọi (Remote Spy)
        table.insert(CapturedLogs, {
            Object = self,
            Path = remotePath,
            Method = method,
            Args = args
        })
        
        -- Giới hạn số lượng log hiển thị tránh tràn bộ nhớ
        if #CapturedLogs > 50 then
            table.remove(CapturedLogs, 1)
        end
    end
    
    return oldNamecall(self, ...)
end)

-- Cập nhật giao diện danh sách log phong cách Remote Spy
local function RefreshLogUI()
    for _, child in ipairs(LogListContainer:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    local totalHeight = 0
    for i, logData in ipairs(CapturedLogs) do
        local LogItem = Instance.new("Frame")
        LogItem.Parent = LogListContainer
        LogItem.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        LogItem.BorderSizePixel = 0
        LogItem.Size = UDim2.new(1, 0, 0, 32)
        
        -- Thanh màu đỏ bên cạnh giống giao diện mẫu
        local RedBar = Instance.new("Frame")
        RedBar.Parent = LogItem
        RedBar.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        RedBar.BorderSizePixel = 0
        RedBar.Size = UDim2.new(0, 4, 1, 0)
        
        -- Số đếm lượt gọi
        local CountLabel = Instance.new("TextLabel")
        CountLabel.Parent = LogItem
        CountLabel.BackgroundTransparency = 1
        CountLabel.Position = UDim2.new(0, 10, 0, 0)
        CountLabel.Size = UDim2.new(0, 30, 1, 0)
        CountLabel.Font = Enum.Font.GothamBold
        CountLabel.Text = "1"
        CountLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
        CountLabel.TextSize = 12
        
        -- Đường dẫn lệnh
        local PathLabel = Instance.new("TextLabel")
        PathLabel.Parent = LogItem
        PathLabel.BackgroundTransparency = 1
        PathLabel.Position = UDim2.new(0, 45, 0, 0)
        PathLabel.Size = UDim2.new(0, 355, 1, 0)
        PathLabel.Font = Enum.Font.Code
        PathLabel.Text = logData.Path .. ":" .. logData.Method .. "()"
        PathLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        PathLabel.TextSize = 11
        PathLabel.TextXAlignment = Enum.TextXAlignment.Left
        PathLabel.TextTruncate = Enum.TextTruncate.AtEnd
        
        totalHeight = totalHeight + 37
    end
    
    LogListContainer.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

-- Nút chuyển sang chế độ Ignore (Chặn)
IgnoreBtn.MouseButton1Click:Connect(function()
