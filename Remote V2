        IgnoredRemotes[logData.Path] = true
        IgnoredRemotes[logData.Object.Name] = true
    end
    print("Đã đưa toàn bộ Remote đang hiển thị vào danh sách chặn (Ignore)!")
end)

-- Nút Bỏ Chặn (Xóa khỏi danh sách Ignore)
UnblockBtn.MouseButton1Click:Connect(function()
