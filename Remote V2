-- ==========================================
-- LOGIC XỬ LÝ CHẶN LỆNH (HOOKING)
-- ==========================================

local BlockedCommands = {} 
local BlockerEnabled = true

-- Hook metamethod để can thiệp vào Remote gọi từ Client lên Server
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    if BlockerEnabled and (method == "FireServer" or method == "InvokeServer") then
        local remoteName = self.Name
        local fullPath = tostring(self)
        
        -- Kiểm tra nếu lệnh gọi khớp với bất kỳ chuỗi nào nằm trong danh sách đen
        for _, blockedPath in ipairs(BlockedCommands) do
            if remoteName == blockedPath or fullPath:find(blockedPath) then
                -- Chặn đứng lệnh (không cho gửi đi)
                return nil 
            end
        end
    end
    
    return oldNamecall(self, ...)
end)

-- Xử lý bật/tắt toàn bộ bộ chặn
ToggleBlockerBtn.MouseButton1Click:Connect(function()
    BlockerEnabled = not BlockerEnabled
    if BlockerEnabled then
        ToggleBlockerBtn.Text = "Trạng thái Chặn: BẬT"
        ToggleBlockerBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    else
        ToggleBlockerBtn.Text = "Trạng thái Chặn: TẮT"
        ToggleBlockerBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Hàm tạo giao diện hiển thị từng lệnh bị chặn trong danh sách
local function RenderBlockedList()
    -- Xóa các UI item cũ (trừ các điều khiển gốc)
    for _, child in ipairs(BlockerTab:GetChildren()) do
        if child:IsA("Frame") and child ~= Spacer then
            child:Destroy()
        end
    end
    
    -- Tạo lại danh sách dòng lệnh
    for i, cmd in ipairs(BlockedCommands) do
        local ItemFrame = Instance.new("Frame")
        ItemFrame.Parent = BlockerTab
        ItemFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        ItemFrame.Size = UDim2.new(0, 360, 0, 30)
        
        local CmdLabel = Instance.new("TextLabel")
        CmdLabel.Parent = ItemFrame
        CmdLabel.BackgroundTransparency = 1
        CmdLabel.Position = UDim2.new(0, 5, 0, 0)
        CmdLabel.Size = UDim2.new(0, 270, 1, 0)
        CmdLabel.Font = Enum.Font.Code
        CmdLabel.Text = cmd
        CmdLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        CmdLabel.TextSize = 11
        CmdLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        local UnblockBtn = Instance.new("TextButton")
        UnblockBtn.Parent = ItemFrame
        UnblockBtn.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
        UnblockBtn.Position = UDim2.new(0, 280, 0, 3)
        UnblockBtn.Size = UDim2.new(0, 75, 0, 24)
        UnblockBtn.Font = Enum.Font.GothamBold
        UnblockBtn.Text = "Bỏ Chặn"
        UnblockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        UnblockBtn.TextSize = 10
        
        -- Sự kiện bấm nút Bỏ chặn
        UnblockBtn.MouseButton1Click:Connect(function()
            table.remove(BlockedCommands, i)
            RenderBlockedList()
        end)
    end
end

-- Sự kiện bấm nút Thêm Chặn
AddButton.MouseButton1Click:Connect(function()
    local text = CommandInput.Text
    -- Loại bỏ khoảng trắng thừa
    text = text:gsub("^%s*(.-)%s*$", "%1")
    
    if text ~= "" then
        -- Kiểm tra trùng lặp
        local exists = false
        for _, v in ipairs(BlockedCommands) do
            if v == text then exists = true break end
        end
        
        if not exists then
            table.insert(BlockedCommands, text)
            CommandInput.Text = ""
            RenderBlockedList()
        end
    end
end)

