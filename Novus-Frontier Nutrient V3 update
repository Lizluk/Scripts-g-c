-- Hàm tạo ô nhập dữ liệu thẩm mỹ
local function createInput(name, placeholder, posY)
    local label = Instance.new("TextLabel")
    local textWidth = (name == "Nutrient C") and 85 or 80
    label.Size = UDim2.new(0, textWidth, 0, 30)
    label.Position = UDim2.new(0, 15, 0, posY)
    label.BackgroundTransparency = 1
    label.Text = "📍 " .. name .. ":"
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = MainFrame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 95, 0, 30)
    box.Position = UDim2.new(0, 125, 0, posY)
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    box.BorderSizePixel = 0
    box.Text = placeholder
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 13
    box.Font = Enum.Font.Gotham
    box.Parent = MainFrame
    
    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = box
    
    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = Color3.fromRGB(60, 60, 60)
    boxStroke.Thickness = 1
    boxStroke.Parent = box
    
    -- Hiệu ứng khi focus ô nhập
    box.Focused:Connect(function()
        boxStroke.Color = Color3.fromRGB(255, 255, 255)
    end)
    box.FocusLost:Connect(function()
        boxStroke.Color = Color3.fromRGB(60, 60, 60)
    end)
    
    return box
end

local InputA = createInput("Nutrient A", "100", 55)
local InputB = createInput("Nutrient B", "100", 100)
local InputC = createInput("Nutrient C", "100", 145)

