--======================================================================
-- LOGIC KẾT NỐI VÀ QUÈT ĐƯỜNG DẪN MỚI ĐỂ KHÓA CHỈ SỐ
--======================================================================
ToggleBtn.MouseButton1Click:Connect(function()
    isLocking = not isLocking
    
    if isLocking then
        targetA = tonumber(InputA.Text) or 100
        targetB = tonumber(InputB.Text) or 100
        targetC = tonumber(InputC.Text) or 100
        
        ToggleBtn.Text = "ĐANG KHÓA (ON) 🔒"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            TextColor3 = Color3.fromRGB(0, 0, 0)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(255, 255, 255)
    else
        ToggleBtn.Text = "CHƯA KHÓA (OFF)"
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(40, 40, 40),
            TextColor3 = Color3.fromRGB(200, 200, 200)
        }):Play()
        BtnStroke.Color = Color3.fromRGB(100, 100, 100)
    end
end)

RunService.Heartbeat:Connect(function()
    if not isLocking then return end
    
    -- Đường dẫn mới bạn yêu cầu: PlayerGui -> ReplicationTarget -> PlayerData -> Saves
    local playerGui = client:FindFirstChild("PlayerGui")
    local repTarget = playerGui and playerGui:FindFirstChild("ReplicationTarget")
    local dataFolder = repTarget and repTarget:FindFirstChild("PlayerData")
    local savesFolder = dataFolder and dataFolder:FindFirstChild("Saves")
    
    if savesFolder then
        -- Sử dụng GetDescendants() để quét sâu vào toàn bộ sinh vật nằm bên trong thư mục Saves
        for _, creature in pairs(savesFolder:GetDescendants()) do
            -- Kiểm tra và khóa thuộc tính Nutrient A
            if creature:GetAttribute("NutrientA") ~= nil then
                creature:SetAttribute("NutrientA", targetA)
            end
            -- Kiểm tra và khóa thuộc tính Nutrient B
            if creature:GetAttribute("NutrientB") ~= nil then
                creature:SetAttribute("NutrientB", targetB)
            end
            -- Kiểm tra và khóa thuộc tính Nutrient C
            if creature:GetAttribute("NutrientC") ~= nil then
                creature:SetAttribute("NutrientC", targetC)
            end
        end
    end
end)

-- Phím tắt phím J dùng để Ẩn / Hiện nhanh giao diện Locker này
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.J then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

