-- 2. LOGIC XỬ LÝ
local function startLoop()
    loopTask = task.spawn(function()
        while isRunning do
            local count = tonumber(countInput.Text) or 20
            local minutes = tonumber(intervalInput.Text) or 2

            -- Thực hiện gọi Remote theo số lượng cấu hình
            for i = 1, count do
                if not isRunning then break end
                pcall(function()
                    local algae = workspace.Interactions.Food:FindFirstChild("Algae")
                    if algae then
                        foodRemote:FireServer(algae)
                    end
                end)
                task.wait(0.1) -- Tránh spam quá nhanh gây lag server
            end

            -- Chờ khoảng thời gian đã định
            if isRunning then
                local waitSeconds = minutes * 60
                for timeRemaining = waitSeconds, 1, -1 do
                    if not isRunning then break end
                    statusLabel.Text = string.format("Chờ lượt tiếp: %d giây", timeRemaining)
                    task.wait(1)
                end
            end
        end
    end)
end

local function toggleState()
    isRunning = not isRunning

    if isRunning then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        toggleBtn.Text = "TRẠNG THÁI: ON"
        statusLabel.Text = "Đang chạy..."
        startLoop()
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        toggleBtn.Text = "TRẠNG THÁI: OFF"
        statusLabel.Text = "Đang dừng..."
        if loopTask then
            task.cancel(loopTask)
            loopTask = nil
        end
    end
end

-- Bật / Tắt bằng nút bấm
toggleBtn.MouseButton1Click:Connect(toggleState)

-- Bật / Tắt bằng phím F2
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F2 then
        toggleState()
    end
end)
