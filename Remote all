local function SaveTargetDataToFile()
    if not writefile then return end
    local exportTable = {}
    for _, item in ipairs(TargetRemotesList) do
        table.insert(exportTable, {
            Name = item.Name,
            Code = item.Code,
            SampleName = item.SampleName,
            Mode = item.Mode,
            Value = item.Value,
            IsActive = item.IsActive
        })
    end
    pcall(function()
        writefile(TargetSaveFileName, HttpService:JSONEncode(exportTable))
    end)
end

local function ExecuteKillForTargetRemote(itemData)
    for plr, _ in pairs(SelectedPlayers) do
        if plr and plr.Parent == Players then
            local targetChar = plr.Character or workspace:FindFirstChild(plr.Name)
            if targetChar then
                local codeToRun = itemData.Code
                if string.find(codeToRun, itemData.SampleName .. "%.Humanoid") then
                    codeToRun = string.gsub(codeToRun, "workspace%." .. itemData.SampleName .. "%.Humanoid", "game:GetService('Players')['" .. plr.Name .. "'].Character.Humanoid")
                else
                    codeToRun = string.gsub(codeToRun, itemData.SampleName, plr.Name)
                end

                local func, err = loadstring(codeToRun)
                if func then
                    task.spawn(function() pcall(func) end)
                end
            end
        end
    end
end

