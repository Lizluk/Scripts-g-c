    local function UpdateItemModeUI()
        if itemData.Mode == 1 then
            SwitchModeBtn.BackgroundColor3 = Color3.fromRGB(45, 80, 140)
            SwitchModeBtn.Text = "⏱️ Delay"
        else
            SwitchModeBtn.BackgroundColor3 = Color3.fromRGB(140, 45, 80)
            SwitchModeBtn.Text = "💥 Spam"
        end
    end
    UpdateItemModeUI()

    SwitchModeBtn.MouseButton1Click:Connect(function()
        itemData.Mode = (itemData.Mode == 1 and 2 or 1)
        UpdateItemModeUI()
        if itemData.IsActive then itemData:RestartLogic() end
        SaveDataToFile()
    end)

    ItemValBox.FocusLost:Connect(function()
        local n = tonumber(ItemValBox.Text)
        if n and n > 0 then itemData.Value = n else ItemValBox.Text = tostring(itemData.Value) end
        if itemData.IsActive then itemData:RestartLogic() end
        SaveDataToFile()
    end)

    local KeyBtn = Instance.new("TextButton")
