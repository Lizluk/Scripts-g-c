local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

-- 1. CẤU HÌNH TỆP LƯU DỮ LIỆU
local FOLDER_NAME = "MyScriptHubData"
local FILE_NAME = FOLDER_NAME .. "/saved_hub.json"

-- Khai báo bảng lưu dữ liệu mặc định
local HubData = {
    SavedScripts = {}, -- Nơi lưu danh sách các script
    Settings = {
        AutoExecute = false,
        DefaultFuel = 100
    }
}

-- 2. HÀM TẢI DỮ LIỆU TỪ Ổ ĐĨA (LOAD)
local function LoadData()
    if isfolder and not isfolder(FOLDER_NAME) then
        makefolder(FOLDER_NAME)
    end

    if isfile and isfile(FILE_NAME) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(FILE_NAME))
        end)
        
        if success and type(result) == "table" then
            HubData = result
            print("[Script Hub]: Đã tải thành công dữ liệu vĩnh viễn!")
        else
            warn("[Script Hub]: Lỗi đọc file JSON, dùng dữ liệu mặc định.")
        end
    else
        print("[Script Hub]: Chưa có file lưu, tạo file mới...")
        -- Lưu file mặc định lần đầu
        if writefile then
            writefile(FILE_NAME, HttpService:JSONEncode(HubData))
        end
    end
end

-- 3. HÀM LƯU DỮ LIỆU VÀO Ổ ĐĨA (SAVE)
local function SaveData()
    if writefile then
        local success, err = pcall(function()
            writefile(FILE_NAME, HttpService:JSONEncode(HubData))
        end)
        if success then
            print("[Script Hub]: Đã lưu dữ liệu vĩnh viễn thành công!")
        else
            warn("[Script Hub]: Lỗi khi lưu dữ liệu:", err)
        end
    else
        warn("[Script Hub]: Executor của bạn không hỗ trợ hàm writefile!")
    end
end

-- Tải dữ liệu ngay khi chạy script
LoadData()

-- =================================================================
-- 4. VÍ DỤ THÊM / XÓA SCRIPT VÀ LƯU VĨNH VIỄN
-- =================================================================

-- Hàm thêm một script mới vào Hub và tự lưu lại
local function AddScriptToHub(name, code)
    HubData.SavedScripts[name] = code
    SaveData() -- Gọi lưu ngay lập tức
end

-- Hàm xóa một script khỏi Hub và cập nhật file lưu
local function RemoveScriptFromHub(name)
    HubData.SavedScripts[name] = nil
    SaveData() -- Cập nhật lại file
end

-- Tự động giữ GUI không bị reset đột ngột khi teleport (nếu tạo bằng GuiService/CoreGui)
-- Nếu gắn ScreenGui vào CoreGui thì sẽ không bị mất khi chuyển scene trong cùng game:
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PermanentScriptHub"

if gethui then
    ScreenGui.Parent = gethui()
elseif syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
    ScreenGui.Parent = game:GetService("CoreGui")
elseif game:GetService("CoreGui"):FindFirstChild("RobloxGui") then
    ScreenGui.Parent = game:GetService("CoreGui")
else
    ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end
