-- HỆ THỐNG ESP TÊN TRÊN ĐẦU
----------------------------------------------------------------
local function createESP(player)
    if player == LocalPlayer then return end

    local function applyESP(character)
        if not character then return end
        local head = character:WaitForChild("Head", 5)
        if not head then return end

        if head:FindFirstChild("PlayerESP") then head.PlayerESP:Destroy() end

        local bb = Instance.new("BillboardGui")
        bb.Name = "PlayerESP"
        bb.Size = UDim2.new(0, 200, 0, 50)
        bb.AlwaysOnTop = true
        bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
        bb.Adornee = head
        bb.Parent = head

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextStrokeTransparency = 0
        txt.Font = Enum.Font.SourceSansBold
        txt.TextSize = 14
        txt.Parent = bb

        local connection
        connection = RunService.RenderStepped:Connect(function()
            if not character:IsDescendantOf(workspace) or not head:IsDescendantOf(character) or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                connection:Disconnect()
                bb:Destroy()
                return
            end

            local myRoot = LocalPlayer.Character.HumanoidRootPart
            local distance = math.floor((myRoot.Position - head.Position).Magnitude)
            
            if SelectedPlayers[player] then
                txt.Text = string.format("[🎯 TARGET] %s\n[%d m]", player.Name, distance)
                txt.TextColor3 = Color3.fromRGB(255, 50, 50)
            else
                txt.Text = string.format("%s\n[%d m]", player.Name, distance)
                txt.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end)
    end

    player.CharacterAdded:Connect(applyESP)
    if player.Character then applyESP(player.Character) end
end

for _, p in pairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
