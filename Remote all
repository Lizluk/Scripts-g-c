local RemotesList = {}

local function SaveDataToFile()
    if not writefile then return end
    local exportTable = {}
    for _, item in ipairs(RemotesList) do
        table.insert(exportTable, {
            Name = item.Name,
            Code = item.Code,
            Mode = item.Mode,
            Value = item.Value,
            UseMouseClick = item.UseMouseClick,
            KeyName = item.Key and item.Key.Name or nil
        })
    end
    pcall(function()
        writefile(SaveFileName, HttpService:JSONEncode(exportTable))
    end)
end

function AddRemoteToList(name, rawCode, mode, val, savedMouseClick, savedKeyName)
    if rawCode == "" then return end
    
    local compiledFunc, err = loadstring(rawCode)
    if not compiledFunc then
        warn("Cảnh báo lỗi cú pháp code: ", err)
    end

    local itemData = {
        Name = (name ~= "" and name) or "Remote #" .. (#RemotesList + 1),
        Code = rawCode,
        Func = compiledFunc or function() warn("Remote này đang bị lỗi cú pháp code!") end,
        Mode = mode or 1,
        Value = tonumber(val) or (mode == 1 and 0.1 or 10),
        UseMouseClick = (savedMouseClick == true),
        Key = savedKeyName and Enum.KeyCode[savedKeyName] or nil,
        IsActive = false,
        Thread = nil
    }

    local ItemFrame = Instance.new("Frame")
    ItemFrame.Size = UDim2.new(1, -10, 0, 45)
    ItemFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    ItemFrame.Parent = ScrollFrame
    Instance.new("UICorner", ItemFrame).CornerRadius = UDim.new(0, 6)

    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(0, 100, 0, 35)
    NameLabel.Position = UDim2.new(0, 8, 0, 5)
    NameLabel.BackgroundTransparency = 1
    NameLabel.Text = itemData.Name
    NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    NameLabel.Font = Enum.Font.SourceSansBold
    NameLabel.TextSize = 13
    NameLabel.TextXAlignment = Enum.TextXAlignment.Left
    NameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    NameLabel.Parent = ItemFrame

    local SwitchModeBtn = Instance.new("TextButton")
    SwitchModeBtn.Size = UDim2.new(0, 65, 0, 28)
    SwitchModeBtn.Position = UDim2.new(0, 110, 0, 8)
    SwitchModeBtn.Font = Enum.Font.SourceSansBold
