    local function RestartKillLoop()
        if itemData.LoopThread then
            task.cancel(itemData.LoopThread)
            itemData.LoopThread = nil
        end

        if itemData.IsActive then
            if itemData.Mode == 1 then
                itemData.LoopThread = task.spawn(function()
                    while itemData.IsActive do
                        ExecuteKillForTargetRemote(itemData)
                        task.wait(itemData.Value)
                    end
                end)
            elseif itemData.Mode == 2 then
                local count = math.clamp(math.floor(itemData.Value), 1, 500)
                for i = 1, count do
                    task.spawn(function() ExecuteKillForTargetRemote(itemData) end)
                end
            end
        end
    end

