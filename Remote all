    SwitchModeBtn.Parent = ItemFrame
    Instance.new("UICorner", SwitchModeBtn).CornerRadius = UDim.new(0, 4)

    local ItemValBox = Instance.new("TextBox")
    ItemValBox.Size = UDim2.new(0, 45, 0, 28)
    ItemValBox.Position = UDim2.new(0, 178, 0, 8)
    ItemValBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
