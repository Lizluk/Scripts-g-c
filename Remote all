    MouseBtn.Parent = ItemFrame
    Instance.new("UICorner", MouseBtn).CornerRadius = UDim.new(0, 4)

    local function UpdateMouseBtnUI()
        if itemData.UseMouseClick then
            MouseBtn.BackgroundColor3 = Color3.fromRGB(180, 110, 20)
            MouseBtn.Text = "🖱️ Chuột: ON"
        else
            MouseBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            MouseBtn.Text = "🖱️ Chuột: OFF"
        end
    end
    UpdateMouseBtnUI()

    MouseBtn.MouseButton1Click:Connect(function()
        itemData.UseMouseClick = not itemData.UseMouseClick
        UpdateMouseBtnUI()
        if itemData.IsActive then itemData:RestartLogic() end
        SaveDataToFile()
    end)

    local RunBtn = Instance.new("TextButton")
    RunBtn.Size = UDim2.new(0, 95, 0, 28)
    RunBtn.Position = UDim2.new(0, 387, 0, 8)
    RunBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    RunBtn.Text = "⚪ TẮT"
    RunBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    RunBtn.Font = Enum.Font.SourceSansBold
    RunBtn.TextSize = 12
    RunBtn.Parent = ItemFrame
    Instance.new("UICorner", RunBtn).CornerRadius = UDim.new(0, 4)

    local DelBtn = Instance.new("TextButton")
    DelBtn.Size = UDim2.new(0, 45, 0, 28)
    DelBtn.Position = UDim2.new(1, -50, 0, 8)
    DelBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    DelBtn.Text = "Xóa"
    DelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    DelBtn.Font = Enum.Font.SourceSansBold
    DelBtn.TextSize = 12
    DelBtn.Parent = ItemFrame
    Instance.new("UICorner", DelBtn).CornerRadius = UDim.new(0, 4)

    local function UpdateBtnState()
        if itemData.IsActive then
            RunBtn.BackgroundColor3 = Color3.fromRGB(220, 40, 40)
            RunBtn.Text = "🔴 ĐANG BẬT"
        else
            RunBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            RunBtn.Text = "⚪ TẮT"
        end
    end

    function itemData:RestartLogic()
        if self.Thread then task.cancel(self.Thread); self.Thread = nil end
        if self.IsActive and not self.UseMouseClick then
            if self.Mode == 1 then
                self.Thread = task.spawn(function()
                    while self.IsActive and not self.UseMouseClick do
                        pcall(self.Func)
                        task.wait(self.Value)
                    end
                end)
            elseif self.Mode == 2 then
                local count = math.clamp(math.floor(self.Value), 1, 500)
                for i = 1, count do task.spawn(function() pcall(self.Func) end) end
            end
        end
    end

    function itemData:ToggleOrExecute()
        self.IsActive = not self.IsActive
        UpdateBtnState()
        self:RestartLogic()
    end

    RunBtn.MouseButton1Click:Connect(function() itemData:ToggleOrExecute() end)

    DelBtn.MouseButton1Click:Connect(function()
        if itemData.Thread then task.cancel(itemData.Thread) end
        for idx, elem in ipairs(RemotesList) do
            if elem == itemData then table.remove(RemotesList, idx); break end
        end
        ItemFrame:Destroy()
        SaveDataToFile()
    end)

    table.insert(RemotesList, itemData)
end

local function LoadDataFromFile()
    if not isfile or not isfile(SaveFileName) or not readfile then return end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(SaveFileName))
    end)
    if success and type(result) == "table" then
        for _, savedData in ipairs(result) do
            AddRemoteToList(savedData.Name, savedData.Code, savedData.Mode, savedData.Value, savedData.UseMouseClick, savedData.KeyName)
        end
    end
end

