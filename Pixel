-- Xử lý sự kiện bàn phím & gán phím mới
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if not gameProcessed then
            performAttacks()
        end
        return
    end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        if waitingForKey then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Keybinds[waitingForKey] = input.KeyCode
                waitingForKey = nil
                updateQKey()
                updateHKey()
                updateKKey()
                updateF5Key()
            end
            return
        end

        if UserInputService:GetFocusedTextBox() then return end
        if gameProcessed then return end

        if input.KeyCode == Keybinds.ToggleMenu then
            MainFrame.Visible = not MainFrame.Visible
        elseif input.KeyCode == Keybinds.ToggleTeamMenu then
            TeamFrame.Visible = not TeamFrame.Visible
        elseif input.KeyCode == Keybinds.SelectAll then
            toggleSelectAll()
        elseif input.KeyCode == Keybinds.ToggleAbilityH then
            abilityActive = not abilityActive
            updateAbilityVisuals()
        elseif input.KeyCode == Keybinds.ToggleKillAuraK then
            killAuraKActive = not killAuraKActive
            updateKillAuraKVisuals()
        elseif input.KeyCode == Keybinds.ToggleKillAuraQ then
            killAuraActive = not killAuraActive
            if killAuraActive then
                StatusLabel.Text = "KILL AURA Q: READY"
                StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
            else
                StatusLabel.Text = "KILL AURA Q: PAUSED"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            end
        end
    end
end)

