local function toggleSelectAll()
    local allPlayers = Players:GetPlayers()
    local otherPlayersCount = 0
    local selectedCount = 0

    for _, p in pairs(allPlayers) do
        if p ~= LocalPlayer and not teamSafeList[p.Name] then
            otherPlayersCount = otherPlayersCount + 1
            if targets[p.Name] then
                selectedCount = selectedCount + 1
            end
        end
    end

    if selectedCount == otherPlayersCount and otherPlayersCount > 0 then
        targets = {}
        SelectAllBtn.Text = "☑️ SELECT ALL PLAYERS"
    else
        for _, p in pairs(allPlayers) do
            if p ~= LocalPlayer and not teamSafeList[p.Name] then
                targets[p.Name] = true
            end
        end
        SelectAllBtn.Text = "☒ DESELECT ALL PLAYERS"
    end
end

SelectAllBtn.MouseButton1Click:Connect(toggleSelectAll)

-- Hàm thực thi đòn đánh khi nhấp chuột trái
local function performAttacks()
    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    if killAuraActive and (tick() - lastAttackTime >= attackCooldown) then
        for pName, isTargeted in pairs(targets) do
            if isTargeted and not teamSafeList[pName] then
                local targetCharacter = workspace:FindFirstChild(pName)
                local targetHead = targetCharacter and targetCharacter:FindFirstChild("Head")
                local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                
                if targetRoot and targetHead then
                    local currentDist = (myRoot.Position - targetRoot.Position).Magnitude
                    if currentDist <= maxDetectDistance then
                        pcall(function()
                            if primaryAttackHitRemote then
                                primaryAttackHitRemote:FireServer("Left", targetHead)
                            end
                        end)
                        lastAttackTime = tick()
                        break
                    end
                end
            end
        end
    end

    if killAuraKActive and (tick() - lastKillAuraKTime >= killAuraKCooldown) then
        for pName, isTargeted in pairs(targets) do
            if isTargeted and not teamSafeList[pName] then
                local targetCharacter = workspace:FindFirstChild(pName)
                local targetJaw = targetCharacter and (targetCharacter:FindFirstChild("Jaw") or targetCharacter:FindFirstChild("Head"))
                local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                
                if targetRoot and targetJaw then
                    local currentDist = (myRoot.Position - targetRoot.Position).Magnitude
                    if currentDist <= maxDetectDistance then
                        pcall(function()
                            if abilityHitRemote then
                                abilityHitRemote:FireServer("Charge", targetJaw)
                            end
                        end)
                        lastKillAuraKTime = tick()
                        break
                    end
                end
            end
        end
    end
end

-- Vòng lặp Ability Pounce tự động
task.spawn(function()
    while true do
        if abilityActive then
            if tick() - lastAbilityTime >= abilityCooldown then
                local myCharacter = LocalPlayer.Character
                local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

                if myRoot then
                    for pName, isTargeted in pairs(targets) do
                        if isTargeted and not teamSafeList[pName] then
                            local targetCharacter = workspace:FindFirstChild(pName)
                            local targetBody = targetCharacter and (targetCharacter:FindFirstChild("Body") or targetCharacter:FindFirstChild("Torso") or targetCharacter:FindFirstChild("UpperTorso") or targetCharacter:FindFirstChild("HumanoidRootPart"))
                            local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

                            if targetRoot and targetBody then
                                local currentDist = (myRoot.Position - targetRoot.Position).Magnitude
                                if currentDist <= maxDetectDistance then
                                    pcall(function()
                                        if abilityHitRemote then
                                            abilityHitRemote:FireServer("Pounce", targetBody, targetRoot.CFrame)
                                        end
                                    end)
                                    lastAbilityTime = tick()
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)

