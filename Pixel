UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if UserInputService:GetFocusedTextBox() then return end
    if gameProcessed then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        performKillAuraAttack()
    end

    if input.KeyCode == Enum.KeyCode.P then MainFrame.Visible = not MainFrame.Visible end
    if input.KeyCode == Enum.KeyCode.T then toggleSelectAll() end
    if input.KeyCode == Enum.KeyCode.H then
        abilityActive = not abilityActive
        updateAbilityVisuals()
    end
    if input.KeyCode == Enum.KeyCode.Q then
        killAuraActive = not killAuraActive
        if killAuraActive then
            StatusLabel.Text = "KILL AURA: READY [Q]"
            StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            StatusLabel.Text = "KILL AURA: PAUSED [Q]"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        end
    end
end)

