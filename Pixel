local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, child in pairs(TeamScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}
    teamButtons = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name

            -- Nút Kill List
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 30)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 14
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                if not teamSafeList[pName] then
                    targets[pName] = not targets[pName]
                end
            end)
            buttons[pName] = {Button = Btn}

            -- Nút Team List
            local TeamBtn = Instance.new("TextButton")
            TeamBtn.Size = UDim2.new(1, 0, 0, 30)
            TeamBtn.Font = Enum.Font.SourceSansBold
            TeamBtn.TextSize = 14
            TeamBtn.BorderSizePixel = 0
            TeamBtn.Parent = TeamScrollingFrame

            local TeamBtnCorner = Instance.new("UICorner")
            TeamBtnCorner.CornerRadius = UDim.new(0, 4)
            TeamBtnCorner.Parent = TeamBtn

            TeamBtn.MouseButton1Click:Connect(function()
                if teamSafeList[pName] then
                    teamSafeList[pName] = nil
                else
                    teamSafeList[pName] = true
                    targets[pName] = nil 
                end
            end)
            teamButtons[pName] = {Button = TeamBtn}
        end
    end
end

