local function applyESP(player, character)
    if not character or player == LocalPlayer then return end
    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 5)
    if not head then return end

    if head:FindFirstChild("PlayerESP") then 
        head.PlayerESP:Destroy() 
    end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerESP"
    bb.Size = UDim2.new(0, 150, 0, 30)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = head
    bb.MaxDistance = maxDetectDistance
    bb.Parent = head

    local txt = Instance.new("TextLabel")
    txt.Name = "ESPText"
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.Parent = bb
end

local function setupPlayerESP(player)
    if player == LocalPlayer then return end
    player.CharacterAdded:Connect(function(char)
        applyESP(player, char)
    end)
    if player.Character then
        applyESP(player, player.Character)
    end
end

for _, p in pairs(Players:GetPlayers()) do 
    setupPlayerESP(p) 
end
Players.PlayerAdded:Connect(setupPlayerESP)

local buttons = {}

local function buildButtons()
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    buttons = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 30)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 14
            Btn.BorderSizePixel = 0
            Btn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                if targets[pName] then
                    targets[pName] = nil
                else
                    targets[pName] = true
                end
            end)

            buttons[pName] = {Button = Btn}
        end
    end
end

Players.PlayerAdded:Connect(buildButtons)
Players.PlayerRemoving:Connect(function(player)
    targets[player.Name] = nil
    buildButtons()
end)
buildButtons()

task.spawn(function()
    while true do
        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        
        local minDistance = math.huge
        local tempClosest = ""

        if myRoot then
            for pName, btnData in pairs(buttons) do
                local p = Players:FindFirstChild(pName)
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist <= maxDetectDistance and dist < minDistance then
                        minDistance = dist
                        tempClosest = pName
                    end
                    if targets[pName] then
                        btnData.Button.LayoutOrder = math.floor(dist) - 100000
                    else
                        btnData.Button.LayoutOrder = math.floor(dist)
                    end
                else
                    btnData.Button.LayoutOrder = 999999
                end
            end
        end
        closestPlayerName = tempClosest

        for pName, btnData in pairs(buttons) do
            local Btn = btnData.Button
            local p = Players:FindFirstChild(pName)
            local distText = ""
            
            if myRoot and p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude)
                distText = " [" .. dist .. "m]"
            end

            if searchFilterText == "" or string.find(string.lower(pName), searchFilterText, 1, true) then
                Btn.Visible = true
            else
                Btn.Visible = false
            end

            if targets[pName] then
                if killAuraActive then
                    Btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                    Btn.Text = pName .. distText .. " [TARGET]"
                else
                    Btn.BackgroundColor3 = Color3.fromRGB(160, 120, 30)
                    Btn.Text = pName .. distText .. " [PAUSED]"
                end
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            elseif pName == closestPlayerName then
                Btn.BackgroundColor3 = Color3.fromRGB(15, 45, 30) 
                Btn.Text = "⭐ " .. pName .. " [GẦN]"
                Btn.TextColor3 = Color3.fromRGB(50, 255, 130)
            else
                Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                Btn.Text = pName .. distText
                Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end

        task.wait(0.3)
    end
end)
