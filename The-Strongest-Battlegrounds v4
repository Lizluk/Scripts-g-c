-- LOGIC KIỂM TRA MẤT MÁU (CHUYỂN MỤC TIÊU SANG KẺ ĐÁNH)
-- =============================================
local lastHealth = 100
local function SetupDamageListener(char)
local hum = char:WaitForChild("Humanoid", 10)
if hum then
lastHealth = hum.Health
hum.HealthChanged:Connect(function(health)
if active and health < lastHealth then
lastDamageTime = os.clock() -- Ghi nhận thời điểm bị trúng đòn để kích hoạt đẩy lùi
local attacker = nil
-- 1. Ưu tiên tìm "creator" tag từ vũ khí chuẩn của Roblox
local creator = hum:FindFirstChild("creator")
if creator and creator.Value and creator.Value:IsA("Player") then
attacker = creator.Value
else
-- 2. Nếu không có creator tag, dò tìm người chơi không có trong Blacklist đứng gần bạn nhất (trong cự ly 15 studs)
local minDist = 15
for _, p in pairs(Players:GetPlayers()) do
if p ~= lp and not Blacklist[p.UserId] and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
local dist = (p.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
if dist < minDist then
minDist = dist
attacker = p
end
end
end
end

            -- Khóa mục tiêu sang kẻ tấn công
            if attacker and attacker ~= lp and not Blacklist[attacker.UserId] then
                SetTarget(attacker)
            end
        end
        lastHealth = health
    end)
end


end
if lp.Character then SetupDamageListener(lp.Character) end
lp.CharacterAdded:Connect(SetupDamageListener)

-- =============================================
-- LOGIC ĐỨNG THẲNG TRÊN MẶT ĐẤT & TỰ ĐỘNG BÁM
-- =============================================
RunService.Stepped:Connect(function()
local myChar = lp.Character
local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

-- AN TOÀN TRẢ LẠI GÓC XOAY CHO NHÂN VẬT KHI KHÔNG HOẠT ĐỘNG
if not active then 
    if myHum and not myHum.AutoRotate then
        myHum.AutoRotate = true
    end
    return 
end

-- CHỐNG BỊ NGÃ/RAGDOLL HOẶC KHỰNG LẠI KHI BỊ ĂN ĐÒN CHUNG VỚI ĐỐI PHƯƠNG
if myHum then
    myHum.PlatformStand = false
    myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    myHum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
    
    -- Nếu vô tình bị chuyển sang trạng thái ngã do nhận sát thương, ép quay lại Running ngay lập tức
    local currentState = myHum:GetState()
    if currentState == Enum.HumanoidStateType.Ragdoll or currentState == Enum.HumanoidStateType.FallingDown or currentState == Enum.HumanoidStateType.PlatformStanding then
        myHum:ChangeState(Enum.HumanoidStateType.Running)
    end
end

-- KIỂM TRA TRẠNG THÁI CHẾT CHÍNH XÁC (Xử lý dứt điểm lỗi bám theo xác chết và kẹt tích xanh)
local targetHum = targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid")
local isTargetDead = false

if targetPlayer then
    if not targetPlayer.Parent then
        isTargetDead = true -- Người chơi thoát game
    elseif not targetPlayer.Character or not targetPlayer.Character.Parent then
        isTargetDead = true -- Mô hình nhân vật bị xóa khỏi game
    elseif not targetHum or targetHum.Health <= 0 or targetHum:GetState() == Enum.HumanoidStateType.Dead then
        isTargetDead = true -- Người chơi đã cạn máu hoặc hệ thống ghi nhận đã chết
    end
else
    isTargetDead = true
end

-- TỰ ĐỘNG QUÉT TÌM MỤC TIÊU MỚI KHI MỤC TIÊU HIỆN TẠI CHẾT
if isTargetDead and myHrp then
    local closestPlayer = nil
    local minDist = Config.AR -- Lấy giới hạn từ Slider "Phạm vi tự động"
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp and not Blacklist[p.UserId] and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pHum = p.Character:FindFirstChildOfClass("Humanoid")
            -- Chỉ quét những người chơi thực sự còn sống
            if pHum and pHum.Health > 0 and pHum:GetState() ~= Enum.HumanoidStateType.Dead then
                local dist = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closestPlayer = p
                end
            end
        end
    end
    
    -- Cập nhật mục tiêu qua SetTarget (nếu không có ai gần, trả về nil và lập tức tắt tích xanh trên giao diện)
    SetTarget(closestPlayer)
end

-- AN TOÀN TRẢ LẠI GÓC XOAY CHO NHÂN VẬT KHI KHÔNG CÓ AI ĐỂ BÁM THEO
if not targetPlayer or not targetPlayer.Character then 
    if myHum and not myHum.AutoRotate then
        myHum.AutoRotate = true
    end
    return 
end

local tChar = targetPlayer.Character
local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

if myHrp and tHrp and myHum and tHum then
    myHum.AutoRotate = false -- Khóa tự động xoay khi đang thực hiện mô phỏng bám sát

    -- 1. Xử lý hướng xoay phẳng (Chống lật lộn nhào)
    local rawLook = tHrp.CFrame.LookVector
    local flatLook = Vector3.new(rawLook.X, 0, rawLook.Z).Unit
    if flatLook.Magnitude == 0 or tostring(flatLook.X) == "nan" then 
        flatLook = Vector3.new(0, 0, -1)
    end

    -- 2. Tính toán vị trí XZ mục tiêu (chưa tính chiều cao Y)
    local uprightTargetCF = CFrame.lookAt(tHrp.Position, tHrp.Position + flatLook)
    local goalCF = uprightTargetCF * CFrame.new(Config.R, 0, -Config.F)
    
    -- [Cơ Chế Đẩy Lùi Khi Bị Sát Thương]: Tính toán khoảng cách đẩy lùi
    local timeSinceDamage = os.clock() - lastDamageTime
    if timeSinceDamage < 1.5 then
        local progress = timeSinceDamage / 1.5
        local pushFactor = 1 - progress -- Smoothly giảm dần lực đẩy lùi từ 1 về 0
        local pushDist = Config.KB * pushFactor
        
        -- Hướng đẩy lùi là hướng từ đối thủ trực diện tới vị trí đích của ta
        local pushDir = (goalCF.Position - tHrp.Position).Unit
        if pushDir.Magnitude == 0 or tostring(pushDir.X) == "nan" then
            pushDir = -flatLook -- Dự phòng đẩy lùi thẳng ra sau lưng đối phương
        end
        
        -- Tịnh tiến vị trí đích ra xa đối phương
        goalCF = goalCF + (pushDir * pushDist)
    end

    -- [Cơ Chế Né Tránh Chủ Động (Active Evasion)]: Quét chuyển động & hoạt ảnh của những người xung quanh
    local dodgeOffset = Vector3.new(0, 0, 0)
    local dodgeDist = Config.DD or 10
    if dodgeDist > 0 then
        for _, p in pairs(Players:GetPlayers()) do
            -- Chỉ kiểm tra người chơi khác và những người không có trong Blacklist
            if p ~= lp and not Blacklist[p.UserId] and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local oHrp = p.Character.HumanoidRootPart
                local oHum = p.Character:FindFirstChildOfClass("Humanoid")
                
                -- Tính toán khoảng cách từ người chơi đó đến vị trí đích (vùng bám của bạn)
                local distToGoal = (oHrp.Position - goalCF.Position).Magnitude
                if distToGoal < dodgeDist then
                    -- Kiểm tra xem người đó có đang "chuyển động" hoặc "kích hoạt chiêu thức (Animation)" không
                    local isThreat = false
                    
                    -- Nếu họ đang chạy hoặc lao tới nhanh (Vận tốc lớn)
                    if oHrp.AssemblyLinearVelocity.Magnitude > 3 then
                        isThreat = true
                    -- Hoặc nếu họ đang chạy Animation (thường là tung skill)
                    elseif oHum then
                        local tracks = oHum:GetPlayingAnimationTracks()
                        if #tracks > 0 then
                            for _, track in ipairs(tracks) do
                                if track.IsPlaying and track.Speed > 0 then
                                    isThreat = true
                                    break
                                end
                            end
                        end
                    end
                    
                    -- Nếu là mối đe dọa hoặc đơn giản là họ đã tiến quá sát vùng an toàn (dưới 70% khoảng cách né)
                    if isThreat or distToGoal < (dodgeDist * 0.7) then
                        local pushDir = (goalCF.Position - oHrp.Position).Unit
                        if pushDir.Magnitude == 0 or tostring(pushDir.X) == "nan" then
                            pushDir = -flatLook -- Dự phòng lướt lùi về sau
                        end
                        -- Tạo lực đẩy lướt mượt mà ra xa mối đe dọa đó
                        local overlapForce = (dodgeDist - distToGoal)
                        dodgeOffset = dodgeOffset + (pushDir * overlapForce)
                    end
                end
            end
        end
    end
    -- Áp dụng độ lệch né tránh vào vị trí đích
    goalCF = goalCF + dodgeOffset
    
    -- 3. RAYCAST ĐỂ TÌM MẶT ĐẤT THỰC TẾ (Chống lún người bên dưới sàn)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    -- Loại bỏ bản thân, mục tiêu, và toàn bộ người chơi khác khỏi tia quét để tránh bị giật lên đầu họ
    local filterInstances = {myChar, tChar}
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            table.insert(filterInstances, p.Character)
        end
    end
    raycastParams.FilterDescendantsInstances = filterInstances
    
    -- Bắn tia từ tầm thấp (chỉ cao hơn mục tiêu 3 studs) xuống dưới vị trí đích để tìm sàn nhà thực tế
    local rayOrigin = Vector3.new(goalCF.Position.X, tHrp.Position.Y + 3, goalCF.Position.Z)
    local rayDirection = Vector3.new(0, -20, 0)
    local raycastResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    
    local finalY = tHrp.Position.Y -- Mặc định lấy theo chiều cao người kia nếu không quét trúng đất
    if raycastResult then
        -- Tính chiều cao đứng chuẩn dựa trên cấu trúc Rig nhân vật
        local hipHeight = (myHum.RigType == Enum.HumanoidRigType.R6) and 3 or (myHum.HipHeight + 1.95)
        finalY = raycastResult.Position.Y + hipHeight
    end
    
    -- 4. Áp dụng chiều cao sàn đã được tính toán kết hợp với Slider "Cao/Thấp (H)"
    local finalPosition = Vector3.new(goalCF.Position.X, finalY + Config.H, goalCF.Position.Z)
    local finalCFrame = CFrame.new(finalPosition) * (goalCF - goalCF.Position)
    
    if faceEachOther then finalCFrame = finalCFrame * CFrame.Angles(0, math.pi, 0) end
    
    -- Đồng bộ vị trí mượt mờ
    myHrp.CFrame = myHrp.CFrame:Lerp(finalCFrame, Config.S/100)
end
if myHrp then 
    -- Khóa đứng yên và triệt tiêu mọi xung lực vật lý gây giật lag
    myHrp.AssemblyLinearVelocity = Vector3.zero 
    myHrp.AssemblyAngularVelocity = Vector3.zero
end
if myChar then
    -- Tắt va chạm của TOÀN BỘ các bộ phận để tránh va chạm vật lý gây giật lag
    for _, p in pairs(myChar:GetDescendants()) do 
        if p:IsA("BasePart") then 
            p.CanCollide = false 
        end 
    end
end


end)
