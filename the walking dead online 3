SpeedBox.PlaceholderText = "Nhập delay (s)..."
SpeedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBox.TextSize = 14
SpeedBox.Font = Enum.Font.SourceSans
SpeedBox.Parent = MainFrame

local BoxCorner = Instance.new("UICorner")
BoxCorner.CornerRadius = UDim.new(0, 6)
BoxCorner.Parent = SpeedBox

local SpeedLabel = Instance.new("TextLabel")
SpeedLabel.Size = UDim2.new(1, 0, 0, 20)
SpeedLabel.Position = UDim2.new(0, 0, 0, 95)
SpeedLabel.BackgroundTransparency = 1
SpeedLabel.Text = "Delay (giây) - Càng nhỏ càng nhanh"
SpeedLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
SpeedLabel.TextSize = 11
SpeedLabel.Font = Enum.Font.SourceSansItalic
SpeedLabel.Parent = MainFrame

--- Hàm cập nhật tốc độ từ ô nhập
SpeedBox.FocusLost:Connect(function(enterPressed)
    local num = tonumber(SpeedBox.Text)
    if num and num >= 0 then
        attackSpeed = num
    else
        SpeedBox.Text = tostring(attackSpeed)
    end
end)

--- Vòng lặp Kill Aura
task.spawn(function()
    while true do
        if enabled then
            pcall(function()
                FightRemote:FireServer(ohString1, ohVector32, ohCFrame3)
            end)
        end
        task.wait(attackSpeed)
    end
end)

--- Lắng nghe sự kiện bấm phím X
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end -- Không kích hoạt khi đang gõ chat
    
    if input.KeyCode == keybind then
        enabled = not enabled
        if enabled then
            StatusLabel.Text = "Trạng thái: ON"
            StatusLabel.TextColor3 = Color3.fromRGB(60, 255, 60)
        else
            StatusLabel.Text = "Trạng thái: OFF"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        end
    end
end)
